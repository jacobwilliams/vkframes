ay (huge() if missed) real ( wp ) :: o ( 3 ), b , c , disc hit = . false . near = huge ( 1.0_wp ) far = huge ( 1.0_wp ) if ( radius <= 0.0_wp ) return o = origin - center b = dot_product ( o , dir ) c = dot_product ( o , o ) - radius * radius disc = b * b - c if ( disc < 0.0_wp ) return if ( - b + sqrt ( disc ) < 0.0_wp ) return near = - b - sqrt ( disc ) far = - b + sqrt ( disc ) hit = . true . end function ray_sphere","tags":"","url":"proc/ray_sphere.html"},{"title":"segment_pick – vkframes","text":"public  function segment_pick(cam, a, b, pixels, s, depth, extra) result(hit) Segment a-b (root frame) passes within the tolerance (plus extra pixels, e.g. half the line's width) of the cursor: the distance\n(pixels) of its closest point, the fraction s of the way from a to b\nof that point in the scene (perspective-correct), and its depth. The\npart behind the eye is cut off. Arguments Type Intent Optional Attributes Name type( PickCamera ), intent(in) :: cam real(kind=wp), intent(in) :: a (3) real(kind=wp), intent(in) :: b (3) real(kind=wp), intent(out) :: pixels distance from the cursor (framebuffer pixels) real(kind=wp), intent(out) :: s fraction of the way from a to b (0 to 1) real(kind=wp), intent(out) :: depth (scene units) real(kind=wp), intent(in), optional :: extra added to the tolerance (framebuffer pixels) Return Value logical Calls proc~~segment_pick~~CallsGraph proc~segment_pick segment_pick proc~project project proc~segment_pick->proc~project Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~segment_pick~~CalledByGraph proc~segment_pick segment_pick proc~curve_pick curve_pick proc~curve_pick->proc~segment_pick proc~segment_artist_pick segment_artist_pick proc~segment_artist_pick->proc~segment_pick proc~vector_pick VectorHandle%vector_pick proc~vector_pick->proc~segment_pick proc~drawable_pick DrawableTrajectory%drawable_pick proc~drawable_pick->proc~curve_pick proc~drawable_pick->proc~segment_artist_pick Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code logical function segment_pick ( cam , a , b , pixels , s , depth , extra ) result ( hit ) type ( PickCamera ), intent ( in ) :: cam real ( wp ), intent ( in ) :: a ( 3 ), b ( 3 ) real ( wp ), intent ( out ) :: pixels !! distance from the cursor (framebuffer pixels) real ( wp ), intent ( out ) :: s !! fraction of the way from a to b (0 to 1) real ( wp ), intent ( out ) :: depth !! (scene units) real ( wp ), intent ( in ), optional :: extra !! added to the tolerance (framebuffer pixels) real ( wp ) :: da , db , s0 , s1 , p0 ( 3 ), p1 ( 3 ), x0 , y0 , x1 , y1 , z0 , z1 , dx , dy , t , len2 , u hit = . false . pixels = huge ( 1.0_wp ) s = 0.0_wp depth = huge ( 1.0_wp ) ! the part in front of the eye: s0 .. s1 of a-b s0 = 0.0_wp s1 = 1.0_wp if ( cam % perspective ) then da = dot_product ( a - cam % eye , cam % forward ) db = dot_product ( b - cam % eye , cam % forward ) if ( da <= cam % near . and . db <= cam % near ) return if ( da <= cam % near ) s0 = ( cam % near - da ) / ( db - da ) * 1.000001_wp if ( db <= cam % near ) s1 = ( da - cam % near ) / ( da - db ) * 0.999999_wp end if p0 = a + s0 * ( b - a ) p1 = a + s1 * ( b - a ) if (. not . project ( cam , p0 , x0 , y0 , z0 )) return if (. not . project ( cam , p1 , x1 , y1 , z1 )) return ! the closest point on the screen segment (the cursor is at 0, 0) dx = x1 - x0 dy = y1 - y0 len2 = dx * dx + dy * dy t = 0.0_wp if ( len2 > 0.0_wp ) t = max ( 0.0_wp , min ( 1.0_wp , - ( x0 * dx + y0 * dy ) / len2 )) pixels = hypot ( x0 + t * dx , y0 + t * dy ) ! back to the scene: linear on the screen is not linear in depth u = t if ( cam % perspective ) u = t * z0 / ( t * z0 + ( 1.0_wp - t ) * z1 ) s = s0 + u * ( s1 - s0 ) depth = z0 + u * ( z1 - z0 ) hit = pixels <= cam % tolerance if ( present ( extra )) hit = pixels <= cam % tolerance + extra hit = hit . and . depth <= cam % max_depth end function segment_pick","tags":"","url":"proc/segment_pick.html"},{"title":"sphere_near – vkframes","text":"public  function sphere_near(cam, c, r, extra) result(near) A sphere (root frame: center c, radius r) might be within the tolerance\n(plus extra pixels) of the cursor on the screen (false only if it\nsurely isn't: to skip what it bounds). Arguments Type Intent Optional Attributes Name type( PickCamera ), intent(in) :: cam real(kind=wp), intent(in) :: c (3) real(kind=wp), intent(in) :: r real(kind=wp), intent(in), optional :: extra added to the tolerance (framebuffer pixels) Return Value logical Calls proc~~sphere_near~~CallsGraph proc~sphere_near sphere_near proc~project project proc~sphere_near->proc~project Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~sphere_near~~CalledByGraph proc~sphere_near sphere_near proc~curve_pick curve_pick proc~curve_pick->proc~sphere_near proc~drawable_pick DrawableTrajectory%drawable_pick proc~drawable_pick->proc~curve_pick Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code logical function sphere_near ( cam , c , r , extra ) result ( near ) type ( PickCamera ), intent ( in ) :: cam real ( wp ), intent ( in ) :: c ( 3 ), r real ( wp ), intent ( in ), optional :: extra !! added to the tolerance (framebuffer pixels) real ( wp ) :: sx , sy , depth , scale , reach near = . true . if ( dot_product ( c - cam % eye , cam % forward ) - r > cam % max_depth ) then ! (all deeper than a hit already found) near = . false . return end if if ( cam % perspective ) then depth = dot_product ( c - cam % eye , cam % forward ) if ( depth <= r + cam % near ) then ! (the eye inside it, or close: can't tell) near = depth > - r return end if if (. not . project ( cam , c , sx , sy , depth )) return scale = cam % half_h / ( cam % tan_y * ( depth - r )) ! pixels per scene unit at its nearest else if (. not . project ( cam , c , sx , sy , depth )) return scale = 2.0_wp * cam % half_h / ( cam % ortho ( 4 ) - cam % ortho ( 3 )) end if reach = cam % tolerance if ( present ( extra )) reach = reach + extra near = hypot ( sx , sy ) <= r * scale + reach end function sphere_near","tags":"","url":"proc/sphere_near.html"},{"title":"wants – vkframes","text":"public pure function wants(cam, kind) Hits of kind (vkf_frames' PICK_*) are wanted. Arguments Type Intent Optional Attributes Name type( PickCamera ), intent(in) :: cam integer, intent(in) :: kind a PICK_* constant of vkf_frames Return Value logical Called by proc~~wants~~CalledByGraph proc~wants wants proc~drawable_pick DrawableTrajectory%drawable_pick proc~drawable_pick->proc~wants proc~pick ReferenceFrame%pick proc~drawable_pick->proc~pick proc~pick->proc~wants proc~pick_ellipsoid pick_ellipsoid proc~pick_ellipsoid->proc~wants proc~time_pick TimeHandle%time_pick proc~time_pick->proc~wants proc~time_pick->proc~pick proc~vector_pick VectorHandle%vector_pick proc~vector_pick->proc~wants proc~vector_pick->proc~pick proc~model_pick Model%model_pick proc~model_pick->proc~pick proc~model_pick->proc~pick_ellipsoid proc~sphere_pick Sphere%sphere_pick proc~sphere_pick->proc~pick proc~sphere_pick->proc~pick_ellipsoid proc~terrain_pick TerrainBody%terrain_pick proc~terrain_pick->proc~pick proc~terrain_pick->proc~pick_ellipsoid proc~window_pick WindowProxy%window_pick proc~window_pick->proc~pick proc~hover_handle hover_handle proc~hover_handle->proc~window_pick proc~dispatch_event dispatch_event proc~dispatch_event->proc~hover_handle proc~release_handle release_handle proc~dispatch_event->proc~release_handle proc~release_handle->proc~hover_handle proc~dispatch_events dispatch_events proc~dispatch_events->proc~dispatch_event proc~frame WindowProxy%frame proc~frame->proc~dispatch_events proc~resize WindowProxy%resize proc~resize->proc~frame proc~run WindowProxy%run proc~run->proc~frame Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Prog