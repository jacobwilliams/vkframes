1 = 0.0_wp end along z (scene units) Source Code type :: ShadowRegion logical :: drawn = . false . !! has a surface (and is to be drawn) real ( wp ) :: z0 = 0.0_wp !! start along z (scene units) real ( wp ) :: r0 = 0.0_wp !! radius at z0 (scene units) real ( wp ) :: z1 = 0.0_wp !! end along z (scene units) real ( wp ) :: r1 = 0.0_wp !! radius at z1 (scene units) real ( wp ) :: color ( 4 ) = 1.0_wp !! [r, g, b, a] (0 to 1) type ( c_ptr ) :: switch = c_null_ptr !! shows or hides the mesh (null until built) type ( c_ptr ) :: mesh = c_null_ptr !! the surface: rings of vertices at z0 and z1 end type ShadowRegion","tags":"","url":"type/shadowregion.html"},{"title":"Sphere – vkframes ","text":"type, public, extends( ReferenceFrame ) :: Sphere A sphere or ellipsoid (see the module documentation). Inherits type~~sphere~~InheritsGraph type~sphere Sphere c_ptr c_ptr type~sphere->c_ptr sphere_node, mesh, lod_node, lod_mesh, image, night type~referenceframe ReferenceFrame type~sphere->type~referenceframe type~referenceframe->c_ptr light_node, light_switch, node_, contents_node, axis_node, axis_label_node, axis_arrow, axis_text, name_label_node, name_text type~framepointer FramePointer type~referenceframe->type~framepointer children, parents type~trajectoryfollower TrajectoryFollower type~referenceframe->type~trajectoryfollower follower_ type~framepointer->type~referenceframe p type~datasource DataSource type~trajectoryfollower->type~datasource sources_ type~trajectorypointer TrajectoryPointer type~trajectoryfollower->type~trajectorypointer trajs type~trajectory Trajectory type~trajectorypointer->type~trajectory p Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial real(kind=wp), private :: ambient_ (4) = 1.0_wp ambient color [r, g, b, a] logical, private :: auto_lod_ = .true. level of detail (default on) real(kind=wp), private :: built_radii (3) = 1.0_wp the mesh's semi-axes real(kind=wp), private :: diffuse_ (4) = 1.0_wp diffuse [r, g, b, a] (times the color if no texture) real(kind=wp), private :: emission_ (4) = [0.0_wp, 0.0_wp, 0.0_wp, 1.0_wp] emission color [r, g, b, a] type(c_ptr), private :: image = c_null_ptr the textures, for meshes built later type(c_ptr), private :: lod_mesh (size(lod_segments)) = c_null_ptr the level-of-detail meshes (null: not built yet) type(c_ptr), private :: lod_node = c_null_ptr chooses among the meshes, per view type(c_ptr), private :: mesh = c_null_ptr without level of detail integer, private :: n_lat = 64 without level of detail integer, private :: n_lon = 128 without level of detail type(c_ptr), private :: night = c_null_ptr the textures, for meshes built later character(len=:), private, allocatable :: night_texture night texture file (unallocated or '': none) real(kind=wp), private :: opacity_ = 1.0_wp 1 opaque; below 1 translucent (see set_opacity) real(kind=wp), private :: radius_ = 1.0_wp radius (scene units; default 1) real(kind=wp), private :: scale_ (3) = 1.0_wp scale along x, y and z: semi-axes radius * scale real(kind=wp), private :: shininess_ = 0.0_wp 0 to 128 (0: no specular highlight) logical, private :: shown = .false. (meshes built later are compiled) real(kind=wp), private :: specular_ (4) = [0.0_wp, 0.0_wp, 0.0_wp, 1.0_wp] specular color [r, g, b, a] real(kind=wp), private :: sphere_attitude_ (4) = quat_identity the body's attitude in the frame ([x, y, z, w]) type(c_ptr), private :: sphere_node = c_null_ptr transform of the body within the frame real(kind=wp), private :: sphere_position_ (3) = 0.0_wp the body's center in the frame (scene units) character(len=:), private, allocatable :: texture texture file (unallocated or '': none) logical, private :: textured = .false. (the color is not used) logical, private :: translucent = .false. built translucent (opacity below 1 when first shown) real(kind=wp), private :: twilight_ = 0.0_wp radians below the horizon (0: none) Constructor public        interface Sphere The Sphere constructor: Sphere(...) makes one (see new_sphere for its\narguments). private  function new_sphere (name, radius, color) result(s) A sphere named name , of radius radius (default 1) and color color ([r, g, b] or [r, g, b, a]; default white, 90% opaque). Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name real(kind=wp), intent(in), optional :: radius scene units (default 1) real(kind=wp), intent(in), optional :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) Return Value type( Sphere ) Type-Bound Procedures procedure, public :: add_child private  function add_child (self, child) result(ok) Add child to this frame's children. Returns false (and does nothing)\nfor this frame itself or an ancestor of it; true if it is already a child. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self class( ReferenceFrame ), intent(inout), target :: child Return Value logical procedure, public :: attitude private pure function attitude (self) result(q) Attitude relative to the parent frame, a quaternion [x, y, z, w]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: auto_lod private pure function auto_lod (self) Whether level of detail is on. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value logical procedure, public :: axes_labels_shown private pure function axes_labels_shown (self) Which axes labels are shown (as axes_shown ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: axes_shown private pure function axes_shown (self) Which axes vectors are shown (NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: axis_label private  function axis_label (self, axis) result(text) The label text of axis X_AXIS, Y_AXIS or Z_AXIS. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: axis Return Value character(len=:), allocatable procedure, public :: bound => sphere_bound private  subroutine sphere_bound (self, center, radius) The body's bounding sphere: its center, and its largest semi-axis. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self real(kind=wp), intent(out) :: center (3) the bounding sphere, frame coordinates (scene units) real(kind=wp), intent(out) :: radius the bounding sphere, frame coordinates (scene units) procedure, public :: build_contents => sphere_build_contents private  subroutine sphere_build_contents (self, viewer, group) The body: an ellipsoid mesh under the sphere's transform. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer (null: headless) type(c_ptr), intent(in) :: group the frame's contents group procedure, public :: child private  function child (self, i) result(c) Child i (1 to num_children). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: child_index private  function child_index (self, frame) Index of frame among the children, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: color private pure function color (self) result(c) The color of the frame's decorations, [r, g, b, a] (0 to 1). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: contents_shown private pure function contents_shown (self) Whether what the frame draws is shown ( show_contents ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: detach private  subroutine detach (self) Remove this frame from all its parents and children (before it goes out\nof scope or is deallocated while in a tree). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self procedure, public :: follow private  subroutine follow (self, traj, data, mode, add) Follow traj (in addition to trajectories already followed, if add is true), with what to follow ( data : FOLLOW_POSITION and/or\nFOLLOW_ATTITUDE; default both) and how ( mode : FOLLOW_LOOP, the\ndefault, or FOLLOW_LIMIT). traj must stay alive while followed. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type( Trajectory ), intent(in), target :: traj the trajectory to follow (not owned) integer, intent(in), optional :: data FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT integer, intent(in), optional :: mode FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT logical, intent(in), optional :: add (true: in addition to those followed (default false)) procedure, public :: follower private  function follower (self) result(f) The frame's trajectory follower, for finer control (data sources, time\noffset, ...). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in), target :: self Return Value type( TrajectoryFollower ), pointer procedure, public :: frame_info => sphere_frame_info private  function sphere_frame_info (self) result(info) What kind of frame this is: 'Sphere'. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: frame_string private recursive function frame_string (self, prefix) result(str) The tree below this frame, one line per frame (\"name (info)\"), in\nOpenFrames' createFrameString format: children are prefixed \"|-->\". Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self character(len=*), intent(in), optional :: prefix before this frame's line (default ' ') Return Value character(len=:), allocatable procedure, public :: has_light_source private recursive function has_light_source (self) result(has) Whether this frame or one of its descendants has a light source enabled. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: is_following private pure function is_following (self) Whether the frame follows trajectories (at least one, since follow ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: label_alignment private pure function label_alignment (self) The labels' alignment (ALIGN_*). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: label_font private  function label_font (self) result(font) The labels' font as set ('' for the renderer's default). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: label_size private pure function label_size (self) The labels' size in pixels. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: late_update private recursive subroutine late_update (self, t) After the whole tree's update for time t (all frames at their positions\nfor t): for contents that depend on other frames' positions, e.g.\nCustomLineSegments between spacecraft. Here, only the descendants'. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time procedure, public :: light_ambient private pure function light_ambient (self) result(rgb) The light source's ambient color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_diffuse private pure function light_diffuse (self) result(rgb) The light source's diffuse color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_source_enabled private pure function light_source_enabled (self) Whether this frame carries a light source. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: light_specular private pure function light_specular (self) result(rgb) The light source's specular color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: local_matrix private pure function local_matrix (self) result(m) The transform from this frame to its parent (4x4). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) procedure, public :: material private pure subroutine material (self, ambient, diffuse, specular, emission, shininess) The material (each optional): ambient, diffuse, specular and emission colors\nand shininess. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self real(kind=wp), intent(out), optional :: ambient (4) [r, g, b, a] real(kind=wp), intent(out), optional :: diffuse (4) [r, g, b, a] real(kind=wp), intent(out), optional :: specular (4) [r, g, b, a] real(kind=wp), intent(out), optional :: emission (4) [r, g, b, a] real(kind=wp), intent(out), optional :: shininess 0 to 128 procedure, public :: move_x_axis private  subroutine move_x_axis (self, base, length, head_ratio, body_radius, head_radius) Place the x axis vector: from base , length long, with a head of head_ratio of the length (default 0.3) and body and head radii (default\n0.05 and 0.1 of the length); its label is at the tip, 0.4 of the length\ntall (at most label_size pixels). As OpenFrames' moveXAxis. Set before\nthe frame is first shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) (base: frame's coordinates) real(kind=wp), intent(in) :: length (base: frame's coordinates) real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_y_axis private  subroutine move_y_axis (self, base, length, head_ratio, body_radius, head_radius) Place the y axis vector (as move_x_axis ; OpenFrames' moveYAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_z_axis private  subroutine move_z_axis (self, base, length, head_ratio, body_radius, head_radius) Place the z axis vector (as move_x_axis ; OpenFrames' moveZAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: name private  function name (self) result(n) The frame's name ('' if none). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: name_label_on_top private pure function name_label_on_top (self) Whether the name label is drawn on top of the scene ( set_name_label_on_top ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: name_label_shown private pure function name_label_shown (self) Whether the name label is shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: night_texture_map private  function night_texture_map (self) result(file) The night texture file ('' for none). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: node private  function node (self) result(n) The frame's transform node (null until realized). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value type(c_ptr) procedure, public :: num_children private pure function num_children (self) Number of children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: num_lod_meshes private  function num_lod_meshes (self) result(n) Number of level-of-detail meshes built so far (0 without level of detail). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value integer procedure, public :: num_parents private pure function num_parents (self) Number of parents. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: opacity private pure function opacity (self) The body's opacity (set_opacity). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp) procedure, public :: parent private  function parent (self, i) result(p) Parent i (1 to num_parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: parent_index private  function parent_index (self, frame) Index of frame among the parents, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: pick => sphere_pick private  subroutine sphere_pick (self, cam, to_root, hits, n) Picked on the ellipsoid (exact), with the geodetic latitude and longitude\nof the point hit (in the body's axes: sphere_attitude); else the frame's\norigin. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in), target :: self type( PickCamera ), intent(in) :: cam the camera and cursor of the pick real(kind=wp), intent(in) :: to_root (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits so far, in hits(1:n); added to integer, intent(inout) :: n number of hits procedure, public :: pickable private pure function pickable (self) Whether pick tests what this frame draws ( set_pickable ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: position private pure function position (self) result(p) Position relative to the parent frame. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: position_of private  function position_of (self, other) result(p) The origin of other (a frame of the same tree) in this frame's\ncoordinates, from both frames' transforms to the root (through their\nfirst parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in) :: other Return Value real(kind=wp), (3) procedure, public :: radii private pure function radii (self) result(r) The semi-axes: radius * sphere_scale. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: radius private pure function radius (self) The sphere's radius (scene units). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp) procedure, public :: realize private recursive subroutine realize (self, viewer) Create the render nodes of this frame and its descendants (once; for viewer , a window's viewer handle, which some contents need while they\nare built (not kept); null: headless). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer handle (null: headless) procedure, public :: remove_child private  function remove_child (self, child) result(ok) Remove child from this frame's children. Returns false if it is not one. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self class( ReferenceFrame ), intent(inout), target :: child Return Value logical procedure, public :: reposition_axes private  subroutine reposition_axes (self) Place the axes for what the frame draws, when it is first shown (unless\nmove_*_axis was called): at its bound's surface, half the bound's radius\nlong (as OpenFrames' Sphere and Model do); at the origin, 1 long, for a\nframe that draws nothing. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: set_attitude private  subroutine set_attitude (self, q) Attitude relative to the parent frame, a quaternion [x, y, z, w]\n(normalized here; overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) procedure, public :: set_auto_lod private  subroutine set_auto_lod (self, lod) Level of detail (default on; see the module documentation): meshes of\nseveral resolutions, the one drawn chosen per view. Off: one mesh of set_resolution 's segments. Set it before a window shows the sphere. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self logical, intent(in) :: lod procedure, public :: set_color => sphere_set_color private  subroutine sphere_set_color (self, color) The body's color (used without a texture); [r, g, b] or [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) procedure, public :: set_label_alignment private  subroutine set_label_alignment (self, alignment) The alignment of the labels relative to their positions (ALIGN_*;\ndefault ALIGN_LEFT_BASE_LINE). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: alignment procedure, public :: set_label_font private  subroutine set_label_font (self, font) The font of the labels: a font file name (found on the data search\npath) or a full path; default: the renderer's default font. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: font procedure, public :: set_label_size private  subroutine set_label_size (self, size) The size of the labels in pixels (default 20): the name label's size,\nand the maximum size of the axes labels (which shrink with distance). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: size procedure, public :: set_light_ambient private  subroutine set_light_ambient (self, rgb) The light source's ambient, diffuse and specular colors ([r, g, b], 0\nto 1; defaults 0.05, 0.8 and 0.05 gray). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_diffuse private  subroutine set_light_diffuse (self, rgb) The light source's diffuse color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_source_enabled private  subroutine set_light_source_enabled (self, enable) Whether this frame carries a light source: a point light at its origin\n(e.g. the Sun), not dimmed with distance (default false; OpenFrames'\nsetLightSourceEnabled). While any frame of a window's scene has one, the\nwindow's own light (WindowProxy%set_light_*) is off. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: enable procedure, public :: set_light_specular private  subroutine set_light_specular (self, rgb) The light source's specular color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_material private  subroutine set_material (self, ambient, diffuse, specular, emission, shininess) The material (OpenFrames' setMaterial; each optional): ambient, diffuse,\nspecular and emission colors ([r, g, b] or [r, g, b, a], 0 to 1) and\nshininess (0 to 128: the specular highlight's sharpness; 0 for none).\nThe ambient and diffuse colors scale the body's color or texture (VSG's\nPhong); the specular color is reflected from the lights' specular parts.\nDefaults: ambient and diffuse white, no specular reflection or emission. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in), optional :: ambient (:) [r, g, b(, a)], 0 to 1 real(kind=wp), intent(in), optional :: diffuse (:) [r, g, b(, a)], 0 to 1 real(kind=wp), intent(in), optional :: specular (:) [r, g, b(, a)], 0 to 1 real(kind=wp), intent(in), optional :: emission (:) [r, g, b(, a)], 0 to 1 real(kind=wp), intent(in), optional :: shininess 0 to 128 (< 0: 0) procedure, public :: set_name private  subroutine set_name (self, name) The frame's name, shown by its name label (also once shown: e.g. a\nreadout that follows the frame). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: name procedure, public :: set_name_label_on_top private  subroutine set_name_label_on_top (self, on_top) Draw the name label on top of the scene (true: not hidden by bodies in\nfront of it, as HUD text; e.g. a readout) or depth-tested (false, the\ndefault, as OpenFrames'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: on_top procedure, public :: set_night_texture_map private  subroutine set_night_texture_map (self, file) The texture for the side away from the light (e.g. city lights; an\nequirectangular image file as the texture, '' for none), shown where the\ndiffuse light is weak. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self character(len=*), intent(in) :: file found with find_data_file; '' for none procedure, public :: set_opacity private  subroutine set_opacity (self, opacity) The body's opacity, 0 (invisible) to 1 (opaque, the default): below 1\nit is drawn translucent (see the module documentation). Set below 1\nbefore a window first shows it to make it translucent; then the\nopacity can change at any time (a translucent body stays translucent,\nan opaque one opaque). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: opacity 0 to 1 procedure, public :: set_pickable private  subroutine set_pickable (self, pickable) Whether pick tests what this frame draws (default true; e.g. false\nfor an overlay such as a selection marker). Its children are picked or\nnot by their own setting. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: pickable procedure, public :: set_position private  subroutine set_position (self, position) Position relative to the parent frame (overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) parent frame's coordinates procedure, public :: set_radius private  subroutine set_radius (self, radius) The sphere's radius (scene units, > 0; default 1); can change at any time. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: radius scene units (<= 0: ignored) procedure, public :: set_resolution private  subroutine set_resolution (self, n_lon, n_lat) The mesh resolution without level of detail: segments in longitude and\nlatitude (default 128 x 64). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self integer, intent(in) :: n_lon segments in longitude (at least 3) integer, intent(in) :: n_lat segments in latitude (at least 2) procedure, public :: set_sphere_attitude private  subroutine set_sphere_attitude (self, q) Attitude of the body in its frame (quaternion [x, y, z, w]), e.g. to\norient its texture. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) quaternion [x, y, z, w] (normalized here) procedure, public :: set_sphere_position private  subroutine set_sphere_position (self, position) Position of the body's center in its frame. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) scene units procedure, public :: set_sphere_scale private  subroutine set_sphere_scale (self, scale) Scale the sphere along its x, y and z axes (all > 0), making an\nellipsoid with semi-axes radius * scale. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: scale (3) along x, y and z (all > 0, else ignored) procedure, public :: set_texture_map private  subroutine set_texture_map (self, file) The texture: an equirectangular image file ('' for none). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self character(len=*), intent(in) :: file found with find_data_file; '' for none procedure, public :: set_twilight private  subroutine set_twilight (self, angle) The twilight: the diffuse light extended past the terminator to where\nthe light is angle (radians, 0 to 1.5) below the horizon, fading out\nsmoothly (where it meets the light on the day side: the same brightness\nand slope, so no line shows), and the night texture fading in across it.\n0 (the default): none, the light ends at the terminator (an airless\nbody). Not in OpenFrames. Can change at any time. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: angle radians below the horizon (clamped to 0 to 1.5) procedure, public :: set_x_label private  subroutine set_x_label (self, text) The text of the x-axis label (default 'X'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_y_label private  subroutine set_y_label (self, text) The text of the y-axis label (default 'Y'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_z_label private  subroutine set_z_label (self, text) The text of the z-axis label (default 'Z'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: show_axes private  subroutine show_axes (self, axes) Which axes vectors to show: NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined with ior. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: axes procedure, public :: show_axes_labels private  subroutine show_axes_labels (self, labels) Which axes labels to show (as show_axes ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: labels procedure, public :: show_contents private  subroutine show_contents (self, show) Show or hide what the frame draws (its sphere, model, ...), but not its\naxes, labels or children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show procedure, public :: show_decorations private  subroutine show_decorations (self, show) Show (true) or hide all the frame's decorations at once: its axes,\ntheir labels and its name label (show_axes, show_axes_labels,\nshow_name_label). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show true: all axes, axes labels and the name label procedure, public :: show_name_label private  subroutine show_name_label (self, show) Show or hide the name label (at the frame's origin; default shown). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show (true: shown) procedure, public :: sphere_attitude private pure function sphere_attitude (self) result(q) Attitude of the body in its frame (quaternion [x, y, z, w]). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: sphere_position private pure function sphere_position (self) result(p) Position of the body's center in its frame (scene units). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: sphere_scale private pure function sphere_scale (self) result(s) The scale along the sphere's x, y and z axes. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: sync private recursive subroutine sync (self) Copy the positions and attitudes of this frame and its descendants to\ntheir transform nodes (only those that changed since the last sync). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: texture_map private  function texture_map (self) result(file) The texture file ('' for none). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: twilight private pure function twilight (self) The twilight angle (radians below the horizon; 0: none). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp) procedure, public :: unfollow private  subroutine unfollow (self) Stop following trajectories (the frame keeps its last position and attitude). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: update => sphere_update private recursive subroutine sphere_update (self, t) Update the frame (followed trajectories, children) and, with level of\ndetail, build the mesh the views have wanted if it isn't built yet (the\ncoarsest with as many segments as wanted, or the finest). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: t the scene time procedure, public :: world_matrix private recursive function world_matrix (self) result(m) The transform from this frame to the root of its tree, through the first\nparent at each level. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) Source Code type , extends ( ReferenceFrame ), public :: Sphere private real ( wp ) :: radius_ = 1.0_wp !! radius (scene units; default 1) real ( wp ) :: scale_ ( 3 ) = 1.0_wp !! scale along x, y and z: semi-axes radius * scale real ( wp ) :: sphere_position_ ( 3 ) = 0.0_wp !! the body's center in the frame (scene units) real ( wp ) :: sphere_attitude_ ( 4 ) = quat_identity !! the body's attitude in the frame ([x, y, z, w]) real ( wp ) :: built_radii ( 3 ) = 1.0_wp !! the mesh's semi-axes logical :: textured = . false . !! (the color is not used) character ( len = :), allocatable :: texture !! texture file (unallocated or '': none) character ( len = :), allocatable :: night_texture !! night texture file (unallocated or '': none) logical :: auto_lod_ = . true . !! level of detail (default on) integer :: n_lon = 128 , n_lat = 64 !! without level of detail ! material (VSG's Phong; OpenGL's default: no specular reflection) real ( wp ) :: ambient_ ( 4 ) = 1.0_wp !! ambient color [r, g, b, a] real ( wp ) :: diffuse_ ( 4 ) = 1.0_wp !! diffuse [r, g, b, a] (times the color if no texture) real ( wp ) :: specular_ ( 4 ) = [ 0.0_wp , 0.0_wp , 0.0_wp , 1.0_wp ] !! specular color [r, g, b, a] real ( wp ) :: emission_ ( 4 ) = [ 0.0_wp , 0.0_wp , 0.0_wp , 1.0_wp ] !! emission color [r, g, b, a] real ( wp ) :: shininess_ = 0.0_wp !! 0 to 128 (0: no specular highlight) real ( wp ) :: twilight_ = 0.0_wp !! radians below the horizon (0: none) real ( wp ) :: opacity_ = 1.0_wp !! 1 opaque; below 1 translucent (see set_opacity) logical :: translucent = . false . !! built translucent (opacity below 1 when first shown) type ( c_ptr ) :: sphere_node = c_null_ptr !! transform of the body within the frame type ( c_ptr ) :: mesh = c_null_ptr !! without level of detail ! level of detail type ( c_ptr ) :: lod_node = c_null_ptr !! chooses among the meshes, per view type ( c_ptr ) :: lod_mesh ( size ( lod_segments )) = c_null_ptr !! the level-of-detail meshes (null: not built yet) type ( c_ptr ) :: image = c_null_ptr , night = c_null_ptr !! the textures, for meshes built later logical :: shown = . false . !! (meshes built later are compiled) contains procedure :: set_radius , radius procedure :: set_color => sphere_set_color procedure :: set_sphere_scale , sphere_scale , radii procedure :: set_sphere_position , sphere_position procedure :: set_sphere_attitude , sphere_attitude procedure :: set_texture_map , texture_map procedure :: set_night_texture_map , night_texture_map procedure :: set_auto_lod , auto_lod procedure :: set_material , material procedure :: set_twilight , twilight procedure :: set_opacity , opacity procedure :: set_resolution procedure :: frame_info => sphere_frame_info procedure :: bound => sphere_bound procedure :: pick => sphere_pick procedure :: build_contents => sphere_build_contents procedure :: update => sphere_update procedure :: num_lod_meshes end type Sphere","tags":"","url":"type/sphere.html"},{"title":"font_entry – vkframes ","text":"type, private :: font_entry A font read (or looked for) by name. Inherits type~~font_entry~~InheritsGraph type~font_entry font_entry c_ptr c_ptr type~font_entry->c_ptr font Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial type(c_ptr), public :: font = c_null_ptr its handle (null: not found or not read) character(len=:), public, allocatable :: name the font's name as given ('' replaced by default_font) Source Code type :: font_entry character ( len = :), allocatable :: name !! the font's name as given ('' replaced by default_font) type ( c_ptr ) :: font = c_null_ptr !! its handle (null: not found or not read) end 