( lod_first ))) return body = self % lod_node else self % mesh = ellipsoid_create ( self % built_radii , [ 1.0_c_float , 1.0_c_float , 1.0_c_float , 1.0_c_float ], image , & self % n_lon , self % n_lat , night , translucent = self % translucent ) if ( c_associated ( image )) call vkf_image_delete ( image ) if ( c_associated ( night )) call vkf_image_delete ( night ) if (. not . c_associated ( self % mesh )) return body = self % mesh end if call apply_material ( self ) self % sphere_node = vkf_transform_create () call update_sphere_transform ( self ) if ( vkf_node_add_child ( self % sphere_node , body ) /= 0 . or . vkf_node_add_child ( group , self % sphere_node ) /= 0 ) & write ( * , '(a)' ) 'vkframes: Sphere ' // self % name () // ': could not build the scene' end subroutine sphere_build_contents","tags":"","url":"proc/sphere_build_contents.html"},{"title":"sphere_pick – vkframes","text":"private  subroutine sphere_pick(self, cam, to_root, hits, n) Picked on the ellipsoid (exact), with the geodetic latitude and longitude\nof the point hit (in the body's axes: sphere_attitude); else the frame's\norigin. Type Bound Sphere Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in), target :: self type( PickCamera ), intent(in) :: cam the camera and cursor of the pick real(kind=wp), intent(in) :: to_root (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits so far, in hits(1:n); added to integer, intent(inout) :: n number of hits Calls proc~~sphere_pick~~CallsGraph proc~sphere_pick Sphere%sphere_pick proc~contents_shown ReferenceFrame%contents_shown proc~sphere_pick->proc~contents_shown proc~pick ReferenceFrame%pick proc~sphere_pick->proc~pick proc~pick_ellipsoid pick_ellipsoid proc~sphere_pick->proc~pick_ellipsoid proc~quat_to_matrix quat_to_matrix proc~sphere_pick->proc~quat_to_matrix proc~radii Sphere%radii proc~sphere_pick->proc~radii proc~add_pick_hit add_pick_hit proc~pick->proc~add_pick_hit pro