icCone type~ellipticcone->type~polyhedralcone type~rectangularcone RectangularCone type~rectangularcone->type~polyhedralcone type~timehandle TimeHandle type~timehandle->type~draghandle type~vectorhandle VectorHandle type~vectorhandle->type~draghandle type~viewpointer ViewPointer type~viewpointer->type~view p type~windowproxy WindowProxy type~windowproxy->type~draghandle hovered_handle, dragged_handle type~windowproxy->type~framemanager scene type~windowproxy->type~view default_view, shown type~windowproxy->type~cameraflight flight type~windowproxy->type~viewpointer views Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial real(kind=wp), private :: attitude_ (4) = quat_identity relative to the parent: quaternion [x, y, z, w] integer, private :: axes = ALL_AXES OpenFrames' defaults: all shown integer, private :: axes_labels = ALL_AXES axes labels shown (as axes) logical, private :: axes_moved = .false. set by move_*_axis (else reposition_axes places them) type(c_ptr), private :: axis_arrow (3) = c_null_ptr the axes arrows (in axis_node; made again when an axis moves) real(kind=wp), private :: axis_base (3,3) = 0.0_wp each axis's base (columns; frame coordinates) real(kind=wp), private :: axis_body_radius (3) = 0.0_wp (0: 0.05 and 0.1 of the length) real(kind=wp), private :: axis_head_radius (3) = 0.0_wp (0: 0.05 and 0.1 of the length) real(kind=wp), private :: axis_head_ratio (3) = 0.3_wp each axis's head, as a fraction of its length type(c_ptr), private :: axis_label_node (3) = c_null_ptr the axes labels' switches real(kind=wp), private :: axis_len (3) = 1.0_wp each axis's length type(c_ptr), private :: axis_node (3) = c_null_ptr the axes arrows' switches type(c_ptr), private :: axis_text (3) = c_null_ptr the axes labels (in axis_label_node) type( FramePointer ), private, allocatable :: children (:) not owned (first n_children, n_parents used) real(kind=wp), private :: color_ (4) = [1.0_wp, 1.0_wp, 1.0_wp, 0.9_wp] decorations' color [r, g, b, a] (0 to 1) logical, private :: contents = .true. what the frame draws shown (show_contents) type(c_ptr), private :: contents_node = c_null_ptr switch holding the contents type( TrajectoryFollower ), private :: follower_ sets position and attitude from followed trajectories logical, private :: following = .false. following trajectories ( follow , until unfollow ) integer, private :: label_alignment_ = ALIGN_LEFT_BASE_LINE labels' alignment (ALIGN_*) character(len=:), private, allocatable :: label_font_ labels' font (unallocated: the renderer's default) integer, private :: label_size_ = 20 labels' size (pixels) real(kind=wp), private :: light_ambient_ (3) = 0.05_wp [r, g, b] real(kind=wp), private :: light_diffuse_ (3) = 0.8_wp [r, g, b] type(c_ptr), private :: light_node = c_null_ptr light and switch (made when enabled) logical, private :: light_source = .false. carries a light source (set_light_source_enabled) real(kind=wp), private :: light_specular_ (3) = 0.05_wp [r, g, b] type(c_ptr), private :: light_switch = c_null_ptr light and switch (made when enabled) integer, private :: n_children = 0 number of children and parents integer, private :: n_parents = 0 number of children and parents character(len=:), private, allocatable :: name_ the name (shown by the name label) logical, private :: name_label = .true. the name label shown type(c_ptr), private :: name_label_node = c_null_ptr the name label's switch logical, private :: name_on_top = .false. the name label drawn on top of the scene type(c_ptr), private :: name_text = c_null_ptr the name label (in name_label_node) type(c_ptr), private :: node_ = c_null_ptr the frame's transform node type( FramePointer ), private, allocatable :: parents (:) not owned (first n_children, n_parents used) logical, private :: pickable_ = .true. picked (WindowProxy%pick); its children aside real(kind=wp), private :: position_ (3) = 0.0_wp relative to the parent logical, private :: realized = .false. render nodes made (realize) logical, private :: shown_ = .false. realized for a window (not headless): later nodes are compiled logical, private :: synced = .false. the node has synced_position/attitude real(kind=wp), private :: synced_attitude (4) = 0.0_wp last copied to the node real(kind=wp), private :: synced_position (3) = 0.0_wp last copied to the node character(len=:), private, allocatable :: x_label_ axes labels (unallocated: 'X', 'Y', 'Z') character(len=:), private, allocatable :: y_label_ axes labels (unallocated: 'X', 'Y', 'Z') character(len=:), private, allocatable :: z_label_ axes labels (unallocated: 'X', 'Y', 'Z') Constructor public        interface ReferenceFrame The ReferenceFrame constructor: ReferenceFrame(...) makes one (see new_reference_frame for its\narguments). private  function new_reference_frame (name, color) result(frame) A frame named name , with decorations of color color ([r, g, b] or\n[r, g, b, a], 0 to 1; default white, 90% opaque). Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name real(kind=wp), intent(in), optional :: color (:) Return Value type( ReferenceFrame ) Type-Bound Procedures procedure, public :: add_child private  function add_child (self, child) result(ok) Add child to this frame's children. Returns false (and does nothing)\nfor this frame itself or an ancestor of it; true if it is already a child. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self class( ReferenceFrame ), intent(inout), target :: child Return Value logical procedure, public :: attitude private pure function attitude (self) result(q) Attitude relative to the parent frame, a quaternion [x, y, z, w]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: axes_labels_shown private pure function axes_labels_shown (self) Which axes labels are shown (as axes_shown ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: axes_shown private pure function axes_shown (self) Which axes vectors are shown (NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: axis_label private  function axis_label (self, axis) result(text) The label text of axis X_AXIS, Y_AXIS or Z_AXIS. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: axis Return Value character(len=:), allocatable procedure, public :: bound private  subroutine bound (self, center, radius) The bounding sphere of what the frame draws, in its own coordinates\n(radius 0 if it draws nothing; extensions override it). Views use it for\ntheir default distance. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self real(kind=wp), intent(out) :: center (3) frame's coordinates real(kind=wp), intent(out) :: radius frame's coordinates procedure, public :: build_contents private  subroutine build_contents (self, viewer, group) Add what this frame draws to group (a node handle). ReferenceFrame\ndraws nothing itself (its axes and labels come later); extensions such as\nSphere and Model override this. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type(c_ptr), intent(in) :: viewer (viewer: as realize 's) type(c_ptr), intent(in) :: group (viewer: as realize 's) procedure, public :: child private  function child (self, i) result(c) Child i (1 to num_children). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: child_index private  function child_index (self, frame) Index of frame among the children, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: color private pure function color (self) result(c) The color of the frame's decorations, [r, g, b, a] (0 to 1). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: contents_shown private pure function contents_shown (self) Whether what the frame draws is shown ( show_contents ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: detach private  subroutine detach (self) Remove this frame from all its parents and children (before it goes out\nof scope or is deallocated while in a tree). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self procedure, public :: follow private  subroutine follow (self, traj, data, mode, add) Follow traj (in addition to trajectories already followed, if add is true), with what to follow ( data : FOLLOW_POSITION and/or\nFOLLOW_ATTITUDE; default both) and how ( mode : FOLLOW_LOOP, the\ndefault, or FOLLOW_LIMIT). traj must stay alive while followed. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type( Trajectory ), intent(in), target :: traj the trajectory to follow (not owned) integer, intent(in), optional :: data FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT integer, intent(in), optional :: mode FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT logical, intent(in), optional :: add (true: in addition to those followed (default false)) procedure, public :: follower private  function follower (self) result(f) The frame's trajectory follower, for finer control (data sources, time\noffset, ...). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in), target :: self Return Value type( TrajectoryFollower ), pointer procedure, public :: frame_info private  function frame_info (self) result(info) What kind of frame this is (shown by frame_string ; extensions override it). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: frame_string private recursive function frame_string (self, prefix) result(str) The tree below this frame, one line per frame (\"name (info)\"), in\nOpenFrames' createFrameString format: children are prefixed \"|-->\". Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self character(len=*), intent(in), optional :: prefix before this frame's line (default ' ') Return Value character(len=:), allocatable procedure, public :: has_light_source private recursive function has_light_source (self) result(has) Whether this frame or one of its descendants has a light source enabled. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: is_following private pure function is_following (self) Whether the frame follows trajectories (at least one, since follow ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: label_alignment private pure function label_alignment (self) The labels' alignment (ALIGN_*). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: label_font private  function label_font (self) result(font) The labels' font as set ('' for the renderer's default). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: label_size private pure function label_size (self) The labels' size in pixels. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: late_update private recursive subroutine late_update (self, t) After the whole tree's update for time t (all frames at their positions\nfor t): for contents that depend on other frames' positions, e.g.\nCustomLineSegments between spacecraft. Here, only the descendants'. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time procedure, public :: light_ambient private pure function light_ambient (self) result(rgb) The light source's ambient color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_diffuse private pure function light_diffuse (self) result(rgb) The light source's diffuse color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_source_enabled private pure function light_source_enabled (self) Whether this frame carries a light source. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: light_specular private pure function light_specular (self) result(rgb) The light source's specular color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: local_matrix private pure function local_matrix (self) result(m) The transform from this frame to its parent (4x4). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) procedure, public :: move_x_axis private  subroutine move_x_axis (self, base, length, head_ratio, body_radius, head_radius) Place the x axis vector: from base , length long, with a head of head_ratio of the length (default 0.3) and body and head radii (default\n0.05 and 0.1 of the length); its label is at the tip, 0.4 of the length\ntall (at most label_size pixels). As OpenFrames' moveXAxis. Set before\nthe frame is first shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) (base: frame's coordinates) real(kind=wp), intent(in) :: length (base: frame's coordinates) real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_y_axis private  subroutine move_y_axis (self, base, length, head_ratio, body_radius, head_radius) Place the y axis vector (as move_x_axis ; OpenFrames' moveYAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_z_axis private  subroutine move_z_axis (self, base, length, head_ratio, body_radius, head_radius) Place the z axis vector (as move_x_axis ; OpenFrames' moveZAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: name private  function name (self) result(n) The frame's name ('' if none). Arguments Type Intent Optional Attribute