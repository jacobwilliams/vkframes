ule. Source Code subroutine write_intermediates ( self , i1 , i2 ) type ( MarkerArtist ), intent ( inout ) :: self integer , intent ( in ) :: i1 , i2 real ( c_float ), dimension (:,:,:), pointer :: p real ( c_float ), dimension (:,:), pointer :: c integer :: j , lo , hi call self % inter % reserve ( i2 ) do j = 1 , self % inter % num_chunks () call self % inter % slice ( j , i1 , i2 , lo , hi , p ) if (. not . associated ( p )) cycle call split_points ( self % inter_xyz (:, lo : hi ), p ) call self % inter % color_slice ( j , i1 , i2 , lo , hi , c ) if ( associated ( c )) c = real ( self % inter_rgba (:, lo : hi ), c_float ) end do call self % inter % written ( i1 , i2 ) end subroutine write_intermediates","tags":"","url":"proc/write_intermediates.html"},{"title":"write_marker – vkframes","text":"private  subroutine write_marker(chain, v, rgba) A single marker's point (in a chain of one marker), and its color (a\ncolored chain), uploaded. Arguments Type Intent Optional Attributes Name type( LineChain ), intent(inout) :: chain real(kind=wp), intent(in) :: v (3) real(kind=wp), intent(in) :: rgba (4) Calls proc~~write_marker~~CallsGraph proc~write_marker write_marker proc~color_slice LineChain%color_slice proc~write_marker->proc~color_slice proc~num_chunks~2 LineChain%num_chunks proc~write_marker->proc~num_chunks~2 proc~slice LineChain%slice proc~write_marker->proc~slice proc~split_points split_points proc~write_marker->proc~split_points proc~written LineChain%written proc~write_marker->proc~written interface~vkf_line_colors vkf_line_colors proc~color_slice->interface~vkf_line_colors proc~line_buffer line_buffer proc~slice->proc~line_buffer interface~vkf_line_points_changed vkf_line_points_changed proc~written->interface~vkf_line_points_changed proc~check_status check_status proc~written->proc~check_status proc~measure measure proc~written->proc~measure proc~update_lod update_lod proc~written->proc~update_lod interface~vkf_line_points vkf_line_points proc~line_buffer->