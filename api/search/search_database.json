ferenceFrame ), intent(in) :: self Return Value integer procedure, public :: axis_label private  function axis_label (self, axis) result(text) The label text of axis X_AXIS, Y_AXIS or Z_AXIS. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: axis Return Value character(len=:), allocatable procedure, public :: body_radius private pure function body_radius (self) The body's equatorial radius in scene units (from its profile: the\nMoon's for 'moon', else the Earth's). Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value real(kind=wp) procedure, public :: bound => terrain_bound private  subroutine terrain_bound (self, center, radius) The body's bounding sphere (frame coordinates): its equatorial radius, at the origin. Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self real(kind=wp), intent(out) :: center (3) real(kind=wp), intent(out) :: radius procedure, public :: build_contents => terrain_build_contents private  subroutine terrain_build_contents (self, viewer, group) The map, made for the viewer showing the body (none headless or without Rocky). Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer handle (null: headless) type(c_ptr), intent(in) :: group the group node to build under procedure, public :: child private  function child (self, i) result(c) Child i (1 to num_children). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: child_index private  function child_index (self, frame) Index of frame among the children, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: color private pure function color (self) result(c) The color of the frame's decorations, [r, g, b, a] (0 to 1). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: contents_shown private pure function contents_shown (self) Whether what the frame draws is shown ( show_contents ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: detach private  subroutine detach (self) Remove this frame from all its parents and children (before it goes out\nof scope or is deallocated while in a tree). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self procedure, public :: elevation private  function elevation (self, lat, lon, found) result(h) The height of the terrain (scene units, above the body's sphere or\nellipsoid) at latitude and longitude lat , lon (degrees), from the\nlast elevation layer added that is a file (LAYER_GDAL), read directly\n(also before the body is shown); found is false (and the height 0)\nwithout such a layer or data there, or without Rocky. Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self real(kind=wp), intent(in) :: lat latitude and longitude (degrees) real(kind=wp), intent(in) :: lon latitude and longitude (degrees) logical, intent(out), optional :: found false if there is no height there Return Value real(kind=wp) procedure, public :: follow private  subroutine follow (self, traj, data, mode, add) Follow traj (in addition to trajectories already followed, if add is true), with what to follow ( data : FOLLOW_POSITION and/or\nFOLLOW_ATTITUDE; default both) and how ( mode : FOLLOW_LOOP, the\ndefault, or FOLLOW_LIMIT). traj must stay alive while followed. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type( Trajectory ), intent(in), target :: traj the trajectory to follow (not owned) integer, intent(in), optional :: data FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT integer, intent(in), optional :: mode FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT logical, intent(in), optional :: add (true: in addition to those followed (default false)) procedure, public :: follower private  function follower (self) result(f) The frame's trajectory follower, for finer control (data sources, time\noffset, ...). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in), target :: self Return Value type( TrajectoryFollower ), pointer procedure, public :: frame_info => terrain_frame_info private  function terrain_frame_info (self) result(info) The kind of frame: 'TerrainBody'. Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: frame_string private recursive function frame_string (self, prefix) result(str) The tree below this frame, one line per frame (\"name (info)\"), in\nOpenFrames' createFrameString format: children are prefixed \"|-->\". Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self character(len=*), intent(in), optional :: prefix before this frame's line (default ' ') Return Value character(len=:), allocatable procedure, public :: has_light_source private recursive function has_light_source (self) result(has) Whether this frame or one of its descendants has a light source enabled. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: is_following private pure function is_following (self) Whether the frame follows trajectories (at least one, since follow ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: label_alignment private pure function label_alignment (self) The labels' alignment (ALIGN_*). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: label_font private  function label_font (self) result(font) The labels' font as set ('' for the renderer's default). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: label_size private pure function label_size (self) The labels' size in pixels. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: late_update private recursive subroutine late_update (self, t) After the whole tree's update for time t (all frames at their positions\nfor t): for contents that depend on other frames' positions, e.g.\nCustomLineSegments between spacecraft. Here, only the descendants'. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time procedure, public :: light_ambient private pure function light_ambient (self) result(rgb) The light source's ambient color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_diffuse private pure function light_diffuse (self) result(rgb) The light source's diffuse color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_source_enabled private pure function light_source_enabled (self) Whether this frame carries a light source. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: light_specular private pure function light_specular (self) result(rgb) The light source's specular color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: lighting private pure function lighting (self) True if the body is lit by the scene's lights. Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value logical procedure, public :: local_matrix private pure function local_matrix (self) result(m) The transform from this frame to its parent (4x4). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) procedure, public :: move_x_axis private  subroutine move_x_axis (self, base, length, head_ratio, body_radius, head_radius) Place the x axis vector: from base , length long, with a head of head_ratio of the length (default 0.3) and body and head radii (default\n0.05 and 0.1 of the length); its label is at the tip, 0.4 of the length\ntall (at most label_size pixels). As OpenFrames' moveXAxis. Set before\nthe frame is first shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) (base: frame's coordinates) real(kind=wp), intent(in) :: length (base: frame's coordinates) real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_y_axis private  subroutine move_y_axis (self, base, length, head_ratio, body_radius, head_radius) Place the y axis vector (as move_x_axis ; OpenFrames' moveYAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_z_axis private  subroutine move_z_axis (self, base, length, head_ratio, body_radius, head_radius) Place the z axis vector (as move_x_axis ; OpenFrames' moveZAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: name private  function name (self) result(n) The frame's name ('' if none). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: name_label_on_top private pure function name_label_on_top (self) Whether the name label is drawn on top of the scene ( set_name_label_on_top ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: name_label_shown private pure function name_label_shown (self) Whether the name label is shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: node private  function node (self) result(n) The frame's transform node (null until realized). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value type(c_ptr) procedure, public :: num_children private pure function num_children (self) Number of children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: num_layers private pure function num_layers (self) Number of layers (image and elevation). Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value integer procedure, public :: num_parents private pure function num_parents (self) Number of parents. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: parent private  function parent (self, i) result(p) Parent i (1 to num_parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: parent_index private  function parent_index (self, frame) Index of frame among the parents, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: pick => terrain_pick private  subroutine terrain_pick (self, cam, to_root, hits, n) Picked on a sphere of the body's radius (not the terrain's heights), with\nthe latitude and longitude of the point hit; else the frame's origin. Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in), target :: self type( PickCamera ), intent(in) :: cam the cursor's ray and the pick's settings real(kind=wp), intent(in) :: to_root (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits so far (grown as needed) integer, intent(inout) :: n number of hits in hits procedure, public :: pickable private pure function pickable (self) Whether pick tests what this frame draws ( set_pickable ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: position private pure function position (self) result(p) Position relative to the parent frame. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: position_of private  function position_of (self, other) result(p) The origin of other (a frame of the same tree) in this frame's\ncoordinates, from both frames' transforms to the root (through their\nfirst parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in) :: other Return Value real(kind=wp), (3) procedure, public :: profile private  function profile (self) result(p) Rocky's tiling profile ('': Rocky's default, the Earth). Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: realize private recursive subroutine realize (self, viewer) Create the render nodes of this frame and its descendants (once; for viewer , a window's viewer handle, which some contents need while they\nare built (not kept); null: headless). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer handle (null: headless) procedure, public :: remove_child private  function remove_child (self, child) result(ok) Remove child from this frame's children. Returns false if it is not one. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self class( ReferenceFrame ), intent(inout), target :: child Return Value logical procedure, public :: reposition_axes private  subroutine reposition_axes (self) Place the axes for what the frame draws, when it is first shown (unless\nmove_*_axis was called): at its bound's surface, half the bound's radius\nlong (as OpenFrames' Sphere and Model do); at the origin, 1 long, for a\nframe that draws nothing. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: set_attitude private  subroutine set_attitude (self, q) Attitude relative to the parent frame, a quaternion [x, y, z, w]\n(normalized here; overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) procedure, public :: set_color private  subroutine set_color (self, color) The color of the frame's decorations: [r, g, b] (alpha unchanged) or [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) procedure, public :: set_label_alignment private  subroutine set_label_alignment (self, alignment) The alignment of the labels relative to their positions (ALIGN_*;\ndefault ALIGN_LEFT_BASE_LINE). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: alignment procedure, public :: set_label_font private  subroutine set_label_font (self, font) The font of the labels: a font file name (found on the data search\npath) or a full path; default: the renderer's default font. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: font procedure, public :: set_label_size private  subroutine set_label_size (self, size) The size of the labels in pixels (default 20): the name label's size,\nand the maximum size of the axes labels (which shrink with distance). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: size procedure, public :: set_light_ambient private  subroutine set_light_ambient (self, rgb) The light source's ambient, diffuse and specular colors ([r, g, b], 0\nto 1; defaults 0.05, 0.8 and 0.05 gray). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_diffuse private  subroutine set_light_diffuse (self, rgb) The light source's diffuse color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_source_enabled private  subroutine set_light_source_enabled (self, enable) Whether this frame carries a light source: a point light at its origin\n(e.g. the Sun), not dimmed with distance (default false;