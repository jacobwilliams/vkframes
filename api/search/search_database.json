ion cone_color (self) result(c) The sides' color [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: cone_length private pure function cone_length (self) The cone's length along the boresight (scene units). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(in) :: self Return Value real(kind=wp) procedure, public :: contents_shown private pure function contents_shown (self) Whether what the frame draws is shown ( show_contents ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: detach private  subroutine detach (self) Remove this frame from all its parents and children (before it goes out\nof scope or is deallocated while in a tree). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self procedure, public :: draw_mode private pure function draw_mode (self) What is drawn: an ior of CONE_SIDES, CONE_EDGES, CONE_BASE_OUTLINE. Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(in) :: self Return Value integer procedure, public :: follow private  subroutine follow (self, traj, data, mode, add) Follow traj (in addition to trajectories already followed, if add is true), with what to follow ( data : FOLLOW_POSITION and/or\nFOLLOW_ATTITUDE; default both) and how ( mode : FOLLOW_LOOP, the\ndefault, or FOLLOW_LIMIT). traj must stay alive while followed. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type( Trajectory ), intent(in), target :: traj the trajectory to follow (not owned) integer, intent(in), optional :: data FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT integer, intent(in), optional :: mode FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT logical, intent(in), optional :: add (true: in addition to those followed (default false)) procedure, public :: follower private  function follower (self) result(f) The frame's trajectory follower, for finer control (data sources, time\noffset, ...). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in), target :: self Return Value type( TrajectoryFollower ), pointer procedure, public :: frame_info => rect_frame_info private  function rect_frame_info (self) result(info) What kind of frame this is: 'RectangularCone'. Arguments Type Intent Optional Attributes Name class( RectangularCone ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: frame_string private recursive function frame_string (self, prefix) result(str) The tree below this frame, one line per frame (\"name (info)\"), in\nOpenFrames' createFrameString format: children are prefixed \"|-->\". Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self character(len=*), intent(in), optional :: prefix before this frame's line (default ' ') Return Value character(len=:), allocatable procedure, public :: has_light_source private recursive function has_light_source (self) result(has) Whether this frame or one of its descendants has a light source enabled. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: is_following private pure function is_following (self) Whether the frame follows trajectories (at least one, since follow ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: is_visible => cone_is_visible private  function cone_is_visible (self, point, min_distance, max_distance) result(visible) Whether point (in the cone's frame) is inside the cone, between\ndistances min_distance and max_distance along the boresight\n(defaults 0 and unlimited): inside the polygon of the vertices' directions\n(OpenFrames' isVisible; its PolyhedralCone always answers false). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(in) :: self real(kind=wp), intent(in) :: point (3) in the cone's frame (scene units) real(kind=wp), intent(in), optional :: min_distance along the boresight (scene units) real(kind=wp), intent(in), optional :: max_distance along the boresight (scene units) Return Value logical procedure, public :: label_alignment private pure function label_alignment (self) The labels' alignment (ALIGN_*). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: label_font private  function label_font (self) result(font) The labels' font as set ('' for the renderer's default). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: label_size private pure function label_size (self) The labels' size in pixels. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: late_update private recursive subroutine late_update (self, t) After the whole tree's update for time t (all frames at their positions\nfor t): for contents that depend on other frames' positions, e.g.\nCustomLineSegments between spacecraft. Here, only the descendants'. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time procedure, public :: light_ambient private pure function light_ambient (self) result(rgb) The light source's ambient color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_diffuse private pure function light_diffuse (self) result(rgb) The light source's diffuse color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_source_enabled private pure function light_source_enabled (self) Whether this frame carries a light source. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: light_specular private pure function light_specular (self) result(rgb) The light source's specular color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: line_color => cone_line_color private pure function cone_line_color (self) result(c) The edges' and base outline's color [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: local_matrix private pure function local_matrix (self) result(m) The transform from this frame to its parent (4x4). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) procedure, public :: make_cone_look_at private  subroutine make_cone_look_at (self, apex, dir, up) Place the cone's apex at apex (in the parent frame) with its boresight\nalong dir and its +y axis toward up (OpenFrames' makeConeLookAt). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: apex (3) parent frame coordinates (scene units) real(kind=wp), intent(in) :: dir (3) boresight direction (any length > 0) real(kind=wp), intent(in) :: up (3) toward the cone's +y axis (any length) procedure, public :: move_x_axis private  subroutine move_x_axis (self, base, length, head_ratio, body_radius, head_radius) Place the x axis vector: from base , length long, with a head of head_ratio of the length (default 0.3) and body and head radii (default\n0.05 and 0.1 of the length); its label is at the tip, 0.4 of the length\ntall (at most label_size pixels). As OpenFrames' moveXAxis. Set before\nthe frame is first shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) (base: frame's coordinates) real(kind=wp), intent(in) :: length (base: frame's coordinates) real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_y_axis private  subroutine move_y_axis (self, base, length, head_ratio, body_radius, head_radius) Place the y axis vector (as move_x_axis ; OpenFrames' moveYAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_z_axis private  subroutine move_z_axis (self, base, length, head_ratio, body_radius, head_radius) Place the z axis vector (as move_x_axis ; OpenFrames' moveZAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: name private  function name (self) result(n) The frame's name ('' if none). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: name_label_on_top private pure function name_label_on_top (self) Whether the name label is drawn on top of the scene ( set_name_label_on_top ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: name_label_shown private pure function name_label_shown (self) Whether the name label is shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: node private  function node (self) result(n) The frame's transform node (null until realized). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value type(c_ptr) procedure, public :: num_children private pure function num_children (self) Number of children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: num_parents private pure function num_parents (self) Number of parents. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: parent private  function parent (self, i) result(p) Parent i (1 to num_parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: parent_index private  function parent_index (self, frame) Index of frame among the parents, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: pick private  subroutine pick (self, cam, to_root, hits, n) Pick what the frame draws (see the module documentation): to_root is its transform to the root frame; hits are added to hits(1:n). A\nplain frame: its origin, if it shows axes or its name label. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in), target :: self type( PickCamera ), intent(in) :: cam the cursor's ray and the pick's settings real(kind=wp), intent(in) :: to_root (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits so far (grown as needed) integer, intent(inout) :: n number of hits in hits procedure, public :: pickable private pure function pickable (self) Whether pick tests what this frame draws ( set_pickable ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: position private pure function position (self) result(p) Position relative to the parent frame. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: position_of private  function position_of (self, other) result(p) The origin of other (a frame of the same tree) in this frame's\ncoordinates, from both frames' transforms to the root (through their\nfirst parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in) :: other Return Value real(kind=wp), (3) procedure, public :: primary_angles => rect_primary_angles private pure subroutine rect_primary_angles (self, x, y) The half-angles along x and y, radians. Arguments Type Intent Optional Attributes Name class( RectangularCone ), intent(in) :: self real(kind=wp), intent(out) :: x radians real(kind=wp), intent(out) :: y radians procedure, public :: realize private recursive subroutine realize (self, viewer) Create the render nodes of this frame and its descendants (once; for viewer , a window's viewer handle, which some contents need while they\nare built (not kept); null: headless). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer handle (null: headless) procedure, public :: remove_child private  function remove_child (self, child) result(ok) Remove child from this frame's children. Returns false if it is not one. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self class( ReferenceFrame ), intent(inout), target :: child Return Value logical procedure, public :: reposition_axes private  subroutine reposition_axes (self) Place the axes for what the frame draws, when it is first shown (unless\nmove_*_axis was called): at its bound's surface, half the bound's radius\nlong (as OpenFrames' Sphere and Model do); at the origin, 1 long, for a\nframe that draws nothing. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: set_attitude private  subroutine set_attitude (self, q) Attitude relative to the parent frame, a quaternion [x, y, z, w]\n(normalized here; overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) procedure, public :: set_color private  subroutine set_color (self, color) The color of the frame's decorations: [r, g, b] (alpha unchanged) or [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) procedure, public :: set_cone_color private  subroutine set_cone_color (self, color) The sides' color ([r, g, b] or [r, g, b, a]; their alpha makes them\ntransparent). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) procedure, public :: set_cone_length private  subroutine set_cone_length (self, length) The cone's length along the boresight (> 0; default 1). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: length scene units (<= 0: ignored) procedure, public :: set_draw_mode private  subroutine set_draw_mode (self, mode) What to draw: an ior of CONE_SIDES, CONE_EDGES, CONE_BASE_OUTLINE. Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self integer, intent(in) :: mode procedure, public :: set_label_alignment private  subroutine set_label_alignment (self, alignment) The alignment of the labels relative to their positions (ALIGN_*;\ndefault ALIGN_LEFT_BASE_LINE). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: alignment procedure, public :: set_label_font private  subroutine set_label_font (self, font) The font of the labels: a font file name (found on the data search\npath) or a full path; default: the renderer's default font. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: font procedure, public :: set_label_size private  subroutine set_label_size (self, size) The size of the labels in pixels (default 20): the name label's size,\nand the maximum size of the axes labels (which shrink with distance). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: size procedure, public :: set_light_ambient private  subroutine set_light_ambient (self, rgb) The light source's ambient, diffuse and specular colors ([r, g, b], 0\nto 1; defaults 0.05, 0.8 and 0.05 gray). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_diffuse private  subroutine set_light_diffuse (self, rgb) The light source's diffuse color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_source_enabled private  subroutine set_light_source_enabled (self, enable) Whether this frame carries a light source: a point light at its origin\n(e.g. the Sun), not dimmed with distance (default false; OpenFrames'\nsetLightSourceEnabled). While any frame of a window's scene has one, the\nwindow's own light (WindowProxy%set_light_*) is off. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: enable procedure, public :: set_light_specular private  subroutine set_light_specular (self, rgb) The light source's specular color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_line_color => cone_set_line_color private  subroutine cone_set_line_color (self, color) The edges' and base outline's color. Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) procedure, public :: set_name private  subroutine set_name (self, name) The frame's name, shown by its name label (also once shown: e.g. a\nreadout that follows the frame). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: name procedure, public :: set_name_label_on_top private  subroutine set_name_label_on_top (self, on_top) Draw the name label on top of the scene (true: not hidden by bodies in\nfront of it, as HUD text; e.g. a readout) or depth-tested (false, the\ndefault, as OpenFrames'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: on_top procedure, public :: set_pickable private  subroutine set_pickable (self, pickable) Whether pick tests what this frame draws (default true; e.g. false\nfor an overlay such as a selection marker). Its children are picked or\nnot by their own setting. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: pickable procedure, public :: set_position private  subroutine set_position (self, position) Position relative to the parent frame (overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) parent frame's coordinates procedure, public :: set_primary_angles => rect_set_primary_angles private  subroutine rect_set_primary_angles (self, x, y) The half-angles along x and y, radians (0 to 90 degrees). Arguments Type Intent Optional Attributes Name class( RectangularCone ), intent(inout) :: self real(kind=wp), intent(in) :: x radians real(kind=wp), intent(in) :: y radians procedure, public :: set_vertex_angles private  subroutine set_vertex_angles (self, clock, cone) The vertices: clock angles (from +x toward +y) and cone angles (from the\nboresight, -z; below 90 degrees), radians, the same number of each (>= 3). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: clock (:) radians real(kind=wp), intent(in) :: cone (:) radians procedure, public :: set_x_label private  subroutine set_x_label (self, text) The text of the x-axis label (default 'X'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_y_label private  subroutine set_y_label (self, text) The text of the y-axis label (default 'Y'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_z_label private  subroutine set_z_label (self, text) The text of the z-axis label (default 'Z'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: show_axes private  subroutine show_axes (self, axes) Which axes vectors to show: NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined with ior. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: axes procedure, public :: show_axes_labels private  subroutine show_axes_labels (self, labels) Which axes labels to show (as show_axes ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: labels procedure, public :: show_contents private  subroutine show_contents (self, show) Show or hide what the frame draws (its sphere, model, ...), but not its\naxes, labels or children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show procedure, public :: show_decorations private  subroutine show_decorations (self, show) Show (true) or hide all the frame's decorations at once: its axes,\ntheir labels and its name label (show_axes, show_axes_labels,\nshow_name_label). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show true: all axes, axes labels and the name label procedure, public :: show_name_label private  subroutine show_name_label (self, show) Show or hide the name label (at the frame's origin; default shown). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show (true: shown) procedure, public :: sync private recursive subroutine sync (self) Copy the positions and attitudes of this frame and its descendants to\ntheir transform nodes (only those that changed since the last sync). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: unfollow private  subroutine unfollow (self) Stop following trajectories (the frame keeps its last position and attitude). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: update private recursive subroutine update (self, t) Update this frame and its descendants for simulation time t (followed\ntrajectories set positions and attitudes). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time procedure, public :: world_matrix private recursive function world_matrix (self) result(m) The transform from this frame to the root of its tree, through the first\nparent at each level. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) Source Code type , extends ( PolyhedralCone ), public :: RectangularCone private real ( wp ) :: x = 6 0.0_wp * pi / 18 0.0_wp !! half-angle along x (radians) real ( wp ) :: y = 3 0.0_wp * pi / 18 0.0_wp !! half-angle along y (radians) contains procedure :: set_primary_angles => rect_set_primary_angles procedure :: primary_angles => rect_primary_angles procedure :: frame_info => rect_frame_info end type RectangularCone","tags":"","url":"type/rectangularcone.html"},{"title":"ShapeNodes – vkframes ","text":"type, private :: ShapeNodes A shape's nodes: made under the frame's contents, replaced when the\nshape changes. Inherits type~~shapenodes~~InheritsGraph type~shapenodes ShapeNodes c_ptr c_ptr type~shapenodes->c_ptr contents, shape Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Inherited by type~~shapenodes~~InheritedByGraph type~shapenodes ShapeNodes type~coordinateaxes CoordinateAxes type~coordinateaxes->type~shapenodes nodes type~latlongrid LatLonGrid type~latlongrid->type~shapenodes nodes type~polyhedralcone PolyhedralCone type~polyhedralcone->type~shapenodes nodes type~polyhedron Polyhedron type~polyhedron->type~shapenodes nodes type~radialplane RadialPlane type~radialplane->type~shapenodes nodes type~ellipticcone EllipticCone type~ellipticcone->type~polyhedralcone type~rectangu