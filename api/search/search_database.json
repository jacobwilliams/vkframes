_array interface~vkf_mesh_material vkf_mesh_material proc~mesh_set_material->interface~vkf_mesh_material interface~vkf_mesh_material_changed vkf_mesh_material_changed proc~mesh_set_material->interface~vkf_mesh_material_changed Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine vector_build_contents ( self , viewer , group ) class ( VectorHandle ), intent ( inout ) :: self type ( c_ptr ), intent ( in ) :: viewer !! a window's viewer (null: headless) type ( c_ptr ), intent ( in ) :: group !! the frame's contents group self % shaft_mesh = unit_part ( 1.0_c_double , 0.0_c_double , 1.0_c_double , 1.0_c_double ) ! (a closed cylinder) self % head_mesh = unit_part ( 0.0_c_double , 1.0_c_double , 0.0_c_double , 1.0_c_double ) ! (a cone on a disk) if (. not . ( c_associated ( self % shaft_mesh ) . and . c_associated ( self % head_mesh ))) then write ( * , '(a)' ) 'vkframes: VectorHandle ' // self % name () // ': could not build its arrow' return end if self % switch = vkf_switch_create () self % shaft = vkf_transform_create () self % head = vkf_transform_create () call check_status ( vkf_node_add_child ( self % shaft , self % shaft_mesh )) call check_status ( vkf_node_add_child ( self % head , self % head_mesh )) call check_status ( vkf_node_add_child ( self % switch , self % shaft )) call check_status ( vkf_node_add_child ( self % switch , self % head )) call check_status ( vkf_node_add_child ( group , self % switch )) call self % show_state () call update_arrow ( self ) if ( c_associated ( viewer )) n_shown = n_shown + 1 end subroutine vector_build_contents","tags":"","url":"proc/vector_build_contents.html"},{"title":"vector_move_handle_point – vkframes","text":"private  subroutine vector_move_handle_point(self, p) The tip dragged to p : the vector p / the display scale. Type Bound VectorHandle Arguments Type Intent Optional Attributes Name class( VectorHandle ), intent(inout) :: self real(kind=wp), intent(in) :: p (3) the tip's new place (frame coordinates) Calls proc~~vector_move_handle_point~~CallsGraph proc~vector_move_handle_point VectorHandle%vector_move_handle_point proc~set_vector VectorHandle%set_vector proc~vector_move_handle_point->proc~set_vector proc~update_arrow update_arrow proc~set_vector->proc~update_arrow interface~vkf_switch_set vkf_switch_set proc~update_arrow->interface~vkf_switch_set interface~vkf_transform_set_matrix vkf_transform_set_matrix proc~update_arrow->interface~vkf_transform_set_matrix proc~arrow_sizes arrow_sizes proc~update_arrow->proc~arrow_sizes proc~check_status check_status proc~update_arrow->proc~check_status proc~cross cross proc~update_arrow->proc~cross proc~tip VectorHandle%tip proc~update_arrow->proc~tip proc~arrow_sizes->proc~tip Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine vector_move_handle_point ( self , p ) class ( VectorHandle ), intent ( inout ) :: self real ( wp ), intent ( in ) :: p ( 3 ) !! the tip's new place (frame coordinates) call self % set_vector ( p / self % scale_ ) end subroutine vector_move_handle_point","tags":"","url":"proc/vector_move_handle_point.html"},{"title":"vector_pick – vkframes","text":"private  subroutine vector_pick(self, cam, to_root, hits, n) Picked at its tip and along its head (within the tolerance, plus a few\npixels), as PICK_HANDLE; else the frame's origin. Type Bound VectorHandle Arguments Type Intent Optional Attributes Name class( VectorHandle ), intent(in), target :: self type( PickCamera ), intent(in) :: cam the camera and cursor of the pick real(kind=wp), intent(in) :: to_root (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits so far, in hits(1:n); added to integer, intent(inout) :: n number of hits Calls proc~~vector_pick~~CallsGraph proc~vector_pick VectorHandle%vector_pick proc~add_pick_hit add_pick_hit proc~vector_pick->proc~add_pick_hit proc~arrow_sizes arrow_sizes proc~vector_pick->proc~arrow_sizes proc~contents_shown ReferenceFrame%contents_shown proc~vector_pick->proc~contents_shown proc~draggable DragHandle%draggable proc~vector_pick->proc~draggable proc~pick ReferenceFrame%pick proc~vector_pick->proc~pick proc~point_pick point_pick proc~vector_pick->proc~point_pick proc~segment_pick segment_pick proc~vector_pick->proc~segment_pick proc~tip VectorHandle%tip proc~vector_pick->proc~tip proc~wants wants proc~vector_pick->proc~wants proc~arrow_sizes->proc~tip proc~pick->proc~add_pick_hit proc~pick->proc~point_pick proc~pick->proc~wants proc~project project proc~point_pick->proc~project proc~segment_pick->proc~project Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine vector_pick ( self , cam , to_root , hits , n ) class ( VectorHandle ), intent ( in ), target :: self type ( PickCamera ), intent ( in ) :: cam !! the camera and cursor of the pick real ( wp ), intent ( in ) :: to_root ( 4 , 4 ) !! the frame's transform to the root frame type ( PickHit ), allocatable , intent ( inout ) :: hits (:) !! hits so far, in hits(1:n); added to integer , intent ( inout ) :: n !! number of hits type ( PickHit ) :: h real ( wp ) :: p ( 3 ), base ( 3 ), len , head_len , radius , pixels , depth , s , head_pixels , head_depth logical :: at_tip , on_head call self % ReferenceFrame % pick ( cam , to_root , hits , n ) if (. not . ( self % draggable () . and . self % contents_shown () . and . wants ( cam , PICK_HANDLE ))) return call arrow_sizes ( self , len , head_len , radius ) if ( len <= 0.0_wp ) return p = matmul ( to_root ( 1 : 3 , 1 : 3 ), self % tip ()) + to_root ( 1 : 3 , 4 ) base = matmul ( to_root ( 1 : 3 , 1 : 3 ), self % tip () * ( 1.0_wp - head_len / len )) + to_root ( 1 : 3 , 4 ) at_tip = point_pick ( cam , p , pixels , depth , extra = 6.0_wp * cam % pixel_ratio ) on_head = segment_pick ( cam , base , p , head_pixels , s , head_depth , extra = 4.0_wp * cam % pixel_ratio ) if (. not . ( at_tip . or . on_head )) return if ( on_head . and . (. not . at_tip . or . head_pixels < pixels )) then pixels = head_pixels depth = head_depth end if h % kind = PICK_HANDLE h % frame => self h % position = p h % local = self % tip () h % distance = depth h % pixels = pixels call add_pick_hit ( hits , n , h ) end subroutine vector_pick","tags":"","url":"proc/vector_pick.html"},{"title":"vector_set_color – vkframes","text":"private  subroutine vector_set_color(self, color) The arrow's color; [r, g, b] or [r, g, b, a]. Type Bound VectorHandle Arguments Ty