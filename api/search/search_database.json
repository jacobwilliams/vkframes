ent(in) :: opacity private pure subroutine rect_primary_angles (self, x, y) The half-angles along x and y, radians. Arguments Type Intent Optional Attributes Name class( RectangularCone ), intent(in) :: self real(kind=wp), intent(out) :: x radians real(kind=wp), intent(out) :: y radians private  subroutine rect_set_primary_angles (self, x, y) The half-angles along x and y, radians (0 to 90 degrees). Arguments Type Intent Optional Attributes Name class( RectangularCone ), intent(inout) :: self real(kind=wp), intent(in) :: x radians real(kind=wp), intent(in) :: y radians private  subroutine rect_vertices (self) The 4 corners (OpenFrames' createRectangularCone). Arguments Type Intent Optional Attributes Name type( RectangularCone ), intent(inout) :: self private  subroutine remove_vertex_colors (self) The face color again, for every vertex. Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self private  subroutine replace (self, new) Show new (a switch made by the shape) in place of the shape's current\nnodes; compiled first if the window already runs. Arguments Type Intent Optional Attributes Name class( ShapeNodes ), intent(inout) :: self type(c_ptr), intent(in) :: new a switch made by the shape (null: none) private  subroutine set_axis_length (self, length) The axes' length (scene units, >= 0; default 1); the frame's own axes are\nmoved to the lines' ends. Arguments Type Intent Optional Attributes Name class( CoordinateAxes ), intent(inout) :: self real(kind=wp), intent(in) :: length scene units (< 0: ignored) private  subroutine set_axis_width (self, width) The axis lines' width (window units; default 1). Arguments Type Intent Optional Attributes Name class( CoordinateAxes ), intent(inout) :: self real(kind=wp), intent(in) :: width window units (<= 0: ignored) private  subroutine set_cone_color (self, color) The sides' color ([r, g, b] or [r, g, b, a]; their alpha makes them\ntransparent). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) private  subroutine set_cone_length (self, length) The cone's length along the boresight (> 0; default 1). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: length scene units (<= 0: ignored) private  subroutine set_draw_axes (self, axes) Which axes to draw: an ior of X_AXIS, Y_AXIS, Z_AXIS. Arguments Type Intent Optional Attributes Name class( CoordinateAxes ), intent(inout) :: self integer, intent(in) :: axes private  subroutine set_draw_mode (self, mode) What to draw: an ior of CONE_SIDES, CONE_EDGES, CONE_BASE_OUTLINE. Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self integer, intent(in) :: mode private  subroutine set_edges (self, edges) The edges drawn (2, k) (vertex numbers), in place of the faces' (after\nset_faces, set_triangles or set_grid). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self integer, intent(in) :: edges (:,:) private  subroutine set_face_color (self, color) The faces' color (the alpha times the opacity). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) private  subroutine set_faces (self, vertices, faces, sizes) Faces given as polygons: faces the vertex numbers (1-based) of each\npolygon in turn, sizes how many each has (>= 3; convex, or at least\nstar-shaped from its first vertex: drawn as a fan of triangles from\nit); the edges are the polygons' sides. E.g. a cube: 8 vertices, 6\nfaces of 4. A face's front: its vertices counterclockwise. Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: vertices (:,:) (3, n), frame coordinates integer, intent(in) :: faces (:) (sum(sizes)) vertex numbers integer, intent(in) :: sizes (:) each face's number of vertices private  subroutine set_grid (self, points, closed_u, closed_v, lines) Faces given as a grid of points (3, nu, nv): quadrilaterals between\nneighbours (two triangles each), joined around if closed_u (the last\npoint i to the first, for each j; e.g. a tube's circumference) or closed_v . The edges: the grid's lines, those of constant i (along j)\nevery lines(1) and of constant j (along i) every lines(2) (default:\nevery one; 0 for none). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: points (:,:,:) (3, nu, nv), frame coordinates logical, intent(in), optional :: closed_u logical, intent(in), optional :: closed_v integer, intent(in), optional :: lines (2) private  subroutine set_line_widths (self, width, main_width) Widths of the grid lines and of the equator and prime meridian (window\nunits; defaults 1 and 3). Arguments Type Intent Optional Attributes Name class( LatLonGrid ), intent(inout) :: self real(kind=wp), intent(in) :: width window units (<= 0: unchanged) real(kind=wp), intent(in) :: main_width window units (<= 0: unchanged) private  subroutine set_lit (self, lit) Faces lit by the scene's lights (the default), or unlit (their color\nas is, transparent as a cone's sides: writing no depth). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self logical, intent(in) :: lit private  subroutine set_plane_color (self, color) The plane's color ([r, g, b] or [r, g, b, a]; default 0.8 gray, 0.2 opaque). Arguments Type Intent Optional Attributes Name class( RadialPlane ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) private  subroutine set_point_color (self, color) The vertices' color (POLY_VERTICES). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) private  subroutine set_point_size (self, size_) The vertices' size (window units; default 6). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: size_ private  subroutine set_smooth (self, smooth) Shading smooth across the vertices (normals averaged over the faces\naround each: a curved surface, e.g. a grid's), or flat faces (the\ndefault: a polyhedron's). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self logical, intent(in) :: smooth private  subroutine set_tick_shape (self, shape) Tick shape: a MARKER_* shape (default MARKER_DISK; OpenFrames'\nsetTickShader with its marker shaders). Arguments Type Intent Optional Attributes Name class( CoordinateAxes ), intent(inout) :: self integer, intent(in) :: shape a MARKER_* shape private  subroutine set_tick_size (self, major, minor) Major and minor tick sizes (window units; default 8 and 4). Arguments Type Intent Optional Attributes Name class( CoordinateAxes ), intent(inout) :: self real(kind=wp), intent(in) :: major window units (<= 0: unchanged) real(kind=wp), intent(in) :: minor window units (<= 0: unchanged) private  subroutine set_tick_spacing (self, major, minor) Major and minor tick spacings (>= 0; 0 for none). Arguments Type Intent Optional Attributes Name class( CoordinateAxes ), intent(inout) :: self real(kind=wp), intent(in) :: major scene units (< 0: unchanged) real(kind=wp), intent(in) :: minor scene units (< 0: unchanged) private  subroutine set_triangles (self, vertices, triangles) Faces given as triangles (3, m) of vertex numbers (1-based); the edges\nare their sides (each once). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: vertices (:,:) (3, n), frame coordinates integer, intent(in) :: triangles (:,:) (3, m) private  subroutine set_two_sided (self, two_sided) Both sides of the faces drawn and lit (the default: open surfaces), or\nonly their fronts (a closed surface, its faces counterclockwise seen\nfrom outside: translucent, its far side isn't drawn through it). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self logical, intent(in) :: two_sided private  subroutine set_vertex_angles (self, clock, cone) The vertices: clock angles (from +x toward +y) and cone angles (from the\nboresight, -z; below 90 degrees), radians, the same number of each (>= 3). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: clock (:) radians real(kind=wp), intent(in) :: cone (:) radians private  subroutine set_vertex_colors (self, colors) A color per vertex (4, n) or (3, n) ([r, g, b(, a)], 0 to 1), for the\nfaces, blended across them (in place of the face color; the opacity\nstill applies). Dropped when the faces are set again. Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: colors (:,:) private  subroutine set_vertices (self, vertices) Move the vertices (3, n), keeping the faces and edges (as many as\nbefore; e.g. a surface changing in time). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: vertices (:,:) private pure subroutine sort_keys (a) Sort keys, increasing (a bottom-up merge sort). Arguments Type Intent Optional Attributes Name integer(kind=int64), intent(inout) :: a (:) private pure subroutine tick_size (self, major, minor) Major and minor tick sizes (window units). Arguments Type Intent Optional Attributes Name class( CoordinateAxes ), intent(in) :: self real(kind=wp), intent(out) :: major window units real(kind=wp), intent(out) :: minor window units private pure subroutine tick_spacing (self, major, minor) Major and minor tick spacings. Arguments Type Intent Optional Attributes Name class( CoordinateAxes ), intent(in) :: self real(kind=wp), intent(out) :: major scene units real(kind=wp), intent(out) :: minor scene units private pure subroutine vertices_sphere (v, center, radius) A sphere around points v (3, n): their box's center, out to the\nfarthest (zero for none). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: v (:,:) real(kind=wp), intent(out) :: center (3) real(kind=wp), intent(out) :: radius","tags":"","url":"module/vkf_shapes.html"},{"title":"vkf_diagnostics – vkframes","text":"Diagnostics (not in OpenFrames): what vkframes is built with and runs on,\nand how fast a window draws, for an information or debugging panel. library_versions() : the versions of vkframes, VSG, vsgXchange, Dear\n  ImGui, the Vulkan headers it was built with and the Vulkan loader it runs\n  with (LibraryVersions). A window's device_info() : its Vulkan device and driver (DeviceInfo). A window's render_stats() : its frame rate and where a frame's time goes\n  (RenderStats), measured at every frame at no cost: the program's part\n  (the scene's update and the event handler), and the renderer's: waiting\n  for the next image to draw into (with vsync, this is mostly waiting for\n  the display), recording and submitting, and presenting; the GPU's time\n  for the frame (timestamps around its commands, read frames later, so it\n  lags a few frames; not measured on devices without timestamps); and the\n  device's memory in use and its budget (if the driver says). A window's scene_counts() : the size of its scene graph (SceneCounts),\n  counted when asked (a traversal of the whole graph: for an occasional\n  update, not every frame). Uses iso_fortran_env vkf_math vkf_layer iso_c_binding module~~vkf_diagnostics~~UsesGraph module~vkf_diagnostics vkf_diagnostics iso_c_binding iso_c_binding module~vkf_diagnostics->iso_c_binding iso_fortran_env iso_fortran_env module~vkf_diagnostics->iso_fortran_env module~vkf_layer vkf_layer module~vkf_diagnostics->module~vkf_layer module~vkf_math vkf_math module~vkf_diagnostics->module~vkf_math module~vkf_layer->iso_c_binding module~vkf_math->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~vkf_diagnostics~~UsedByGraph module~vkf_diagnostics vkf_diagnostics module~vkf_window vkf_window module~vkf_window->module~vkf_diagnostics module~vkframes vkframes module~vkframes->module~vkf_diagnostics module~vkframes->module~vkf_window Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial character(len=*), public, parameter :: vkframes_version = '0.0.1' vkframes' version (fpm.toml's). Derived Types type, public :: DeviceInfo A window's Vulkan device and driver (each '' if unknown). Components Type Visibility Attributes Name Initial character(len=:), public, allocatable :: driver its driver's name character(len=:), public, allocatable :: driver_info its driver's information (e.g. its version) character(len=:), public, allocatable :: kind integrated GPU, discrete GPU, virtual GPU, CPU or other character(len=:), public, allocatable :: name the device (e.g. \"Apple M3 Max\") character(len=:), public, allocatable :: vulkan the Vulkan version it supports type, public :: LibraryVersions The versions of vkframes and the libraries it uses (each '' if unknown). Components Type Visibility Attributes Name Initial character(len=:), public, allocatable