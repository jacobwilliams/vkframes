f )) end subroutine set_time_scale","tags":"","url":"proc/set_time_scale~2.html"},{"title":"set_view_transition – vkframes","text":"private  subroutine set_view_transition(self, seconds) The time (s) a change of view or a reset flies from one camera to the\nother (default 0: a cut, as OpenFrames). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: seconds wall-clock s (0: a cut) Source Code subroutine set_view_transition ( self , seconds ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: seconds !! wall-clock s (0: a cut) self % transition_ = max ( 0.0_wp , seconds ) end subroutine set_view_transition","tags":"","url":"proc/set_view_transition.html"},{"title":"set_zoom_speed – vkframes","text":"private  subroutine set_zoom_speed(self, speed) How fast the mouse zooms (default 1, VSG's: 10% per wheel step, and a\nright drag's rate): e.g. 0.3 for a gentler zoom. Scales scroll steps\nhowever they come (a mouse wheel, a trackpad, a host's scroll ). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: speed (> 0; 1: the default) Calls proc~~set_zoom_speed~~CallsGraph proc~set_zoom_speed WindowProxy%set_zoom_speed proc~apply_camera_controls apply_camera_controls proc~set_zoom_speed->proc~apply_camera_controls interface~vkf_viewer_set_camera_controls vkf_viewer_set_camera_controls proc~apply_camera_controls->interface~vkf_viewer_set_camera_controls Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_zoom_speed ( self , speed ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: speed !! (> 0; 1: the default) if ( speed <= 0.0_wp ) return self % zoom_speed_ = speed call apply_camera_controls ( self ) end subroutine set_zoom_speed","tags":"","url":"proc/set_zoom_speed.html"},{"title":"start_flight – vkframes","text":"private  subroutine start_flight(self, from, start, to, finish, duration) Fly from camera start (in view from 's frame) to finish (in view to 's) over duration s, from now. Arguments Type Intent Optional Attributes Name type( WindowProxy ), intent(inout) :: self type( View ), intent(in), target :: from real(kind=wp), intent(in) :: start (3,3) (columns: eye, center, up; duration: s) type( View ), intent(in), target :: to real(kind=wp), intent(in) :: finish (3,3) (columns: eye, center, up; duration: s) real(kind=wp), intent(in) :: duration (columns: eye, center, up; duration: s) Calls proc~~start_flight~~CallsGraph proc~start_flight start_flight proc~window_wall window_wall proc~start_flight->proc~window_wall proc~wall_time wall_time proc~window_wall->proc~wall_time Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~start_flight~~CalledByGraph proc~start_flight start_flight proc~place_camera place_camera proc~place_camera->proc~start_flight proc~set_camera WindowProxy%set_camera proc~set_camera->proc~start_flight proc~frame WindowProxy%frame proc~frame->proc~place_camera proc~resize WindowProxy%resize proc~resize->proc~frame proc~run WindowProxy%run proc~run->proc~frame Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine start_flight ( self , from , start , to , finish , duration ) type ( WindowProxy ), intent ( inout ) :: self type ( View ), intent ( in ), target :: from , to real ( wp ), intent ( in ) :: start ( 3 , 3 ), finish ( 3 , 3 ), duration !! (columns: eye, center, up; duration: s) self % flight % from => from self % flight % to => to self % flight % start = start self % flight % finish = finish self % flight % duration = duration self % flight % started = window_wall ( self ) self % flight % active = . true . end subroutine start_flight","tags":"","url":"proc/start_flight.html"},{"title":"stop_transition – vkframes","text":"private  subroutine stop_transition(self) End a flight where the camera is now. Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self Source Code subroutine stop_transition ( self ) class ( WindowProxy ), intent ( inout ) :: self self % flight % active = . false . end subroutine stop_transition","tags":"","url":"proc/stop_transition.html"},{"title":"time_range – vkframes","text":"private  subroutine time_range(self, t_min, t_max) The simulation time range ( set_time_range ). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(in) :: self real(kind=wp), intent(out) :: t_min real(kind=wp), intent(out) :: t_max Calls proc~~time_range~3~~CallsGraph proc~time_range~3 WindowProxy%time_range proc~time_range~2 SimulationClock%time_range proc~time_range~3->proc~time_range~2 proc~time_range~2->proc~time_range~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine time_range ( self , t_min , t_max ) class ( WindowProxy ), intent ( in ) :: self real ( wp ), intent ( out ) :: t_min , t_max call self % clock_ % time_range ( t_min , t_max ) end subroutine time_range","tags":"","url":"proc/time_range~3.html"},{"title":"update_huds – vkframes","text":"private  subroutine update_huds(self) Show the HUD texts' changes: text, color, position, size and alignment\nin place; a new font makes the text's node again. Arguments Type Intent Optional Attributes Name type( WindowProxy ), intent(inout) :: self Calls proc~~update_huds~~CallsGraph proc~update_huds update_huds interface~vkf_label_set_color vkf_label_set_color proc~update_huds->interface~vkf_label_set_color interface~vkf_label_set_text vkf_label_set_text proc~update_huds->interface~vkf_label_set_text interface~vkf_node_delete vkf_node_delete proc~update_huds->interface~vkf_node_delete interface~vkf_viewer_hud_remove vkf_viewer_hud_remove proc~update_huds->interface~vkf_viewer_hud_remove proc~alignment HUDText%alignment proc~update_huds->proc~alignment proc~color~2 HUDText%color proc~update_huds->proc~color~2 proc~create_hud create_hud proc~update_huds->proc~create_hud proc~font HUDText%font proc~update_huds->proc~font proc~label_set_layout label_set_layout proc~update_huds->proc~label_set_layout proc~position~2 HUDText%position proc~update_huds->proc~position~2 proc~revision~2 HUDText%revision proc~update_huds->proc~revision~2 proc~text~2 HUDText%text proc~update_huds->proc~text~2 proc~create_hud->proc~alignment proc~create_hud->proc~color~2 proc~create_hud->proc~font proc~create_hud->proc~position~2 proc~create_hud->proc~revision~2 proc~create_hud->proc~text~2 interface~vkf_viewer_hud_add vkf_viewer_hud_add proc~create_hud->interface~vkf_viewer_hud_add proc~label_create label_create proc~create_hud->proc~label_create interface~vkf_label_set_layout vkf_label_set_layout proc~label_set_layout->interface~vkf_label_set_layout proc~vsg_alignment vsg_alignment proc~label_set_layout->proc~vsg_alignment proc~label_create->proc~vsg_alignment interface~vkf_label_create vkf_label_create proc~label_create->interface~vkf_label_create proc~get_font get_font proc~label_create->proc~get_font interface~vkf_font_read vkf_font_read proc~get_font->interface~vkf_font_read proc~find_font find_font proc~get_font->proc~find_font proc~find_in_dirs find_in_dirs proc~find_font->proc~find_in_dirs Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~update_huds~~CalledByGraph proc~update_huds update_huds proc~frame WindowProxy%frame proc~frame->proc~update_huds proc~resize WindowProxy%resize proc~resize->proc~frame proc~run WindowProxy%run proc~run->proc~frame Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine update_huds ( self ) type ( WindowProxy ), intent ( inout ) :: self type ( HUDText ), pointer :: h character ( len = :), allocatable :: t integer ( c_int ) :: status integer :: k do k = 1 , self % n_huds h => self % huds ( k )% p if (. not . c_associated ( self % huds ( k )% node ) . or . h % revision () == self % huds ( k )% revision ) cycle if ( h % font () /= self % huds ( k )% font ) then status = vkf_viewer_hud_remove ( self % viewer_ , self % huds ( k )% node ) call vkf_node_delete ( self % huds ( k )% node ) call create_hud ( self , k ) cycle end if t = h % text () if ( vkf_label_set_text ( self % huds ( k )% node , t , len ( t , kind = c_int )) /= 0 . or . & vkf_label_set_color ( self % huds ( k )% node , real ( h % color (), c_float )) /= 0 . or . & . not . label_set_layout ( self % huds ( k )% node , [ h % position (), 0.0_wp ], h % size (), 0.0_wp , h % alignment ())) & write ( * , '(a)' ) 'vkframes: could not update HUD text' self % huds ( k )% revision = h % revision () end do end subroutine update_huds","tags":"","url":"proc/update_huds.html"},{"title":"update_window_light – vkframes","text":"private  subroutine update_window_light(self, root) The window's light on while no frame of the scene has a light source. Arguments Type Intent Optional Att