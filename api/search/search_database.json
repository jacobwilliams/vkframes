s( ShadowCones ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: frame_string private recursive function frame_string (self, prefix) result(str) The tree below this frame, one line per frame (\"name (info)\"), in\nOpenFrames' createFrameString format: children are prefixed \"|-->\". Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self character(len=*), intent(in), optional :: prefix before this frame's line (default ' ') Return Value character(len=:), allocatable procedure, public :: has_light_source private recursive function has_light_source (self) result(has) Whether this frame or one of its descendants has a light source enabled. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: is_following private pure function is_following (self) Whether the frame follows trajectories (at least one, since follow ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: label_alignment private pure function label_alignment (self) The labels' alignment (ALIGN_*). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: label_font private  function label_font (self) result(font) The labels' font as set ('' for the renderer's default). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: label_size private pure function label_size (self) The labels' size in pixels. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: late_update => shadow_late_update private recursive subroutine shadow_late_update (self, t) After the tree's update for time t: the shadow moved to the body, turned\naway from the light, and reshaped if the distance or a setting changed. Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(inout) :: self real(kind=wp), intent(in) :: t the scene time procedure, public :: length private pure function length (self) The length set (0: automatic). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(in) :: self Return Value real(kind=wp) procedure, public :: light private  function light (self) result(p) The light (null if not set). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(in) :: self Return Value class( ReferenceFrame ), pointer procedure, public :: light_ambient private pure function light_ambient (self) result(rgb) The light source's ambient color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_diffuse private pure function light_diffuse (self) result(rgb) The light source's diffuse color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_radius private  function light_radius (self) The light's radius used (0: none known). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(in) :: self Return Value real(kind=wp) procedure, public :: light_source_enabled private pure function light_source_enabled (self) Whether this frame carries a light source. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: light_specular private pure function light_specular (self) result(rgb) The light source's specular color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: local_matrix private pure function local_matrix (self) result(m) The transform from this frame to its parent (4x4). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) procedure, public :: move_x_axis private  subroutine move_x_axis (self, base, length, head_ratio, body_radius, head_radius) Place the x axis vector: from base , length long, with a head of head_ratio of the length (default 0.3) and body and head radii (default\n0.05 and 0.1 of the length); its label is at the tip, 0.4 of the length\ntall (at most label_size pixels). As OpenFrames' moveXAxis. Set before\nthe frame is first shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) (base: frame's coordinates) real(kind=wp), intent(in) :: length (base: frame's coordinates) real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_y_axis private  subroutine move_y_axis (self, base, length, head_ratio, body_radius, head_radius) Place the y axis vector (as move_x_axis ; OpenFrames' moveYAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_z_axis private  subroutine move_z_axis (self, base, length, head_ratio, body_radius, head_radius) Place the z axis vector (as move_x_axis ; OpenFrames' moveZAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: name private  function name (self) result(n) The frame's name ('' if none). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: name_label_on_top private pure function name_label_on_top (self) Whether the name label is drawn on top of the scene ( set_name_label_on_top ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: name_label_shown private pure function name_label_shown (self) Whether the name label is shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: node private  function node (self) result(n) The frame's transform node (null until realized). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value type(c_ptr) procedure, public :: num_children private pure function num_children (self) Number of children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: num_parents private pure function num_parents (self) Number of parents. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: parent private  function parent (self, i) result(p) Parent i (1 to num_parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: parent_index private  function parent_index (self, frame) Index of frame among the parents, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: pick private  subroutine pick (self, cam, to_root, hits, n) Pick what the frame draws (see the module documentation): to_root is its transform to the root frame; hits are added to hits(1:n). A\nplain frame: its origin, if it shows axes or its name label. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in), target :: self type( PickCamera ), intent(in) :: cam the cursor's ray and the pick's settings real(kind=wp), intent(in) :: to_root (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits so far (grown as needed) integer, intent(inout) :: n number of hits in hits procedure, public :: pickable private pure function pickable (self) Whether pick tests what this frame draws ( set_pickable ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: position private pure function position (self) result(p) Position relative to the parent frame. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: position_of private  function position_of (self, other) result(p) The origin of other (a frame of the same tree) in this frame's\ncoordinates, from both frames' transforms to the root (through their\nfirst parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in) :: other Return Value real(kind=wp), (3) procedure, public :: realize private recursive subroutine realize (self, viewer) Create the render nodes of this frame and its descendants (once; for viewer , a window's viewer handle, which some contents need while they\nare built (not kept); null: headless). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer handle (null: headless) procedure, public :: region_color private  function region_color (self, region) result(c) A region's color [r, g, b, a] (0 for an unknown region). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(in) :: self integer, intent(in) :: region SHADOW_UMBRA, SHADOW_PENUMBRA or SHADOW_ANTUMBRA Return Value real(kind=wp), (4) procedure, public :: region_extent private  subroutine region_extent (self, region, drawn, z0, r0, z1, r1) A region's surface at the last update, along the frame's +z axis (away\nfrom the light; the body's center at the origin): drawn, from z0\n(radius r0) to z1 (radius r1). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(in) :: self integer, intent(in) :: region SHADOW_UMBRA, SHADOW_PENUMBRA or SHADOW_ANTUMBRA logical, intent(out) :: drawn it has a surface and is drawn real(kind=wp), intent(out), optional :: z0 scene units real(kind=wp), intent(out), optional :: r0 scene units real(kind=wp), intent(out), optional :: z1 scene units real(kind=wp), intent(out), optional :: r1 scene units procedure, public :: regions private pure function regions (self) The regions drawn: an ior of SHADOW_UMBRA, SHADOW_PENUMBRA and\nSHADOW_ANTUMBRA. Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(in) :: self Return Value integer procedure, public :: remove_child private  function remove_child (self, child) result(ok) Remove child from this frame's children. Returns false if it is not one. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self class( ReferenceFrame ), intent(inout), target :: child Return Value logical procedure, public :: reposition_axes private  subroutine reposition_axes (self) Place the axes for what the frame draws, when it is first shown (unless\nmove_*_axis was called): at its bound's surface, half the bound's radius\nlong (as OpenFrames' Sphere and Model do); at the origin, 1 long, for a\nframe that draws nothing. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: set_attitude private  subroutine set_attitude (self, q) Attitude relative to the parent frame, a quaternion [x, y, z, w]\n(normalized here; overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) procedure, public :: set_body private  subroutine set_body (self, body, radius) The body casting the shadow (it must stay alive while set), and its\nradius (optional: see set_body_radius). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(inout) :: self class( ReferenceFrame ), intent(in), target :: body real(kind=wp), intent(in), optional :: radius scene units (see set_body_radius) procedure, public :: set_body_radius private  subroutine set_body_radius (self, radius) The body's radius (scene units; 0: the body's own, a Sphere's\nequatorial radius or a TerrainBody's). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(inout) :: self real(kind=wp), intent(in) :: radius scene units (0: the body's own) procedure, public :: set_color private  subroutine set_color (self, color) The color of the frame's decorations: [r, g, b] (alpha unchanged) or [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) procedure, public :: set_label_alignment private  subroutine set_label_alignment (self, alignment) The alignment of the labels relative to their positions (ALIGN_*;\ndefault ALIGN_LEFT_BASE_LINE). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: alignment procedure, public :: set_label_font private  subroutine set_label_font (self, font) The font of the labels: a font file name (found on the data search\npath) or a full path; default: the renderer's default font. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: font procedure, public :: set_label_size private  subroutine set_label_size (self, size) The size of the labels in pixels (default 20): the name label's size,\nand the maximum size of the axes labels (which shrink with distance). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: size procedure, public :: set_length private  subroutine set_length (self, length) How far behind the body's center the shadow is drawn (scene units; 0:\nautomatic, twice the umbra's length). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(inout) :: self real(kind=wp), intent(in) :: length scene units (0: automatic) procedure, public :: set_light private  subroutine set_light (self, light, radius) The light (e.g. the Sun; it must stay alive while set), and its radius\n(optional: see set_light_radius). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(inout) :: self class( ReferenceFrame ), intent(in), target :: light real(kind=wp), intent(in), optional :: radius scene units (see set_light_radius) procedure, public :: set_light_ambient private  subroutine set_light_ambient (self, rgb) The light source's ambient, diffuse and specular colors ([r, g, b], 0\nto 1; defaults 0.05, 0.8 and 0.05 gray). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_diffuse private  subroutine set_light_diffuse (self, rgb) The light source's diffuse color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_radius private  subroutine set_light_radius (self, radius) The light's radius (scene units; 0: the light's own, if a Sphere). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(inout) :: self real(kind=wp), intent(in) :: radius scene units (0: the light's own) procedure, public :: set_light_source_enabled private  subroutine set_light_source_enabled (self, enable) Whether this frame carries a light source: a point light at its origin\n(e.g. the Sun), not dimmed with distance (default false; OpenFrames'\nsetLightSourceEnabled). While any frame of a window's scene has one, the\nwindow's own light (WindowProxy%set_light_*) is off. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: enable procedure, public :: set_light_specular private  subroutine set_light_specular (self, rgb) The light source's specular color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_name private  subroutine set_name (self, name) The frame's name, shown by its name label (also once shown: e.g. a\nreadout that follows the frame). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: name procedure, public :: set_name_label_on_top private  subroutine set_name_label_on_top (self, on_top) Draw the name label on top of the scene (true: not hidden by bodies in\nfront of it, as HUD text; e.g. a readout) or depth-tested (false, the\ndefault, as OpenFrames'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: on_top procedure, public :: set_pickable private  subroutine set_pickable (self, pickable) Whether pick tests what this frame draws (default true; e.g. false\nfor an overlay such as a selection marker). Its children are picked or\nnot by their own setting. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: pickable procedure, public :: set_position private  subroutine set_position (self, position) Position relative to the parent frame (overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) parent frame's coordinates procedure, public :: set_region_color private  subroutine set_region_color (self, region, color) A region's color (region: one of SHADOW_UMBRA, SHADOW_PENUMBRA,\nSHADOW_ANTUMBRA; [r, g, b], alpha unchanged, or [r, g, b, a]). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(inout) :: self integer, intent(in) :: region SHADOW_UMBRA, SHADOW_PENUMBRA or SHADOW_ANTUMBRA real(kind=wp), intent(in) :: color (:) [r, g, b] (alpha unchanged) or [r, g, b, a], 0 to 1 procedure, public :: set_regions private  subroutine set_regions (self, regions) The regions to draw: an ior of SHADOW_UMBRA, SHADOW_PENUMBRA and\nSHADOW_ANTUMBRA (default SHADOW_ALL). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(inout) :: self integer, intent(in) :: regions an ior of SHADOW_UMBRA, SHADOW_PENUMBRA, SHADOW_ANTUMBRA procedure, public :: set_x_label private  subroutine set_x_label (self, text) The text of the x-axis label (default 'X'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_y_label private  subroutine set_y_label (self, text) The text of the y-axis label (default 'Y'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_z_label private  subroutine set_z_label (self, text) The text of the z-axis label (default 'Z'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: show_axes private  subroutine show_axes (self, axes) Which axes vectors to show: NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined with ior. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: axes procedure, public :: show_axes_labels private  subroutine show_axes_labels (self, labels) Which axes labels to show (as show_axes ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: labels procedure, public :: show_contents private  subroutine show_contents (self, show) Show or hide what the frame draws (its sphere, model, ...), but not its\naxes, labels or children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show procedure, public :: show_decorations private  subroutine show_decorations (self, show) Show (true) or hide all the frame's decorations at once: its axes,\ntheir labels and its name label (show_axes, show_axes_labels,\nshow_name_label). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show true: all axes, axes labels and the name label procedure, public :: show_name_label private  subroutine show_name_label (self, show) Show or hide the name label (at the frame's origin; default shown). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show (true: shown) procedure, public :: sync private recursive subroutine sync (self) Copy the positions and attitudes of this frame and its descendants to\ntheir transform nodes (only those that changed since the last sync). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: umbra_length private pure function umbra_length (self) The distance from the body's center to the umbra's apex at the last\nupdate (huge() for a body no smaller than its light; 0 before). Arguments Type Intent Optional Attributes Name class( ShadowCones ), intent(in) :: self Return Value real(kind=wp) procedure, public :: unfollow private  subroutine unfollow (self) Stop following trajectories (the frame keeps its last position and attitude). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: update private recursive subroutine update (self, t) Update this frame and its descendants for simulation time t (followed\ntrajectories set positions and attitudes). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time procedure, public :: world_matrix private recursive function world_matrix (self) result(m) The transform from this frame to the root of its tree, through the first\nparent at each level. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) Source Code type , extends ( ReferenceFrame ), public :: ShadowCones private class ( ReferenceFrame ), pointer :: body_ => null () !! the body casting the shadow (not owned) class ( ReferenceFrame ), pointer :: light_ => null () !! the light (not owned) real ( wp ) :: body_radius_ = 0.0_wp , light_radius_ = 0.0_wp !! (0: the frames' own) real ( wp ) :: length_ = 0.0_wp !! (0: automatic) integer :: regions_ = SHADOW_ALL !! an ior of SHADOW_UMBRA, SHADOW_PENUMBRA, SHADOW_ANTUMBRA type ( ShadowRegion ) :: region ( n_regions ) !! umbra, penumbra and antumbra real ( wp ) :: shaped ( 4 ) = - 1.0_wp !! R, Rs, d and length the cones have now real ( wp ) :: distance_ = 0.0_wp !! body to light at the last update (scene units) real ( wp ) :: drawn_length_ = 0.0_wp !! the length drawn at the last update (scene units) contains procedure :: set_body , body , set_light , light procedure :: set_body_radius , set_light_radius , body_radius , light_radius procedure :: set_length , length , drawn_length , distance procedure :: set_regions , regions procedure :: set_region_color , region_color procedure :: region_extent 