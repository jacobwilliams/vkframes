, t, k, k2) Arguments Type Intent Optional Attributes Name class( ChainArtist ), intent(inout) :: self real(kind=wp), intent(in) :: t the current time integer, intent(in) :: k the tail's ends (0: none) integer, intent(in) :: k2 the tail's ends (0: none) Description The trace tail: from point k (the latest passed) to the point\ninterpolated at time t toward point k2 (the next in time); none if\neither isn't a point written.","tags":"","url":"interface/draw_tail_interface.html"},{"title":"new_tail_interface – vkframes","text":"interface private  function new_tail_interface(self) result(node) Arguments Type Intent Optional Attributes Name class( ChainArtist ), intent(in) :: self Return Value type(c_ptr) Description The trace tail's node (null on failure), made with the chain.","tags":"","url":"interface/new_tail_interface.html"},{"title":"write_points_interface – vkframes","text":"interface private  subroutine write_points_interface(self, i1, i2) Arguments Type Intent Optional Attributes Name class( ChainArtist ), intent(inout) :: self integer, intent(in) :: i1 the trajectory points integer, intent(in) :: i2 the trajectory points Description Write trajectory points i1 .. i2 into the chain (and upload the chunks written to).","tags":"","url":"interface/write_points_interface.html"},{"title":"segments_compute – vkframes","text":"interface private  subroutine segments_compute(self, segments, t) Arguments Type Intent Optional Attributes Name class( LineSegmentsCallback ), intent(inout) :: self class( CustomLineSegments ), intent(inout) :: segments real(kind=wp), intent(in) :: t simulation time (s) Description Set segments ' segments for simulation time t (with set_segments).","tags":"","url":"interface/segments_compute.html"},{"title":"handle_point_interface – vkframes","text":"interface private pure function handle_point_interface(self) result(p) Arguments Type Intent Optional Attributes Name class( DragHandle ), intent(in) :: self Return Value real(kind=wp)(3) Descriptio