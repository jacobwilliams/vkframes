onal Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: vertices (:,:) (3, n), frame coordinates integer, intent(in) :: triangles (:,:) (3, m) procedure, public :: set_two_sided private  subroutine set_two_sided (self, two_sided) Both sides of the faces drawn and lit (the default: open surfaces), or\nonly their fronts (a closed surface, its faces counterclockwise seen\nfrom outside: translucent, its far side isn't drawn through it). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self logical, intent(in) :: two_sided procedure, public :: set_vertex_colors private  subroutine set_vertex_colors (self, colors) A color per vertex (4, n) or (3, n) ([r, g, b(, a)], 0 to 1), for the\nfaces, blended across them (in place of the face color; the opacity\nstill applies). Dropped when the faces are set again. Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: colors (:,:) procedure, public :: set_vertices private  subroutine set_vertices (self, vertices) Move the vertices (3, n), keeping the faces and edges (as many as\nbefore; e.g. a surface changing in time). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: vertices (:,:) procedure, public :: set_x_label private  subroutine set_x_label (self, text) The text of the x-axis label (default 'X'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_y_label private  subroutine set_y_label (self, text) The text of the y-axis label (default 'Y'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_z_label private  subroutine set_z_label (self, text) The text of the z-axis label (default 'Z'). Arguments Type Intent Optional