erenceFrame ), pointer , intent ( in ) :: root !! the scene's root (may be null) logical :: on on = . true . if ( associated ( root )) on = . not . root % has_light_source () if ( on . eqv . self % light_on ) return self % light_on = on if ( vkf_viewer_light_enable ( self % viewer_ , merge ( 1_c_int , 0_c_int , on )) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not switch the window light' end subroutine update_window_light","tags":"","url":"proc/update_window_light.html"},{"title":"window_pick – vkframes","text":"private  subroutine window_pick(self, x, y, hits, tolerance, kinds, nearest) What is under point (x, y) of the window (-1 to 1 across it, y up: as\nthe event handler's positions), nearest first (see the module\ndocumentation): none before the first frame. tolerance : how close\nlines, markers and frames' origins must be, in window units (logical\npixels; default 4), beyond half a line's width or a marker's size. kinds : only hits of these kinds (PICK_*; the others aren't tested). nearest : only the nearest hit (cheaper: what is deeper than a hit\nfound is skipped, e.g. to pick on every mouse move). Frames and\nartists can be left out ( set_pickable(.false.) ). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(in), target :: self real(kind=wp), intent(in) :: x -1 to 1 across the window, y up real(kind=wp), intent(in) :: y -1 to 1 across the window, y up type( PickHit ), intent(out), allocatable :: hits (:) what is there, nearest first real(kind=wp), intent(in), optional :: tolerance window units (default 4) integer, intent(in), optional :: kinds (:) PICK_* (default: all) logical, intent(in), optional :: nearest default false Calls proc~~window_pick~~CallsGraph proc~window_pick WindowProxy%window_pick proc~child ReferenceFrame%child proc~window_pick->proc~child proc~fm_frame FrameManager%fm_frame proc~window_pick->proc~fm_frame proc~identity_matrix identity_matrix proc~window_pick->proc~identity_matrix proc~l