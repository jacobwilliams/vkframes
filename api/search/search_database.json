allocatable :: vulkan the Vulkan version it supports Source Code type , public :: DeviceInfo character ( len = :), allocatable :: name !! the device (e.g. \"Apple M3 Max\") character ( len = :), allocatable :: kind !! integrated GPU, discrete GPU, virtual GPU, CPU or other character ( len = :), allocatable :: vulkan !! the Vulkan version it supports character ( len = :), allocatable :: driver !! its driver's name character ( len = :), allocatable :: driver_info !! its driver's information (e.g. its version) end type DeviceInfo","tags":"","url":"type/deviceinfo.html"},{"title":"LibraryVersions – vkframes ","text":"type, public :: LibraryVersions The versions of vkframes and the libraries it uses (each '' if unknown). Components Type Visibility Attributes Name Initial character(len=:), public, allocatable :: imgui Dear ImGui (GUI panels) character(len=:), public, allocatable :: vkframes vkframes character(len=:), public, allocatable :: vsg VulkanSceneGraph character(len=:), public, allocatable :: vsgxchange vsgXchange (images, models, fonts) character(len=:), public, allocatable :: vulkan_headers the Vulkan headers vkframes was built with character(len=:), public, allocatable :: vulkan_loader the Vulkan loader it runs with (its instance version) Source Code type , public :: LibraryVersions character ( len = :), allocatable :: vkframes !! vkframes character ( len = :), allocatable :: vsg !! VulkanSceneGraph character ( len = :), allocatable :: vsgxchange !! vsgXchange (images, models, fonts) character ( len = :), allocatable :: imgui !! Dear ImGui (GUI panels) character ( len = :), allocatable :: vulkan_headers !! the Vulkan headers vkframes was built with character ( len = :), allocatable :: vulkan_loader !! the Vulkan loader it runs with (its instance version) end type LibraryVersions","tags":"","url":"type/libraryversions.html"},{"title":"RenderStats – vkframes ","text":"type, public :: RenderStats A window's frame rate and frame times (see the module documentation)