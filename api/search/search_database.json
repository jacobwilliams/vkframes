: TrajectoryPointer A pointer to a followed trajectory (for an array of them). Components Type Visibility Attributes Name Initial type( Trajectory ), public, pointer :: p => null() the trajectory (not owned) Functions private  function chosen_trajectory (self, t) result(k) The trajectory to follow at time t: the current one if it contains t,\nelse the first that does, else the closest. Arguments Type Intent Optional Attributes Name type( TrajectoryFollower ), intent(in) :: self real(kind=wp), intent(in) :: t Return Value integer private pure function data_sources (self) result(s) Where the followed position's x, y and z come from. Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value type( DataSource ), (3) private pure function data_valid (self) True if every followed trajectory has the data the position sources use. Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value logical private pure function follow_data (self) What is followed: FOLLOW_POSITION and/or FOLLOW_ATTITUDE (combined with ior). Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value integer private pure function follow_mode (self) How time outside the trajectories is handled: FOLLOW_LOOP or FOLLOW_LIMIT. Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value integer private pure function is_following_time (self) True if following the simulation time plus an offset, false for a fixed time. Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value logical private pure function last_time (self) The time (after looping) at the last update. Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value real(kind=wp) private  function last_trajectory (self) result(traj) The trajectory followed at the last update (null if none). Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value type( Trajectory ), pointer private pure function num_trajectories (self) Number of trajectories followed. Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value integer private  function set_x_data (self, src) result(valid) Where the x, y and z of the followed position come from (default: the\ntrajectories' positions). Returns whether all followed trajectories have\nthose data. Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical private  function set_y_data (self, src) result(valid) Where the y of the followed position comes from (see set_x_data ). Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical private  function set_z_data (self, src) result(valid) Where the z of the followed position comes from (see set_x_data ). Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical private pure function using_default_data (self) True if the followed position is the trajectories' positions ( set_default_data ). Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value logical private  function wrapped_time (self, t) result(tw) For FOLLOW_LOOP, t wrapped into the combined time range of the trajectories. Arguments Type Intent Optional Attributes Name type( TrajectoryFollower ), intent(in) :: self real(kind=wp), intent(in) :: t Return Value real(kind=wp) Subroutines private  subroutine add_trajectory (self, traj) Also follow traj (no effect if it is already followed). Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self type( Trajectory ), intent(in), pointer :: traj private  subroutine interpolate_attitude (traj, t, status, index, attitude, ok) Slerp of the attitude at time t; the first/last attitude outside the time\nrange. status and index : the trajectory's time_index for t. Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(in) :: traj real(kind=wp), intent(in) :: t integer, intent(in) :: status integer, intent(in) :: index real(kind=wp), intent(inout) :: attitude (4) quaternion [x, y, z, w] logical, intent(out) :: ok false if there is no attitude (attitude unchanged) private  subroutine interpolate_position (traj, sources, t, status, index, position, ok) Linear interpolation of the position (from sources ) at time t; the\nfirst/last point outside the time range. status and index : the\ntrajectory's time_index for t. Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(in) :: traj type( DataSource ), intent(in) :: sources (3) real(kind=wp), intent(in) :: t integer, intent(in) :: status integer, intent(in) :: index real(kind=wp), intent(inout) :: position (3) logical, intent(out) :: ok false if there is no position (position unchanged) private  subroutine remove_all (self) Stop following all trajectories. Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self private  subroutine remove_trajectory (self, traj) Stop following traj . Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self type( Trajectory ), intent(in), pointer :: traj private  subroutine set_default_data (self) Use the trajectories' positions (per the first trajectory's DOF). Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self private  subroutine set_follow_type (self, data, mode) What to follow (FOLLOW_POSITION and/or FOLLOW_ATTITUDE, combined with\nior) and how (FOLLOW_LOOP or FOLLOW_LIMIT). Arguments Type Intent