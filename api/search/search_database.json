y_matrix () if (. not . associated ( self % frame )) return f = frame_to_root ( self , self % frame ) if ( self % frame_type == ABSOLUTE_FRAME ) then m = translation_matrix ( - f ( 1 : 3 , 4 )) else m = rigid_inverse ( f ) end if if (. not . associated ( self % lookat )) return ! the look-at frame's origin in the view frame, turned onto +y f = frame_to_root ( self , self % lookat ) rel = matmul ( m ( 1 : 3 , 1 : 3 ), f ( 1 : 3 , 4 )) + m ( 1 : 3 , 4 ) if ( norm2 ( rel ) <= eps ) return if ( self % rotation_type == VIEW_DIRECT ) then m = rotated ( quat_to_matrix ( quat_from_vectors ( rel , [ 0.0_wp , 1.0_wp , 0.0_wp ])), m ) else xy = [ rel ( 1 ), rel ( 2 ), 0.0_wp ] len = norm2 ( xy ) if ( len > eps ) m = rotated ( quat_to_matrix ( quat_from_vectors ( xy , [ 0.0_wp , 1.0_wp , 0.0_wp ])), m ) r = quat_to_matrix ( quat_from_vectors ([ 0.0_wp , len , rel ( 3 )], [ 0.0_wp , 1.0_wp , 0.0_wp ])) m = rotated ( r , m ) end if end function world_to_view","tags":"","url":"proc/world_to_view.html"},{"title":"camera_orientation – vkframes","text":"private pure subroutine camera_orientation(cam, q, d) A camera's orientation (columns: right, up, back, as a quaternion) and\nits distance from eye to center (at least a tiny one). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: cam (3,3) (columns: eye, center, up) real(kind=wp), intent(out) :: q (4) orientation quaternion [x, y, z, w] real(kind=wp), intent(out) :: d distance from eye to center Calls proc~~camera_orientation~~CallsGraph proc~camera_orientation camera_orientation proc~cross cross proc~camera_orientation->proc~cross proc~quat_from_matrix quat_from_matrix proc~camera_orientation->proc~quat_from_matrix Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~camera_orientation~~CalledByGraph proc~camera_orientation camera_orientation proc~camera_between camera_between proc~camera_between->proc~camera_orientation proc~fly fly proc~fly->proc~camera_between proc~place_camera place_camera proc~place_camera->proc~fly proc~frame WindowProxy%frame proc~frame->proc~place_camera proc~resize WindowProxy%resize proc~resize->proc~frame proc~run WindowProxy%run proc~run->proc~frame Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine camera_orientation ( cam , q , d ) real ( wp ), intent ( in ) :: cam ( 3 , 3 ) !! (columns: eye, center, up) real ( wp ), intent ( out ) :: q ( 4 ) !! orientation quaternion [x, y, z, w] real ( wp ), intent ( out ) :: d !! distance from eye to center real ( wp ) :: f ( 3 ), r ( 3 ), m ( 3 , 3 ) f = cam (:, 2 ) - cam (:, 1 ) d = norm2 ( f ) if ( d > 0.0_wp ) then f = f / d else f = [ 0.0_wp , 1.0_wp , 0.0_wp ] end if d = max ( d , tiny ( 1.0_wp ) * 1.0e10_wp ) r = cross ( f , cam (:, 3 )) if ( norm2 ( r ) < 1.0e-12_wp ) r = cross ( f , [ 0.0_wp , 0.0_wp , 1.0_wp ]) ! (up along the view: any) if ( norm2 ( r ) < 1.0e-12_wp ) r = cross ( f , [ 1.0_wp , 0.0_wp , 0.0_wp ]) r = r / norm2 ( r ) m (:, 1 ) = r m (:, 2 ) = cross ( r , f ) m (:, 3 ) = - f q = quat_from_matrix ( m ) end subroutine camera_orientation","tags":"","url":"proc/camera_orientation.html"},{"title":"clear_default_view_parameters – vkframes","text":"private  subroutine clear_default_view_parameters(self) Forget the camera set by set_default_view_parameters (back to the default view distance). Type Bound View Arguments Type Intent Optional Attributes Name class( View ), intent(inout) :: self Source Code subroutine clear_default_view_parameters ( self ) class ( View ), intent ( inout ) :: self self % default_eye = 0.0_wp self % default_center = 0.0_wp self % default_up = 0.0_wp end subroutine clear_default_view_parameters","tags":"","url":"proc/clear_default_view_parameters.html"},{"title":"default_view_parameters – vkframes","text":"private pure subroutine default_view_parameters(self, eye, center, up) The camera after a reset (view-frame coordinates; all zero if none is set). Type Bound View Arguments Type Intent Optional Attributes Name class( View ), intent(in) :: self real(kind=wp), intent(out) :: eye (3) real(kind=wp), intent(out) :: center (3) real(kind=wp), intent(out) :: up (3) Source Code pure subroutine default_view_parameters ( self , eye , center , up ) class ( View ), intent ( in ) :: self real ( wp ), intent ( out ) :: eye ( 3 ), center ( 3 ), up ( 3 ) eye = self % default_eye center = self % default_center up = self % default_up end subroutine default_view_parameters","tags":"","url":"proc/default_view_parameters.html"},{"title":"home – vkframes","text":"private  subroutine home(self, aspect, eye, center, up) The default camera (eye, center, up in view-frame coordinates) for a\nviewport of aspect ratio aspect (width / height): OpenFrames' resetView. Type Bound View Arguments Type Intent Optional Attributes Name class( View ), intent(in) :: self real(kind=wp), intent(in) :: aspect viewport width / height real(kind=wp), intent(out) :: eye (3) real(kind=wp), intent(out) :: center (3) real(kind=wp), intent(out) :: up (3) Calls proc~~home~~CallsGraph proc~home View%home proc~bound ReferenceFrame%bound proc~home->proc~bound proc~frame_to_root frame_to_root proc~home->proc~frame_to_root proc~world_to_view View%world_to_view proc~home->proc~world_to_view proc~rigid_inverse rigid_inverse proc~frame_to_root->proc~rigid_inverse proc~world_matrix ReferenceFrame%world_matrix proc~frame_to_root->proc~world_matrix proc~world_to_view->proc~frame_to_root proc~identity_matrix identity_matrix proc~world_to_view->proc~identity_matrix proc~quat_from_vectors quat_from_vectors proc~world_to_view->proc~quat_from_vectors proc~quat_to_matrix quat_to_matrix proc~world_to_view->proc~quat_to_matrix proc~world_to_view->proc~rigid_inverse proc~rotated rotated proc~world_to_view->proc~rotated proc~translation_matrix translation_matrix proc~world_to_view->proc~translation_matrix proc~cross cross proc~quat_from_vectors->proc~cross proc~quat_normalize quat_normalize proc~quat_from_vectors->proc~quat_normalize proc~translation_matrix->proc~identity_matrix proc~world_matrix->proc~world_matrix proc~local_matrix ReferenceFrame%local_matrix proc~world_matrix->proc~local_matrix proc~frame_matrix frame_matrix proc~local_matrix->proc~frame_matrix proc~frame_matrix->proc~quat_to_matrix Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~home~~CalledByGraph proc~home View%home proc~place_camera place_camera proc~place_camera->proc~home proc~frame WindowProxy%frame proc~frame->proc~place_camera proc~resize WindowProxy%resize proc~resize->proc~frame proc~run WindowProxy%run proc~run->proc~frame Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine home ( self , aspect , eye , center , up ) class ( View ), intent ( in ) :: self real ( wp ), intent ( in ) :: aspect !! viewport width / height real ( wp ), intent ( out ) :: eye ( 3 ), center ( 3 ), up ( 3 ) real ( wp ) :: c ( 3 ), r , dist , half_fovy , half_fovx , m ( 4 , 4 ) if ( norm2 ( self % default_up ) /= 0.0_wp ) then eye = self % default_eye center = self % default_center up = self % default_up return end if c = 0.0_wp r = 0.0_wp if ( associated ( self % frame )) then call self % frame % bound ( c , r ) m = matmul ( self % world_to_view (), frame_to_root ( self , self % frame )) ! frame to view frame c = matmul ( m ( 1 : 3 , 1 : 3 ), c ) + m ( 1 : 3 , 4 ) end if if ( self % default_distance > 0.0_wp ) then r = self % default_distance else if ( r <= 0.0_wp ) then r = 1.0_wp end if dist = 2.0_wp * r if ( self % projection == PERSPECTIVE ) then half_fovy = 0.5_wp * self % fovy * pi / 18 0.0_wp half_fovx = atan ( aspect * tan ( half_fovy )) dist = r / sin ( min ( half_fovy , half_fovx )) end if center = c eye = c + [ 0.0_wp , - dist , 0.0_wp ] up = [ 0.0_wp , 0.0_wp , 1.0_wp ] end subroutine home","tags":"","url":"proc/home.html"},{"title":"reset_view – vkframes","text":"private  subroutine reset_view(self) Put the camera back at the default position (applied at t