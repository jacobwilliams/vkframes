d=wp), intent(in) :: p (3) the point (frame coordinates) procedure, public :: move_x_axis private  subroutine move_x_axis (self, base, length, head_ratio, body_radius, head_radius) Place the x axis vector: from base , length long, with a head of head_ratio of the length (default 0.3) and body and head radii (default\n0.05 and 0.1 of the length); its label is at the tip, 0.4 of the length\ntall (at most label_size pixels). As OpenFrames' moveXAxis. Set before\nthe frame is first shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) (base: frame's coordinates) real(kind=wp), intent(in) :: length (base: frame's coordinates) real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_y_axis private  subroutine move_y_axis (self, base, length, head_ratio, body_radius, head_radius) Place the y axis vector (as move_x_axis ; OpenFrames' moveYAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_z_axis private  subroutine move_z_axis (self, base, length, head_ratio, body_radius, head_radius) Place the z axis vector (as move_x_axis ; OpenFrames' moveZAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: name private  function name (self) result(n) The frame's name ('' if none). Arguments Type In