elf % chain % draw_range ( 2 * self % first_drawn_ - 1 , 2 * ( self % first_drawn_ + self % n_drawn - 1 )) end subroutine segment_update","tags":"","url":"proc/segment_update.html"},{"title":"set_auto_attenuate – vkframes","text":"private  subroutine set_auto_attenuate(self, attenuate) Shrink markers farther from the camera than the trajectory's size\n(OpenFrames' auto-attenuation; see shaders/marker.vert). On by default\n(OpenFrames': off). Type Bound MarkerArtist Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self logical, intent(in) :: attenuate Calls proc~~set_auto_attenuate~~CallsGraph proc~set_auto_attenuate MarkerArtist%set_auto_attenuate proc~marker_style marker_style proc~set_auto_attenuate->proc~marker_style proc~is_colored LineChain%is_colored proc~marker_style->proc~is_colored proc~set_marker_style LineChain%set_marker_style proc~marker_style->proc~set_marker_style proc~apply_style~2 apply_style proc~set_marker_style->proc~apply_style~2 interface~vkf_line_set_dash_mode vkf_line_set_dash_mode proc~apply_style~2->interface~vkf_line_set_dash_mode interface~vkf_line_set_highlight vkf_line_set_highlight proc~apply_style~2->interface~vkf_line_set_highlight interface~vkf_line_set_trail vkf_line_set_trail proc~apply_style~2->interface~vkf_line_set_trail proc~check_status check_status proc~apply_style~2->proc~check_status proc~line_set_pattern line_set_pattern proc~apply_style~2->proc~line_set_pattern proc~line_set_style line_set_style proc~apply_style~2->proc~line_set_style proc~marker_set_style marker_set_style proc~apply_style~2->proc~marker_set_style interface~vkf_line_style vkf_line_style proc~line_set_pattern->interface~vkf_line_style interface~vkf_line_style_changed vkf_line_style_changed proc~line_set_pattern->interface~vkf_line_style_changed proc~line_set_style->interface~vkf_line_style proc~line_set_style->interface~vkf_line_style_changed proc~marker_set_style->interface~vkf_line_style proc~marker_set_style->interface~vkf_line_style_changed Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_auto_attenuate ( self , attenuate ) class ( MarkerArtist ), intent ( inout ) :: self logical , intent ( in ) :: attenuate self % attenuate = attenuate call marker_style ( self ) end subroutine set_auto_attenuate","tags":"","url":"proc/set_auto_attenuate.html"},{"title":"set_end_relative – vkframes","text":"private  subroutine set_end_relative(self, relative) Relative ends (default false): each segment ends at its start plus the\nend sources' values (a vector drawn from each point), not at them. Type Bound SegmentArtist Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self logical, intent(in) :: relative Source Code subroutine set_end_relative ( self , relative ) class ( SegmentArtist ), intent ( inout ) :: self logical , intent ( in ) :: relative if ( relative . eqv . self % end_relative_ ) return self % end_relative_ = relative self % seen_generation = - 1 ! (all segments written again) end subroutine set_end_relative","tags":"","url":"proc/set_end_relative.html"},{"title":"set_end_scale – vkframes","text":"private  subroutine set_end_scale(self, scale) Set the scale of all three end sources (with relative ends: the length\ndrawn per unit of the stored vector, e.g. km per newton). Only this\nartist's segments are written again. Type Bound SegmentArtist Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self real(kind=wp), intent(in) :: scale Source Code subroutine set_end_scale ( self , scale ) class ( SegmentArtist ), intent ( inout ) :: self real ( wp ), intent ( in ) :: scale if ( all ( self % end_ % scale == scale )) return self % end_ % scale = scale self % default_data = . false . self % seen_generation = - 1 end subroutine set_end_scale","tags":"","url":"proc/set_end_scale.html"},{"title":"set_intermediate_direction – vkframes","text":"private  subroutine set_intermediate_direction(self, direction) Count intermediate markers from the start (MARKER_START, default) or\nfrom the end (MARKER_END; recomputed whenever points are added). Type Bound MarkerArtist Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: direction Calls proc~~set_intermediate_direction~~CallsGraph proc~set_intermediate_direction MarkerArtist%set_intermediate_direction proc~redraw_markers redraw_markers proc~set_intermediate_direction->proc~redraw_markers Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_intermediate_direction ( self , direction ) class ( MarkerArtist ), intent ( inout ) :: self integer , intent ( in ) :: direction if ( direction == self % direction_ ) return self % direction_ = merge ( MARKER_END , MARKER_START , direction == MARKER_END ) call redraw_markers ( self ) end subroutine set_intermediate_direction","tags":"","url":"proc/set_intermediate_direction.html"},{"title":"set_intermediate_spacing – vkframes","text":"private  subroutine set_intermediate_spacing(self, spacing) Spacing of intermediate markers (> 0): time units, arc length, or a\nnumber of data points (rounded down, at least 1). Type Bound MarkerArtist Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self real(kind=wp), intent(in) :: spacing Calls proc~~set_intermediate_spacing~~CallsGraph proc~set_intermediate_spacing MarkerArtist%set_intermediate_spacing proc~redraw_markers redraw_markers proc~set_intermediate_spacing->proc~redraw_markers Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_intermediate_spacing ( self , spacing ) class ( MarkerArtist ), intent ( inout ) :: self real ( wp ), intent ( in ) :: spacing if ( spacing <= 0.0_wp . or . spacing == self % spacing_ ) return self % spacing_ = spacing call redraw_markers ( self ) end subroutine set_intermediate_spacing","tags":"","url":"proc/set_intermediate_spacing.html"},{"title":"set_intermediate_type – vkframes","text":"private  subroutine set_intermediate_type(self, type) Type Bound MarkerArtist Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: type Calls proc~~set_intermediate_type~~CallsGraph proc~set_intermediate_type MarkerArtist%set_intermediate_type proc~redraw_markers redraw_markers proc~set_intermediate_type->proc~redraw_markers Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_intermediate_type ( self , type ) class ( MarkerArtist ), intent ( inout ) :: self integer , intent ( in ) :: type if ( type == self % intermediate_type_ ) return self % intermediate_type_ = type call redraw_markers ( self ) end subroutine set_intermediate_type","tags":"","url":"proc/set_intermediate_type.html"},{"title":"set_level_of_detail – vkframes","text":"private  subroutine set_level_of_detail(self, enabled) Level of detail (default on): seen from far away, the curve is drawn\nfrom every 2nd, 4th, ... point (and its last), as many as can be\nskipped while staying within half a pixel of all of them, chosen per\nview and per chunk of points. Off: every point is drawn. Type Bound CurveArtist Arguments Type Intent Optional Attributes Name class( CurveArtist ), intent(inout) :: self logical, intent(in) :: enabled Calls proc~~set_level_of_detail~~CallsGraph proc~set_level_of_detail CurveArtist%set_level_of_detail set_lod set_lod proc~set_level_of_detail->set_lod Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_level_of_detail ( self , enabled ) class ( CurveArtist ), intent ( inout ) :: self logical , intent ( in ) :: enabled self % lod_ = enabled call self % chain % set_lod ( enabled ) end subroutine set_level_of_detail","tags":"","url":"proc/set_level_of_detail.html"},{"title":"set_marker_color – vkframes","text":"private  subroutine set_marker_color(self, which, color) The color of the markers in which (an ior of MARKER_* flags): [r, g,\nb] (alpha unchanged) or [r, g, b, a]. Type Bound MarkerArtist Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: which real(kind=wp), intent(in) :: color (:) Calls proc~~set_marker_color~~CallsGraph proc~set_marker_color MarkerArtist%set_marker_color proc~marker_style marker_style proc~set_marker_color->proc~marker_style proc~set_rgba set_rgba proc~set_marker_color->proc~set_rgba proc~is_colored LineChain%is_colored proc~marker_style->proc~is_colored proc~set_marker_style LineChain%set_marker_style proc~marker_style->proc~set_marker_style proc~apply_style~2 apply_style proc~set_marker_style->proc~apply_style~2 interface~vkf_line_set_dash_mode vkf_line_set_dash_mode proc~apply_style~2->interface~vkf_line_set_dash_mode interface~vkf_line_set_highlight vkf_line_set_highlight proc~apply_style~2->interface~vkf_line_set_highlight interface~vkf_line_set_trail vkf_line_set_trail proc~apply_style~2->interface~vkf_line_set_trail proc~check_status check_status proc~apply_style~2->proc~check_status proc~line_set_pattern line_set_pattern proc~apply_style~2->proc~line_set_pattern proc~line_set_style line_set_style proc~apply_style~2->proc~line_set_style proc~marker_set_style marker_set_style proc~apply_style~2->proc~marker_set_style interface~vkf_line_style vkf_line_style proc~line_set_pattern->interface~vkf_line_style interface~vkf_line_style_changed vkf_line_style_changed proc~line_set_pattern->interface~vkf_line_style_changed proc~line_set_style->interface~vkf_line_style proc~line_set_style->interface~vkf_line_style_changed proc~marker_set_style->interface~vkf_line_style proc~marker_set_style->interface~vkf_line_style_changed Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~set_marker_color~~CalledByGraph proc~set_marker_color MarkerArtist%set_marker_color proc~new_marker_artist new_marker_artist proc~new_marker_artist->proc~set_marker_color interface~markerartist MarkerArtist interface~markerartist->proc~new_marker_artist Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_marker_color ( self , which , color ) class ( MarkerArtist ), intent ( inout ) :: self integer , intent ( in ) :: which real ( wp ), intent ( in ) :: color (:) if ( iand ( which , MARKER_START ) /= 0 ) call set_rgba ( self % start_color , color ) if ( iand ( which , MARKER_END ) /= 0 ) call set_rgba ( self % end_color , color ) if ( iand ( which , MARKER_INTERMEDIATE ) /= 0 ) call set_rgba ( self % intermediate_color , color ) call marker_style ( self ) end subroutine set_marker_color","tags":"","url":"proc/set_marker_color.html"},{"title":"set_marker_shape – vkframes","text":"private  subroutine set_marker_shape(self, shape) Marker shape: a MARKER_ shape constant (MARKER_DISK to MARKER_SPIRAL;\nMARKER_IMAGE after set_marker_image). These are OpenFrames' disk and its\nmarker shaders (Demos/Shaders/Marker_ .frag), built in. Type Bound MarkerArtist Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: shape Calls proc~~set_marker_shape~~CallsGraph proc~set_marker_shape MarkerArtist%set_marker_shape proc~marker_style marker_style proc~set_marker_shape->proc~marker_style proc~is_colored LineChain%is_colored proc~marker_style->proc~is_colored proc~set_marker_style LineChain%set_marker_style proc~marker_style->proc~set_marker_style proc~apply_style~2 apply_style proc~set_marker_style->proc~apply_style~2 interface~vkf_line_set_dash_mode vkf_line_set_dash_mode proc~apply_style~2->interface~vkf_line_set_dash_mode interface~vkf_line_set_highlight vkf_line_set_highlight proc~apply_style~2->interface~vkf_line_set_highlight interface~vkf_line_set_trail vkf_line_set_trail proc~apply_style~2->interface~vkf_line_set_trail proc~check_status check_status proc~apply_style~2->proc~check_status proc~line_set_pattern line_set_pattern proc~apply_style~2->proc~line_set_pattern proc~line_set_style line_set_style proc~apply_style~2->proc~line_set_style proc~marker_set_style marker_set_style proc~apply_style~2->proc~marker_set_style interface~vkf_line_style vkf_line_style proc~line_set_pattern->interface~vkf_line_style interface~vkf_line_style_changed vkf_line_style_changed proc~line_set_pattern->interface~vkf_line_style_changed proc~line_set_style->interface~vkf_line_style proc~line_set_style->interface~vkf_line_style_changed proc~marker_set_style->interface~vkf_line_style proc~marker_set_style->interface~vkf_line_style_changed Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_marker_shape ( self , shape ) class ( MarkerArtist ), intent ( inout ) :: self integer , intent ( in ) :: shape self % shape_ = max ( MARKER_DISK , min ( MARKER_IMAGE , shape )) call marker_style ( self ) end subroutine set_marker_shape","tags":"","url":"proc/set_marker_shape.html"},{"title":"set_marker_size – vkframes","text":"private  subroutine set_marker_size(self, size) Marker size in window units (logical pixels; > 0). Type Bound MarkerArtist Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self real(kind=wp), intent(in) :: size Calls proc~~set_marker_size~~CallsGraph proc~set_marker_size MarkerArtist%set_marker_size proc~marker_style marker_style proc~set_marker_size->proc~marker_style proc~is_colored LineChain%is_colored proc~marker_style->proc~is_colored proc~set_marker_style LineChain%set_marker_style proc~marker_style->proc~set_marker_style proc~apply_style~2 apply_style proc~set_marker_style->proc~apply_style~2 interface~vkf_line_set_dash_mode vkf_line_set_dash_mode proc~apply_style~2->interface~vkf_line_set_dash_mode interface~vkf_line_set_highlight vkf_line_set_highlight proc~apply_style~2->interface~vkf_line_set_highlight interface~vkf_line_set_trail vkf_line_set_trail proc~apply_style~2->interface~vkf_line_set_trail proc~check_status check_status proc~apply_style~2->proc~check_status proc~line_set_pattern line_set_pattern proc~apply_style~2->proc~line_set_pattern proc~line_set_style line_set_style proc~apply_style~2->proc~line_set_style proc~marker_set_style marker_set_style proc~apply_style~2->proc~marker_set_style interface~vkf_line_style vkf_line_style proc~line_set_pattern->interface~vkf_line_style interface~vkf_line_style_changed vkf_line_style_changed proc~line_set_pattern->interface~vkf_line_style_changed proc~line_set_style->interface~vkf_line_style proc~line_set_style->interface~vkf_line_style_changed proc~marker_set_style->interface~vkf_line_style proc~marker_set_style->interface~vkf_line_style_changed Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_marker_size ( self , size ) class ( MarkerArtist ), intent ( inout ) :: self real ( wp ), intent ( in ) :: size if ( size <= 0.0_wp ) return self % size_ = size call marker_style ( self ) end subroutine set_marker_size","tags":"","url":"proc/set_marker_size.html"},{"title":"set_markers – vkframes","text":"private  subroutine set_markers(self, markers) Which markers to draw: an ior of MARKER_START, MARKER_INTERMEDIATE and\nMARKER_END (0 for none). Type Bound MarkerArtist Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: markers Calls proc~~set_markers~~CallsGraph proc~set_markers MarkerArtist%set_markers proc~redraw_markers redraw_markers proc~set_markers->proc~redraw_markers Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_markers ( self , markers ) class ( MarkerArtist ), intent ( inout ) :: self integer , intent ( in ) :: markers if ( markers == self % markers_ ) return self % markers_ = markers call redraw_markers ( self ) end subroutine set_markers","tags":"","url":"proc/set_markers.html"},{"title":"set_point_colors – vkframes","text":"private  subroutine set_point_colors(self, enabled) Whether a trajectory with colors is drawn in them (default true); points\nwithout a color yet (colors arriving after positions) in the artist's\ncolor. A curve: each segment blended from its first point's color to its\nsecond's (with level of detail, a color lasting fewer points than are\nskipped may not show from far away); a surface: each point's pair in its\ncolor, times the artist's alpha. False: all in the artist's color. Type Bound ChainArtist Arguments Type Intent Optional Attributes Name class( ChainArtist ), intent(inout) :: self logical, intent(in) :: enabled true: the trajectory's colors Source Code subroutine set_point_colors ( self , enabled ) class ( ChainArtist ), intent ( inout ) :: self logical , intent ( in ) :: enabled !! true: the trajectory's colors self % point_colors_ = enabled end subroutine set_point_colors","tags":"","url":"proc/set_point_colors.html"},{"title":"set_stride – vkframes","text":"private  subroutine set_stride(self, stride) Draw a segment at points 1, 1 + stride, 1 + 2 stride, ... (stride >= 1). Type Bound SegmentArtist Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self integer, intent(in) :: stride Called by proc~~set_stride~~CalledByGraph proc~set_stride SegmentArtist%set_stride proc~new_segment_artist new_segment_artist proc~new_segment_artist->proc~set_stride interface~segmentartist SegmentArtist interface~segmentartist->proc~new_segment_artist Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_stride ( self , stride ) class ( SegmentArtist ), intent ( inout ) :: self integer , intent ( in ) :: stride if ( max ( 1 , stride ) == self % stride_ ) return self % stride_ = max ( 1 , stride ) self % seen_generation = - 1 end subroutine set_stride","tags":"","url":"proc/set_stride.html"},{"title":"set_trace_mode – vkframes","text":"private  subroutine set_trace_mode(self, enabled) Draw only the part up to the current time (see the module documentation). Type Bound TrajectoryArtist Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(inout) :: self logical, intent(in) :: enabled Source Code subroutine set_trace_mode ( self , enabled ) class ( TrajectoryArtist ), intent ( inout ) :: self logical , intent ( in ) :: enabled self % trace = enabled end subroutine set_trace_mode","tags":"","url":"proc/set_trace_mode.html"},{"title":"set_trail – vkframes","text":"private  subroutine set_trail(self, past, future, fade) A trail (see the module documentation): only the part within past before the current time and future after it (s, >= 0; 0: none of\nit; huge(1.0_wp): no limit), each fading out over the last fade (0\nto 1, default 0.25) of its window toward its cutoff. Replaces trace\nmode while set. Type Bound CurveArtist Arguments Type Intent Optional Attributes Name class( CurveArtist ), intent(inout) :: self real(kind=wp), intent(in) :: past s before and after the current time real(kind=wp), intent(in) :: future s before and after the current time real(kind=wp), intent(in), optional :: fade of each part's window (default 0.25) Source Code subroutine set_trail ( self , past , future , fade ) class ( CurveArtist ), intent ( inout ) :: self real ( wp ), intent ( in ) :: past , future !! s before and after the current time real ( wp ), intent ( in ), optional :: fade !! of each part's window (default 0.25) self % trail_ % on = . true . self % trail_ % past = max ( 0.0_wp , past ) self % trail_ % future = max ( 0.0_wp , future ) if ( present ( fade )) self % trail_ % fade = max ( 0.0_wp , min ( 1.0_wp , fade )) self % tail_time = huge ( 1.0_wp ) ! (drawn again at the next update) end subroutine set_trail","tags":"","url":"proc/set_trail.html"},{"title":"set_trail_style – vkframes","text":"private  subroutine set_trail_style(self, which, color, opacity, factor, pattern) The style of a trail's part, which TRAIL_PAST or TRAIL_FUTURE: color ([r, g, b] or [r, g, b, a]: drawn in it instead of the line's\ncolors), opacity (its alpha multiplied by it: translucency, default\n1), a dash pattern ( factor and 16 pattern bits, as set_pattern;\ndefault solid). Settings not given are kept. Type Bound CurveArtist Arguments Type Intent Optional Attributes Name class( CurveArtist ), intent(inout) :: self integer, intent(in) :: which TRAIL_PAST or TRAIL_FUTURE real(kind=wp), intent(in), optional :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) real(kind=wp), intent(in), optional :: opacity 0 to 1 integer, intent(in), optional :: factor window units per bit (>= 1), 16 bits integer, intent(in), optional :: pattern window units per bit (>= 1), 16 bits Calls proc~~set_trail_style~~CallsGraph proc~set_trail_style CurveArtist%set_trail_style proc~set_rgba set_rgba proc~set_trail_style->proc~set_rgba Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_trail_style ( self , which , color , opacity , factor , pattern ) class ( CurveArtist ), intent ( inout ) :: self integer , intent ( in ) :: which !! TRAIL_PAST or TRAIL_FUTURE real ( wp ), intent ( in ), optional :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) real ( wp ), intent ( in ), optional :: opacity !! 0 to 1 integer , intent ( in ), optional :: factor , pattern !! window units per bit (>= 1), 16 bits integer :: k k = merge ( 1 , 2 , which == TRAIL_PAST ) if ( present ( color )) then call set_rgba ( self % trail_ % color (:, k ), color ) self % trail_ % replace ( k ) = . true . end if if ( present ( opacity )) self % trail_ % opacity ( k ) = max ( 0.0_wp , min ( 1.0_wp , opacity )) if ( present ( factor )) self % trail_ % factor ( k ) = max ( 1 , factor ) if ( present ( pattern )) self % trail_ % pattern ( k ) = iand ( pattern , int ( z 'FFFF' )) self % tail_time = huge ( 1.0_wp ) end subroutine set_trail_style","tags":"","url":"proc/set_trail_style.html"},{"title":"set_trajectory – vkframes","text":"private  subroutine set_trajectory(self, traj) Draw traj (it must stay alive while drawn). Type Bound TrajectoryArtist Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(inout) :: self type( Trajectory ), intent(in), target :: traj Source Code subroutine set_trajectory ( self , traj ) class ( TrajectoryArtist ), intent ( inout ) :: self type ( Trajectory ), intent ( in ), target :: traj self % traj => traj self % seen_generation = - 1 ! redraw end subroutine set_trajectory","tags":"","url":"proc/set_trajectory~2.html"},{"title":"tail_colors – vkframes","text":"private  subroutine tail_colors(self, k, k2, frac) The tail's colors: from point k's to the color at frac along to point\nk2's (white, showing the style's color, if the chain has none). Arguments Type Intent Optional Attributes Name type( CurveArtist ), intent(inout) :: self integer, intent(in) :: k integer, intent(in) :: k2 real(kind=wp), intent(in) :: frac Calls proc~~tail_colors~~CallsGraph proc~tail_colors tail_colors interface~vkf_line_colors vkf_line_colors proc~tail_colors->interface~vkf_line_colors is_colored is_colored proc~tail_colors->is_colored proc~point_rgba point_rgba proc~tail_colors->proc~point_rgba color color proc~point_rgba->color num_colors num_colors proc~point_rgba->num_colors Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~tail_colors~~CalledByGraph proc~tail_colors tail_colors proc~update_tail CurveArtist%update_tail proc~update_tail->proc~tail_colors Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine tail_colors ( self , k , k2 , frac ) type ( CurveArtist ), intent ( inout ) :: self integer , intent ( in ) :: k , k2 real ( wp ), intent ( in ) :: frac real ( c_float ), dimension (:,:), pointer :: c real ( wp ) :: c0 ( 4 ), c1 ( 4 ) integer ( c_int ) :: capacity type ( c_ptr ) :: data data = vkf_line_colors ( self % tail , capacity ) if (. not . c_associated ( data ) . or . capacity < 2 ) return call c_f_pointer ( data , c , [ 4 , 2 ]) if ( self % chain % is_colored ()) then c0 = point_rgba ( self , k ) c1 = point_rgba ( self , k2 ) c (:, 1 ) = real ( c0 , c_float ) c (:, 2 ) = real ( c0 + frac * ( c1 - c0 ), c_float ) else c = 1.0_c_float end if end subroutine tail_colors","tags":"","url":"proc/tail_colors.html"},{"title":"tail_ends – vkframes","text":"private  subroutine tail_ends(traj, n, i1, i2, k, k2) Trace mode's tail, for the points passed i1 .. i2 of the n written: from\nthe latest passed (k) toward the next in time (k2: i2 + 1, or i1 - 1 for\ndecreasing times); none (0, 0) without a trajectory. Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(in), pointer :: traj the trajectory (null: none) integer, intent(in) :: n the points written integer, intent(in) :: i1 the points passed integer, intent(in) :: i2 the points passed integer, intent(out) :: k the tail's ends integer, intent(out) :: k2 the tail's ends Calls proc~~tail_ends~~CallsGraph proc~tail_ends tail_ends proc~decreasing_times decreasing_times proc~tail_ends->proc~decreasing_times Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~tail_ends~~CalledByGraph proc~tail_ends tail_ends proc~draw_written draw_written proc~draw_written->proc~tail_ends proc~chain_update ChainArtist%chain_update proc~chain_update->proc~draw_written proc~curve_update CurveArtist%curve_update proc~curve_update->proc~draw_written Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine tail_ends ( traj , n , i1 , i2 , k , k2 ) type ( Trajectory ), pointer , intent ( in ) :: traj !! the trajectory (null: none) integer , intent ( in ) :: n !! the points written integer , intent ( in ) :: i1 , i2 !! the points passed integer , intent ( out ) :: k , k2 !! the tail's ends k = 0 k2 = 0 if (. not . associated ( traj )) return if ( decreasing_times ( traj , n )) then k = i1 k2 = i1 - 1 else k = i2 k2 = i2 + 1 end if end subroutine tail_ends","tags":"","url":"proc/tail_ends.html"},{"title":"trace_range – vkframes","text":"private  subroutine trace_range(traj, t, n, i1, i2) The points of 1 .. n whose times are at most t (trace mode): i1 .. i2\n(none: i2 < i1), the first points for increasing times, the last for\ndecreasing ones (by bisection). Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(in) :: traj real(kind=wp), intent(in) :: t integer, intent(in) :: n integer, intent(out) :: i1 integer, intent(out) :: i2 Calls proc~~trace_range~~CallsGraph proc~trace_range trace_range proc~decreasing_times decreasing_times proc~trace_range->proc~decreasing_times Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~trace_range~~CalledByGraph proc~trace_range trace_range proc~draw_written draw_written proc~draw_written->proc~trace_range proc~segment_update SegmentArtist%segment_update proc~segment_update->proc~trace_range proc~chain_update ChainArtist%chain_update proc~chain_update->proc~draw_written proc~curve_update CurveArtist%curve_update proc~curve_update->proc~draw_written Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine trace_range ( traj , t , n , i1 , i2 ) type ( Trajectory ), intent ( in ) :: traj real ( wp ), intent ( in ) :: t integer , intent ( in ) :: n integer , intent ( out ) :: i1 , i2 integer :: low , high , mid i1 = 1 i2 = 0 if ( n < 1 ) return low = 0 high = n + 1 if (. not . decreasing_times ( traj , n )) then ! points 1 .. low have times <= t do while ( high - low > 1 ) mid = ( low + high ) / 2 if ( traj % time ( mid ) <= t ) then low = mid else high = mid end if end do i2 = low else ! points high .. n have times <= t do while ( high - low > 1 ) mid = ( low + high ) / 2 if ( traj % time ( mid ) <= t ) then high = mid else low = mid end if end do i1 = high i2 = n end if end subroutine trace_range","tags":"","url":"proc/trace_range.html"},{"title":"update_bounds – vkframes","text":"private  subroutine update_bounds(self, n, zero) The bounds of the points (for the attenuation radius: OpenFrames uses\nthe artist's bounding sphere). Arguments Type Intent Optional Attributes Name type( MarkerArtist ), intent(inout) :: self integer, intent(in) :: n logical, intent(in) :: zero all sources zero, or no trajectory: a marker at the origin Calls proc~~update_bounds~~CallsGraph proc~update_bounds update_bounds points points proc~update_bounds->points proc~marker_style marker_style proc~update_bounds->proc~marker_style proc~is_colored LineChain%is_colored proc~marker_style->proc~is_colored proc~set_marker_style LineChain%set_marker_style proc~marker_style->proc~set_marker_style proc~apply_style~2 apply_style proc~set_marker_style->proc~apply_style~2 interface~vkf_line_set_dash_mode vkf_line_set_dash_mode proc~apply_style~2->interface~vkf_line_set_dash_mode interface~vkf_line_set_highlight vkf_line_set_highlight proc~apply_style~2->interface~vkf_line_set_highlight interface~vkf_line_set_trail vkf_line_set_trail proc~apply_style~2->interface~vkf_line_set_trail proc~check_status check_status proc~apply_style~2->proc~check_status proc~line_set_pattern line_set_pattern proc~apply_style~2->proc~line_set_pattern proc~line_set_style line_set_style proc~apply_style~2->proc~line_set_style proc~marker_set_style marker_set_style proc~apply_style~2->proc~marker_set_style interface~vkf_line_style vkf_line_style proc~line_set_pattern->interface~vkf_line_style interface~vkf_line_style_changed vkf_line_style_changed proc~line_set_pattern->interface~vkf_line_style_changed proc~line_set_style->interface~vkf_line_style proc~line_set_style->interface~vkf_line_style_changed proc~marker_set_style->interface~vkf_line_style proc~marker_set_style->interface~vkf_line_style_changed Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~update_bounds~~CalledByGraph proc~update_bounds update_bounds proc~marker_update MarkerArtist%marker_update proc~marker_update->proc~update_bounds Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine update_bounds ( self , n , zero ) type ( MarkerArtist ), intent ( inout ) :: self integer , intent ( in ) :: n logical , intent ( in ) :: zero !! all sources zero, or no trajectory: a marker at the origin real ( wp ), allocatable :: v (:,:) real ( wp ) :: r if ( zero ) then self % lo = 0.0_wp self % hi = 0.0_wp else if ( n > self % n_seen ) then ! the new points, a range at a time allocate ( v ( 3 , n - self % n_seen )) call self % traj % points ( self % n_seen + 1 , n , self % sources_ , v ) if ( self % n_seen == 0 ) then self % lo = v (:, 1 ) self % hi = v (:, 1 ) end if self % lo = min ( self % lo , minval ( v , dim = 2 )) self % hi = max ( self % hi , maxval ( v , dim = 2 )) end if self % n_seen = n r = 0.5_wp * norm2 ( self % hi - self % lo ) if ( r < 1.0e-8_wp ) r = 0.0_wp ! too small: no attenuation (as OpenFrames) if ( r /= self % radius ) then self % radius = r if ( self % attenuate ) call marker_style ( self ) end if end subroutine update_bounds","tags":"","url":"proc/update_bounds.html"},{"title":"update_highlight – vkframes","text":"private  subroutine update_highlight(h, mode, color, arrow_spacing, arrow_speed, band_width, pulse_period) Change the settings given (see CurveArtist%set_highlight). Arguments Type Intent Optional Attributes Name type( HighlightStyle ), intent(inout) :: h integer, intent(in) :: mode real(kind=wp), intent(in), optional :: color (:) real(kind=wp), intent(in), optional :: arrow_spacing real(kind=wp), intent(in), optional :: arrow_speed real(kind=wp), intent(in), optional :: band_width real(kind=wp), intent(in), optional :: pulse_period Calls proc~~update_highlight~~CallsGraph proc~update_highlight update_highlight proc~set_rgba set_rgba proc~update_highlight->proc~set_rgba Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~update_highlight~~CalledByGraph proc~update_highlight update_highlight proc~curve_set_highlight CurveArtist%curve_set_highlight proc~curve_set_highlight->proc~update_highlight proc~segment_set_highlight SegmentArtist%segment_set_highlight proc~segment_set_highlight->proc~update_highlight Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine update_highlight ( h , mode , color , arrow_spacing , arrow_speed , band_width , pulse_period ) type ( HighlightStyle ), intent ( inout ) :: h integer , intent ( in ) :: mode real ( wp ), intent ( in ), optional :: color (:), arrow_spacing , arrow_speed , band_width , pulse_period h % mode = iand ( mode , HIGHLIGHT_PULSE + HIGHLIGHT_ARROWS ) if ( present ( color )) call set_rgba ( h % color , color ) if ( present ( arrow_spacing )) h % arrow_spacing = max ( arrow_spacing , 1.0_wp ) if ( present ( arrow_speed )) h % arrow_speed = arrow_speed if ( present ( band_width )) h % band_width = max ( band_width , 0.0_wp ) if ( present ( pulse_period )) h % pulse_period = max ( pulse_period , 0.05_wp ) end subroutine update_highlight","tags":"","url":"proc/update_highlight.html"},{"title":"update_ribbon_tail – vkframes","text":"private  subroutine update_ribbon_tail(self, t, k, k2) The tail: the quad from the pair at point k to the pair interpolated at\ntime t toward point k2 (as the curve's tail: none if either isn't a\npoint written). Type Bound RibbonArtist Arguments Type Intent Optional Attributes Name class( RibbonArtist ), intent(inout) :: self real(kind=wp), intent(in) :: t integer, intent(in) :: k integer, intent(in) :: k2 Calls proc~~update_ribbon_tail~~CallsGraph proc~update_ribbon_tail RibbonArtist%update_ribbon_tail interface~vkf_line_colors vkf_line_colors proc~update_ribbon_tail->interface~vkf_line_colors interface~vkf_line_points_changed vkf_line_points_changed proc~update_ribbon_tail->interface~vkf_line_points_changed interface~vkf_line_set_range vkf_line_set_range proc~update_ribbon_tail->interface~vkf_line_set_range is_colored is_colored proc~update_ribbon_tail->is_colored point point proc~update_ribbon_tail->point point_between point_between proc~update_ribbon_tail->point_between proc~check_status check_status proc~update_ribbon_tail->proc~check_status proc~line_buffer line_buffer proc~update_ribbon_tail->proc~line_buffer proc~ribbon_point_rgba ribbon_point_rgba proc~update_ribbon_tail->proc~ribbon_point_rgba proc~split_points split_points proc~update_ribbon_tail->proc~split_points time_fraction time_fraction proc~update_ribbon_tail->time_fraction interface~vkf_line_points vkf_line_points proc~line_buffer->interface~vkf_line_points color color proc~ribbon_point_rgba->color num_colors num_colors proc~ribbon_point_rgba->num_colors Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine update_ribbon_tail ( self , t , k , k2 ) class ( RibbonArtist ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t integer , intent ( in ) :: k , k2 real ( c_float ), dimension (:,:,:), pointer :: p real ( c_float ), dimension (:,:), pointer :: c real ( wp ) :: frac , xyz ( 3 , 4 ), c0 ( 4 ), c1 ( 4 ) integer ( c_int ) :: capacity type ( c_ptr ) :: data self % tail_shown = . false . if (. not . c_associated ( self % tail )) return if ( min ( k , k2 ) < 1 . or . max ( k , k2 ) > self % n_written ) then call check_status ( vkf_line_set_range ( self % tail , 1_c_int , 0_c_int ), 'trajectory artists' ) return end if frac = self % traj % time_fraction ( k , k2 , t ) xyz (:, 1 ) = self % traj % point ( k , self % start_ ) xyz (:, 2 ) = self % traj % point ( k , self % end_ ) xyz (:, 3 ) = self % traj % point_between ( k , k2 , t , self % start_ ) xyz (:, 4 ) = self % traj % point_between ( k , k2 , t , self % end_ ) call line_buffer ( self % tail , p ) if (. not . associated ( p )) return call split_points ( xyz , p (:, :, 1 : 4 )) data = vkf_line_colors ( self % tail , capacity ) if ( c_associated ( data ) . and . capacity >= 4 ) then call c_f_pointer ( data , c , [ 4 , 4 ]) if ( self % chain % is_colored ()) then c0 = ribbon_point_rgba ( self , k ) c1 = ribbon_point_rgba ( self , k2 ) c (:, 1 : 2 ) = spread ( real ( c0 , c_float ), 2 , 2 ) c (:, 3 : 4 ) = spread ( real ( c0 + frac * ( c1 - c0 ), c_float ), 2 , 2 ) else c = 1.0_c_float end if end if call check_status ( vkf_line_points_changed ( self % tail , 4_c_int ), 'trajectory artists' ) self % tail_shown = . true . end subroutine update_ribbon_tail","tags":"","url":"proc/update_ribbon_tail.html"},{"title":"update_tail – vkframes","text":"private  subroutine update_tail(self, t, k, k2) The tail: from point k (the latest passed) to the point interpolated at\ntime t toward po