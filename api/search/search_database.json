an interface in a parent module. Source Code subroutine reset_markers ( self ) type ( MarkerArtist ), intent ( inout ) :: self self % n_seen = 0 self % n_inter = 0 self % n_inter_written = 0 self % next_index = 0 ! (0: not started) end subroutine reset_markers","tags":"","url":"proc/reset_markers.html"},{"title":"ribbon_set_color – vkframes","text":"private  subroutine ribbon_set_color(self, color) The surface's color: [r, g, b] (alpha unchanged) or [r, g, b, a]; its\nalpha is the surface's opacity (also with the trajectory's colors). Type Bound RibbonArtist Arguments Type Intent Optional Attributes Name class( RibbonArtist ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) Calls proc~~ribbon_set_color~~CallsGraph proc~ribbon_set_color RibbonArtist%ribbon_set_color is_colored is_colored proc~ribbon_set_color->is_colored proc~ribbon_style RibbonArtist%ribbon_style proc~ribbon_set_color->proc~ribbon_style proc~set_rgba set_rgba proc~ribbon_set_color->proc~set_rgba proc~ribbon_style->is_colored proc~check_status check_status proc~ribbon_style->proc~check_status proc~line_set_style line_set_style proc~ribbon_style->proc~line_set_style set_style set_style proc~ribbon_style->set_style interface~vkf_line_style vkf_line_style proc~line_set_style->interface~vkf_line_style interface~vkf_line_style_changed vkf_line_style_changed proc~line_set_style->interface~vkf_line_style_changed Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine ribbon_set_color ( self , color ) class ( RibbonArtist ), intent ( inout ) :: self real ( wp ), intent ( in ) :: color (:) call set_rgba ( self % color_ , color ) call ribbon_style ( self ) if ( self % chain % is_colored ()) self % seen_generation = - 1 ! (points without colors redrawn) end subroutine ribbon_set_color","tags":"","url":"proc/ribbon_set_color.html"},{"title":"ribbon_set_trajectory – vkframes","text":"private  subroutine ribbon_set_trajectory(self, traj) Draw traj ; with the default data sources, from the origin to its\npositions (per its DOF). Type Bound RibbonArtist Arguments Type Intent Optional Attributes Name class( RibbonArtist ), intent(inout) :: self type( Trajectory ), intent(in), target :: traj Calls proc~~ribbon_set_trajectory~~CallsGraph proc~ribbon_set_trajectory RibbonArtist%ribbon_set_trajectory proc~dof Trajectory%dof proc~ribbon_set_trajectory->proc~dof proc~position_sources position_sources proc~ribbon_set_trajectory->proc~position_sources Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~ribbon_set_trajectory~~CalledByGraph proc~ribbon_set_trajectory RibbonArtist%ribbon_set_trajectory proc~new_ribbon_artist new_ribbon_artist proc~new_ribbon_artist->proc~ribbon_set_trajectory interface~ribbonartist RibbonArtist interface~ribbonartist->proc~new_ribbon_artist Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine ribbon_set_trajectory ( self , traj ) class ( RibbonArtist ), intent ( inout ) :: self type ( Trajectory ), intent ( in ), target :: traj self % traj => traj if ( self % default_data ) self % end_ = position_sources ( traj % dof ()) self % seen_generation = - 1 end subroutine ribbon_set_trajectory","tags":"","url":"proc/ribbon_set_trajectory.html"},{"title":"ribbon_style – vkframes","text":"private  subroutine ribbon_style(self) The style: the artist's color, or white with its alpha if the points'\ncolors are drawn (the shader multiplies them by it). Type Bound RibbonArtist Arguments Type Intent Optional Attributes Name class( RibbonArtist ), intent(inout) :: self Calls proc~~ribbon_style~~CallsGraph proc~ribbon_style RibbonArtist%ribbon_style is_colored is_colored proc~ribbon_style->is_colored proc~check_status check_status proc~ribbon_style->proc~check_status proc~line_set_style line_set_style proc~ribbon_style->proc~line_set_style set_style set_style proc~ribbon_style->set_style interface~vkf_line_style vkf_line_style proc~line_set_style->interface~vkf_line_style interface~vkf_line_style_changed vkf_line_style_changed proc~line_set_style->interface~vkf_line_style_changed Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~ribbon_style~~CalledByGraph proc~ribbon_style RibbonArtist%ribbon_style proc~ribbon_set_color RibbonArtist%ribbon_set_color proc~ribbon_set_color->proc~ribbon_style Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine ribbon_style ( self ) class ( RibbonArtist ), intent ( inout ) :: self real ( wp ) :: rgba ( 4 ) rgba = self % color_ if ( self % chain % is_colored ()) rgba ( 1 : 3 ) = 1.0_wp call self % chain % set_style ( rgba , 1.0_wp ) if ( c_associated ( self % tail )) & call check_status ( line_set_style ( self % tail , real ( rgba , c_float ), 1.0_c_float ), 'trajectory artists' ) end subroutine ribbon_style","tags":"","url":"proc/ribbon_style.html"},{"title":"segment_artist_pick – vkframes","text":"private  subroutine segment_artist_pick(a, frame, cam, m, hits, n) A segment artist's best hit: on the segments drawn (as drawn: relative\nends included; a segment of no length isn't drawn). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(in), target :: a class( ReferenceFrame ), intent(in), target :: frame the frame drawing it (for the hit) type( PickCamera ), intent(in) :: cam real(kind=wp), intent(in) :: m (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits are added to hits(1:n) integer, intent(inout) :: n number of hits Calls proc~~segment_artist_pick~~CallsGraph proc~segment_artist_pick segment_artist_pick num_times num_times proc~segment_artist_pick->num_times proc~add_pick_hit add_pick_hit proc~segment_artist_pick->proc~add_pick_hit proc~better better proc~segment_artist_pick->proc~better proc~drawn_segment SegmentArtist%drawn_segment proc~segment_artist_pick->proc~drawn_segment proc~segment_pick segment_pick proc~segment_artist_pick->proc~segment_pick proc~point~2 LineChain%point proc~drawn_segment->proc~point~2 proc~project project proc~segment_pick->proc~project proc~line_buffer line_buffer proc~point~2->proc~line_buffer interface~vkf_line_points vkf_line_points proc~line_buffer->interface~vkf_line_points Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~segment_artist_pick~~CalledByGraph proc~segment_artist_pick segment_artist_pick proc~drawable_pick DrawableTrajectory%drawable_pick proc~drawable_pick->proc~segment_artist_pick Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine segment_artist_pick ( a , frame , cam , m , hits , n ) class ( SegmentArtist ), intent ( in ), target :: a class ( ReferenceFrame ), intent ( in ), target :: frame !! the frame drawing it (for the hit) type ( PickCamera ), intent ( in ) :: cam real ( wp ), intent ( in ) :: m ( 4 , 4 ) !! the frame's transform to the root frame type ( PickHit ), allocatable , intent ( inout ) :: hits (:) !! hits are added to hits(1:n) integer , intent ( inout ) :: n !! number of hits real ( wp ) :: extra , a0 ( 3 ), b0 ( 3 ), px , s , depth , best_px , best_depth , best_s integer :: k , best_k type ( PickHit ) :: h if (. not . associated ( a % traj ) . or . a % n_drawn < 1 ) return extra = 0.5_wp * a % width_ * cam % pixel_ratio best_px = huge ( 1.0_wp ) best_depth = huge ( 1.0_wp ) best_k = 0 best_s = 0.0_wp do k = a % first_drawn_ , a % first_drawn_ + a % n_drawn - 1 call a % drawn_segment ( k , a0 , b0 ) if ( all ( a0 == b0 )) cycle if ( segment_pick ( cam , matmul ( m ( 1 : 3 , 1 : 3 ), a0 ) + m ( 1 : 3 , 4 ), matmul ( m ( 1 : 3 , 1 : 3 ), b0 ) + m ( 1 : 3 , 4 ), & px , s , depth , extra )) then if ( better ( px , depth , best_px , best_depth )) then best_px = px best_depth = depth best_k = k best_s = s end if end if end do if ( best_k == 0 ) return call a % drawn_segment ( best_k , a0 , b0 ) h % kind = PICK_SEGMENT h % frame => frame h % artist => a h % trajectory => a % traj h % index = best_k h % time = a % traj % time ( min ( a % traj % num_times (), 1 + ( best_k - 1 ) * a % stride_ )) h % local = a0 + best_s * ( b0 - a0 ) h % position = matmul ( m ( 1 : 3 , 1 : 3 ), h % local ) + m ( 1 : 3 , 4 ) h % distance = best_depth h % pixels = best_px call add_pick_hit ( hits , n , h ) end subroutine segment_artist_pick","tags":"","url":"proc/segment_artist_pick.html"},{"title":"segment_build – vkframes","text":"private  subroutine segment_build(self, viewer, group) Create the chain of