trajectory proc~new_ribbon_artist new_ribbon_artist proc~new_ribbon_artist->proc~ribbon_set_trajectory proc~new_segment_artist new_segment_artist proc~new_segment_artist->proc~segment_set_trajectory interface~curveartist CurveArtist interface~curveartist->proc~new_curve_artist interface~markerartist MarkerArtist interface~markerartist->proc~new_marker_artist interface~ribbonartist RibbonArtist interface~ribbonartist->proc~new_ribbon_artist interface~segmentartist SegmentArtist interface~segmentartist->proc~new_segment_artist proc~follow ReferenceFrame%follow proc~follow->proc~add_trajectory proc~set_trajectory TrajectoryFollower%set_trajectory proc~follow->proc~set_trajectory proc~set_trajectory->proc~add_trajectory Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure function optional_sources ( opt , dof , scale ) result ( s ) integer , intent ( in ) :: opt !! the optional (1 to num_optionals) integer , intent ( in ), optional :: dof real ( wp ), intent ( in ), optional :: scale type ( DataSource ) :: s ( 3 ) integer :: k , d d = 3 if ( present ( dof )) d = dof do k = 1 , min ( 3 , d ) s ( k ) = DataSource ( SOURCE_POSOPT , element = k , opt = opt , scale = scale ) end do end function optional_sources !> Reserve memory for `n` points: times, positions (with their optionals) !> unless `positions` is false, and attitudes and colors only if !> `attitudes` / `colors` is true. Optional: storage grows as needed, but !> reserving avoids reallocations for a known size. It never shrinks the !> storage (see `compact`). subroutine reserve ( self , n , positions , attitudes , colors ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: n !! number of points logical , intent ( in ), optional :: positions !! reserve positions (default true) logical , intent ( in ), optional :: attitudes !! reserve attitudes (default false) logical , intent ( in ), optional :: colors !! reserve colors (default false) logical :: pos , att , col pos = . true . att = . false . col = . false . if ( present ( positions )) pos = positions if ( present ( attitudes )) att = attitudes if ( present ( colors )) col = colors call grow_times ( self , n , exact = . true .) if ( pos ) call grow_positions ( self , n , exact = . true .) if ( att ) call grow_attitudes ( self , n , exact = . true .) if ( col ) call grow_colors ( self , n , exact = . true .) end subroutine reserve !> Free the storage not used: each array is reallocated to the points it !> holds (one copy, an array at a time), and arrays holding none are !> deallocated. For a trajectory that is complete: growing doubles the !> storage, so up to about half of it can be unused. The data and what is !> drawn of them don't change; pointers from `times`, `positions`, ... !> must be fetched again. Points can still be added (storage grows again). subroutine compact ( self ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), allocatable :: t (:), posopt (:,:,:), att (:,:) real ( c_float ), allocatable :: col (:,:) if ( allocated ( self % t )) then if ( size ( self % t ) /= self % n_times ) then allocate ( t ( self % n_times )) t = self % t ( 1 : self % n_times ) call move_alloc ( t , self % t ) end if if ( self % n_times == 0 ) deallocate ( self % t ) end if if ( allocated ( self % posopt )) then if ( size ( self % posopt , 3 ) /= self % n_pos ) then allocate ( posopt ( 3 , 0 : self % nopt_ , self % n_pos )) posopt = self % posopt (:, :, 1 : self % n_pos ) call move_alloc ( posopt , self % posopt ) end if if ( self % n_pos == 0 ) deallocate ( self % posopt ) end if if ( allocated ( self % att )) then if ( size ( self % att , 2 ) /= self % n_att ) then allocate ( att ( 4 , self % n_att )) att = self % att (:, 1 : self % n_att ) call move_alloc ( att , self % att ) end if if ( self % n_att == 0 ) deallocate ( self % att ) end if if ( allocated ( self % col )) then if ( size ( self % col , 2 ) /= self % n_col ) then allocate ( col ( 4 , self % n_col )) col = self % col (:, 1 : self % n_col ) call move_alloc ( col , self % col ) end if if ( self % n_col == 0 ) deallocate ( self % col ) end if end subroutine compact !> The memory the trajectory's data take (bytes), used or not: its !> storage's capacity (see `reserve`, `compact`). pure integer ( int64 ) function storage_bytes ( self ) result ( b ) class ( Trajectory ), intent ( in ) :: self b = 0_int64 if ( allocated ( self % t )) b = b + storage_size ( self % t , int64 ) / 8 * size ( self % t , kind = int64 ) if ( allocated ( self % posopt )) b = b + storage_size ( self % posopt , int64 ) / 8 * size ( self % posopt , kind = int64 ) if ( allocated ( self % att )) b = b + storage_size ( self % att , int64 ) / 8 * size ( self % att , kind = int64 ) if ( allocated ( self % col )) b = b + storage_size ( self % col , int64 ) / 8 * size ( self % col , kind = int64 ) end function storage_bytes !> Remove all points (keeping the memory). subroutine clear ( self ) class ( Trajectory ), intent ( inout ) :: self self % n_times = 0 self % n_pos = 0 self % n_att = 0 self % n_col = 0 self % generation_ = self % generation_ + 1 self % revision_ = self % revision_ + 1 end subroutine clear !> Set the degrees of freedom (2 or 3) of positions and optionals; clears the trajectory. subroutine set_dof ( self , dof ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: dof self % dof_ = max ( 2 , min ( 3 , dof )) call self % clear () end subroutine set_dof !> Degrees of freedom (2 or 3) of positions and optionals. pure integer function dof ( self ) class ( Trajectory ), intent ( in ) :: self dof = self % dof_ end function dof","tags":"","url":"proc/dof.html"},{"title":"generation – vkframes","text":"private pure function generation(self) Number of times the data were cleared (by clear , set_dof or set_num_optionals ): while it is unchanged, data were only appended. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer Called by proc~~generation~~CalledByGraph proc~generation Trajectory%generation proc~data_changed data_changed proc~data_changed->proc~generation proc~marker_update MarkerArtist%marker_update proc~marker_update->proc~data_changed proc~segment_update SegmentArtist%segment_update proc~segment_update->proc~data_changed proc~write_changed write_changed proc~write_changed->proc~data_changed proc~chain_update ChainArtist%chain_update proc~chain_update->proc~write_changed proc~curve_update CurveArtist%curve_update proc~curve_update->proc~write_changed Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure integer function generation ( self ) class ( Trajectory ), intent ( in ) :: self generation = self % generation_ end function generation","tags":"","url":"proc/generation.html"},{"title":"is_empty – vkframes","text":"private pure function is_empty(self) True if the trajectory has no times. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value logical Source Code pure logical function is_empty ( self ) class ( Trajectory ), intent ( in ) :: self is_empty = self % n_times == 0 end function is_empty","tags":"","url":"proc/is_empty.html"},{"title":"new_capacity – vkframes","text":"private pure function new_capacity(current, needed, exact) The capacity to grow to for needed points: twice the current, or what is\nneeded and a quarter more (so that appending after a large bulk add\ndoesn't copy everything at once); exact (reserve): what is needed. Arguments Type Intent Optional Attributes Name integer, intent(in) :: current current capacity integer, intent(in) :: needed points needed logical, intent(in), optional :: exact Return Value integer Called by proc~~new_capacity~~CalledByGraph proc~new_capacity new_capacity proc~grow_attitudes grow_attitudes proc~grow_attitudes->proc~new_capacity proc~grow_colors grow_colors proc~grow_colors->proc~new_capacity proc~grow_positions grow_positions proc~grow_positions->proc~new_capacity proc~grow_times grow_times proc~grow_times->proc~new_capacity proc~add_attitude Trajectory%add_attitude proc~add_attitude->proc~grow_attitudes proc~add_color Trajectory%add_color proc~add_color->proc~grow_colors proc~add_points Trajectory%add_points proc~add_points->proc~grow_attitudes proc~add_points->proc~grow_colors proc~add_points->proc~grow_positions proc~add_points->proc~grow_times proc~add_position Trajectory%add_position proc~add_position->proc~grow_positions proc~add_time Trajectory%add_time proc~add_time->proc~grow_times proc~reserve Trajectory%reserve proc~reserve->proc~grow_attitudes proc~reserve->proc~grow_colors proc~reserve->proc~grow_positions proc~reserve->proc~grow_times proc~add_point Trajectory%add_point proc~add_point->proc~add_attitude proc~add_point->proc~add_color proc~add_point->proc~add_position proc~add_point->proc~add_time Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure integer function new_capacity ( current , needed , exact ) integer , intent ( in ) :: current !! current capacity integer , intent ( in ) :: needed !! points needed logical , intent ( in ), optional :: exact new_capacity = max ( needed + needed / 4 , 2 * current , 16 ) if ( present ( exact )) then if ( exact ) new_capacity = needed end if end function new_capacity","tags":"","url":"proc/new_capacity.html"},{"title":"new_data_source – vkframes","text":"private pure function new_data_source(src, element, opt, scale) result(s) A data source (see DataSource ); element defaults to 1, opt to 0, scale to 1. Arguments Type Intent Optional Attributes Name integer, intent(in) :: src a SOURCE_* constant integer, intent(in), optional :: element element (1 to dof, or 1 to 4 for an attitude; default 1) integer, intent(in), optional :: opt (0: the position (default), k: optional k) real(kind=wp), intent(in), optional :: scale Return Value type( DataSource ) Called by proc~~new_data_source~~CalledByGraph proc~new_data_source new_data_source interface~datasource DataSource interface~datasource->proc~new_data_source Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure function new_data_source ( src , element , opt , scale ) result ( s ) integer , intent ( in ) :: src !! a SOURCE_* constant integer , intent ( in ), optional :: element !! element (1 to dof, or 1 to 4 for an attitude; default 1) integer , intent ( in ), optional :: opt !! (0: the position (default), k: optional k) real ( wp ), intent ( in ), optional :: scale type ( DataSource ) :: s s % src = src if ( present ( element )) s % element = element if ( present ( opt )) s % opt = opt if ( present ( scale )) s % scale = scale end function new_data_source","tags":"","url":"proc/new_data_source.html"},{"title":"new_trajectory – vkframes","text":"private  function new_trajectory(dof, nopt) result(traj) A trajectory with dof (2 or 3, default 3) degrees of freedom and nopt (default 0) optional vectors per position. Arguments Type Intent Optional Attributes Name integer, intent(in), optional :: dof degrees of freedom (2 or 3, default 3) integer, intent(in), optional :: nopt optional vectors per position (default 0) Return Value type( Trajectory ) Called by proc~~new_trajectory~~CalledByGraph proc~new_trajectory new_trajectory interface~trajectory Trajectory interface~trajectory->proc~new_trajectory Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function new_trajectory ( dof , nopt ) result ( traj ) integer , intent ( in ), optional :: dof !! degrees of freedom (2 or 3, default 3) integer , intent ( in ), optional :: nopt !! optional vectors per position (default 0) type ( Trajectory ) :: traj if ( present ( dof )) traj % dof_ = max ( 2 , min ( 3 , dof )) if ( present ( nopt )) traj % nopt_ = max ( 0 , nopt ) end function new_trajectory","tags":"","url":"proc/new_trajectory.html"},{"title":"num_attitudes – vkframes","text":"private pure function num_attitudes(self) Number of attitudes (at most num_times). Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer Called by proc~~num_attitudes~~CalledByGraph proc~num_attitudes Trajectory%num_attitudes proc~interpolate_attitude interpolate_attitude proc~interpolate_attitude->proc~num_attitudes proc~update TrajectoryFollower%update proc~update->proc~interpolate_attitude proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure integer function num_attitudes ( self ) class ( Trajectory ), intent ( in ) :: self num_attitudes = self % n