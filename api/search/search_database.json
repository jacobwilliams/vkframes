h shrink with distance). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: size procedure, public :: set_light_ambient private  subroutine set_light_ambient (self, rgb) The light source's ambient, diffuse and specular colors ([r, g, b], 0\nto 1; defaults 0.05, 0.8 and 0.05 gray). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_diffuse private  subroutine set_light_diffuse (self, rgb) The light source's diffuse color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_source_enabled private  subroutine set_light_source_enabled (self, enable) Whether this frame carries a light source: a point light at its origin\n(e.g. the Sun), not dimmed with distance (default false; OpenFrames'\nsetLightSourceEnabled). While any frame of a window's scene has one, the\nwindow's own light (WindowProxy%set_light_*) is off. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: enable procedure, public :: set_light_specular private  subroutine set_light_specular (self, rgb) The light source's specular color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_line_color => cone_set_line_color private  subroutine cone_set_line_color (self, color) The edges' and base outline's color. Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) procedure, public :: set_name private  subroutine set_name (self, name) The frame's name, shown by its name label (also once shown: e.g. a\nreadout that follows the frame). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: name procedure, public :: set_name_label_on_top private  subroutine set_name_label_on_top (self, on_top) Draw the name label on top of the scene (true: not hidden by bodies in\nfront of it, as HUD text; e.g. a readout) or depth-tested (false, the\ndefault, as OpenFrames'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: on_top procedure, public :: set_pickable private  subroutine set_pickable (self, pickable) Whether pick tests what this frame draws (default true; e.g. false\nfor an overlay such as a selection marker). Its children are picked or\nnot by their own setting. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: pickable procedure, public :: set_position private  subroutine set_position (self, position) Position relative to the parent frame (overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) parent frame's coordinates procedure, public :: set_primary_angles => elliptic_set_primary_angles private  subroutine elliptic_set_primary_angles (self, a, b) The half-angles along x (a) and y (b), radians (0 to 90 degrees). Arguments Type Intent Optional Attributes Name class( EllipticCone ), intent(inout) :: self real(kind=wp), intent(in) :: a radians real(kind=wp), intent(in) :: b radians procedure, public :: set_vertex_angles private  subroutine set_vertex_angles (self, clock, cone) The vertices: clock angles (from +x toward +y) and cone angles (from the\nboresight, -z; below 90 degrees), radians, the same number of each (>= 3). Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: clock (:)