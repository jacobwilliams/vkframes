osition (from sources ) at time t; the\nfirst/last point outside the time range. status and index : the\ntrajectory's time_index for t. Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(in) :: traj type( DataSource ), intent(in) :: sources (3) real(kind=wp), intent(in) :: t integer, intent(in) :: status integer, intent(in) :: index real(kind=wp), intent(inout) :: position (3) logical, intent(out) :: ok false if there is no position (position unchanged) Calls proc~~interpolate_position~~CallsGraph proc~interpolate_position interpolate_position proc~num_points Trajectory%num_points proc~interpolate_position->proc~num_points proc~point Trajectory%point proc~interpolate_position->proc~point proc~point_between Trajectory%point_between proc~interpolate_position->proc~point_between proc~point_between->proc~num_points proc~point_between->proc~point proc~time_fraction Trajectory%time_fraction proc~point_between->proc~time_fraction Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~interpolate_position~~CalledByGraph proc~interpolate_position interpolate_position proc~update TrajectoryFollower%update proc~update->proc~interpolate_position proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine interpolate_position ( traj , sources , t , status , index , position , ok ) type ( Trajectory ), intent ( in ) :: traj type ( DataSource ), intent ( in ) :: sources ( 3 ) real ( wp ), intent ( in ) :: t integer , intent ( in ) :: status , index real ( wp ), intent ( inout ) :: position ( 3 ) logical , intent ( out ) :: ok !! false if there is no position (position unchanged) integer :: n , i ok = . false . n = traj % num_points ( sources ) if ( n == 0 ) return if ( all ( sources % src == SOURCE_ZERO )) then position = 0.0_wp ok = . true . return end if i = index if ( status == TIME_NOT_FOUND ) return if ( status == TIME_OUT_OF_RANGE ) then position = traj % point ( merge ( 1 , n , i < 1 ), sources ) else if ( i >= n ) then position = traj % point ( n , sources ) ! (the last; or fewer points than times: the last available) else position = traj % point_between ( i , i + 1 , t , sources ) end if ok = . true . end subroutine interpolate_position","tags":"","url":"proc/interpolate_position.html"},{"title":"remove_all – vkframes","text":"private  subroutine remove_all(self) Stop following all trajectories. Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self Called by proc~~remove_all~~CalledByGraph proc~remove_all TrajectoryFollower%remove_all proc~set_trajectory TrajectoryFollower%set_trajectory proc~set_trajectory->proc~remove_all proc~unfollow ReferenceFrame%unfollow proc~unfollow->proc~remove_all proc~follow ReferenceFrame%follow proc~follow->proc~set_trajectory Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine remove_all ( self ) class ( TrajectoryFollower ), intent ( inout ) :: self integer :: k do k = 1 , self % n self % trajs ( k )% p => null () end do self % n = 0 self % current = 0 end subroutine remove_all","tags":"","url":"proc/remove_all.html"},{"title":"remove_trajectory – vkframes","text":"private  subroutine remove_trajectory(self, traj) Stop following traj . Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self type( Trajectory ), intent(in), pointer :: traj Source Code subroutine remove_trajectory ( self , traj ) class ( TrajectoryFollower ), intent ( inout ) :: self type ( Trajectory ), pointer , intent ( in ) :: traj integer :: k do k = 1 , self % n if ( associated ( self % trajs ( k )% p , traj )) then self % trajs ( k : self % n - 1 ) = self % trajs ( k + 1 : self % n ) self % trajs ( self % n )% p => null () self % n = self % n - 1 if ( self % current >= k ) self % current = max ( 0 , self % current - 1 ) exit end if end do end subroutine remove_trajectory","tags":"","url":"proc/remove_trajectory.html"},{"title":"set_default_data – vkframes","text":"private  subroutine set_default_data