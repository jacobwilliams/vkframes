x private pure function local_matrix (self) result(m) The transform from this frame to its parent (4x4). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) procedure, public :: move_x_axis private  subroutine move_x_axis (self, base, length, head_ratio, body_radius, head_radius) Place the x axis vector: from base , length long, with a head of head_ratio of the length (default 0.3) and body and head radii (default\n0.05 and 0.1 of the length); its label is at the tip, 0.4 of the length\ntall (at most label_size pixels). As OpenFrames' moveXAxis. Set before\nthe frame is first shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) (base: frame's coordinates) real(kind=wp), intent(in) :: length (base: frame's coordinates) real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_y_axis private  subroutine move_y_axis (self, base, length, head_ratio, body_radius, head_radius) Place the y axis vector (as move_x_axis ; OpenFrames' moveYAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_z_axis private  subroutine move_z_axis (self, base, length, head_ratio, body_radius, head_radius) Place the z axis vector (as move_x_axis ; OpenFrames' moveZAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: name private  function name (self) result(n) The frame's name ('' if none). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: name_label_on_top private pure function name_label_on_top (self) Whether the name label is drawn on top of the scene ( set_name_label_on_top ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: name_label_shown private pure function name_label_shown (self) Whether the name label is shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: node private  function node (self) result(n) The frame's transform node (null until realized). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value type(c_ptr) procedure, public :: num_artists private pure function num_artists (self) Number of artists. Arguments Type Intent Optional Attributes Name class( DrawableTrajectory ), intent(in) :: self Return Value integer procedure, public :: num_children private pure function num_children (self) Number of children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: num_parents private pure function num_parents (self) Number of parents. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: parent private  function parent (self, i) result(p) Parent i (1 to num_parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: parent_index private  function parent_index (self, frame) Index of frame among the parents, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: pick => drawable_pick private  subroutine drawable_pick (self, cam, to_root, hits, n) Picks what the artists draw (see the module documentation), then\nthe frame's origin (if it shows axes or its name label). Arguments Type Intent Optional Attributes Name class( DrawableTrajectory ), intent(in), target :: self type( PickCamera ), intent(in) :: cam real(kind=wp), intent(in) :: to_root (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits are added to hits(1:n) integer, intent(inout) :: n number of hits procedure, public :: pickable private pure function pickable (self) Whether pick tests what this frame draws ( set_pickable ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: position private pure function position (self) result(p) Position relative to the parent frame. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: position_of private  function position_of (self, other) result(p) The origin of other (a frame of the same tree) in this frame's\ncoordinates, from both frames' transforms to the root (through their\nfirst parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in) :: other Return Value real(kind=wp), (3) procedure, public :: realize private recursive subroutine realize (self, viewer) Create the render nodes of this frame and its descendants (once; for viewer , a window's viewer handle, which some contents need while they\nare built (not kept); null: headless). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer handle (null: headless) procedure, public :: remove_all_artists private  subroutine remove_all_artists (self) Remove all the artists. Arguments Type Intent Optional Attributes Name class( DrawableTrajectory ), intent(inout) :: self procedure, public :: remove_artist private  subroutine remove_artist (self, a) Remove an artist (it stops being drawn; it can be added again, also to\nanother frame). Arguments Type Intent Optional Attributes Name class( DrawableTrajectory ), intent(inout) :: self class( TrajectoryArtist ), intent(in), target :: a procedure, public :: remove_child private  function remove_child (self, child) result(ok) Remove child from this frame's children. Returns false if it is not one. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self class( ReferenceFrame ), intent(inout), target :: child Return Value logical procedure, public :: reposition_axes private  subroutine reposition_axes (self) Place the axes for what the frame draws, when it is first shown (unless\nmove_*_axis was called): at its bound's surface, half the bound's radius\nlong (as OpenFrames' Sphere and Model do); at the origin, 1 long, for a\nframe that draws nothing. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: set_attitude private  subroutine set_attitude (self, q) Attitude relative to the parent frame, a quaternion [x, y, z, w]\n(normalized here; overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) procedure, public :: set_color private  subroutine set_color (self, color) The color of the frame's decorations: [r, g, b] (alpha unchanged) or [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) procedure, public :: set_highlight => drawable_set_highlight private  subroutine drawable_set_highlight (self, mode, color, arrow_spacing, arrow_speed, band_width, pulse_period) Highlight all the frame's curve and segment artists (see\nCurveArtist%set_highlight; HIGHLIGHT_NONE: none of them). Arguments Type Intent Optional Attributes Name class( DrawableTrajectory ), intent(inout) :: self integer, intent(in) :: mode HIGHLIGHT_* (added) real(kind=wp), intent(in), optional :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) real(kind=wp), intent(in), optional :: arrow_spacing between arrows (window units; default 40) real(kind=wp), intent(in), optional :: arrow_speed (window units per second; default 50) real(kind=wp), intent(in), optional :: band_width of the arrows' band (window units; default 12) real(kind=wp), intent(in), optional :: pulse_period (s; default 1.5) procedure, public :: set_label_alignment private  subroutine set_label_alignment (self, alignment) The alignment of the labels relative to their positions (ALIGN_*;\ndefault ALIGN_LEFT_BASE_LINE). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: alignment procedure, public :: set_label_font private  subroutine set_label_font (self, font) The font of the labels: a font file name (found on the data search\npath) or a full path; default: the renderer's default font. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: font procedure, public :: set_label_size private  subroutine set_label_size (self, size) The size of the labels in pixels (default 20): the name label's size,\nand the maximum size of the axes labels (which shrink with distance). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: size procedure, public :: set_light_ambient private  subroutine set_light_ambient (self, rgb) The light source's ambient, diffuse and specular colors ([r, g, b], 0\nto 1; defaults 0.05, 0.8 and 0.05 gray). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_diffuse private  subroutine set_light_diffuse (self, rgb) The light source's diffuse color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_source_enabled private  subroutine set_light_source_enabled (self, enable) Whether this frame carries a light source: a point light at its origin\n(e.g. the Sun), not dimmed with distance (default false; OpenFrames'\nsetLightSourceEnabled). While any frame of a window's scene has one, the\nwindow's own light (WindowProxy%set_light_*) is off. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: enable procedure, public :: set_light_specular private  subroutine set_light_specular (self, rgb) The light source's specular color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_name private  subroutine set_name (self, name) The frame's name, shown by its name label (also once shown: e.g. a\nreadout that follows the frame). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: name procedure, public :: set_name_label_on_top private  subroutine set_name_label_on_top (self, on_top) Draw the name label on top of the scene (true: not hidden by bodies in\nfront of it, as HUD text; e.g. a readout) or depth-tested (false, the\ndefault, as OpenFrames'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: on_top procedure, public :: set_pickable private  subroutine set_pickable (self, pickable) Whether pick tests what this frame draws (default true; e.g. false\nfor an overlay such as a selection marker). Its children are picked or\nnot by their own setting. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: pickable procedure, public :: set_position private  subroutine set_position (self, position) Position relative to the parent frame (overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) parent frame's coordinates procedure, public :: set_x_label private  subroutine set_x_label (self, text) The text of the x-axis label (default 'X'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_y_label private  subroutine set_y_label (self, text) The text of the y-axis label (default 'Y'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_z_label private  subroutine set_z_label (self, text) The text of the z-axis label (default 'Z'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: show_axes private  subroutine show_axes (self, axes) Which axes vectors to show: NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined with ior. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: axes procedure, public :: show_axes_labels private  subroutine show_axes_labels (self, labels) Which axes labels to show (as show_axes ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: labels procedure, public :: show_contents private  subroutine show_contents (self, show) Show or hide what the frame draws (its sphere, model, ...), but not its\naxes, labels or children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show procedure, public :: show_decorations private  subroutine show_decorations (self, show) Show (true) or hide all the frame's decorations at once: its axes,\ntheir labels and its name label (show_axes, show_axes_labels,\nshow_name_label). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show true: all axes, axes labels and the name label procedure, public :: show_name_label private  subroutine show_name_label (self, show) Show or hide the name label (at the frame's origin; default shown). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show (true: shown) procedure, public :: sync private recursive subroutine sync (self) Copy the positions and attitudes of this frame and its descendants to\ntheir transform nodes (only those that changed since the last sync). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: unfollow private  subroutine unfollow (self) Stop following trajectories (the frame keeps its last position and attitude). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: update => drawable_update private recursive subroutine drawable_update (self, t) Update the frame (and its descendants), then its artists. Arguments Type Intent Optional Attributes Name class( DrawableTrajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t procedure, public :: world_matrix private recursive function world_matrix (self) result(m) The transform from this frame to the root of its tree, through the first\nparent at each level. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) Source Code type , extends ( ReferenceFrame ), public :: DrawableTrajectory private type ( ArtistPointer ), allocatable :: artists (:) !! the artists (1:n_artists; not owned) integer :: n_artists = 0 !! number of artists type ( c_ptr ) :: contents_group = c_null_ptr !! the artists' group (null until built) logical :: shown = . false . !! built for a window (artists added later are compiled) contains procedure :: add_artist , remove_artist , remove_all_artists , num_artists , artist procedure :: set_highlight => drawable_set_highlight procedure :: frame_info => drawable_frame_info procedure :: build_contents => drawable_build_contents procedure :: update => drawable_update procedure :: pick => drawable_pick end type DrawableTrajectory","tags":"","url":"type/drawabletrajectory.html"},{"title":"HighlightStyle – vkframes ","text":"type, private :: HighlightStyle A line artist's highlight (see the module documentation and set_highlight). Inherited by type~~highlightstyle~~InheritedByGraph type~highlightstyle HighlightStyle type~curveartist CurveArtist type~curveartist->type~highlightstyle highlight_ type~segmentartist SegmentArtist type~segmentartist->type~highlightstyle highlight_ Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial real(kind=wp), public :: arrow_spacing = 40.0_wp between arrows (window units) real(kind=wp), public :: arrow_speed = 50.0_wp window units per second real(kind=wp), public :: band_width = 12.0_wp (window units) real(kind=wp), public :: color (4) = [1.0_wp, 1.0_wp, 1.0_wp, 1.0_wp] [r, g, b, a] (default white) integer, public :: mode = HIGHLIGHT_NONE HIGHLIGHT_* (added) real(kind=wp), public :: pulse_period = 1.5_wp (s) Source Code type :: HighlightStyle integer :: mode = HIGHLIGHT_NONE !! HIGHLIGHT_* (added) real ( wp ) :: color ( 4 ) = [ 1.0_wp , 1.0_wp , 1.0_wp , 1.0_wp ] !! [r, g, b, a] (default white) real ( wp ) :: arrow_spacing = 4 0.0_wp !! between arrows (window units) real ( wp ) :: arrow_speed = 5 0.0_wp !! window units per second real ( wp ) :: band_width = 1 2.0_wp !! (window units) real ( wp ) :: pulse_period = 1.5_wp !! (s) end type HighlightStyle","tags":"","url":"type/highlightstyle.html"},{"title":"MarkerArtist – vkframes ","text":"type, public, extends( TrajectoryArtist ) :: MarkerArtist Draws markers at a trajectory's points (OpenFrames' MarkerArtist): at\nits start and end, and intermediate markers spaced by time, arc length\nor data points, counted from the start or from the end. Markers keep\ntheir size on screen (window units), or with auto-attenuation shrink\nwhen the camera is farther than the trajectory's size. In trace mode\n(an addition), the markers passed are drawn: the end marker (at the\ntrajectory's end) only once the time reaches the end. Point colors (an\naddition, off by default: set_point_colors): each marker in the\ntrajectory's color there (see set_point_colors). Inherits type~~markerartist~~InheritsGraph type~markerartist MarkerArtist c_ptr c_ptr type~markerartist->c_ptr image, group type~datasource DataSource type~markerartist->type~datasource sources_ type~linechain LineChain type~markerartist->type~linechain start_node, end_node, inter type~trajectoryartist TrajectoryArtist type~markerartist->type~trajectoryartist type~linechain->c_ptr group, image type~linechunk LineChunk type~linechain->type~linechunk chunks type~trajectory Trajectory type~trajectoryartist->type~trajectory traj type~linechunk->c_ptr line type~lodlevel LodLevel type~linechunk->type~lodlevel lod Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial real(kind=wp), private :: arc = 0.0_wp arc length (INTERMEDIATE_DISTANCE): so far, at prev_point, and of the next marker; the last point logical, private :: attenuate = .true. auto-attenuation (see set_auto_attenuate; on by default) logical, private :: default_data = .true. sources not set: the positions, per the DOF integer, private :: direction_ = MARKER_START intermediate markers counted from MARKER_START or MARKER_END logical, private :: drawn = .false. drawn at least once since built real(kind=wp), private :: end_color (4) = [1.0_wp, 0.0_wp, 0.0_wp, 1.0_wp] end marker color (red) type( LineChain ), private :: end_node start, end and intermediate marker buffers logical, private :: end_shown = .false. the start and end markers are drawn type(c_ptr), private :: group = c_null_ptr the artist's group (null until built) real(kind=wp), private :: hi (3) = 0.0_wp bounds of the points seen type(c_ptr), private :: image = c_null_ptr the image read from it (owned; null: none) character(len=:), private, allocatable :: image_file the marker image file ('': none) type( LineChain ), private :: inter start, end and intermediate marker buffers integer, private :: inter_first = 1 the first intermediate marker drawn (trace, decreasing times: later) real(kind=wp), private, allocatable :: inter_rgba (:,:) (4, :) their colors (with point colors) real(kind=wp), private, allocatable :: inter_t (:) intermediate markers' points and times (1:n_inter) real(kind=wp), private, allocatable :: inter_xyz (:,:) intermediate markers' points and times (1:n_inter) real(kind=wp), private :: intermediate_color (4) = [1.0_wp, 1.0_wp, 1.0_wp, 1.0_wp] intermediate marker color (white) integer, private :: intermediate_type_ = INTERMEDIATE_DATA INTERMEDIATE_TIME, _DISTANCE or _DATA real(kind=wp), private :: lo (3) = 0.0_wp bounds of the points seen integer, private :: markers_ = ior(MARKER_START, MARKER_END) markers drawn (an ior of MARKER_* flags) integer, private :: n_colors_seen = 0 the trajectory's colors when the markers were written integer, private :: n_inter = 0 intermediate markers computed, written, drawn integer, private :: n_inter_drawn = 0 intermediate markers computed, written, drawn integer, private :: n_inter_written = 0 intermediate markers computed, written, drawn integer, private :: n_seen = 0 points seen (for the bounds) integer, private :: next_index = 0 where to continue (0: not started) real(kind=wp), private :: next_time = 0.0_wp time of the next marker (INTERMEDIATE_TIME) logical, private :: point_colors_ = .false. the trajectory's colors, if any (see set_point_colors) real(kind=wp), private :: prev_arc = 0.0_wp arc length (INTERMEDIATE_DISTANCE): so far, at prev_point, and of the next marker; the last point real(kind=wp), private :: prev_point (3) = 0.0_wp arc length (INTERMEDIATE_DISTANCE): so far, at prev_point, and of the next marker; the last point real(kind=wp), private :: radius = 0.0_wp attenuation radius applied integer, private :: shape_ = MARKER_DISK marker shape: a MARKER_* shape constant logical, private :: shown = .false. built for a window (marker nodes made later are compiled) real(kind=wp), private :: size_ = 10.0_wp marker size (window units) type( DataSource ), private :: sources_ (3) x, y, z data sources (default: the positions) real(kind=wp), private :: spacing_ = 1.0_wp intermediate spacing: time units, arc length or data points real(kind=wp), private :: start_color (4) = [1.0_wp, 0.0_wp, 0.0_wp, 1.0_wp] start marker color [r, g, b, a] (red) type( LineChain ), private :: start_node start, end and intermediate marker buffers logical, private :: start_shown = .false. the start and end markers are drawn real(kind=wp), private :: target = 0.0_wp arc length (INTERMEDIATE_DISTANCE): so far, at prev_point, and of the next marker; the last point Constructor public        interface MarkerArtist The MarkerArtist constructor: MarkerArtist(...) makes one (see new_marker_artist for its\narguments). private  function new_marker_artist (traj, markers, size, color) result(a) A marker artist for traj (optional; without one, or with all data\nsources zero, a start marker at the origin: in a DrawableTrajectory that\nfollows a trajectory, or is a child of a frame that does, it marks the\ncurrent position, as in OpenFrames), drawing markers (an ior\nof MARKER_START, MARKER_INTERMEDIATE, MARKER_END; default start and end)\nof size window units (default 10) in color (all markers; default red\nstart and end, white intermediate). Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(in), optional, target :: traj integer, intent(in), optional :: markers real(kind=wp), intent(in), optional :: size real(kind=wp), intent(in), optional :: color (:) Return Value type( MarkerArtist ) Type-Bound Procedures procedure, public :: auto_attenuate private pure function auto_attenuate (self) Whether the markers are auto-attenuated. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value logical procedure, public :: build => marker_build private  subroutine marker_build (self, viewer, group) Create the marker nodes under group (see artist_build). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self type(c_ptr), intent(in) :: viewer type(c_ptr), intent(in) :: group procedure, public :: data_sources => marker_data_sources private pure function marker_data_sources (self) result(s) The x, y and z data sources. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value type( DataSource ), (3) procedure, public :: drawn_color => marker_drawn_color private  function marker_drawn_color (self, which, k) result(rgba) The color marker k of which (one MARKER_* flag; k: the intermediate\nmarker's number) is drawn in: read back from its buffer with point\ncolors, else the marker's own color. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self integer, intent(in) :: which integer, intent(in), optional :: k Return Value real(kind=wp), (4) procedure, public :: drawn_marker private  function drawn_marker (self, which, v, i) result(shown) Where marker which (MARKER_START, MARKER_END, or MARKER_INTERMEDIATE\nnumber i) is drawn, read back from its buffer; false if not drawn. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self integer, intent(in) :: which real(kind=wp), intent(out) :: v (3) where it is drawn (frame coordinates) integer, intent(in), optional :: i the intermediate marker's number (1 to num_intermediate) Return Value logical procedure, public :: get_trajectory private  function get_trajectory (self) result(traj) The trajectory drawn (null if none). Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(in) :: self Return Value type( Trajectory ), pointer procedure, public :: intermediate_direction private pure function intermediate_direction (self) Where intermediate markers are counted from (MARKER_START or MARKER_END). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value integer procedure, public :: intermediate_spacing private pure function intermediate_spacing (self) Spacing of intermediate markers. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value real(kind=wp) procedure, public :: intermediate_type private pure function intermediate_type (self) How intermediate markers are spaced (INTERMEDIATE_*). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value integer procedure, public :: marker_color private pure function marker_color (self, which) result(c) The color of the start, intermediate or end markers ( which : one MARKER_* flag). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self integer, intent(in) :: which Return Value real(kind=wp), (4) procedure, public :: marker_image_file private  function marker_image_file (self) result(file) The marker image file ('' for none). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: marker_shape private pure function marker_shape (self) Marker shape (a MARKER_* shape constant). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value integer procedure, public :: marker_size private pure function marker_size (self) Marker size (window units). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value real(kind=wp) procedure, public :: markers private pure function markers (self) Which markers are drawn (an ior of MARKER_* flags). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value integer procedure, public :: num_intermediate private pure function num_intermediate (self) Number of intermediate markers drawn now. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value integer procedure, public :: pickable => artist_pickable private pure function artist_pickable (self) Whether pick tests what this artist draws. Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(in) :: self Return Value logical procedure, public :: point_colors => marker_point_colors private pure function marker_point_colors (self) Whether the trajectory's colors are drawn (set_point_colors). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(in) :: self Return Value logical procedure, public :: release => marker_release private  subroutine marker_release (self) Forget the render nodes (see artist_release). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self procedure, public :: set_auto_attenuate private  subroutine set_auto_attenuate (self, attenuate) Shrink markers farther from the camera than the trajectory's size\n(OpenFrames' auto-attenuation; see shaders/marker.vert). On by default\n(OpenFrames': off). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self logical, intent(in) :: attenuate procedure, public :: set_intermediate_direction private  subroutine set_intermediate_direction (self, direction) Count intermediate markers from the start (MARKER_START, default) or\nfrom the end (MARKER_END; recomputed whenever points are added). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: direction procedure, public :: set_intermediate_spacing private  subroutine set_intermediate_spacing (self, spacing) Spacing of intermediate markers (> 0): time units, arc length, or a\nnumber of data points (rounded down, at least 1). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self real(kind=wp), intent(in) :: spacing procedure, public :: set_intermediate_type private  subroutine set_intermediate_type (self, type) Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: type procedure, public :: set_marker_color private  subroutine set_marker_color (self, which, color) The color of the markers in which (an ior of MARKER_* flags): [r, g,\nb] (alpha unchanged) or [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: which real(kind=wp), intent(in) :: color (:) procedure, public :: set_marker_image private  function set_marker_image (self, file) result(ok) Draw the markers as an image file (tinted by the marker color; its\ntransparent parts left out), or as a disk again with ''. Returns false\nif the image cannot be read (the markers are then unchanged). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self character(len=*), intent(in) :: file Return Value logical procedure, public :: set_marker_shape private  subroutine set_marker_shape (self, shape) Marker shape: a MARKER_ shape constant (MARKER_DISK to MARKER_SPIRAL;\nMARKER_IMAGE after set_marker_image). These are OpenFrames' disk and its\nmarker shaders (Demos/Shaders/Marker_ .frag), built in. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: shape procedure, public :: set_marker_size private  subroutine set_marker_size (self, size) Marker size in window units (logical pixels; > 0). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self real(kind=wp), intent(in) :: size procedure, public :: set_markers private  subroutine set_markers (self, markers) Which markers to draw: an ior of MARKER_START, MARKER_INTERMEDIATE and\nMARKER_END (0 for none). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self integer, intent(in) :: markers procedure, public :: set_pickable => artist_set_pickable private  subroutine artist_set_pickable (self, pickable) Whether pick tests what this artist draws (default true; e.g. false for\na spacecraft's marker beside its orbit's curve). Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(inout) :: self logical, intent(in) :: pickable procedure, public :: set_point_colors => marker_set_point_colors private  subroutine marker_set_point_colors (self, enabled) How intermediate markers are spaced: INTERMEDIATE_TIME, _DISTANCE or _DATA.\nPoint colors (default off): with the trajectory's colors (Trajectory%\nadd_color, or add's color ), each marker is drawn in the color at its\npoint (intermediate markers between points: blended between theirs, by\ntime), points without a color yet in the marker's own color\n(set_marker_color). Off, or without colors: the markers' own colors. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self logical, intent(in) :: enabled procedure, public :: set_trace_mode private  subroutine set_trace_mode (self, enabled) Draw only the part up to the current time (see the module documentation). Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(inout) :: self logical, intent(in) :: enabled procedure, public :: set_trajectory => marker_set_trajectory private  subroutine marker_set_trajectory (self, traj) Draw traj ; with the default data sources, its positions (per its DOF). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self type( Trajectory ), intent(in), target :: traj procedure, public :: set_x_data => marker_set_x_data private  function marker_set_x_data (self, src) result(valid) Where the x (y, z) of the markers come from. Returns whether the\ntrajectory has those data. Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical procedure, public :: set_y_data => marker_set_y_data private  function marker_set_y_data (self, src) result(valid) Where the y of the markers come from (see set_x_data). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical procedure, public :: set_z_data => marker_set_z_data private  function marker_set_z_data (self, src) result(valid) Where the z of the markers come from (see set_x_data). Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src