m a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine make_cone ( self ) class ( PolyhedralCone ), intent ( inout ) :: self real ( wp ), allocatable :: v (:,:), edges (:,:) integer , allocatable :: idx (:,:) type ( c_ptr ) :: group integer :: i , n if (. not . c_associated ( self % nodes % contents )) return n = size ( self % clock ) allocate ( v ( 3 , n + 1 ), idx ( 3 , n ), edges ( 3 , 2 * n )) v (:, n + 1 ) = 0.0_wp ! the apex do i = 1 , n v (:, i ) = self % length_ * [ tan ( self % cone ( i )) * cos ( self % clock ( i )), tan ( self % cone ( i )) * sin ( self % clock ( i )), - 1.0_wp ] idx (:, i ) = [ n + 1 , i , modulo ( i , n ) + 1 ] edges (:, 2 * i - 1 ) = 0.0_wp edges (:, 2 * i ) = v (:, i ) end do group = vkf_switch_create () if ( iand ( self % mode , CONE_SIDES ) /= 0 ) call add ( group , surface_node ( v , idx , self % cone_color_ )) if ( iand ( self % mode , CONE_EDGES ) /= 0 ) call add ( group , line_node ( edges , self % line_color_ , self % width_ , . true .)) if ( iand ( self % mode , CONE_BASE_OUTLINE ) /= 0 ) & call add ( group , line_node ( closed_segments ( v (:, 1 : n )), self % line_color_ , self % width_ , . true .)) call self % nodes % replace ( group ) end subroutine make_cone","tags":"","url":"proc/make_cone.html"},{"title":"make_cone_look_at – vkframes","text":"private  subroutine make_cone_look_at(self, apex, dir, up) Place the cone's apex at apex (in the parent frame) with its boresight\nalong dir and its +y axis toward up (OpenFrames' makeConeLookAt). Type Bound PolyhedralCone Arguments Type Intent Optional Attributes Name class( PolyhedralCone ), intent(inout) :: self real(kind=wp), intent(in) :: apex (3) parent frame coordinates (scene units) real(kind=wp), intent(in) :: dir (3) boresight direction (any length > 0) real(kind=wp), intent(in) :: up (3) toward the cone's +y axis (any length) Calls proc~~make_cone_look_at~~CallsGraph proc~make_cone_look_at PolyhedralCone%make_cone_look_at proc~cross cross proc~make_cone_look_at->proc~cross proc~quat_from_matrix quat_from_matrix proc~make_cone_look_at->proc~quat_from_matrix proc~set_attitude~2 ReferenceFrame%set_attitude proc~make_cone_look_at->proc~set_attitude~2 proc~set_position~2 ReferenceFrame%set_position proc~make_cone_look_at->proc~set_position~2 proc~quat_normalize quat_normalize proc~set_attitude~2->proc~quat_normalize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine make_cone_look_at ( self , apex , dir , up ) class ( PolyhedralCone ), intent ( inout ) :: self real ( wp ), intent ( in ) :: apex ( 3 ) !! parent frame coordinates (scene units) real ( wp ), intent ( in ) :: dir ( 3 ) !! boresight direction (any length > 0) real ( wp ), intent ( in ) :: up ( 3 ) !! toward the cone's +y axis (any length) real ( wp ) :: f ( 3 ), s ( 3 ), u ( 3 ), m ( 3 , 3 ) if ( norm2 ( dir ) <= 0.0_wp ) return f = dir / norm2 ( dir ) s = cross ( f , up ) if ( norm2 ( s ) <= 1.0e-12_wp ) s = cross ( f , [ 1.0_wp , 0.0_wp , 0.0_wp ]) if ( norm2 ( s ) <= 1.0e-12_wp ) s = cross ( f , [ 0.0_wp , 1.0_wp , 0.0_wp ]) s = s / norm2 ( s ) u = cross ( s , f ) m (:, 1 ) = s ! the cone's axes in the parent frame m (:, 2 ) = u m (:, 3 ) = - f call self % set_position ( apex ) call self % set_attitude ( quat_from_matrix ( m )) end subroutine make_cone_look_at","tags":"","url":"proc/make_cone_look_at.html"},{"title":"make_grid – vkframes","text":"private  subroutine make_grid(self) Make the grid's lines (circles in 1 degree steps, meridians in 0.5 degree\nsteps), in place of the old. Arguments Type Intent Optional Attributes Name type( LatLonGrid ), intent(inout) :: self Calls proc~~make_grid~~CallsGraph proc~make_grid make_grid interface~vkf_switch_create vkf_switch_create proc~make_grid->interface~vkf_switch_create proc~add add proc~make_grid->proc~add proc~append~2 append proc~make_grid->proc~append~2 proc~closed_segments closed_segments proc~make_grid->proc~closed_segments proc~color~3 ReferenceFrame%color proc~make_grid->proc~color~3 proc~line_node line_node proc~make_grid->proc~line_node proc~open_segments open_segments proc~make_grid->proc~open_segments proc~replace ShapeNodes%replace proc~make_grid->proc~replace proc~surface_point surface_point proc~make_grid->proc~surface_point interface~vkf_node_add_child vkf_node_add_child proc~add->interface~vkf_node_add_child interface~vkf_node_delete vkf_node_delete proc~add->interface~vkf_node_delete proc~check_status check_status proc~add->proc~check_status interface~vkf_line_create vkf_line_create proc~line_node->interface~vkf_line_create proc~line_node->proc~check_status proc~line_set_points line_set_points proc~line_node->proc~line_set_points proc~line_set_segments line_set_segments proc~line_node->proc~line_set_segments proc~line_set_style line_set_style proc~line_node->proc~line_set_style interface~vkf_compile_node vkf_compile_node proc~replace->interface~vkf_compile_node proc~replace->interface~vkf_node_add_child proc~replace->interface~vkf_node_delete interface~vkf_node_remove_child vkf_node_remove_child proc~replace->interface~vkf_node_remove_child proc~replace->proc~check_status interface~vkf_line_points vkf_line_points proc~line_set_points->interface~vkf_line_points interface~vkf_line_points_changed vkf_line_points_changed p