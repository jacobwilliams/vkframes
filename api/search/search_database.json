_transition !> The view shown (the default view of the scene's root if none were added). function current_view ( self ) result ( v ) class ( WindowProxy ), intent ( in ), target :: self type ( View ), pointer :: v if ( self % current >= 1 . and . self % current <= self % n_views ) then v => self % views ( self % current )% p else v => self % default_view end if end function current_view !> View i (1 to num_views). function window_view ( self , i ) result ( v ) class ( WindowProxy ), intent ( in ) :: self integer , intent ( in ) :: i type ( View ), pointer :: v v => self % views ( i )% p end function window_view !> Number of views added. pure integer function num_views ( self ) class ( WindowProxy ), intent ( in ) :: self num_views = self % n_views end function num_views !> Set the renderer's camera for the current view: keep the previous view's !> trackball state and restore (or reset) the current one's when the view !> changes, then set its world-to-view transform and projection. subroutine place_camera ( self ) type ( WindowProxy ), intent ( inout ), target :: self type ( View ), pointer :: v , from class ( ReferenceFrame ), pointer :: root real ( wp ) :: eye ( 3 ), center ( 3 ), up ( 3 ), dist , near , far , bounds ( 4 ), cam ( 3 , 3 ), from_cam ( 3 , 3 ), duration logical :: have_target v => self % current_view () if ( associated ( v , self % default_view ) . and . associated ( self % scene )) then root => self % scene % frame () if ( associated ( root ) . and . . not . self % default_view % is_valid ()) call self % default_view % set_view_frame ( root , root ) end if ! the camera shown (to fly from), and the new one: a view changed to (its ! camera set, kept, or reset), a camera set, or a reset from => null () if ( associated ( self % shown )) then if ( vkf_viewer_get_look_at ( self % viewer_ , from_cam (:, 1 ), from_cam (:, 2 ), from_cam (:, 3 )) == 0 ) & from => self % shown end if duration = self % transition_ have_target = . false . if (. not . associated ( v , self % shown )) then if ( associated ( from )) call from % save_state ( from_cam (:, 1 ), from_cam (:, 2 ), from_cam (:, 3 )) if ( self % switch_duration >= 0.0_wp ) duration = self % switch_duration self % switch_duration = - 1.0_wp if ( v % take_camera ( cam )) then have_target = . true . else if ( v % saved_state ( eye , center , up )) then cam = reshape ([ eye , center , up ], [ 3 , 3 ]) have_target = . true . else call v % reset_view () end if self % shown => v else if ( v % take_camera ( cam )) then have_target = . true . duration = 0.0_wp ! (View%set_camera: at once) end if if ( v % take_reset ()) then call v % home ( aspect_ratio ( self ), eye , center , up ) cam = reshape ([ eye , center , up ], [ 3 , 3 ]) have_target = . true . end if if ( have_target ) then if ( associated ( from ) . and . duration > 0.0_wp ) then call start_flight ( self , from , from_cam , v , cam , duration ) else self % flight % active = . false . call put_camera ( self , cam ) end if end if call fly ( self , v ) if ( vkf_viewer_set_view_transform ( self % viewer_ , v % world_to_view ()) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not set the view' ! near and far planes from the camera's distance to its center (reverse-Z ! float depth covers the wide ratio) if ( vkf_viewer_get_look_at ( self % viewer_ , eye , center , up ) /= 0 ) return dist = max ( norm2 ( eye - center ), tiny ( 1.0_wp )) near = 1.0e-6_wp * dist far = 1.0e9_wp * dist if ( v % projection_type () == PERSPECTIVE ) then if ( vkf_viewer_perspective ( self % viewer_ , v % field_of_view (), near , far ) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not set the projection' else bounds = v % orthographic_bounds () if ( vkf_viewer_orthographic ( self % viewer_ , bounds ( 1 ), bounds ( 2 ), bounds ( 3 ), bounds ( 4 ), - far , far ) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not set the projection' end if end subroutine place_camera !> The renderer's camera (columns: eye, center, up; the shown view's frame). subroutine put_camera ( self , cam ) type ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: cam ( 3 , 3 ) !! (columns: eye, center, up) if ( vkf_viewer_look_at ( self % viewer_ , cam (:, 1 ), cam (:, 2 ), cam (:, 3 )) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not set the camera' end subroutine put_camera !> Fly from camera `start` (in view `from`'s frame) to `finish` (in view !> `to`'s) over `duration` s, from now. subroutine start_flight ( self , from , start , to , finish , duration ) type ( WindowProxy ), intent ( inout ) :: self type ( View ), intent ( in ), target :: from , to real ( wp ), intent ( in ) :: start ( 3 , 3 ), finish ( 3 , 3 ), duration !! (columns: eye, center, up; duration: s) self % flight % from => from self % flight % to => to self % flight % start = start self % flight % finish = finish self % flight % duration = duration self % flight % started = window_wall ( self ) self % flight % active = . true . end subroutine start_flight !> The camera of an active flight to view `v`, at this moment: both !> cameras in the root frame (their views' frames as they are now), in !> between by the eased fraction of the time passed, back in `v`'s frame. subroutine fly ( self , v ) type ( WindowProxy ), intent ( inout ) :: self type ( View ), intent ( in ), target :: v real ( wp ) :: s , from ( 3 , 3 ), to ( 3 , 3 ), m ( 4 , 4 ) if (. not . self % flight % active ) return if (. not . associated ( self % flight % to , v )) then ! (another view since) self % flight % active = . false . return end if s = ( window_wall ( self ) - self % flight % started ) / self % flight % duration if ( s >= 1.0_wp ) then self % flight % active = . false . call put_camera ( self , self % flight % finish ) return end if s = s * s * ( 3.0_wp - 2.0_wp * s ) ! (eased in and out) m = v % world_to_view () from = transform_camera ( rigid_inverse ( self % flight % from % world_to_view ()), self % flight % start ) to = transform_camera ( rigid_inverse ( m ), self % flight % finish ) call put_camera ( self , transform_camera ( m , camera_between ( s , from , to ))) end subroutine fly ! ================================================================== ! simulation time !> Set the simulation time (limited to the time range). subroutine set_time ( self , t ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t !! simulation time call self % clock_ % set_time ( t , window_wall ( self )) end subroutine set_time !> The simulation time (at the last frame). real ( wp ) function time ( self ) class ( WindowProxy ), intent ( in ) :: self time = self % clock_ % time () end function time !> Pause (true) or resume (false) the simulation time. subroutine pause_time ( self , paused ) class ( WindowProxy ), intent ( inout ) :: self logical , intent ( in ) :: paused call self % clock_ % pause ( paused , window_wall ( self )) end subroutine pause_time !> Whether the simulation time is paused. logical function is_time_paused ( self ) class ( WindowProxy ), intent ( in ) :: self is_time_paused = self % clock_ % is_paused () end function is_time_paused !> Simulation seconds per wall-clock second (may be 0 or negative). subroutine set_time_scale ( self , scale ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: scale call self % clock_ % set_time_scale ( scale , window_wall ( self )) end subroutine set_time_scale !> Simulation seconds per wall-clock second. real ( wp ) function time_scale ( self ) class ( WindowProxy ), intent ( in ) :: self time_scale = self % clock_ % time_scale () end function time_scale !> Limit the simulation time to [t_min, t_max] (ignored if t_max < t_min). subroutine set_time_range ( self , t_min , t_max ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t_min , t_max !! simulation times call self % clock_ % set_time_range ( t_min , t_max ) end subroutine set_time_range !> The simulation time range (`set_time_range`). subroutine time_range ( self , t_min , t_max ) class ( WindowProxy ), intent ( in ) :: self real ( wp ), intent ( out ) :: t_min , t_max call self % clock_ % time_range ( t_min , t_max ) end subroutine time_range !> The window's viewer handle in the rendering layer (null until open), for !> adding low-level nodes (src/vsg/vkf_layer.f90). function window_viewer ( self ) result ( v ) class ( WindowProxy ), intent ( in ) :: self type ( c_ptr ) :: v v = self % viewer_ end function window_viewer !> The window's simulation clock (e.g. to synchronize it with another window's). function clock ( self ) result ( c ) class ( WindowProxy ), intent ( in ), target :: self type ( SimulationClock ), pointer :: c c => self % clock_ end function clock ! ================================================================== ! events from a host window (positions in framebuffer pixels from the top ! left; buttons 1 left, 2 middle, 3 right; `mask` the buttons held, as ! VSG's BUTTON_MASK_1/2/3 = 256/512/1024) !> A mouse event: kind MOUSE_MOVE, MOUSE_PRESS or MOUSE_RELEASE. subroutine mouse ( self , kind , x , y , mask , button ) class ( WindowProxy ), intent ( inout ) :: self integer , intent ( in ) :: kind !! MOUSE_MOVE, MOUSE_PRESS or MOUSE_RELEASE integer , intent ( in ) :: x , y !! framebuffer pixels from the top left integer , intent ( in ) :: mask !! buttons held (ior: 256 left, 512 middle, 1024 right) integer , intent ( in ) :: button !! button pressed or released (1 left, 2 middle, 3 right) if (. not . c_associated ( self % viewer_ )) return if ( vkf_viewer_mouse ( self % viewer_ , int ( kind , c_int ), int ( x , c_int ), int ( y , c_int ), int ( mask , c_int ), & int ( button , c_int )) /= 0 ) write ( * , '(a)' ) 'vkframes: mouse event failed' end subroutine mouse !> The scroll wheel: dy > 0 away from the user. subroutine scroll ( self , dy ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: dy !! wheel steps (> 0: away from the user; fractions !! for a trackpad's small steps: Qt's angleDelta / 120) if (. not . c_associated ( self % viewer_ )) return if ( vkf_viewer_scroll ( self % viewer_ , real ( dy , c_float )) /= 0 ) write ( * , '(a)' ) 'vkframes: scroll event failed' end subroutine scroll !> A key press (pressed true) or release, as VSG key symbols and modifiers !> (ASCII for printable keys; vsg/ui/KeyEvent.h). subroutine key ( self , pressed , symbol , modified_symbol , modifier ) class ( WindowProxy ), intent ( inout ) :: self logical , intent ( in ) :: pressed integer , intent ( in ) :: symbol !! the key without modifiers (VSG's keyBase) integer , intent ( in ) :: modified_symbol !! the key with the modifiers (VSG's keyModified, e.g. 'A') integer , intent ( in ) :: modifier !! the modifier keys held (MOD_* bits) if (. not . c_associated ( self % viewer_ )) return if ( vkf_viewer_key ( self % viewer_ , merge ( 1_c_int , 0_c_int , pressed ), int ( symbol , c_int ), & int ( modified_symbol , c_int ), int ( modifier , c_int )) /= 0 ) & write ( * , '(a)' ) 'vkframes: key event failed' end subroutine key !> The host window was resized (framebuffer pixels), and `pixel_ratio`: its !> framebuffer pixels per window unit (Qt's devicePixelRatio), if it may !> have changed (the window moved to a screen of another scale, or the !> display's scaling changed: sizes in window units, such as line widths, !> markers and labels, are scaled by it). Once the scene is shown, a frame !> of the new size is rendered at once (call this from the host's resize !> event), so that the window isn't shown stretched or blank while it is !> resized. subroutine resize ( self , width , height , pixel_ratio ) class ( WindowProxy ), intent ( inout ) :: self integer , intent ( in ) :: width , height !! framebuffer pixels real ( wp ), intent ( in ), optional :: pixel_ratio !! framebuffer pixels per window unit if (. not . c_associated ( self % viewer_ )) return if ( present ( pixel_ratio )) then if ( pixel_ratio > 0.0_wp . and . pixel_ratio /= self % pixel_ratio_ ) then self % pixel_ratio_ = pixel_ratio if ( vkf_viewer_set_pixel_ratio ( self % viewer_ , real ( pixel_ratio , c_double )) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not set the pixel ratio' end if end if self % width_ = max ( 1 , width ) self % height_ = max ( 1 , height ) if ( vkf_viewer_resize ( self % viewer_ , int ( width , c_int ), int ( height , c_int )) /= 0 ) & write ( * , '(a)' ) 'vkframes: resize failed' ! a frame of the new size at once (once the scene is shown), so the window ! isn't shown stretched or blank while being resized if ( self % scene_added ) then if ( self % frame ()) continue end if end subroutine resize ! ================================================================== ! keyboard and mouse: the program's handler (OpenFrames' callbacks) !> Give the window's keyboard and mouse events to `handler` (not owned: it !> must stay alive while set), in place of any handler set before. subroutine set_event_handler ( self , handler ) class ( WindowProxy ), intent ( inout ) :: self class ( WindowEventHandler ), intent ( in ), target :: handler !! not owned self % handler => handler end subroutine set_event_handler !> Give the events to no handler (the built-in keys remain). subroutine clear_event_handler ( self ) class ( WindowProxy ), intent ( inout ) :: self self % handler => null () end subroutine clear_event_handler !> The event handler (null if none). function event_handler ( self ) result ( handler ) class ( WindowProxy ), intent ( in ) :: self class ( WindowEventHandler ), pointer :: handler handler => self % handler end function event_handler !> The built-in keys (default on): `v` the next view, `V` the previous !> one, the space bar resets the view. subroutine set_default_keys ( self , on ) class ( WindowProxy ), intent ( inout ) :: self logical , intent ( in ) :: on self % default_keys_ = on end subroutine set_default_keys !> Whether the built-in keys are on (`set_default_keys`). pure logical function default_keys ( self ) class ( WindowProxy ), intent ( in ) :: self default_keys = self % default_keys_ end function default_keys !> A key was pressed: `key` (a character's code, iachar('v'), or KEY_*), !> with the modifier keys held (MOD_* bits). Set `handled` (false on entry) !> to skip the built-in key's action. subroutine handler_key_press ( self , window , key , modifiers , handled ) class ( WindowEventHandler ), intent ( inout ) :: self class ( WindowProxy ), intent ( inout ) :: window !! the window of the event integer , intent ( in ) :: key , modifiers !! a character code or KEY_*; MOD_* bits logical , intent ( inout ) :: handled !! (true: skip the built-in key) end subroutine handler_key_press !> A key was released (see `key_press`). subroutine handler_key_release ( self , window , key , modifiers ) class ( WindowEventHandler ), intent ( inout ) :: self class ( WindowProxy ), intent ( inout ) :: window integer , intent ( in ) :: key , modifiers !! as key_press's end subroutine handler_key_release !> The mouse moved to (x, y) (-1 to 1 across the window, y up), with the !> buttons held (left, middle, right): moving (none held, OpenFrames' mouse !> motion) or dragging. subroutine handler_mouse_motion ( self , window , x , y , buttons ) class ( WindowEventHandler ), intent ( inout ) :: self class ( WindowProxy ), intent ( inout ) :: window real ( wp ), intent ( in ) :: x , y !! -1 to 1 across the window, y up logical , intent ( in ) :: buttons ( 3 ) !! (held: left, middle, right) end subroutine handler_mouse_motion !> A mouse button (MOUSE_LEFT, MOUSE_MIDDLE, MOUSE_RIGHT) was pressed at !> (x, y) (see `mouse_motion`). subroutine handler_button_press ( self , window , x , y , button ) class ( WindowEventHandler ), intent ( inout ) :: self class ( WindowProxy ), intent ( inout ) :: window real ( wp ), intent ( in ) :: x , y integer , intent ( in ) :: button !! MOUSE_LEFT, MOUSE_MIDDLE or MOUSE_RIGHT end subroutine handler_button_press !> A mouse button was released at (x, y) (see `button_press`). subroutine handler_button_release ( self , window , x , y , button ) class ( WindowEventHandler ), intent ( inout ) :: self class ( WindowProxy ), intent ( inout ) :: window real ( wp ), intent ( in ) :: x , y integer , intent ( in ) :: button !! as button_press's end subroutine handler_button_release !> Called each frame just before drawing, the scene at time `t` and the !> camera placed (see the module documentation): e.g. to move HUD text !> next to a moving object. subroutine handler_before_draw ( self , window , t ) class ( WindowEventHandler ), intent ( inout ) :: self class ( WindowProxy ), intent ( inout ) :: window real ( wp ), intent ( in ) :: t !! simulation time end subroutine handler_before_draw !> A handle (vkf_handles) was grabbed (DRAG_START), dragged (DRAG_MOVE: !> it has moved) or released (DRAG_END) with the mouse: e.g. compute !> again what depends on it (see the module documentation). subroutine handler_handle_drag ( self , window , handle , stage ) class ( WindowEventHandler ), intent ( inout ) :: self class ( WindowProxy ), intent ( inout ) :: window !! the window the handle is dragged in class ( DragHandle ), intent ( inout ), target :: handle !! the handle (select type for its kind) integer , intent ( in ) :: stage !! DRAG_START, DRAG_MOVE or DRAG_END end subroutine handler_handle_drag !> The keyboard and mouse events of the last frame, to the handler and the !> built-in keys (stopping if the window is closed meanwhile). subroutine dispatch_events ( self ) class ( WindowProxy ), intent ( inout ), target :: self integer , parameter :: capacity = 64 integer ( c_int ) :: events ( 12 , capacity ), n integer :: i do if (. not . self % is_open ()) return n = vkf_viewer_events ( self % viewer_ , events , int ( capacity , c_int )) do i = 1 , n if (. not . self % is_open ()) return call dispatch_event ( self , int ( events (:, i ))) end do if ( n < capacity ) return end do end subroutine dispatch_events !> One event (see vkf_viewer_events): kind, key, key base, modifiers, !> button, buttons held, x, y (framebuffer pixels from the top left), the !> render area (x, y, width, height). subroutine dispatch_event ( self , e ) class ( WindowProxy ), intent ( inout ), target :: self integer , intent ( in ) :: e ( 12 ) !! the event (see above) integer , parameter :: KEY_PRESS = 1 , KEY_RELEASE = 2 , MOVE = 3 , BUTTON_PRESS = 4 , BUTTON_RELEASE = 5 integer , parameter :: BUTTON_MASKS ( 3 ) = [ 256 , 512 , 1024 ] ! (VSG's BUTTON_MASK_1/2/3) integer :: key real ( wp ) :: x , y logical :: handled key = e ( 2 ) if ( key == 0 ) key = e ( 3 ) ! (no modified key given) x = 0.0_wp y = 0.0_wp if ( e ( 11 ) > 0 ) x = 2.0_wp * real ( e ( 7 ) - e ( 9 ), wp ) / real ( e ( 11 ), wp ) - 1.0_wp if ( e ( 12 ) > 0 ) y = 1.0_wp - 2.0_wp * real ( e ( 8 ) - e ( 10 ), wp ) / real ( e ( 12 ), wp ) select case ( e ( 1 )) case ( KEY_PRESS ) handled = . false . if ( associated ( self % handler )) call self % handler % key_press ( self , key , e ( 4 ), handled ) if (. not . handled . and . self % default_keys_ . and . self % is_open ()) call default_key ( self , key , e ( 4 )) case ( KEY_RELEASE ) if ( associated ( self % handler )) call self % handler % key_release ( self , key , e ( 4 )) case ( MOVE ) if ( e ( 2 ) == 1 ) then ! (grabbed: a handle dragged) call drag_handle ( self , x , y ) return end if if ( all ( iand ( e ( 6 ), BUTTON_MASKS ) == 0 )) call hover_handle ( self , x , y ) ! (no button held) if ( associated ( self % handler )) call self % handler % mouse_motion ( self , x , y , iand ( e ( 6 ), BUTTON_MASKS ) /= 0 ) case ( BUTTON_PRESS ) self % flight % active = . false . ! (the mouse takes the camera) if ( e ( 2 ) == 1 ) then call grab_handle ( self , x , y ) return end if if ( associated ( self % handler )) call self % handler % button_press ( self , x , y , e ( 5 )) case ( BUTTON_RELEASE ) if ( e ( 2 ) == 1 ) then call release_handle ( self , x , y ) return end if if ( associated ( self % handler )) call self % handler % button_release ( self , x , y , e ( 5 )) end select end subroutine dispatch_event ! ------------------------------------------------------------------ ! handles (see the module documentation) !> The handle under (x, y), if any, hovered (the one before not), and the !> grab armed for it. Of handles on the same spot: the nearest on the !> screen; within `same_spot` pixels of it, the highest priority, then the !> nearest to the eye (vkf_handles). subroutine hover_handle ( self , x , y ) class ( WindowProxy ), intent ( inout ), target :: self real ( wp ), intent ( in ) :: x , y !! the cursor: -1 to 1 across the window, y up real ( wp ), parameter :: same_spot = 3.0_wp !! framebuffer pixels type ( PickHit ), allocatable :: hits (:) class ( DragHandle ), pointer :: found real ( wp ) :: least integer :: k found => null () if ( handles_shown ()) then call self % pick ( x , y , hits , kinds = [ PICK_HANDLE ]) if ( size ( hits ) > 0 ) least = minval ( hits % pixels ) do k = 1 , size ( hits ) ! (nearest to the eye first) if ( hits ( k )% pixels > least + same_spot ) cycle select type ( f => hits ( k )% frame ) class is ( DragHandle ) if (. not . f % draggable ()) cycle if ( associated ( found )) then if ( f % priority () <= found % priority ()) cycle end if found => f end select end do end if if ( associated ( found , self % hovered_handle )) return if ( associated ( self % hovered_handle )) call self % hovered_handle % set_hovered (. false .) self % hovered_handle => found if ( associated ( found )) call found % set_hovered (. true .) if ( vkf_viewer_set_grab ( self % viewer_ , merge ( 1_c_int , 0_c_int , associated ( found ))) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not arm a grab' end subroutine hover_handle !> A left press grabbed the mouse (the grab armed): the hovered handle grabbed. subroutine grab_handle ( self , x , y ) class ( WindowProxy ), intent ( inout ), target :: self real ( wp ), intent ( in ) :: x , y !! the cursor: -1 to 1 across the window, y up real ( wp ) :: origin ( 3 ), dir ( 3 ) if (. not . associated ( self % hovered_handle )) return if (. not . self % cursor_ray ( x , y , origin , dir )) return if (. not . self % hovered_handle % grab ( origin , dir )) return self % dragged_handle => self % hovered_handle if ( associated ( self % handler )) call self % handler % handle_drag ( self , self % dragged_handle , DRAG_START ) end subroutine grab_handle !> The grabbed handle dragged to (x, y). subroutine drag_handle ( self , x , y ) class ( WindowProxy ), intent ( inout ), target :: self real ( wp ), intent ( in ) :: x , y !! the cursor: -1 to 1 across the window, y up real ( wp ) :: origin ( 3 ), dir ( 3 ) if (. not . associated ( self % dragged_handle )) return if (. not . self % cursor_ray ( x , y , origin , dir )) return if (. not . self % dragged_handle % drag ( origin , dir )) return if ( associated ( self % handler )) call self % handler % handle_drag ( self , self % dragged_handle , DRAG_MOVE ) end subroutine drag_handle !> The grabbed handle released at (x, y); then the handle under the cursor !> hovered. subroutine release_handle ( self , x , y ) class ( WindowProxy ), intent ( inout ), target :: self real ( wp ), intent ( in ) :: x , y !! the cursor: -1 to 1 across the window, y up class ( DragHandle ), pointer :: released if ( associated ( self % dragged_handle )) then released => self % dragged_handle self % dragged_handle => null () call released % release () if ( associated ( self % handler )) call self % handler % handle_drag ( self , released , DRAG_END ) end if if ( self % is_open ()) call hover_handle ( self , x , y ) end subroutine release_handle !> No handle hovered or grabbed (the scene or the window changes). subroutine forget_handles ( self ) class ( WindowProxy ), intent ( inout ) :: self integer ( c_int ) :: status if ( associated ( self % dragged_handle )) call self % dragged_handle % release () if ( associated ( self % hovered_handle )) call self % hovered_handle % set_hovered (. false .) self % dragged_handle => null () self % hovered_handle => null () if ( c_associated ( self % viewer_ )) status = vkf_viewer_set_grab ( self % viewer_ , 0_c_int ) end subroutine forget_handles !> The built-in keys (OpenFrames'): `v` the next view, `V` the previous !> one, the space bar resets the view; not with control, alt or meta held. subroutine default_key ( self , key , modifiers ) class ( WindowProxy ), intent ( inout ), target :: self integer , intent ( in ) :: key , modifiers !! a character code or KEY_*; MOD_* bits type ( View ), pointer :: v if ( iand ( modifiers , MOD_CONTROL + MOD_ALT + MOD_META ) /= 0 ) return if ( key == iachar ( 'v' )) then call self % next_view () else if ( key == iachar ( 'V' )) then call self % previous_view () else if ( key == KEY_SPACE ) then v => self % current_view () call v % reset_view () end if end subroutine default_key !> The width / height of the window drawn: a host's (from `resize`), or of !> the window's own, as it is now. real ( wp ) function aspect_ratio ( self ) class ( WindowProxy ), intent ( in ) :: self integer ( c_int ) :: width , height aspect_ratio = real ( self % width_ , wp ) / real ( self % height_ , wp ) if ( self % hosted . or . . not . c_associated ( self % viewer_ )) return if ( vkf_viewer_size ( self % viewer_ , width , height ) /= 0 ) return if ( width > 0 . and . height > 0 ) aspect_ratio = real ( width , wp ) / real ( height , wp ) end function aspect_ratio end module vkf_window","tags":"","url":"sourcefile/vkf_window.f90.html"},{"title":"vkf_hud.f90 – vkframes","text":"This file depends on sourcefile~~vkf_hud.f90~~EfferentGraph sourcefile~vkf_hud.f90 vkf_hud.f90 sourcefile~vkf_frames.f90 vkf_frames.f90 sourcefile~vkf_hud.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_math.f90 vkf_math.f90 sourcefile~vkf_hud.f90->sourcefile~vkf_math.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_math.f90 sourcefile~vkf_follower.f90 vkf_follower.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_follower.f90 sourcefile~vkf_geometry.f90 vkf_geometry.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_geometry.f90 sourcefile~vkf_layer.f90 vkf_layer.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_pick.f90 vkf_pick.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_pick.f90 sourcefile~vkf_text.f90 vkf_text.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_text.f90 sourcefile~vkf_trajectory.f90 vkf_trajectory.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_trajectory.f90 sourcefile~vkf_follower.f90->sourcefile~vkf_math.f90 sourcefile~vkf_follower.f90->sourcefile~vkf_trajectory.f90 sourcefile~vkf_geometry.f90->sourcefile~vkf_math.f90 sourcefile~vkf_geometry.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_pick.f90->sourcefile~vkf_math.f90 sourcefile~vkf_text.f90->sourcefile~vkf_math.f90 sourcefile~vkf_text.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_files.f90 vkf_files.f90 sourcefile~vkf_text.f90->sourcefile~vkf_files.f90 sourcefile~vkf_trajectory.f90->sourcefile~vkf_math.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~vkf_hud.f90~~AfferentGraph sourcefile~vkf_hud.f90 vkf_hud.f90 sourcefile~vkf_window.f90 vkf_window.f90 sourcefile~vkf_window.f90->sourcefile~vkf_hud.f90 sourcefile~vkframes.f90 vkframes.f90 sourcefile~vkframes.f90->sourcefile~vkf_hud.f90 sourcefile~vkframes.f90->sourcefile~vkf_window.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code !> HUD text: text drawn on top of the scene at a fixed place in a window, as !> OpenFrames' HUD text (one per RenderRectangle there; any number here). !> !> Its position is (x, y) from 0 to 1 across the window, left to right and !> bottom to top, and the text's alignment (an ALIGN_* constant) says which !> point of the text is there; its size is in window units (logical pixels). !> Everything can change at any time, also while shown: the text (e.g. a !> clock; up to 256 characters, or twice the text's length when first shown !> if more: longer ones are cut), color, position, size and alignment in !> place, and the font (the text is made again). Moved each frame to an !> object's place on the screen (WindowProxy%screen_position), it is a !> callout that follows the object. A HUDText can be shown in several !> windows (`WindowProxy%add_hud_text`); it is not owned by them and must !> stay alive while shown. module vkf_hud use vkf_math , only : wp use vkf_frames , only : ALIGN_LEFT_BOTTOM implicit none private !> HUD text (see the module documentation). type , public :: HUDText private character ( len = :), allocatable :: text_ !! the text real ( wp ) :: position_ ( 2 ) = [ 0.01_wp , 0.01_wp ] !! [x, y] (0 to 1 across the window, y up) integer :: alignment_ = ALIGN_LEFT_BOTTOM !! the point of the text at `position_` (ALIGN_*) real ( wp ) :: size_ = 2 0.0_wp !! character height (window units) real ( wp ) :: color_ ( 4 ) = [ 1.0_wp , 1.0_wp , 1.0_wp , 1.0_wp ] !! [r, g, b, a] (0 to 1) character ( len = :), allocatable :: font_ !! font file (unallocated: the default font) logical :: shown = . true . !! false while hidden integer :: revision_ = 0 !! incremented by each change contains procedure :: set_text , text procedure :: set_position , position procedure :: set_alignment , alignment procedure :: set_size , size procedure :: set_color , color procedure :: set_font , font procedure :: show , is_shown procedure :: revision end type HUDText !> The HUDText constructor: `HUDText(...)` makes one (see `new_hud_text` for its !> arguments). interface HUDText module procedure new_hud_text end interface HUDText contains !> HUD text `text`, optionally at `position` ([x, y], 0 to 1; default near !> the bottom left), with `alignment` (default ALIGN_LEFT_BOTTOM), `size` !> (window units; default 20), `color` ([r, g, b] or [r, g, b, a]; default !> white) and `font` (default: the default font). function new_hud_text ( text , position , alignment , size , color , font ) result ( h ) character ( len =* ), intent ( in ) :: text real ( wp ), intent ( in ), optional :: position ( 2 ) !! [x, y] (0 to 1 across the window, y up) real ( wp ), intent ( in ), optional :: size !! character height (window units) real ( wp ), intent ( in ), optional :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) integer , intent ( in ), optional :: alignment !! an ALIGN_* constant character ( len =* ), intent ( in ), optional :: font !! font file type ( HUDText ) :: h h % text_ = text if ( present ( position )) h % position_ = position if ( present ( alignment )) h % alignment_ = alignment if ( present ( size )) h % size_ = size if ( present ( color )) call h % set_color ( color ) if ( present ( font )) h % font_ = font end function new_hud_text !> Set the text (up to 256 characters, or twice the first text's length; see the module documentation). subroutine set_text ( self , text ) class ( HUDText ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: text self % text_ = text self % revision_ = self % revision_ + 1 end subroutine set_text !> The text (as shown: '' while hidden). function text ( self ) result ( t ) class ( HUDText ), intent ( in ) :: self character ( len = :), allocatable :: t t = '' if ( allocated ( self % text_ ) . and . self % shown ) t = self % text_ end function text !> Set where the text is. subroutine set_position ( self , position ) class ( HUDText ), intent ( inout ) :: self real ( wp ), intent ( in ) :: position ( 2 ) !! [x, y] (0 to 1 across the window, y up) self % position_ = position self % revision_ = self % revision_ + 1 end subroutine set_position !> Where the text is: [x, y] (0 to 1 across the window, y up). pure function position ( self ) result ( p ) class ( HUDText ), intent ( in ) :: self real ( wp ) :: p ( 2 ) p = self % position_ end function position !> Set which point of the text is at its position. subroutine set_alignment ( self , alignment ) class ( HUDText ), intent ( inout ) :: self integer , intent ( in ) :: alignment !! an ALIGN_* constant self % alignment_ = alignment self % revision_ = self % revision_ + 1 end subroutine set_alignment !> Which point of the text is at its position (an ALIGN_* constant). pure integer function alignment ( self ) class ( HUDText ), intent ( in ) :: self alignment = self % alignment_ end function alignment !> Set the size of the text. subroutine set_size ( self , size ) class ( HUDText ), intent ( inout ) :: self real ( wp ), intent ( in ) :: size !! character height (window units) self % size_ = size self % revision_ = self % revision_ + 1 end subroutine set_size !> The size of the text: character height (window units). pure real ( wp ) function size ( self ) class ( HUDText ), intent ( in ) :: self size = self % size_ end function size !> [r, g, b] (alpha unchanged) or [r, g, b, a], 0 to 1. subroutine set_color ( self , color ) class ( HUDText ), intent ( inout ) :: self real ( wp ), intent ( in ) :: color (:) integer :: n n = min ( 4 , ubound ( color , 1 )) self % color_ ( 1 : n ) = color ( 1 : n ) self % revision_ = self % revision_ + 1 end subroutine set_color !> The color: [r, g, b, a] (0 to 1). pure function color ( self ) result ( c ) class ( HUDText ), intent ( in ) :: self real ( wp ) :: c ( 4 ) c = self % color_ end function color !> Set the font (the text is made again when next drawn). subroutine set_font ( self , font ) class ( HUDText ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: font !! font file self % font_ = font self % revision_ = self % revision_ + 1 end subroutine set_font !> The font file ('' for the default font). function font ( self ) result ( f ) class ( HUDText ), intent ( in ) :: self character ( len = :), allocatable :: f f = '' if ( allocated ( self % font_ )) f = self % font_ end function font !> Show (true) or hide the text (OpenFrames' enable HUD text). subroutine show ( self , shown ) class ( HUDText ), intent ( inout ) :: self logical , intent ( in ) :: shown self % shown = shown self % revision_ = self % revision_ + 1 end subroutine show !> True if the text is shown. pure logical function is_shown ( self ) class ( HUDText ), intent ( in ) :: self is_shown = self % shown end function is_shown !> Number of changes so far (for the windows drawing the text to update it). pure integer function revision ( self ) class ( HUDText ), intent ( in ) :: self revision = self % revision_ end function revision end module vkf_hud","tags":"","url":"sourcefile/vkf_hud.f90.html"},{"title":"vkf_files.f90 – vkframes","text":"Files dependent on this one sourcefile~~vkf_files.f90~~AfferentGraph sourcefile~vkf_files.f90 vkf_files.f90 sourcefile~vkf_shapes.f90 vkf_shapes.f90 sourcefile~vkf_shapes.f90->sourcefile~vkf_files.f90 sourcefile~vkf_frames.f90 vkf_frames.f90 sourcefile~vkf_shapes.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_artists.f90 vkf_artists.f90 sourcefile~vkf_shapes.f90->sourcefile~vkf_artists.f90 sourcefile~vkf_sky.f90 vkf_sky.f90 sourcefile~vkf_sky.f90->sourcefile~vkf_files.f90 sourcefile~vkf_text.f90 vkf_text.f90 sourcefile~vkf_sky.f90->sourcefile~vkf_text.f90 sourcefile~vkf_sphere.f90 vkf_sphere.f90 sourcefile~vkf_sphere.f90->sourcefile~vkf_files.f90 sourcefile~vkf_sphere.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_terrain.f90 vkf_terrain.f90 sourcefile~vkf_terrain.f90->sourcefile~vkf_files.f90 sourcefile~vkf_terrain.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_text.f90->sourcefile~vkf_files.f90 sourcefile~vkframes.f90 vkframes.f90 sourcefile~vkframes.f90->sourcefile~vkf_files.f90 sourcefile~vkframes.f90->sourcefile~vkf_shapes.f90 sourcefile~vkframes.f90->sourcefile~vkf