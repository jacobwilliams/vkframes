camera => view_set_camera procedure, public :: set_default_view_distance procedure, public :: set_default_view_parameters procedure, public :: set_orthographic procedure, public :: set_perspective procedure, public :: set_view_between_frames procedure, public :: set_view_frame procedure, public :: take_camera procedure, public :: take_reset procedure, public :: view_frame procedure, public :: view_frame_type procedure, public :: view_root procedure, public :: view_rotation_type procedure, public :: world_to_view Functions public pure function camera_between (s, from, to) result(cam) The camera a fraction s (0 to 1) of the way from camera from to\ncamera to (columns: eye, center, up; in one frame's coordinates): the\ncenter moved along a straight line, the distance to it changed by the\nsame factor at each step (so far-to-near flights don't rush the near\npart), and the orientation turned by the shortest rotation. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: s fraction of the way (0: from , 1: to ) real(kind=wp), intent(in) :: from (3,3) (columns: eye, center, up) real(kind=wp), intent(in) :: to (3,3) (columns: eye, center, up) Return Value real(kind=wp), (3,3) private pure function default_view_distance (self) The radius framed when the view is reset (<= 0: the viewed frame's bound). Arguments Type Intent Optional Attributes Name class( View ), intent(in) :: self Return Value real(kind=wp) private pure function field_of_view (self) result(fovy) The vertical field of view (degrees) of the perspective projection. Arguments Type Intent Optional Attributes Name class( View ), intent(in) :: self Return Value real(kind=wp) private  function frame_to_root (self, f) result(m) The transform from f to the view's root frame (the tree root if none). Arguments Type Intent Optional Attributes Name type( View ), intent(in) :: self class( ReferenceFrame ), intent(in) :: f Return Value real(kind=wp), (4,4) private  function is_valid (self) True if the 