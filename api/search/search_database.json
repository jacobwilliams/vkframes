rgb) The ambient, diffuse and specular colors ([r, g, b], 0 to 1) of the\nwindow's light (OpenFrames' defaults: 0.2 gray, white, none). The\nwindow's light is used while no frame of the scene has a light source\n(ReferenceFrame%set_light_source_enabled). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) private  subroutine set_light_diffuse (self, rgb) The diffuse color of the window's light (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) private  subroutine set_light_position (self, position) The light's position in eye coordinates (x right, y up, z toward the\nviewer): [x, y, z, 0] for a directional light from direction (x, y, z),\n[x, y, z, 1] for a point light (OpenFrames' setLightPosition; default\n[0, 0, 1, 0], a headlight). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: position (4) [x, y, z, w], eye coordinates (not all 0) private  subroutine set_light_specular (self, rgb) The specular color of the window's light (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) private  subroutine set_scene (self, fm) Show the scene of fm (which must stay alive while shown). For now, set\nit before the window's first frame. Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self type( FrameManager ), intent(in), target :: fm private  subroutine set_sky (self, sky) Draw sky behind the scene (it must stay alive while shown; it can be\nshown in several windows), in place of the window's sky so far; at any\ntime (its texture and stars can change too). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self type( SkySphere ), intent(inout), target :: sky private  subroutine set_time (self, t) Set the simulation time (limited to the time range). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time private  subroutine set_time_range (self, t_min, t_max) Limit the simulation time to [t_min, t_max] (ignored if t_max < t_min). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: t_min simulation times real(kind=wp), intent(in) :: t_max simulation times private  subroutine set_time_scale (self, scale) Simulation seconds per wall-clock second (may be 0 or negative). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: scale private  subroutine set_view_transition (self, seconds) The time (s) a change of view or a reset flies from one camera to the\nother (default 0: a cut, as OpenFrames). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: seconds wall-clock s (0: a cut) private  subroutine set_zoom_speed (self, speed) How fast the mouse zooms (default 1, VSG's: 10% per wheel step, and a\nright drag's rate): e.g. 0.3 for a gentler zoom. Scales scroll steps\nhowever they come (a mouse wheel, a trackpad, a host's scroll ). Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: speed (> 0; 1: the default) private  subroutine start_flight (self, from, start, to, finish, duration) Fly from camera start (in view from 's frame) to finish (in view to 's) over duration s, from now. Arguments Type Intent Optional Attributes Name type( WindowProxy ), intent(inout) :: self type( View ), intent(in), target :: from real(kind=wp), intent(in) :: start (3,3) (columns: eye, center, up; duration: s) type( View ), intent(in), target :: to real(kind=wp), intent(in) :: finish (3,3) (columns: eye, cen