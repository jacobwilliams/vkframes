e ( self % posopt , int64 ) / 8 * size ( self % posopt , kind = int64 ) if ( allocated ( self % att )) b = b + storage_size ( self % att , int64 ) / 8 * size ( self % att , kind = int64 ) if ( allocated ( self % col )) b = b + storage_size ( self % col , int64 ) / 8 * size ( self % col , kind = int64 ) end function storage_bytes","tags":"","url":"proc/storage_bytes.html"},{"title":"time – vkframes","text":"private pure function time(self, i) Time i. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: i Return Value real(kind=wp) Source Code pure real ( wp ) function time ( self , i ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i time = self % t ( i ) end function time","tags":"","url":"proc/time.html"},{"title":"time_distance – vkframes","text":"private pure function time_distance(self, t) The \"distance\" from time t to the time range [t0, tf]: > 0 outside it (to\nthe nearer end), 0 at its ends, < 0 inside; huge() without times.\n(OpenFrames' getTimeDistance.) Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self real(kind=wp), intent(in) :: t Return Value real(kind=wp) Called by proc~~time_distance~~CalledByGraph proc~time_distance Trajectory%time_distance proc~chosen_trajectory chosen_trajectory proc~chosen_trajectory->proc~time_distance proc~time_index Trajectory%time_index proc~time_index->proc~time_distance proc~point_at Trajectory%point_at proc~point_at->proc~time_index proc~update TrajectoryFollower%update proc~update->proc~chosen_trajectory proc~update->proc~time_index proc~trajectory_path_position TrajectoryPath%trajectory_path_position proc~trajectory_path_position->proc~point_at proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure real ( wp ) function time_distance ( self , t ) class ( Trajectory ), intent ( in ) :: self real ( wp ), intent ( in ) :: t real ( wp ) :: t0 , tf if ( self % n_times == 0 ) then time_distance = huge ( 1.0_wp ) return end if t0 = min ( self % t ( 1 ), self % t ( self % n_times )) tf = max ( self % t ( 1 ), self % t ( self % n_times )) if ( t <= t0 ) then time_distance = t0 - t else if ( t >= tf ) then time_distance = t - tf else time_distance = ( t - t0 ) * ( t - tf ) end if end function time_distance","tags":"","url":"proc/time_distance.html"},{"title":"time_fraction – vkframes","text":"private pure function time_fraction(self, k, k2, t) result(frac) The fraction of the way in time from point k to point k2 (any two\npoints: e.g. k + 1, or k - 1 with times running backward) at time t,\nkept within 0 to 1 (0 if their times are the same). No checks: k and k2\nmust be times. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: k the points (1 to num_times) integer, intent(in) :: k2 the points (1 to num_times) real(kind=wp), intent(in) :: t the time Return Value real(kind=wp) Called by proc~~time_fraction~~CalledByGraph proc~time_fraction Trajectory%time_fraction proc~point_between Trajectory%point_between proc~point_between->proc~time_fraction proc~interpolate_position interpolate_position proc~interpolate_position->proc~point_between proc~point_at Trajectory%point_at proc~point_at->proc~point_between proc~trajectory_path_position TrajectoryPath%trajectory_path_position proc~trajectory_path_position->proc~point_at proc~update TrajectoryFollower%update proc~update->proc~interpolate_position proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure real ( wp ) function time_fraction ( self , k , k2 , t ) result ( frac ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: k , k2 !! the points (1 to num_times) real ( wp ), intent ( in ) :: t !! the time frac = 0.0_wp if ( self % t ( k2 ) /= self % t ( k )) frac = max ( 0.0_wp , min ( 1.0_wp , ( t - self % t ( k )) / ( self % t ( k2 ) - self % t ( k )))) end function time_fraction","tags":"","url":"proc/time_fraction.html"},{"title":"time_index – vkframes","text":"private  function time_index(self, t, index) result(status) Find the interval of the time list containing t, by bisection (times\nincreasing or decreasing). Returns a TIME_ code, or the number of\niterations (> 0) when found, with times(index) <= t < times(index+1) for\nincreasing times (>= and > for decreasing). See the TIME_ constants for index in the other cases. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self real(kind=wp), intent(in) :: t integer, intent(out) :: index the interval's first index (see the TIME_* constants) Return Value integer Calls proc~~time_index~~CallsGraph proc~time_index Trajectory%time_index proc~time_distance Trajectory%time_distance proc~time_index->proc~time_distance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~time_index~~CalledByGraph proc~time_index Trajectory%time_index proc~point_at Trajectory%point_at proc~point_at->proc~time_index proc~update TrajectoryFollower%update proc~update->proc~time_index proc~trajectory_path_position TrajectoryPath%trajectory_path_position proc~trajectory_path_position->proc~point_at proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code integer function time_index ( self , t , index ) result ( status ) class ( Trajectory ), intent ( in ) :: self real ( wp ), intent ( in ) :: t integer , intent ( out ) :: index !! the interval's first index (see the TIME_* constants) integer :: low , high , mid , iter , n real ( wp ) :: dir , dist n = self % n_times if ( n == 0 ) then index = 0 status = TIME_OUT_OF_RANGE return end if dir = merge ( 1.0_wp , - 1.0_wp , self % t ( 1 ) <= self % t ( n )) dist = self % time_distance ( t ) if ( dist > 0.0_wp ) then index = merge ( 0 , n + 1 , dir * t < dir * self % t ( 1 )) status = TIME_OUT_OF_RANGE return else if ( dist == 0.0_wp ) then index = merge ( 1 , n , t == self % t ( 1 )) status = TIME_AT_BOUND return end if low = 1 high = n do iter = 1 , 64 mid = low + ( high - low ) / 2 if ( dir * t < dir * self % t ( mid )) then high = mid else low = mid end if if ( high - low <= 1 ) then index = low status = iter return end if end do index = low status = TIME_NOT_FOUND end function time_index","tags":"","url":"proc/time_index.html"},{"title":"time_range – vkframes","text":"private  function time_range(self, t0, tf) The first and last times, ordered (t0 <= tf); false if there are no times. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self real(kind=wp), intent(out) :: t0 real(kind=wp), intent(out) :: tf Return Value logical Called by proc~~time_range~~CalledByGraph proc~time_range Trajectory%time_range proc~wrapped_time wrapped_time proc~wrapped_time->proc~time_range proc~update TrajectoryFollower%update proc~update->proc~wrapped_time proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code logical function time_range ( self , t0 , tf ) class ( Trajectory ), intent ( in ) :: self real ( wp ), intent ( out ) :: t0 , tf time_range = self % n_times > 0 if (. not . time_range ) then t0 = 0.0_wp tf = 0.0_wp return end if t0 = min ( self % t ( 1 ), self % t ( self % n_times )) tf = max ( self % t ( 1 ), self % t ( self % n_times )) end function time_range","tags":"","url":"proc/time_range.html"},{"title":"verify_data – vkframes","text":"private pure function verify_data(self, sources) True if the trajectory has the data the sources refer to (elements and\noptionals in range). Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self type( DataSource ), intent(in) :: sources (3) Return Value logical Called by proc~~verify_data~~CalledByGraph proc~verify_data Trajectory%verify_data proc~data_valid TrajectoryFollower%data_valid proc~data_valid->proc~verify_data proc~source_points source_points proc~source_points->proc~verify_data proc~curve_points CurveArtist%curve_points proc~curve_points->proc~source_points proc~marker_pick marker_pick proc~marker_pick->proc~source_points proc~marker_update MarkerArtist%marker_update proc~marker_update->proc~source_points proc~ribbon_points RibbonArtist%ribbon_points proc~ribbon_points->proc~source_points proc~segment_count segment_count proc~segment_count->proc~source_points proc~set_x_data TrajectoryFollower%set_x_data proc~set_x_data->proc~data_valid proc~set_y_data TrajectoryFollower%set_y_data proc~set_y_data->proc~data_valid proc~set_z_data TrajectoryFollower%set_z_data proc~set_z_data->proc~data_valid proc~update TrajectoryFollower%update proc~update->proc~data_valid proc~drawable_pick DrawableTrajectory%drawable_pick proc~drawable_pick->proc~marker_pick proc~segment_build SegmentArtist%segment_build proc~segment_build->proc~segment_count proc~segment_update SegmentArtist%segment_update proc~segment_update->proc~segment_count proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure logical function verify_data ( self , sources ) class ( Trajectory ), intent ( in ) :: self type ( DataSource ), intent ( in ) :: sources ( 3 ) integer :: k verify_data = . true . do k = 1 , 3 select case ( sources ( k )% src ) case ( SOURCE_ZERO , SOURCE_TIME ) case ( SOURCE_POSOPT ) if ( sources ( k )% element < 1 . or . sources ( k )% element > self % dof_ . or . & sources ( k )% opt < 0 . or . sources ( k )% opt > self % nopt_ ) verify_data = . false . case ( SOURCE_ATTITUDE ) if ( sources ( k )% element < 1 . or . sources ( k )% element > 4 ) verify_data = . false . case default verify_data = . false . end select end do end function verify_data","tags":"","url":"proc/verify_data.html"},{"title":"add_attitude – vkframes","text":"private  subroutine add_attitude(self, q, ok) Add an attitude quaternion [x, y, z, w] for the next time that has none. ok is false if every time already has an attitude. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) quaternion [x, y, z, w] logical, intent(out), optional :: ok false if not added Calls proc~~add_attitude~~CallsGraph proc~add_attitude Trajectory%add_attitude proc~grow_attitudes grow_attitudes proc~add_attitude->proc~grow_attitudes proc~new_capacity new_capacity proc~grow_attitudes->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~add_attitude~~CalledByGraph proc~add_attitude Trajectory%add_attitude proc~add_point Trajectory%add_point proc~add_point->proc~add_attitude Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine add_attitude ( self , q , ok ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: q ( 4 ) !! quaternion [x, y, z, w] logical , intent ( out ), optional :: ok !! false if not added if ( present ( ok )) ok = . false . if ( self % n_att >= self % n_times ) return call grow_attitudes ( self , self % n_att + 1 ) self % n_att = self % n_att + 1 self % att (:, self % n_att ) = q self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine add_attitude","tags":"","url":"proc/add_attitude.html"},{"title":"add_color – vkframes","text":"private  subroutine add_color(self, color, ok) Add a color ([r, g, b], alpha 1, or [r, g, b, a], 0 to 1) for the next\ntime that has none. ok is false if every time already has a color. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) logical, intent(out), optional :: ok false if not added Calls proc~~add_color~~CallsGraph proc~add_color Trajectory%add_color proc~grow_colors grow_colors proc~add_color->proc~grow_colors proc~to_float_rgba to_float_rgba proc~add_color->proc~to_float_rgba proc~new_capacity new_capacity proc~grow_colors->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~add_color~~CalledByGraph proc~add_color Trajectory%add_color proc~add_point Trajectory%add_point proc~add_point->proc~add_color Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine add_color ( self , color , ok ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) logical , intent ( out ), optional :: ok !! false if not added if ( present ( ok )) ok = . false . if ( self % n_col >= self % n_times ) return call grow_colors ( self , self % n_col + 1 ) self % n_col = self % n_col + 1 call to_float_rgba ( self % col (:, self % n_col ), color ) self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine add_color","tags":"","url":"proc/add_color.html"},{"title":"add_point – vkframes","text":"private  subroutine add_point(self, t, pos, att, color) Add a point: a time with an optional position, attitude and color\n([r, g, b] or [r, g, b, a]). Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t time real(kind=wp), intent(in), optional :: pos (:) position (first dof elements used) real(kind=wp), intent(in), optional :: att (4) attitude quaternion [x, y, z, w] real(kind=wp), intent(in), optional :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) Calls proc~~add_point~~CallsGraph proc~add_point Trajectory%add_point proc~add_attitude Trajectory%add_attitude proc~add_point->proc~add_attitude proc~add_color Trajectory%add_color proc~add_point->proc~add_color proc~add_position Trajectory%add_position proc~add_point->proc~add_position proc~add_time Trajectory%add_time proc~add_point->proc~add_time proc~grow_attitudes grow_attitudes proc~add_attitude->proc~grow_attitudes proc~grow_colors grow_colors proc~add_color->proc~grow_colors proc~to_float_rgba to_float_rgba proc~add_color->proc~to_float_rgba proc~grow_positions grow_positions proc~add_position->proc~grow_positions proc~grow_times grow_times proc~add_time->proc~grow_times proc~new_capacity new_capacity proc~grow_attitudes->proc~new_capacity proc~grow_colors->proc~new_capacity proc~grow_positions->proc~new_capacity proc~grow_times->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine add_point ( self , t , pos , att , color ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t !! time real ( wp ), intent ( in ), optional :: pos (:) !! position (first `dof` elements used) real ( wp ), intent ( in ), optional :: att ( 4 ) !! attitude quaternion [x, y, z, w] real ( wp ), intent ( in ), optional :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) call self % add_time ( t ) if ( present ( pos )) call self % add_position ( pos ) if ( present ( att )) call self % add_attitude ( att ) if ( present ( color )) call self % add_color ( color ) end subroutine add_point","tags":"","url":"proc/add_point.html"},{"title":"add_points – vkframes","text":"private  subroutine add_points(self, t, pos, att, color) Add points in bulk: times t(n) , with optional positions pos(dof, n) ,\nattitudes att(4, n) and colors color(3 or 4, n) . Times, positions,\nattitudes and colors must all have been complete before (as many of each\nas times) for the given ones to line up with t . Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t (:) (n): times real(kind=wp), intent(in), optional :: pos (:,:) (dof, n): positions real(kind=wp), intent(in), optional :: att (:,:) (4, n): attitude quaternions [x, y, z, w] real(kind=wp), intent(in), optional :: color (:,:) (3 or 4, n): colors [r, g, b(, a)] (0 to 1) Calls proc~~add_points~~CallsGraph proc~add_points Trajectory%add_points proc~grow_attitudes grow_attitudes proc~add_points->proc~grow_attitudes proc~grow_colors grow_colors proc~add_points->proc~grow_colors proc~grow_positions grow_positions proc~add_points->proc~grow_positions proc~grow_times grow_times proc~add_points->proc~grow_times proc~new_capacity new_capacity proc~grow_attitudes->proc~new_capacity proc~grow_colors->proc~new_capacity proc~grow_positions->proc~new_capacity proc~grow_times->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine add_points ( self , t , pos , att , color ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t (:) !! (n): times real ( wp ), intent ( in ), optional :: pos (:,:) !! (dof, n): positions real ( wp ), intent ( in ), optional :: att (:,:) !! (4, n): attitude quaternions [x, y, z, w] real ( wp ), intent ( in ), optional :: color (:,:) !! (3 or 4, n): colors [r, g, b(, a)] (0 to 1) integer :: n , i0 , d n = size ( t ) i0 = self % n_times call grow_times ( self , i0 + n ) self % t ( i0 + 1 : i0 + n ) = t self % n_times = i0 + n if ( present ( pos )) then n = min ( size ( pos , 2 ), self % n_times - self % n_pos ) d = min ( self % dof_ , size ( pos , 1 )) call grow_positions ( self , self % n_pos + n ) self % posopt (:, :, self % n_pos + 1 : self % n_pos + n ) = 0.0_wp self % posopt ( 1 : d , 0 , self % n_pos + 1 : self % n_pos + n ) = pos ( 1 : d , 1 : n ) self % n_pos = self % n_pos + n end if if ( present ( att )) then n = min ( size ( att , 2 ), self % n_times - self % n_att ) call grow_attitudes ( self , self % n_att + n ) self % att (:, self % n_att + 1 : self % n_att + n ) = att (:, 1 : n ) self % n_att = self % n_att + n end if if ( present ( color )) then n = min ( size ( color , 2 ), self % n_times - self % n_col ) d = min ( 4 , size ( color , 1 )) call grow_colors ( self , self % n_col + n ) self % col (:, self % n_col + 1 : self % n_col + n ) = 1.0_c_float self % col ( 1 : d , self % n_col + 1 : self % n_col + n ) = real ( color ( 1 : d , 1 : n ), c_float ) self % n_col = self % n_col + n end if self % revision_ = self % revision_ + 1 end subroutine add_points","tags":"","url":"proc/add_points.html"},{"title":"add_position – vkframes","text":"private  subroutine add_position(self, pos, ok) Add a position (the first dof elements of pos are used) for the next\ntime that has none. ok is false if every time already has a position. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: pos (:) logical, intent(out), optional :: ok false if not added Calls proc~~add_position~~CallsGraph proc~add_position Trajectory%add_position proc~grow_positions grow_positions proc~add_position->proc~grow_positions proc~new_capacity new_capacity proc~grow_positions->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~add_position~~CalledByGraph proc~add_position Trajectory%add_position proc~add_point Trajectory%add_point proc~add_point->proc~add_position Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine add_position ( self , pos , ok ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: pos (:) logical , intent ( out ), optional :: ok !! false if not added integer :: d if ( present ( ok )) ok = . false . if ( self % n_pos >= self % n_times ) return call grow_positions ( self , self % n_pos + 1 ) self % n_pos = self % n_pos + 1 d = min ( self % dof_ , size ( pos )) self % posopt (:, :, self % n_pos ) = 0.0_wp self % posopt ( 1 : d , 0 , self % n_pos ) = pos ( 1 : d ) self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine add_position","tags":"","url":"proc/add_position.html"},{"title":"add_time – vkframes","text":"private  subroutine add_time(self, t) Add a time at the end of the time list. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t Calls proc~~add_time~~CallsGraph proc~add_time Trajectory%add_time proc~grow_times grow_times proc~add_time->proc~grow_times proc~new_capacity new_capacity proc~grow_times->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~add_time~~CalledByGraph proc~add_time Trajectory%add_time proc~add_point Trajectory%add_point proc~add_point->proc~add_time Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine add_time ( self , t ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t call grow_times ( self , self % n_times + 1 ) self % n_times = self % n_times + 1 self % t ( self % n_times ) = t self % revision_ = self % revision_ + 1 end subroutine add_time","tags":"","url":"proc/add_time.html"},{"title":"attitudes – vkframes","text":"private  subroutine attitudes(self, q) Pointer to the attitudes (4, num_attitudes), without copying. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in), target :: self real(kind=wp), intent(out), dimension(:,:), pointer :: q Source Code subroutine reserve ( self , n , positions , attitudes , colors ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: n !! number of points logical , intent ( in ), optional :: positions !! reserve positions (default true) logical , intent ( in ), optional :: attitudes !! reserve attitudes (default false) logical , intent ( in ), optional :: colors !! reserve colors (default false) logical :: pos , att , col pos = . true . att = . false . col = . false . if ( present ( positions )) pos = positions if ( present ( attitudes )) att = attitudes if ( present ( colors )) col = colors call grow_times ( self , n , exact = . true .) if ( pos ) call grow_positions ( self , n , exact = . true .) if ( att ) call grow_attitudes ( self , n , exact = . true .) if ( col ) call grow_colors ( self , n , exact = . true .) end subroutine reserve !> Free the storage not used: each array is reallocated to the points it !> holds (one copy, an array at a time), and arrays holding none are !> deallocated. For a trajectory that is complete: growing doubles the !> storage, so up to about half of it can be unused. The data and what is !> drawn of them don't change; pointers from `times`, `positions`, ... !> must be fetched again. Points can still be added (storage grows again). subroutine compact ( self ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), allocatable :: t (:), posopt (:,:,:), att (:,:) real ( c_float ), allocatable :: col (:,:) if ( allocated ( self % t )) then if ( size ( self % t ) /= self % n_times ) then allocate ( t ( self % n_times )) t = self % t ( 1 : self % n_times ) call move_alloc ( t , self % t ) end if if ( self % n_times == 0 ) deallocate ( self % t ) end if if ( allocated ( self % posopt )) then if ( size ( self % posopt , 3 ) /= self % n_pos ) then allocate ( posopt ( 3 , 0 : self % nopt_ , self % n_pos )) posopt = self % posopt (:, :, 1 : self % n_pos ) call move_alloc ( posopt , self % posopt ) end if if ( self % n_pos == 0 ) deallocate ( self % posopt ) end if if ( allocated ( self % att )) then if ( size ( self % att , 2 ) /= self % n_att ) then allocate ( att ( 4 , self % n_att )) att = self % att (:, 1 : self % n_att ) call move_alloc ( att , self % att ) end if if ( self % n_att == 0 ) deallocate ( self % att ) end if if ( allocated ( self % col )) then if ( size ( self % col , 2 ) /= self % n_col ) then allocate ( col ( 4 , self % n_col )) col = self % col (:, 1 : self % n_col ) call move_alloc ( col , self % col ) end if if ( self % n_col == 0 ) deallocate ( self % col ) end if end subroutine compact !> The memory the trajectory's data take (bytes), used or not: its !> storage's capacity (see `reserve`, `compact`). pure integer ( int64 ) function storage_bytes ( self ) result ( b ) class ( Trajectory ), intent ( in ) :: self b = 0_int64 if ( allocated ( self % t )) b = b + storage_size ( self % t , int64 ) / 8 * size ( self % t , kind = int64 ) if ( allocated ( self % posopt )) b = b + storage_size ( self % posopt , int64 ) / 8 * size ( self % posopt , kind = int64 ) if ( allocated ( self % att )) b = b + storage_size ( self % att , int64 ) / 8 * size ( self % att , kind = int64 ) if ( allocated ( self % col )) b = b + storage_size ( self % col , int64 ) / 8 * size ( self % col , kind = int64 ) end function storage_bytes !> Remove all points (keeping the memory). subroutine clear ( self ) class ( Trajectory ), intent ( inout ) :: self self % n_times = 0 self % n_pos = 0 self % n_att = 0 self % n_col = 0 self % generation_ = self % generation_ + 1 self % revision_ = self % revision_ + 1 end subroutine clear !> Set the degrees of freedom (2 or 3) of positions and optionals; clears the trajectory. subroutine set_dof ( self , dof ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: dof self % dof_ = max ( 2 , min ( 3 , dof )) call self % clear () end subroutine set_dof !> Degrees of freedom (2 or 3) of positions and optionals. pure integer function dof ( self ) class ( Trajectory ), intent ( in ) :: self dof = self % dof_ end function dof !> Set the number of optional vectors per position; clears the trajectory. subroutine set_num_optionals ( self , nopt ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: nopt if ( nopt /= self % nopt_ . and . allocated ( self % posopt )) deallocate ( self % posopt ) self % nopt_ = max ( 0 , nopt ) call self % clear () end subroutine set_num_optionals !> Number of optional vectors per position. pure integer function num_optionals ( self ) class ( Trajectory ), intent ( in ) :: self num_optionals = self % nopt_ end function num_optionals !> Number of times. pure integer function num_times ( self ) class ( Trajectory ), intent ( in ) :: self num_times = self % n_times end function num_times !> Number of positions (at most num_times). pure integer function num_positions ( self ) class ( Trajectory ), intent ( in ) :: self num_positions = self % n_pos end function num_positions !> Number of attitudes (at most num_times). pure integer function num_attitudes ( self ) class ( Trajectory ), intent ( in ) :: self num_attitudes = self % n_att end function num_attitudes !> Number of colors (at most num_times). pure integer function num_colors ( self ) class ( Trajectory ), intent ( in ) :: self num_colors = self % n_col end function num_colors !> True if the trajectory has no times. pure logical function is_empty ( self ) class ( Trajectory ), intent ( in ) :: self is_empty = self % n_times == 0 end function is_empty !> Number of changes so far (any added, set or cleared data). pure integer function revision ( self ) class ( Trajectory ), intent ( in ) :: self revision = self % revision_ end function revision !> Number of times the data were cleared (by `clear`, `set_dof` or !> `set_num_optionals`): while it is unchanged, data were only appended. pure integer function generation ( self ) class ( Trajectory ), intent ( in ) :: self generation = self % generation_ end function generation ! ================================================================== ! adding data !> Add a time at the end of the time list. subroutine add_time ( self , t ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t call grow_times ( self , self % n_times + 1 ) self % n_times = self % n_times + 1 self % t ( self % n_times ) = t self % revision_ = self % revision_ + 1 end subroutine add_time !> Add a position (the first `dof` elements of `pos` are used) for the next !> time that has none. `ok` is false if every time already has a position. subroutine add_position ( self , pos , ok ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: pos (:) logical , intent ( out ), optional :: ok !! false if not added integer :: d if ( present ( ok )) ok = . false . if ( self % n_pos >= self % n_times ) return call grow_positions ( self , self % n_pos + 1 ) self % n_pos = self % n_pos + 1 d = min ( self % dof_ , size ( pos )) self % posopt (:, :, self % n_pos ) = 0.0_wp self % posopt ( 1 : d , 0 , self % n_pos ) = pos ( 1 : d ) self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine add_position !> Add an attitude quaternion [x, y, z, w] for the next time that has none. !> `ok` is false if every time already has an attitude. subroutine add_attitude ( self , q , ok ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: q ( 4 ) !! quaternion [x, y, z, w] logical , intent ( out ), optional :: ok !! false if not added if ( present ( ok )) ok = . false . if ( self % n_att >= self % n_times ) return call grow_attitudes ( self , self % n_att + 1 ) self % n_att = self % n_att + 1 self % att (:, self % n_att ) = q self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine add_attitude !> Add a color ([r, g, b], alpha 1, or [r, g, b, a], 0 to 1) for the next !> time that has none. `ok` is false if every time already has a color. subroutine add_color ( self , color , ok ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) logical , intent ( out ), optional :: ok !! false if not added if ( present ( ok )) ok = . false . if ( self % n_col >= self % n_times ) return call grow_colors ( self , self % n_col + 1 ) self % n_col = self % n_col + 1 call to_float_rgba ( self % col (:, self % n_col ), color ) self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine add_color !> rgba from [r, g, b] (alpha 1) or [r, g, b, a]. pure subroutine to_float_rgba ( rgba , color ) real ( c_float ), intent ( out ) :: rgba ( 4 ) !! [r, g, b, a] real ( wp ), intent ( in ) :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) integer :: n n = min ( 4 , size ( color )) rgba = 1.0_c_float rgba ( 1 : n ) = real ( color ( 1 : n ), c_float ) end subroutine to_float_rgba !> Set optional vector `index` (1 to num_optionals) of the most recently !> added position. `ok` is false if there is no position or no such optional. subroutine set_optional ( self , index , v , ok ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: index !! the optional (1 to num_optionals) real ( wp ), intent ( in ) :: v (:) !! the vector (its first `dof` elements are used) logical , intent ( out ), optional :: ok !! false if not set integer :: d if ( present ( ok )) ok = . false . if ( index < 1 . or . index > self % nopt_ . or . self % n_pos == 0 ) return d = min ( self % dof_ , size ( v )) self % posopt ( 1 : d , index , self % n_pos ) = v ( 1 : d ) self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine set_optional !> Add a point: a time with an optional position, attitude and color !> ([r, g, b] or [r, g, b, a]). subroutine add_point ( self , t , pos , att , color ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t !! time real ( wp ), intent ( in ), optional :: pos (:) !! position (first `dof` elements used) real ( wp ), intent ( in ), optional :: att ( 4 ) !! attitude quaternion [x, y, z, w] real ( wp ), intent ( in ), optional :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) call self % add_time ( t ) if ( present ( pos )) call self % add_position ( pos ) if ( present ( att )) call self % add_attitude ( att ) if ( present ( color )) call self % add_color ( color ) end subroutine add_point !> Add points in bulk: times `t(n)`, with optional positions `pos(dof, n)`, !> attitudes `att(4, n)` and colors `color(3 or 4, n)`. Times, positions, !> attitudes and colors must all have been complete before (as many of each !> as times) for the given ones to line up with `t`. subroutine add_points ( self , t , pos , att , color ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t (:) !! (n): times real ( wp ), intent ( in ), optional :: pos (:,:) !! (dof, n): positions real ( wp ), intent ( in ), optional :: att (:,:) !! (4, n): attitude quaternions [x, y, z, w] real ( wp ), intent ( in ), optional :: color (:,:) !! (3 or 4, n): colors [r, g, b(, a)] (0 to 1) integer :: n , i0 , d n = size ( t ) i0 = self % n_times call grow_times ( self , i0 + n ) self % t ( i0 + 1 : i0 + n ) = t self % n_times = i0 + n if ( present ( pos )) then n = min ( size ( pos , 2 ), self % n_times - self % n_pos ) d = min ( self % dof_ , size ( pos , 1 )) call grow_positions ( self , self % n_pos + n ) self % posopt (:, :, self % n_pos + 1 : self % n_pos + n ) = 0.0_wp self % posopt ( 1 : d , 0 , self % n_pos + 1 : self % n_pos + n ) = pos ( 1 : d , 1 : n ) self % n_pos = self % n_pos + n end if if ( present ( att )) then n = min ( size ( att , 2 ), self % n_times - self % n_att ) call grow_attitudes ( self , self % n_att + n ) self % att (:, self % n_att + 1 : self % n_att + n ) = att (:, 1 : n ) self % n_att = self % n_att + n end if if ( present ( color )) then n = min ( size ( color , 2 ), self % n_times - self % n_col ) d = min ( 4 , size ( color , 1 )) call grow_colors ( self , self % n_col + n ) self % col (:, self % n_col + 1 : self % n_col + n ) = 1.0_c_float self % col ( 1 : d , self % n_col + 1 : self % n_col + n ) = real ( color ( 1 : d , 1 : n ), c_float ) self % n_col = self % n_col + n end if self % revision_ = self % revision_ + 1 end subroutine add_points ! ================================================================== ! reading data !> Time i. pure real ( wp ) function time ( self , i ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i time = self % t ( i ) end function time !> Position i (z = 0 for a 2-DOF trajectory). pure function position ( self , i ) result ( p ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i real ( wp ) :: p ( 3 ) p = self % posopt (:, 0 , i ) end function position !> Attitude i (quaternion [x, y, z, w]). pure function attitude ( self , i ) result ( q ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i real ( wp ) :: q ( 4 ) q = self % att (:, i ) end function attitude !> Color i ([r, g, b, a]). pure function color ( self , i ) result ( c ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i real ( wp ) :: c ( 4 ) c = real ( self % col (:, i ), wp ) end function color !> Optional vector k (1 to num_optionals) of position i. pure function optional ( self , i , k ) result ( v ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i , k real ( wp ) :: v ( 3 ) v = self % posopt (:, k , i ) end function optional !> Pointer to the times (num_times), without copying. subroutine times ( self , t ) class ( Trajectory ), intent ( in ), target :: self real ( wp ), dimension (:), pointer , intent ( out ) :: t if ( self % n_times == 0 ) then t => null () else t => self % t ( 1 : self % n_times ) end if end subroutine times !> Pointer to the positions (3, num_positions), without copying. subroutine positions ( self , p ) class ( Trajectory ), intent ( in ), target :: self real ( wp ), dimension (:,:), pointer , intent ( out ) :: p if ( self % n_pos == 0 ) then p => null () else p => self % posopt (:, 0 , 1 : self % n_pos ) end if end subroutine positions !> Pointer to the attitudes (4, num_attitudes), without copying. subroutine attitudes ( self , q ) class ( Trajectory ), intent ( in ), target :: self real ( wp ), dimension (:,:), pointer , intent ( out ) :: q if ( self % n_att == 0 ) then q => null () else q => self % att (:, 1 : self % n_att ) end if end subroutine attitudes","tags":"","url":"proc/attitudes.html"},{"title":"clear – vkframes","text":"private  subroutine clear(self) Remove all points (keeping the memory). Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self Called by proc~~clear~~CalledByGraph proc~clear Trajectory%clear proc~set_dof Trajectory%set_dof proc~set_dof->proc~clear proc~set_num_optionals Trajectory%set_num_optionals proc~set_num_optionals->proc~clear Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine clear ( self ) class ( Trajectory ), intent ( inout ) :: self self % n_times = 0 self % n_pos = 0 self % n_att = 0 self % n_col = 0 self % generation_ = self % generation_ + 1 self % revision_ = self % revision_ + 1 end subroutine clear","tags":"","url":"proc/clear.html"},{"title":"colors – vkframes","text":"private  subroutine colors(self, c) Pointer to the colors (4, num_colors; single precision, as drawn),\nwithout copying. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in), target :: self real(kind=c_float), intent(out), dimension(:,:), pointer :: c Source Code subroutine colors ( self , c ) class ( Trajectory ), intent ( in ), target :: self real ( c_float ), dimension (:,:), pointer , intent ( out ) :: c if ( self % n_col == 0 ) then c => null () else c => self % col (:, 1 : self % n_col ) end if end subroutine colors","tags":"","url":"proc/colors.html"},{"title":"compact – vkframes","text":"private  subroutine compact(self) Free the storage not used: each array is reallocated to the points it\nholds (one copy, an array at a time), and arrays holding none are\ndeallocated. For a trajectory that is complete: growing doubles the\nstorage, so up to about half of it can be unused. The data and what is\ndrawn of them don't change; pointers from times , positions , ...\nmust be fetched again. Points can still be added (storage grows again). Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self Source Code subroutine compact ( self ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), allocatable :: t (:), posopt (:,:,:), att (:,:) real ( c_float ), allocatable :: col (:,:) if ( allocated ( self % t )) then if ( size ( self % t ) /= self % n_times ) then allocate ( t ( self % n_times )) t = self % t ( 1 : self % n_times ) call move_alloc ( t , self % t ) end if if ( self % n_times == 0 ) deallocate ( self % t ) end if if ( allocated ( self % posopt )) then if ( size ( self % posopt , 3 ) /= self % n_pos ) then allocate ( posopt ( 3 , 0 : self % nopt_ , self % n_pos )) posopt = self % posopt (:, :, 1 : self % n_pos ) call move_alloc ( posopt , self % posopt ) end if if ( self % n_pos == 0 ) deallocate ( self % posopt ) end if if ( allocated ( self % att )) then if ( size ( self % att , 2 ) /= self % n_att ) then allocate ( att ( 4 , self % n_att )) att = self % att (:, 1 : self % n_att ) call move_alloc ( att , self % att ) end if if ( self % n_att == 0 ) deallocate ( self % att ) end if if ( allocated ( self % col )) then if ( size ( self % col , 2 ) /= self % n_col ) then allocate ( col ( 4 , self % n_col )) col = self % col (:, 1 : self % n_col ) call move_alloc ( col , self % col ) end if if ( self % n_col == 0 ) deallocate ( self % col ) end if end subroutine compact","tags":"","url":"proc/compact.html"},{"title":"grow_attitudes – vkframes","text":"private  subroutine grow_attitudes(self, n, exact) Grow the attitudes' storage to hold at least n . Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(inout) :: self integer, intent(in) :: n logical, intent(in), optional :: exact Calls proc~~grow_attitudes~~CallsGraph proc~grow_attitudes grow_attitudes proc~new_capacity new_capacity proc~grow_attitudes->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~grow_attitudes~~CalledByGraph proc~grow_attitudes grow_attitudes proc~add_attitude Trajectory%add_attitude proc~add_attitude->proc~grow_attitudes proc~add_points Trajectory%add_points proc~add_points->proc~grow_attitudes proc~reserve Trajectory%reserve proc~reserve->proc~grow_attitudes proc~add_point Trajectory%add_point proc~add_point->proc~add_attitude Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine grow_attitudes ( self , n , exact ) type ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: n logical , intent ( in ), optional :: exact real ( wp ), allocatable :: tmp (:,:) integer :: cap cap = 0 if ( allocated ( self % att )) cap = size ( self % att , 2 ) if ( n <= cap ) return allocate ( tmp ( 4 , new_capacity ( cap , n , exact ))) if ( self % n_att > 0 ) tmp (:, 1 : self % n_att ) = self % att (:, 1 : self % n_att ) call move_alloc ( tmp , self % att ) end subroutine grow_attitudes","tags":"","url":"proc/grow_attitudes.html"},{"title":"grow_colors – vkframes","text":"private  subroutine grow_colors(self, n, exact) Grow the colors' storage to hold at least n . Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(inout) :: self integer, intent(in) :: n logical, intent(in), optional :: exact Calls proc~~grow_colors~~CallsGraph proc~grow_colors grow_colors proc~new_capacity new_capacity proc~grow_colors->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~grow_colors~~CalledByGraph proc~grow_colors grow_colors proc~add_color Trajectory%add_color proc~add_color->proc~grow_colors proc~add_points Trajectory%add_points proc~add_points->proc~grow_colors proc~reserve Trajectory%reserve proc~reserve->proc~grow_colors proc~add_point Trajectory%add_point proc~add_point->proc~add_color Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine grow_colors ( self , n , exact ) type ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: n logical , intent ( in ), optional :: exact real ( c_float ), allocatable :: tmp (:,:) integer :: cap cap = 0 if ( allocated ( self % col )) cap = size ( self % col , 2 ) if ( n <= cap ) return allocate ( tmp ( 4 , new_capacity ( cap , n , exact ))) if ( self % n_col > 0 ) tmp (:, 1 : self % n_col ) = self % col (:, 1 : self % n_col ) call move_alloc ( tmp , self % col ) end subroutine grow_colors","tags":"","url":"proc/grow_colors.html"},{"title":"grow_positions – vkframes","text":"private  subroutine grow_positions(self, n, exact) Grow the positions' (and optionals') storage to hold at least n . Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(inout) :: self integer, intent(in) :: n logical, intent(in), optional :: exact Calls proc~~grow_positions~~CallsGraph proc~grow_positions grow_positions proc~new_capacity new_capacity proc~grow_positions->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~grow_positions~~CalledByGraph proc~grow_positions grow_positions proc~add_points Trajectory%add_points proc~add_points->proc~grow_positions proc~add_position Trajectory%add_position proc~add_position->proc~grow_positions proc~reserve Trajectory%reserve proc~reserve->proc~grow_positions proc~add_point Trajectory%add_point proc~add_point->proc~add_position Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine grow_positions ( self , n , exact ) type ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: n logical , intent ( in ), optional :: exact real ( wp ), allocatable :: tmp (:,:,:) integer :: cap cap = 0 if ( allocated ( self % posopt )) cap = size ( self % posopt , 3 ) if ( n <= cap ) return allocate ( tmp ( 3 , 0 : self % nopt_ , new_capacity ( cap , n , exact ))) if ( self % n_pos > 0 ) tmp (:, :, 1 : self % n_pos ) = self % posopt (:, :, 1 : self % n_pos ) call move_alloc ( tmp , self % posopt ) end subroutine grow_positions","tags":"","url":"proc/grow_positions.html"},{"title":"grow_times – vkframes","text":"private  subroutine grow_times(self, n, exact) Grow the times' storage to hold at least n (see new_capacity ). Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(inout) :: self integer, intent(in) :: n logical, intent(in), optional :: exact Calls proc~~grow_times~~CallsGraph proc~grow_times grow_times proc~new_capacity new_capacity proc~grow_times->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~grow_times~~CalledByGraph proc~grow_times grow_times proc~add_points Trajectory%add_points proc~add_points->proc~grow_times proc~add_time Trajectory%add_time proc~add_time->proc~grow_times proc~reserve Trajectory%reserve proc~reserve->proc~grow_times proc~add_point Trajectory%add_point proc~add_point->proc~add_time Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine grow_times ( self , n , exact ) type ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: n logical , intent ( in ), optional :: exact real ( wp ), allocatable :: tmp (:) integer :: cap cap = 0 if ( allocated ( self % t )) cap = size ( self % t ) if ( n <= cap ) return allocate ( tmp ( new_capacity ( cap , n , exact ))) if ( self % n_times > 0 ) tmp ( 1 : self % n_times ) = self % t ( 1 : self % n_times ) call move_alloc ( tmp , self % t ) end subroutine grow_times","tags":"","url":"proc/grow_times.html"},{"title":"points – vkframes","text":"private pure subroutine points(self, i1, i2, sources, v, stride) Points i1, i1 + stride, ... (up to i2) with components from sources , into\nv(3, :) (as many columns as points; point for a range, a whole array\nslice per component). No checks: use verify_data and num_points first. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: i1 integer, intent(in) :: i2 type( DataSource ), intent(in) :: sources (3) real(kind=wp), intent(out) :: v (:,:) (3, number of points) integer, intent(in), optional :: stride step between points (default 1) Source Code pure subroutine points ( self , i1 , i2 , sources , v , stride ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i1 , i2 type ( DataSource ), intent ( in ) :: sources ( 3 ) real ( wp ), intent ( out ) :: v (:,:) !! (3, number of points) integer , intent ( in ), optional :: stride !! step between points (default 1) integer :: k , s s = 1 if ( present ( stride )) s = stride do k = 1 , 3 associate ( src => sources ( k )) select case ( src % src ) case ( SOURCE_TIME ) v ( k , :) = src % scale * self % t ( i1 : i2 : s ) case ( SOURCE_POSOPT ) v ( k , :) = src % scale * self % posopt ( src % element , src % opt , i1 : i2 : s ) case ( SOURCE_ATTITUDE ) v ( k , :) = src % scale * self % att ( src % element , i1 : i2 : s ) case default v ( k , :) = 0.0_wp end select end associate end do end subroutine points","tags":"","url":"proc/points.html"},{"title":"positions – vkframes","text":"private  subroutine positions(self, p) Pointer to the positions (3, num_positions), without copying. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in), target :: self real(kind=wp), intent(out), dimension(:,:), pointer :: p Source Code subroutine reserve ( self , n , positions , attitudes , colors ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: n !! number of points logical , intent ( in ), optional :: positions !! reserve positions (default true) logical , intent ( in ), optional :: attitudes !! reserve attitudes (default false) logical , intent ( in ), optional :: colors !! reserve colors (default false) logical :: pos , att , col pos = . true . att = . false . col = . false . if ( present ( positions )) pos = positions if ( present ( attitudes )) att = attitudes if ( present ( colors )) col = colors call grow_times ( self , n , exact = . true .) if ( pos ) call grow_positions ( self , n , exact = . true .) if ( att ) call grow_attitudes ( self , n , exact = . true .) if ( col ) call grow_colors ( self , n , exact = . true .) end subroutine reserve !> Free the storage not used: each array is reallocated to the points it !> holds (one copy, an array at a time), and arrays holding none are !> deallocated. For a trajectory that is complete: growing doubles the !> storage, so up to about half of it can be unused. The data and what is !> drawn of them don't change; pointers from `times`, `positions`, ... !> must be fetched again. Points can still be added (storage grows again). subroutine compact ( self ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), allocatable :: t (:), posopt (:,:,:), att (:,:) real ( c_float ), allocatable :: col (:,:) if ( allocated ( self % t )) then if ( size ( self % t ) /= self % n_times ) then allocate ( t ( self % n_times )) t = self % t ( 1 : self % n_times ) call move_alloc ( t , self % t ) end if if ( self % n_times == 0 ) deallocate ( self % t ) end if if ( allocated ( self % posopt )) then if ( size ( self % posopt , 3 ) /= self % n_pos ) then allocate ( posopt ( 3 , 0 : self % nopt_ , self % n_pos )) posopt = self % posopt (:, :, 1 : self % n_pos ) call move_alloc ( posopt , self % posopt ) end if if ( self % n_pos == 0 ) deallocate ( self % posopt ) end if if ( allocated ( self % att )) then if ( size ( self % att , 2 ) /= self % n_att ) then allocate ( att ( 4 , self % n_att )) att = self % att (:, 1 : self % n_att ) call move_alloc ( att , self % att ) end if if ( self % n_att == 0 ) deallocate ( self % att ) end if if ( allocated ( self % col )) then if ( size ( self % col , 2 ) /= self % n_col ) then allocate ( col ( 4 , self % n_col )) col = self % col (:, 1 : self % n_col ) call move_alloc ( col , self % col ) end if if ( self % n_col == 0 ) deallocate ( self % col ) end if end subroutine compact !> The memory the trajectory's data take (bytes), used or not: its !> storage's capacity (see `reserve`, `compact`). pure integer ( int64 ) function storage_bytes ( self ) result ( b ) class ( Trajectory ), intent ( in ) :: self b = 0_int64 if ( allocated ( self % t )) b = b + storage_size ( self % t , int64 ) / 8 * size ( self % t , kind = int64 ) if ( allocated ( self % posopt )) b = b + storage_size ( self % posopt , int64 ) / 8 * size ( self % posopt , kind = int64 ) if ( allocated ( self % att )) b = b + storage_size ( self % att , int64 ) / 8 * size ( self % att , kind = int64 ) if ( allocated ( self % col )) b = b + storage_size ( self % col , int64 ) / 8 * size ( self % col , kind = int64 ) end function storage_bytes !> Remove all points (keeping the memory). subroutine clear ( self ) class ( Trajectory ), intent ( inout ) :: self self % n_times = 0 self % n_pos = 0 self % n_att = 0 self % n_col = 0 self % generation_ = self % generation_ + 1 self % revision_ = self % revision_ + 1 end subroutine clear !> Set the degrees of freedom (2 or 3) of positions and optionals; clears the trajectory. subroutine set_dof ( self , dof ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: dof self % dof_ = max ( 2 , min ( 3 , dof )) call self % clear () end subroutine set_dof !> Degrees of freedom (2 or 3) of positions and optionals. pure integer function dof ( self ) class ( Trajectory ), intent ( in ) :: self dof = self % dof_ end function dof !> Set the number of optional vectors per position; clears the trajectory. subroutine set_num_optionals ( self , nopt ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: nopt if ( nopt /= self % nopt_ . and . allocated ( self % posopt )) deallocate ( self % posopt ) self % nopt_ = max ( 0 , nopt ) call self % clear () end subroutine set_num_optionals !> Number of optional vectors per position. pure integer function num_optionals ( self ) class ( Trajectory ), intent ( in ) :: self num_optionals = self % nopt_ end function num_optionals !> Number of times. pure integer function num_times ( self ) class ( Trajectory ), intent ( in ) :: self num_times = self % n_times end function num_times !> Number of positions (at most num_times). pure integer function num_positions ( self ) class ( Trajectory ), intent ( in ) :: self num_positions = self % n_pos end function num_positions !> Number of attitudes (at most num_times). pure integer function num_attitudes ( self ) class ( Trajectory ), intent ( in ) :: self num_attitudes = self % n_att end function num_attitudes !> Number of colors (at most num_times). pure integer function num_colors ( self ) class ( Trajectory ), intent ( in ) :: self num_colors = self % n_col end function num_colors !> True if the trajectory has no times. pure logical function is_empty ( self ) class ( Trajectory ), intent ( in ) :: self is_empty = self % n_times == 0 end function is_empty !> Number of changes so far (any added, set or cleared data). pure integer function revision ( self ) class ( Trajectory ), intent ( in ) :: self revision = self % revision_ end function revision !> Number of times the data were cleared (by `clear`, `set_dof` or !> `set_num_optionals`): while it is unchanged, data were only appended. pure integer function generation ( self ) class ( Trajectory ), intent ( in ) :: self generation = self % generation_ end function generation ! ================================================================== ! adding data !> Add a time at the end of the time list. subroutine add_time ( self , t ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t call grow_times ( self , self % n_times + 1 ) self % n_times = self % n_times + 1 self % t ( self % n_times ) = t self % revision_ = self % revision_ + 1 end subroutine add_time !> Add a position (the first `dof` elements of `pos` are used) for the next !> time that has none. `ok` is false if every time already has a position. subroutine add_position ( self , pos , ok ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: pos (:) logical , intent ( out ), optional :: ok !! false if not added integer :: d if ( present ( ok )) ok = . false . if ( self % n_pos >= self % n_times ) return call grow_positions ( self , self % n_pos + 1 ) self % n_pos = self % n_pos + 1 d = min ( self % dof_ , size ( pos )) self % posopt (:, :, self % n_pos ) = 0.0_wp self % posopt ( 1 : d , 0 , self % n_pos ) = pos ( 1 : d ) self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine add_position !> Add an attitude quaternion [x, y, z, w] for the next time that has none. !> `ok` is false if every time already has an attitude. subroutine add_attitude ( self , q , ok ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: q ( 4 ) !! quaternion [x, y, z, w] logical , intent ( out ), optional :: ok !! false if not added if ( present ( ok )) ok = . false . if ( self % n_att >= self % n_times ) return call grow_attitudes ( self , self % n_att + 1 ) self % n_att = self % n_att + 1 self % att (:, self % n_att ) = q self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine add_attitude !> Add a color ([r, g, b], alpha 1, or [r, g, b, a], 0 to 1) for the next !> time that has none. `ok` is false if every time already has a color. subroutine add_color ( self , color , ok ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) logical , intent ( out ), optional :: ok !! false if not added if ( present ( ok )) ok = . false . if ( self % n_col >= self % n_times ) return call grow_colors ( self , self % n_col + 1 ) self % n_col = self % n_col + 1 call to_float_rgba ( self % col (:, self % n_col ), color ) self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine add_color !> rgba from [r, g, b] (alpha 1) or [r, g, b, a]. pure subroutine to_float_rgba ( rgba , color ) real ( c_float ), intent ( out ) :: rgba ( 4 ) !! [r, g, b, a] real ( wp ), intent ( in ) :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) integer :: n n = min ( 4 , size ( color )) rgba = 1.0_c_float rgba ( 1 : n ) = real ( color ( 1 : n ), c_float ) end subroutine to_float_rgba !> Set optional vector `index` (1 to num_optionals) of the most recently !> added position. `ok` is false if there is no position or no such optional. subroutine set_optional ( self , index , v , ok ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: index !! the optional (1 to num_optionals) real ( wp ), intent ( in ) :: v (:) !! the vector (its first `dof` elements are used) logical , intent ( out ), optional :: ok !! false if not set integer :: d if ( present ( ok )) ok = . false . if ( index < 1 . or . index > self % nopt_ . or . self % n_pos == 0 ) return d = min ( self % dof_ , size ( v )) self % posopt ( 1 : d , index , self % n_pos ) = v ( 1 : d ) self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine set_optional !> Add a point: a time with an optional position, attitude and color !> ([r, g, b] or [r, g, b, a]). subroutine add_point ( self , t , pos , att , color ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t !! time real ( wp ), intent ( in ), optional :: pos (:) !! position (first `dof` elements used) real ( wp ), intent ( in ), optional :: att ( 4 ) !! attitude quaternion [x, y, z, w] real ( wp ), intent ( in ), optional :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) call self % add_time ( t ) if ( present ( pos )) call self % add_position ( pos ) if ( present ( att )) call self % add_attitude ( att ) if ( present ( color )) call self % add_color ( color ) end subroutine add_point !> Add points in bulk: times `t(n)`, with optional positions `pos(dof, n)`, !> attitudes `att(4, n)` and colors `color(3 or 4, n)`. Times, positions, !> attitudes and colors must all have been complete before (as many of each !> as times) for the given ones to line up with `t`. subroutine add_points ( self , t , pos , att , color ) class ( Trajectory ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t (:) !! (n): times real ( wp ), intent ( in ), optional :: pos (:,:) !! (dof, n): positions real ( wp ), intent ( in ), optional :: att (:,:) !! (4, n): attitude quaternions [x, y, z, w] real ( wp ), intent ( in ), optional :: color (:,:) !! (3 or 4, n): colors [r, g, b(, a)] (0 to 1) integer :: n , i0 , d n = size ( t ) i0 = self % n_times call grow_times ( self , i0 + n ) self % t ( i0 + 1 : i0 + n ) = t self % n_times = i0 + n if ( present ( pos )) then n = min ( size ( pos , 2 ), self % n_times - self % n_pos ) d = min ( self % dof_ , size ( pos , 1 )) call grow_positions ( self , self % n_pos + n ) self % posopt (:, :, self % n_pos + 1 : self % n_pos + n ) = 0.0_wp self % posopt ( 1 : d , 0 , self % n_pos + 1 : self % n_pos + n ) = pos ( 1 : d , 1 : n ) self % n_pos = self % n_pos + n end if if ( present ( att )) then n = min ( size ( att , 2 ), self % n_times - self % n_att ) call grow_attitudes ( self , self % n_att + n ) self % att (:, self % n_att + 1 : self % n_att + n ) = att (:, 1 : n ) self % n_att = self % n_att + n end if if ( present ( color )) then n = min ( size ( color , 2 ), self % n_times - self % n_col ) d = min ( 4 , size ( color , 1 )) call grow_colors ( self , self % n_col + n ) self % col (:, self % n_col + 1 : self % n_col + n ) = 1.0_c_float self % col ( 1 : d , self % n_col + 1 : self % n_col + n ) = real ( color ( 1 : d , 1 : n ), c_float ) self % n_col = self % n_col + n end if self % revision_ = self % revision_ + 1 end subroutine add_points ! ================================================================== ! reading data !> Time i. pure real ( wp ) function time ( self , i ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i time = self % t ( i ) end function time !> Position i (z = 0 for a 2-DOF trajectory). pure function position ( self , i ) result ( p ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i real ( wp ) :: p ( 3 ) p = self % posopt (:, 0 , i ) end function position !> Attitude i (quaternion [x, y, z, w]). pure function attitude ( self , i ) result ( q ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i real ( wp ) :: q ( 4 ) q = self % att (:, i ) end function attitude !> Color i ([r, g, b, a]). pure function color ( self , i ) result ( c ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i real ( wp ) :: c ( 4 ) c = real ( self % col (:, i ), wp ) end function color !> Optional vector k (1 to num_optionals) of position i. pure function optional ( self , i , k ) result ( v ) class ( Trajectory ), intent ( in ) :: self integer , intent ( in ) :: i , k real ( wp ) :: v ( 3 ) v = self % posopt (:, k , i ) end function optional !> Pointer to the times (num_times), without copying. subroutine times ( self , t ) class ( Trajectory ), intent ( in ), target :: self real ( wp ), dimension (:), pointer , intent ( out ) :: t if ( self % n_times == 0 ) then t => null () else t => self % t ( 1 : self % n_times ) end if end subroutine times !> Pointer to the positions (3, num_positions), without copying. subroutine positions ( self , p ) class ( Trajectory ), intent ( in ), target :: self real ( wp ), dimension (:,:), pointer , intent ( out ) :: p if ( self % n_pos == 0 ) then p => null () else p => self % posopt (:, 0 , 1 : self % n_pos ) end if end subroutine positions","tags":"","url":"proc/positions.html"},{"title":"reserve – vkframes","text":"private  subroutine reserve(self, n, positions, attitudes, colors) Reserve memory for n points: times, positions (with their optionals)\nunless positions is false, and attitudes and colors only if attitudes / colors is true. Optional: storage grows as needed, but\nreserving avoids reallocations for a known size. It never shrinks the\nstorage (see compact ). Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self integer, intent(in) :: n number of points logical, intent(in), optional :: positions reserve positions (default true) logical, intent(in), optional :: attitudes reserve attitudes (default false) logical, intent(in), optional :: colors reserve colors (default false) Calls proc~~reserve~~CallsGraph proc~reserve Trajectory%reserve proc~grow_attitudes grow_attitudes proc~reserve->proc~grow_attitudes proc~grow_colors grow_colors proc~reserve->proc~grow_colors proc~grow_positions grow_positions proc~reserve->proc~grow_positions proc~grow_times grow_times proc~reserve->proc~grow_times proc~new_capacity new_capacity proc~grow_attitudes->proc~new_capacity proc~grow_colors->proc~new_capacity proc~grow_positions->proc~new_capacity proc~grow_times->proc~new_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine reserve ( self , n , positions , attitudes , colors ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: n !! number of points logical , intent ( in ), optional :: positions !! reserve positions (default true) logical , intent ( in ), optional :: attitudes !! reserve attitudes (default false) logical , intent ( in ), optional :: colors !! reserve colors (default false) logical :: pos , att , col pos = . true . att = . false . col = . false . if ( present ( positions )) pos = positions if ( present ( attitudes )) att = attitudes if ( present ( colors )) col = colors call grow_times ( self , n , exact = . true .) if ( pos ) call grow_positions ( self , n , exact = . true .) if ( att ) call grow_attitudes ( self , n , exact = . true .) if ( col ) call grow_colors ( self , n , exact = . true .) end subroutine reserve","tags":"","url":"proc/reserve.html"},{"title":"set_dof – vkframes","text":"private  subroutine set_dof(self, dof) Set the degrees of freedom (2 or 3) of positions and optionals; clears the trajectory. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self integer, intent(in) :: dof Calls proc~~set_dof~~CallsGraph proc~set_dof Trajectory%set_dof proc~clear Trajectory%clear proc~set_dof->proc~clear Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_dof ( self , dof ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: dof self % dof_ = max ( 2 , min ( 3 , dof )) call self % clear () end subroutine set_dof","tags":"","url":"proc/set_dof.html"},{"title":"set_num_optionals – vkframes","text":"private  subroutine set_num_optionals(self, nopt) Set the number of optional vectors per position; clears the trajectory. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self integer, intent(in) :: nopt Calls proc~~set_num_optionals~~CallsGraph proc~set_num_optionals Trajectory%set_num_optionals proc~clear Trajectory%clear proc~set_num_optionals->proc~clear Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_num_optionals ( self , nopt ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: nopt if ( nopt /= self % nopt_ . and . allocated ( self % posopt )) deallocate ( self % posopt ) self % nopt_ = max ( 0 , nopt ) call self % clear () end subroutine set_num_optionals","tags":"","url":"proc/set_num_optionals.html"},{"title":"set_optional – vkframes","text":"private  subroutine set_optional(self, index, v, ok) Set optional vector index (1 to num_optionals) of the most recently\nadded position. ok is false if there is no position or no such optional. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self integer, intent(in) :: index the optional (1 to num_optionals) real(kind=wp), intent(in) :: v (:) the vector (its first dof elements are used) logical, intent(out), optional :: ok false if not set Source Code subroutine set_optional ( self , index , v , ok ) class ( Trajectory ), intent ( inout ) :: self integer , intent ( in ) :: index !! the optional (1 to num_optionals) real ( wp ), intent ( in ) :: v (:) !! the vector (its first `dof` elements are used) logical , intent ( out ), optional :: ok !! false if not set integer :: d if ( present ( ok )) ok = . false . if ( index < 1 . or . index > self % nopt_ . or . self % n_pos == 0 ) return d = min ( self % dof_ , size ( v )) self % posopt ( 1 : d , index , self % n_pos ) = v ( 1 : d ) self % revision_ = self % revision_ + 1 if ( present ( ok )) ok = . true . end subroutine set_optional","tags":"","url":"proc/set_optional.html"},{"title":"times – vkframes","text":"private  subroutine times(self, t) Pointer to the times (num_times), without copying. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in), target :: self real(kind=wp), intent(out), dimension(:), pointer :: t Source Code subroutine times ( self , t ) class ( Trajectory ), intent ( in ), target :: self real ( wp ), dimension (:), pointer , intent ( out ) :: t if ( self % n_times == 0 ) then t => null () else t => self % t ( 1 : self % n_times ) end if end subroutine times","tags":"","url":"proc/times.html"},{"title":"to_float_rgba – vkframes","text":"private pure subroutine to_float_rgba(rgba, color) rgba from [r, g, b] (alpha 1) or [r, g, b, a]. Arguments Type Intent Optional Attributes Name real(kind=c_float), intent(out) :: rgba (4) [r, g, b, a] real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) Called by proc~~to_float_rgba~~CalledByGraph proc~to_float_rgba to_float_rgba proc~add_color Trajectory%add_color proc~add_color->proc~to_float_rgba proc~add_point Trajectory%add_point proc~add_point->proc~add_color Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine to_float_rgba ( rgba , color ) real ( c_float ), intent ( out ) :: rgba ( 4 ) !! [r, g, b, a] real ( wp ), intent ( in ) :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) integer :: n n = min ( 4 , size ( color )) rgba = 1.0_c_float rgba ( 1 : n ) = real ( color ( 1 : n ), c_float ) end subroutine to_float_rgba","tags":"","url":"proc/to_float_rgba.html"},{"title":"DataSource – vkframes","text":"public interface DataSource The DataSource constructor: DataSource(...) makes one (see new_data_source for its\narguments). Calls interface~~datasource~~CallsGraph interface~datasource DataSource proc~new_data_source new_data_source interface~datasource->proc~new_data_source Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Module Procedures private pure function new_data_source (src, element, opt, scale) result(s) A data source (see DataSource ); element defaults to 1, opt to 0, scale to 1. Arguments Type Intent Optional Attributes Name integer, intent(in) :: src a SOURCE_* constant integer, intent(in), optional :: element element (1 to dof, or 1 to 4 for an attitude; default 1) integer, intent(in), optional :: opt (0: the position (default), k: optional k) real(kind=wp), intent(in), optional :: scale Return Value type( DataSource )","tags":"","url":"interface/datasource.html"},{"title":"Trajectory – vkframes","text":"public interface Trajectory The Trajectory constructor: Trajectory(...) makes one (see new_trajectory for its\narguments). Calls interface~~trajectory~~CallsGraph interface~trajectory Trajectory proc~new_trajectory new_trajectory interface~trajectory->proc~new_trajectory Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Module Procedures private  function new_trajectory (dof, nopt) result(traj) A trajectory with dof (2 or 3, default 3) degrees of freedom and nopt (default 0) optional vectors per position. Arguments Type Intent Optional Attributes Name integer, intent(in), optional :: dof degrees of freedom (2 or 3, default 3) integer, intent(in), optional :: nopt optional vectors per position (default 0) Return Value type( Trajectory )","tags":"","url":"interface/trajectory.html"},{"title":"body_radius – vkframes","text":"private pure function body_radius(self) The body's equatorial radius in scene units (from its profile: the\nMoon's for 'moon', else the Earth's). Type Bound TerrainBody Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value real(kind=wp) Called by proc~~body_radius~~CalledByGraph proc~body_radius TerrainBody%body_radius proc~terrain_bound TerrainBody%terrain_bound proc~terrain_bound->proc~body_radius proc~terrain_pick TerrainBody%terrain_pick proc~terrain_pick->proc~body_radius Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure real ( wp ) function body_radius ( self ) class ( TerrainBody ), intent ( in ) :: self if ( self % profile_ == 'moon' ) then body_radius = moon_radius * self % units_per_meter_ else body_radius = earth_radius * self % units_per_meter_ end if end function body_radius","tags":"","url":"proc/body_radius.html"},{"title":"elevation – vkframes","text":"private  function elevation(self, lat, lon, found) result(h) The height of the terrain (scene units, above the body's sphere or\nellipsoid) at latitude and longitude lat , lon (degrees), from the\nlast elevation layer added that is a file (LAYER_GDAL), read directly\n(also before the body is shown); found is false (and the height 0)\nwithout such a layer or data there, or without Rocky. Type Bound TerrainBody Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self real(kind=wp), intent(in) :: lat latitude and longitude (degrees) real(kind=wp), intent(in) :: lon latitude and longitude (degrees) logical, intent(out), optional :: found false if there is no height there Return Value real(kind=wp) Calls proc~~elevation~~CallsGraph proc~elevation TerrainBody%elevation interface~vkf_rocky_elevation vkf_rocky_elevation proc~elevation->interface~vkf_rocky_elevation proc~find_data_file find_data_file proc~elevation->proc~find_data_file proc~rocky_available rocky_available proc~elevation->proc~rocky_available proc~find_in_dirs find_in_dirs proc~find_data_file->proc~find_in_dirs interface~vkf_rocky_available vkf_rocky_available proc~rocky_available->interface~vkf_rocky_available Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function elevation ( self , lat , lon , found ) result ( h ) class ( TerrainBody ), intent ( in ) :: self real ( wp ), intent ( in ) :: lat , lon !! latitude and longitude (degrees) logical , intent ( out ), optional :: found !! false if there is no height there real ( wp ) :: h character ( len = :), allocatable :: file integer ( c_int ) :: ok integer :: k h = 0.0_wp if ( present ( found )) found = . false . if (. not . rocky_available ()) return do k = self % n_layers , 1 , - 1 if (. not . ( self % layers ( k )% elevation . and . self % layers ( k )% source == LAYER_GDAL )) cycle file = self % layers ( k )% uri if ( index ( file , '://' ) == 0 ) file = find_data_file ( file ) if ( len ( file ) == 0 ) return h = vkf_rocky_elevation ( file , len ( file , kind = c_int ), self % profile_ , len ( self % profile_ , kind = c_int ), & real ( lat , c_double ), real ( lon , c_double ), ok ) * self % units_per_meter_ if ( present ( found )) found = ok /= 0 return end do end function elevation","tags":"","url":"proc/elevation.html"},{"title":"lighting – vkframes","text":"private pure function lighting(self) True if the body is lit by the scene's lights. Type Bound TerrainBody Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value logical Source Code pure logical function lighting ( self ) class ( TerrainBody ), intent ( in ) :: self lighting = self % lighting_ end function lighting","tags":"","url":"proc/lighting.html"},{"title":"new_terrain_body – vkframes","text":"private  function new_terrain_body(name, profile, units_per_meter, color) result(b) A body named name in Rocky's tiling profile profile (default '':\nthe Earth; 'moon': the Moon), drawn at units_per_meter scene units per\nmeter (default 1e-3), in color color where it has no imagery ([r, g, b]\nor [r, g, b, a]; default the frame's). Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name character(len=*), intent(in), optional :: profile Rocky's tiling profile (default '') real(kind=wp), intent(in), optional :: units_per_meter scene units per meter (default 1e-3) real(kind=wp), intent(in), optional :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) Return Value type( TerrainBody ) Called by proc~~new_terrain_body~~CalledByGraph proc~new_terrain_body new_terrain_body interface~terrainbody TerrainBody interface~terrainbody->proc~new_terrain_body Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function new_terrain_body ( name , profile , units_per_meter , color ) result ( b ) character ( len =* ), intent ( in ) :: name character ( len =* ), intent ( in ), optional :: profile !! Rocky's tiling profile (default '') real ( wp ), intent ( in ), optional :: units_per_meter !! scene units per meter (default 1e-3) real ( wp ), intent ( in ), optional :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) type ( TerrainBody ) :: b b % ReferenceFrame = ReferenceFrame ( name , color ) b % profile_ = '' if ( present ( profile )) b % profile_ = profile if ( present ( units_per_meter )) b % units_per_meter_ = units_per_meter allocate ( b % layers ( 4 )) end function new_terrain_body","tags":"","url":"proc/new_terrain_body.html"},{"title":"num_layers – vkframes","text":"private pure function num_layers(self) Number of layers (image and elevation). Type Bound TerrainBody Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value integer Source Code pure integer function num_layers ( self ) class ( TerrainBody ), intent ( in ) :: self num_layers = self % n_layers end function num_layers","tags":"","url":"proc/num_layers.html"},{"title":"profile – vkframes","text":"private  function profile(self) result(p) Rocky's tiling profile ('': Rocky's default, the Earth). Type Bound TerrainBody Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value character(len=:), allocatable Source Code function new_terrain_body ( name , profile , units_per_meter , color ) result ( b ) character ( len =* ), intent ( in ) :: name character ( len =* ), intent ( in ), optional :: profile !! Rocky's tiling profile (default '') real ( wp ), intent ( in ), optional :: units_per_meter !! scene units per meter (default 1e-3) real ( wp ), intent ( in ), optional :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) type ( TerrainBody ) :: b b % ReferenceFrame = ReferenceFrame ( name , color ) b % profile_ = '' if ( present ( profile )) b % profile_ = profile if ( present ( units_per_meter )) b % units_per_meter_ = units_per_meter allocate ( b % layers ( 4 )) end function new_terrain_body !> Add an image layer: `uri` (a URL, URL template or file) of a `source` !> kind (LAYER_*; default LAYER_TMS). Layers added later are drawn on top. subroutine add_image_layer ( self , uri , source ) class ( TerrainBody ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: uri integer , intent ( in ), optional :: source !! a LAYER_* constant (default LAYER_TMS) type ( MapLayer ) :: layer layer % uri = uri if ( present ( source )) layer % source = source call add_layer ( self , layer ) end subroutine add_image_layer !> Add an elevation layer: `uri` of a `source` kind (LAYER_*; default !> LAYER_TMS), heights in meters or `encoding` (ELEVATION_*; default !> ELEVATION_HEIGHTS). subroutine add_elevation_layer ( self , uri , source , encoding ) class ( TerrainBody ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: uri integer , intent ( in ), optional :: source !! a LAYER_* constant (default LAYER_TMS) integer , intent ( in ), optional :: encoding !! an ELEVATION_* constant (default ELEVATION_HEIGHTS) type ( MapLayer ) :: layer layer % elevation = . true . layer % uri = uri if ( present ( source )) layer % source = source if ( present ( encoding )) layer % encoding = encoding call add_layer ( self , layer ) end subroutine add_elevation_layer !> Keep `layer`, and add it to the map if it is made. subroutine add_layer ( self , layer ) type ( TerrainBody ), intent ( inout ) :: self type ( MapLayer ), intent ( in ) :: layer type ( MapLayer ), allocatable :: tmp (:) if (. not . allocated ( self % layers )) allocate ( self % layers ( 4 )) if ( self % n_layers == size ( self % layers )) then allocate ( tmp ( 2 * self % n_layers )) tmp ( 1 : self % n_layers ) = self % layers ( 1 : self % n_layers ) call move_alloc ( tmp , self % layers ) end if self % n_layers = self % n_layers + 1 self % layers ( self % n_layers ) = layer if ( c_associated ( self % map )) call apply_layer ( self , layer ) end subroutine add_layer !> Number of layers (image and elevation). pure integer function num_layers ( self ) class ( TerrainBody ), intent ( in ) :: self num_layers = self % n_layers end function num_layers !> Light the body with the scene's lights (default), or show its imagery as it is. subroutine set_lighting ( self , lit ) class ( TerrainBody ), intent ( inout ) :: self logical , intent ( in ) :: lit self % lighting_ = lit call apply_settings ( self ) end subroutine set_lighting !> True if the body is lit by the scene's lights. pure logical function lighting ( self ) class ( TerrainBody ), intent ( in ) :: self lighting = self % lighting_ end function lighting !> Rocky's tiling profile ('': Rocky's default, the Earth). function profile ( self ) result ( p ) class ( TerrainBody ), intent ( in ) :: self character ( len = :), allocatable :: p p = self % profile_ end function profile","tags":"","url":"proc/profile.html"},{"title":"rocky_available – vkframes","text":"public  function rocky_available() Whether vkframes was built with Rocky (the rocky pixi environment). Arguments None Return Value logical Calls proc~~rocky_available~~CallsGraph proc~rocky_available rocky_available interface~vkf_rocky_available vkf_rocky_available proc~rocky_available->interface~vkf_rocky_available Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~rocky_available~~CalledByGraph proc~rocky_available rocky_available proc~elevation TerrainBody%elevation proc~elevation->proc~rocky_available proc~terrain_build_contents TerrainBody%terrain_build_contents proc~terrain_build_contents->proc~rocky_available Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code logical function rocky_available () rocky_available = vkf_rocky_available () /= 0 end function rocky_available","tags":"","url":"proc/rocky_available.html"},{"title":"terrain_frame_info – vkframes","text":"private  function terrain_frame_info(self) result(info) The kind of frame: 'TerrainBody'. Type Bound TerrainBody Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value character(len=:), allocatable Source Code function terrain_frame_info ( self ) result ( info ) class ( TerrainBody ), intent ( in ) :: self character ( len = :), allocatable :: info info = 'TerrainBody' end function terrain_frame_info","tags":"","url":"proc/terrain_frame_info.html"},{"title":"units_per_meter – vkframes","text":"private pure function units_per_meter(self) Scene units per meter the body is drawn at. Type Bound TerrainBody Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(in) :: self Return Value real(kind=wp) Source Code function new_terrain_body ( name , profile , units_per_meter , color ) result ( b ) character ( len =* ), intent ( in ) :: name character ( len =* ), intent ( in ), optional :: profile !! Rocky's tiling profile (default '') real ( wp ), intent ( in ), optional :: units_per_meter !! scene units per meter (default 1e-3) real ( wp ), intent ( in ), optional :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) type ( TerrainBody ) :: b b % ReferenceFrame = ReferenceFrame ( name , color ) b % profile_ = '' if ( present ( profile )) b % profile_ = profile if ( present ( units_per_meter )) b % units_per_meter_ = units_per_meter allocate ( b % layers ( 4 )) end function new_terrain_body !> Add an image layer: `uri` (a URL, URL template or file) of a `source` !> kind (LAYER_*; default LAYER_TMS). Layers added later are drawn on top. subroutine add_image_layer ( self , uri , source 