ch it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial real(kind=wp), private, allocatable :: att (:,:) (4, capacity): quaternions [x, y, z, w] real(kind=c_float), private, allocatable :: col (:,:) (4, capacity): colors [r, g, b, a] (as drawn) integer, private :: dof_ = 3 degrees of freedom of positions and optionals (2 or 3) integer, private :: generation_ = 0 incremented when the data are cleared integer, private :: n_att = 0 number of attitudes (<= n_times) integer, private :: n_col = 0 number of colors (<= n_times) integer, private :: n_pos = 0 number of positions (<= n_times) integer, private :: n_times = 0 number of times integer, private :: nopt_ = 0 optionals per position real(kind=wp), private, allocatable :: posopt (:,:,:) (3, 0:nopt, capacity): position, then optionals integer, private :: revision_ = 0 incremented on every change real(kind=wp), private, allocatable :: t (:) (capacity): times Constructor public        interface Trajectory The Trajectory constructor: Trajectory(...) makes one (see new_trajectory for its\narguments). private  function new_trajectory (dof, nopt) result(traj) A trajectory with dof (2 or 3, default 3) degrees of freedom and nopt (default 0) optional vectors per position. Arguments Type Intent Optional Attributes Name integer, intent(in), optional :: dof degrees of freedom (2 or 3, default 3) integer, intent(in), optional :: nopt optional vectors per position (default 0) Return Value type( Trajectory ) Type-Bound Procedures generic, public :: add => add_point , add_points private  subroutine add_point (self, t, pos, att, color) Add a point: a time with an optional position, attitude and color\n([r, g, b] or [r, g, b, a]). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t time real(kind=wp), intent(in), optional :: pos (:) position (first dof elements used) real(kind=wp), intent(in), optional :: att (4) attitude quaternion [x, y, z, w] real(kind=wp), intent(in), optional :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) private  subroutine add_points (self, t, pos, att, color) Add points in bulk: times t(n) , with optional positions pos(dof, n) ,\nattitudes att(4, n) and colors color(3 or 4, n) . Times, positions,\nattitudes and colors must all have been complete before (as many of each\nas times) for the given ones to line up with t . Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t (:) (n): times real(kind=wp), intent(in), optional :: pos (:,:) (dof, n): positions real(kind=wp), intent(in), optional :: att (:,:) (4, n): attitude quaternions [x, y, z, w] real(kind=wp), intent(in), optional :: color (:,:) (3 or 4, n): colors [r, g, b(, a)] (0 to 1) procedure, public :: add_attitude private  subroutine add_attitude (self, q, ok) Add an attitude quaternion [x, y, z, w] for the next time that has none. ok is false if every time already has an attitude. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) quaternion [x, y, z, w] logical, intent(out), optional :: ok false if not added procedure, public :: add_color private  subroutine add_color (self, color, ok) Add a color ([r, g, b], alpha 1, or [r, g, b, a], 0 to 1) for the next\ntime that has none. ok is false if every time already has a color. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) logical, intent(out), optional :: ok false if not added procedure, private :: add_point private  subroutine add_point (self, t, pos, att, color) Add a point: a time with an optional position, attitude and color\n([r, g, b] or [r, g, b, a]). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t time real(kind=wp), intent(in), optional :: pos (:) position (first dof elements used) real(kind=wp), intent(in), optional :: att (4) attitude quaternion [x, y, z, w] real(kind=wp), intent(in), optional :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) procedure, private :: add_points private  subroutine add_points (self, t, pos, att, color) Add points in bulk: times t(n) , with optional positions pos(dof, n) ,\nattitudes att(4, n) and colors color(3 or 4, n) . Times, positions,\nattitudes and colors must all have been complete before (as many of each\nas times) for the given ones to line up with t . Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t (:) (n): times real(kind=wp), intent(in), optional :: pos (:,:) (dof, n): positions real(kind=wp), intent(in), optional :: att (:,:) (4, n): attitude quaternions [x, y, z, w] real(kind=wp), intent(in), optional :: color (:,:) (3 or 4, n): colors [r, g, b(, a)] (0 to 1) procedure, public :: add_position private  subroutine add_position (self, pos, ok) Add a position (the first dof elements of pos are used) for the next\ntime that has none. ok is false if every time already has a position. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: pos (:) logical, intent(out), optional :: ok false if not added procedure, public :: add_time private  subroutine add_time (self, t) Add a time at the end of the time list. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t procedure, public :: attitude private pure function attitude (self, i) result(q) Attitude i (quaternion [x, y, z, w]). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: i Return Value real(kind=wp), (4) procedure, public :: attitudes private  subroutine attitudes (self, q) Pointer to the attitudes (4, num_attitudes), without copying. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in), target :: self real(kind=wp), intent(out), dimension(:,:), pointer :: q procedure, public :: clear private  subroutine clear (self) Remove all points (keeping the memory). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self procedure, public :: color private pure function color (self, i) result(c) Color i ([r, g, b, a]). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: i Return Value real(kind=wp), (4) procedure, public :: colors private  subroutine colors (self, c) Pointer to the colors (4, num_colors; single precision, as drawn),\nwithout copying. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in), target :: self real(kind=c_float), intent(out), dimension(:,:), pointer :: c procedure, public :: compact private  subroutine compact (self) Free the storage not used: each array is reallocated to the points it\nholds (one copy, an array at a time), and arrays holding none are\ndeallocated. For a trajectory that is complete: growing doubles the\nstorage, so up to about half of it can be unused. The data and what is\ndrawn of them don't change; pointers from times , positions , ...\nmust be fetched again. Points can still be added (storage grows again). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self procedure, public :: dof private pure function dof (self) Degrees of freedom (2 or 3) of positions and optionals. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer procedure, public :: generation private pure function generation (self) Number of times the data were cleared (by clear , set_dof or set_num_optionals ): while it is unchanged, data were only appended. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer procedure, public :: is_empty private pure function is_empty (self) True if the trajectory has no times. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value logical procedure, public :: num_attitudes private pure function num_attitudes (self) Number of attitudes (at most num_times). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer procedure, public :: num_colors private pure function num_colors (self) Number of colors (at most num_times). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer procedure, public :: num_optionals private pure function num_optionals (self) Number of optional vectors per position. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer procedure, public :: num_points private pure function num_points (self, sources) Number of points available with these sources: the number of times,\nlimited by the positions or attitudes they use; huge() if all are zero. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self type( DataSource ), intent(in) :: sources (3) Return Value integer procedure, public :: num_positions private pure function num_positions (self) Number of positions (at most num_times). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer procedure, public :: num_times private pure function num_times (self) Number of times. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer procedure, public :: optional private pure function optional (self, i, k) result(v) Optional vector k (1 to num_optionals) of position i. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: i integer, intent(in) :: k Return Value real(kind=wp), (3) procedure, public :: point private pure function point (self, i, sources) result(v) Point i with components from sources (OpenFrames' getPoint). No checks:\nuse verify_data and num_points first. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: i type( DataSource ), intent(in) :: sources (3) Return Value real(kind=wp), (3) procedure, public :: point_at private  function point_at (self, t, sources, ok) result(v) The point at time t (components from sources ; default: the\nposition's), linear in time between the points about it; outside the\ntimes, the first or last point. ok (optional) false, and v 0, if there\nis no point (or the search for the time failed). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self real(kind=wp), intent(in) :: t the time type( DataSource ), intent(in), optional :: sources (3) where the components come from (default: the position) logical, intent(out), optional :: ok a point was found Return Value real(kind=wp), (3) procedure, public :: point_between private pure function point_between (self, k, k2, t, sources) result(v) The point at time t between points k and k2 (components from sources ): linear in time, within the two (time_fraction). Point k if\nk2 isn't a point (beyond the ends, or more times than data). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: k a point (1 to num_points(sources)) integer, intent(in) :: k2 the other point (e.g. k + 1) real(kind=wp), intent(in) :: t the time type( DataSource ), intent(in) :: sources (3) where the components come from Return Value real(kind=wp), (3) procedure, public :: points private pure subroutine points (self, i1, i2, sources, v, stride) Points i1, i1 + stride, ... (up to i2) with components from sources , into\nv(3, :) (as many columns as points; point for a range, a whole array\nslice per component). No checks: use verify_data and num_points first. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: i1 integer, intent(in) :: i2 type( DataSource ), intent(in) :: sources (3) real(kind=wp), intent(out) :: v (:,:) (3, number of points) integer, intent(in), optional :: stride step between points (default 1) procedure, public :: position private pure function position (self, i) result(p) Position i (z = 0 for a 2-DOF trajectory). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: i Return Value real(kind=wp), (3) procedure, public :: positions private  subroutine positions (self, p) Pointer to the positions (3, num_positions), without copying. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in), target :: self real(kind=wp), intent(out), dimension(:,:), pointer :: p procedure, public :: reserve private  subroutine reserve (self, n, positions, attitudes, colors) Reserve memory for n points: times, positions (with their optionals)\nunless positions is false, and attitudes and colors only if attitudes / colors is true. Optional: storage grows as needed, but\nreserving avoids reallocations for a known size. It never shrinks the\nstorage (see compact ). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self integer, intent(in) :: n number of points logical, intent(in), optional :: positions reserve positions (default true) logical, intent(in), optional :: attitudes reserve attitudes (default false) logical, intent(in), optional :: colors reserve colors (default false) procedure, public :: revision private pure function revision (self) Number of changes so far (any added, set or cleared data). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer procedure, public :: set_dof private  subroutine set_dof (self, dof) Set the degrees of freedom (2 or 3) of positions and optionals; clears the trajectory. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self integer, intent(in) :: dof procedure, public :: set_num_optionals private  subroutine set_num_optionals (self, nopt) Set the number of optional vectors per position; clears the trajectory. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self integer, intent(in) :: nopt procedure, public :: set_optional private  subroutine set_optional (self, index, v, ok) Set optional vector index (1 to num_optionals) of the most recently\nadded position. ok is false if there is no position or no such optional. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(inout) :: self integer, intent(in) :: index the optional (1 to num_optionals) real(kind=wp), intent(in) :: v (:) the vector (its first dof elements are used) logical, intent(out), optional :: ok false if not set procedure, public :: storage_bytes private pure function storage_bytes (self) result(b) The memory the trajectory's data take (bytes), used or not: its\nstorage's capacity (see reserve , compact ). Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer(kind=int64) procedure, public :: time private pure function time (self, i) Time i. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: i Return Value real(kind=wp) procedure, public :: time_distance private pure function time_distance (self, t) The \"distance\" from time t to the time range [t0, tf]: > 0 outside it (to\nthe nearer end), 0 at its ends, < 0 inside; huge() without times.\n(OpenFrames' getTimeDistance.) Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self real(kind=wp), intent(in) :: t Return Value real(kind=wp) procedure, public :: time_fraction private pure function time_fraction (self, k, k2, t) result(frac) The fraction of the way in time from point k to point k2 (any two\npoints: e.g. k + 1, or k - 1 with times running backward) at time t,\nkept within 0 to 1 (0 if their times are the same). No checks: k and k2\nmust be times. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self integer, intent(in) :: k the points (1 to num_times) integer, intent(in) :: k2 the points (1 to num_times) real(kind=wp), intent(in) :: t the time Return Value real(kind=wp) procedure, public :: time_index private  function time_index (self, t, index) result(status) Find the interval of the time list containing t, by bisection (times\nincreasing or decreasing). Returns a TIME_ code, or the number of\niterations (> 0) when found, with times(index) <= t < times(index+1) for\nincreasing times (>= and > for decreasing). See the TIME_ constants for index in the other cases. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self real(kind=wp), intent(in) :: t integer, intent(out) :: index the interval's first index (see the TIME_* constants) Return Value integer procedure, public :: time_range private  function time_range (self, t0, tf) The first and last times, ordered (t0 <= tf); false if there are no times. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self real(kind=wp), intent(out) :: t0 real(kind=wp), intent(out) :: tf Return Value logical procedure, public :: times private  subroutine times (self, t) Pointer to the times (num_times), without copying. Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in), target :: self real(kind=wp), intent(out), dimension(:), pointer :: t procedure, public :: verify_data private pure function verify_data (self, sources) True if the trajectory has the data the sources refer to (elements and\noptionals in range). Arguments Type Intent Optional Attributes Name class( Trajec