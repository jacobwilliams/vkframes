allocatable :: hits (:) what is there, nearest first real(kind=wp), intent(in), optional :: tolerance window units (default 4) integer, intent(in), optional :: kinds (:) PICK_* (default: all) logical, intent(in), optional :: nearest default false","tags":"","url":"module/vkf_window.html"},{"title":"vkf_hud – vkframes","text":"HUD text: text drawn on top of the scene at a fixed place in a window, as\nOpenFrames' HUD text (one per RenderRectangle there; any number here). Its position is (x, y) from 0 to 1 across the window, left to right and\nbottom to top, and the text's alignment (an ALIGN_* constant) says which\npoint of the text is there; its size is in window units (logical pixels).\nEverything can change at any time, also while shown: the text (e.g. a\nclock; up to 256 characters, or twice the text's length when first shown\nif more: longer ones are cut), color, position, size and alignment in\nplace, and the font (the text is made again). Moved each frame to an\nobject's place on the screen (WindowProxy%screen_position), it is a\ncallout that follows the object. A HUDText can be shown in several\nwindows ( WindowProxy%add_hud_text ); it is not owned by them and must\nstay alive while shown. Uses vkf_math vkf_frames module~~vkf_hud~~UsesGraph module~vkf_hud vkf_hud module~vkf_frames vkf_frames module~vkf_hud->module~vkf_frames module~vkf_math vkf_math module~vkf_hud->module~vkf_math module~vkf_frames->module~vkf_math iso_c_binding iso_c_binding module~vkf_frames->iso_c_binding module~vkf_follower vkf_follower module~vkf_frames->module~vkf_follower module~vkf_geometry vkf_geometry module~vkf_frames->module~vkf_geometry module~vkf_layer vkf_layer module~vkf_frames->module~vkf_layer module~vkf_pick vkf_pick module~vkf_frames->module~vkf_pick module~vkf_text vkf_text module~vkf_frames->module~vkf_text module~vkf_trajectory vkf_trajectory module~vkf_frames->module~vkf_trajectory iso_fortran_env iso_fortran_env module~vkf_math->iso_fortran_env module~vkf_follower->mod