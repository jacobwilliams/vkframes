p , step ) * ( t_last - self % next_time ) > 0.0_wp ) tm = self % next_time status = self % traj % time_index ( tm , index ) index = max ( 1 , min ( n - 1 , index )) call push_intermediate ( self , self % traj % point_between ( index , index + 1 , tm , self % sources_ ), tm ) self % next_time = self % next_time + step end do end subroutine intermediates_by_time","tags":"","url":"proc/intermediates_by_time.html"},{"title":"marker_build – vkframes","text":"private  subroutine marker_build(self, viewer, group) Create the marker nodes under group (see artist_build). Type Bound MarkerArtist Arguments Type Intent Optional Attributes Name class( MarkerArtist ), intent(inout) :: self type(c_ptr), intent(in) :: viewer type(c_ptr), intent(in) :: group Calls proc~~marker_build~~CallsGraph proc~marker_build MarkerArtist%marker_build proc~build_marker_nodes build_marker_nodes proc~marker_build->proc~build_marker_nodes proc~init LineChain%init proc~build_marker_nodes->proc~init proc~marker_style marker_style proc~build_marker_nodes->proc~marker_style proc~marker_uses_colors marker_uses_colors proc~build_marker_nodes->proc~marker_uses_colors proc~redraw_markers redraw_markers proc~build_marker_nodes->proc~redraw_markers proc~reserve~2 LineChain%reserve proc~build_marker_nodes->proc~reserve~2 proc~set_compile LineChain%set_compile proc~build_marker_nodes->proc~set_compile proc~is_colored LineChain%is_colored proc~marker_style->proc~is_colored proc~set_marker_style LineChain%set_marker_style proc~marker_style->proc~set_marker_style num_colors num_colors proc~marker_uses_colors->num_colors interface~vkf_compile_node vkf_compile_node proc~reserve~2->interface~vkf_compile_node interface~vkf_line_create vkf_line_create proc~reserve~2->interface~vkf_line_create interface~vkf_line_create_colored vkf_line_create_colored proc~reserve~2->interface~vkf_line_create_colored interface~vkf_marker_create vkf_marker_create proc~reserve~2->interface~vkf_marker_create interface~vkf_node_add_child vkf