s , min_size , max_size , min_dim_ratio ) & result ( ok ) class ( SkySphere ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: catalog !! star catalog file; '' for none real ( wp ), intent ( in ), optional :: min_mag , max_mag !! apparent magnitudes real ( wp ), intent ( in ), optional :: min_size , max_size !! window units real ( wp ), intent ( in ), optional :: min_dim_ratio !! 0 to 1 integer , intent ( in ), optional :: max_stars real ( wp ) :: mags ( 2 ), sizes ( 2 ), dim integer :: n mags = [ self % min_mag , self % max_mag ] if ( present ( min_mag )) mags ( 1 ) = min_mag if ( present ( max_mag )) mags ( 2 ) = max_mag sizes = [ self % min_size , self % max_size ] if ( present ( min_size )) sizes ( 1 ) = min_size if ( present ( max_size )) sizes ( 2 ) = max_size dim = self % min_dim if ( present ( min_dim_ratio )) dim = min_dim_ratio n = self % max_stars if ( present ( max_stars )) n = max_stars ok = mags ( 1 ) <= mags ( 2 ) . and . n >= 1 . and . sizes ( 1 ) <= sizes ( 2 ) . and . dim >= 0.0_wp . and . dim <= 1.0_wp if (. not . ok ) return self % min_mag = mags ( 1 ) self % max_mag = mags ( 2 ) self % min_size = sizes ( 1 ) self % max_size = sizes ( 2 ) self % min_dim = dim self % max_stars = n self % catalog = trim ( catalog ) self % n_stars = 0 if ( len_trim ( catalog ) > 0 ) ok = read_stars ( self ) if ( c_associated ( self % root )) call make_star_node ( self ) end function set_star_data","tags":"","url":"proc/set_star_data.html"},{"title":"set_star_names – vkframes","text":"private  function set_star_names(self, shown, max_mag, size, rgba, font) result(ok) Draw the names of the named stars drawn (those of the catalog's last\nfield), beside them: shown (default false), of the stars up to\nmagnitude max_mag (default all of them), size window units tall\n(default 12), in color rgba (default a pale blue) and font font ('' or default: vkframes' default font). Also while shown; the\nsettings not given are kept. Returns false (nothing changed) if 