kf_* modules (math, trajectories and followers, the !> clock, reference frames and what extends them, windows and views, handles !> and the cursor's ray, HUD text and GUI panels, the sky, shapes, artists, !> line segments, shadows, terrain, file search, the cache, diagnostics); see each module !> for its documentation. module vkframes use vkf_math , only : wp , pi , quat_identity , quat_from_axis_angle , quat_multiply , quat_conjugate , quat_from_matrix , & quat_normalize , quat_rotate , quat_to_matrix , quat_slerp , & quat_from_vectors , identity_matrix , translation_matrix , frame_matrix , rigid_inverse use vkf_trajectory , only : Trajectory , DataSource , position_sources , optional_sources , & SOURCE_ZERO , SOURCE_TIME , SOURCE_POSOPT , SOURCE_ATTITUDE , & TIME_NOT_FOUND , TIME_OUT_OF_RANGE , TIME_AT_BOUND use vkf_follower , only : TrajectoryFollower , FOLLOW_LOOP , FOLLOW_LIMIT , FOLLOW_POSITION , FOLLOW_ATTITUDE use vkf_clock , only : SimulationClock , wall_time use vkf_frames , only : ReferenceFrame , FramePointer , NO_AXES , X_AXIS , Y_AXIS , Z_AXIS , ALL_AXES , & PickHit , PICK_FRAME , PICK_BODY , PICK_CURVE , PICK_SEGMENT , PICK_MARKER , PICK_HANDLE , & ALIGN_LEFT_TOP , ALIGN_LEFT_CENTER , ALIGN_LEFT_BOTTOM , & ALIGN_CENTER_TOP , ALIGN_CENTER_CENTER , ALIGN_CENTER_BOTTOM , & ALIGN_RIGHT_TOP , ALIGN_RIGHT_CENTER , ALIGN_RIGHT_BOTTOM , & ALIGN_LEFT_BASE_LINE , ALIGN_CENTER_BASE_LINE , ALIGN_RIGHT_BASE_LINE use vkf_sphere , only : Sphere use vkf_model , only : Model use vkf_window , only : FrameManager , WindowProxy , MOUSE_MOVE , MOUSE_PRESS , MOUSE_RELEASE , & WindowEventHandler , MOUSE_LEFT , MOUSE_MIDDLE , MOUSE_RIGHT , DRAG_START , DRAG_MOVE , DRAG_END , & KEY_SPACE , KEY_BACKSPACE , KEY_TAB , KEY_RETURN , KEY_ESCAPE , KEY_DELETE , KEY_HOME , & KEY_LEFT , KEY_UP , KEY_RIGHT , KEY_DOWN , KEY_PAGE_UP , KEY_PAGE_DOWN , KEY_END , KEY_INSERT , & KEY_F1 , MOD_SHIFT , MOD_CAPS_LOCK , MOD_CONTROL , MOD_ALT , MOD_NUM_LOCK , MOD_META use vkf_handles , only : DragHandle , VectorHandle , TimeHandle , TimePath , TrajectoryPath , & HANDLE_FREE , HANDLE_PLANE , HANDLE_LINE , HANDLE_RADIAL , HANDLE_SPHERE use vkf_pick , only : ray_plane , ray_sphere , ray_line use vkf_hud , only : HUDText use vkf_gui , only : Gui use vkf_sky , only : SkySphere , SKY_NONE , SKY_TEXTURE , SKY_STARS use vkf_shapes , only : CoordinateAxes , LatLonGrid , RadialPlane , PolyhedralCone , EllipticCone , RectangularCone , & CONE_NONE , CONE_SIDES , CONE_EDGES , CONE_BASE_OUTLINE , CONE_ALL , & Polyhedron , POLY_NONE , POLY_FACES , POLY_EDGES , POLY_VERTICES , POLY_ALL use vkf_files , only : find_data_file use vkf_cache , only : cache_directory , clear_cache use vkf_diagnostics , only : LibraryVersions , DeviceInfo , RenderStats , SceneCounts , library_versions , vkframes_version use vkf_artists , only : TrajectoryArtist , CurveArtist , SegmentArtist , MarkerArtist , RibbonArtist , DrawableTrajectory , & MARKER_START , MARKER_INTERMEDIATE , MARKER_END , & INTERMEDIATE_TIME , INTERMEDIATE_DISTANCE , INTERMEDIATE_DATA , & MARKER_DISK , MARKER_CIRCLE , MARKER_SQUARE , MARKER_PLUS , MARKER_X , MARKER_TARGET , & MARKER_ROSE , MARKER_CIRCLE_PULSE , MARKER_DISK_PULSE , MARKER_SPIRAL , MARKER_IMAGE , & HIGHLIGHT_NONE , HIGHLIGHT_PULSE , HIGHLIGHT_ARROWS , TRAIL_PAST , TRAIL_FUTURE , & DASH_SCENE , DASH_SCREEN , DASH_FIXED use vkf_line_segments , only : CustomLineSegments , LineSegmentsCallback use vkf_shadow , only : ShadowCones , SHADOW_UMBRA , SHADOW_PENUMBRA , SHADOW_ANTUMBRA , SHADOW_ALL use vkf_view , only : View , ABSOLUTE_FRAME , RELATIVE_FRAME , VIEW_DIRECT , VIEW_AZEL , ORTHOGRAPHIC , PERSPECTIVE , & camera_between , transform_camera use vkf_terrain , only : TerrainBody , rocky_available , LAYER_TMS , LAYER_GDAL , LAYER_GEODETIC , LAYER_MERCATOR , & ELEVATION_HEIGHTS , ELEVATION_MAPBOX , ELEVATION_TERRARIUM implicit none public end module vkframes","tags":"","url":"sourcefile/vkframes.f90.html"},{"title":"vkf_view.f90 – vkframes","text":"This file depends on sourcefile~~vkf_view.f90~~EfferentGraph sourcefile~vkf_view.f90 vkf_view.f90 sourcefile~vkf_frames.f90 vkf_frames.f90 sourcefile~vkf_view.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_math.f90 vkf_math.f90 sourcefile~vkf_view.f90->sourcefile~vkf_math.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_math.f90 sourcefile~vkf_follower.f90 vkf_follower.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_follower.f90 sourcefile~vkf_geometry.f90 vkf_geometry.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_geometry.f90 sourcefile~vkf_layer.f90 vkf_layer.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_pick.f90 vkf_pick.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_pick.f90 sourcefile~vkf_text.f90 vkf_text.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_text.f90 sourcefile~vkf_trajectory.f90 vkf_trajectory.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_trajectory.f90 sourcefile~vkf_follower.f90->sourcefile~vkf_math.f90 sourcefile~vkf_follower.f90->sourcefile~vkf_trajectory.f90 sourcefile~vkf_geometry.f90->sourcefile~vkf_math.f90 sourcefile~vkf_geometry.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_pick.f90->sourcefile~vkf_math.f90 sourcefile~vkf_text.f90->sourcefile~vkf_math.f90 sourcefile~vkf_text.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_files.f90 vkf_files.f90 sourcefile~vkf_text.f90->sourcefile~vkf_files.f90 sourcefile~vkf_trajectory.f90->sourcefile~vkf_math.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~vkf_view.f90~~AfferentGraph sourcefile~vkf_view.f90 vkf_view.f90 sourcefile~vkf_window.f90 vkf_window.f90 sourcefile~vkf_window.f90->sourcefile~vkf_view.f90 sourcefile~vkframes.f90 vkframes.f90 sourcefile~vkframes.f90->sourcefile~vkf_view.f90 sourcefile~vkframes.f90->sourcefile~vkf_window.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code !> Camera views: where the camera looks from, as OpenFrames' View. !> !> A view follows a frame: the camera's trackball (eye, center, up, which the !> mouse moves) is kept in the view frame's coordinates, so the camera moves !> with the frame. The view frame is !> * RELATIVE_FRAME (the default): the viewed frame itself (a body-fixed view); !> * ABSOLUTE_FRAME: the root frame's axes, at the viewed frame's origin (an !>   inertial view that follows the frame as it moves). !> A view between frames (`set_view_between_frames`) looks from one frame at !> another: the view frame is turned so that its +y axis (the trackball's !> initial viewing direction) points at the second frame, in one direct rotation !> (VIEW_DIRECT) or first in azimuth, then elevation (VIEW_AZEL, the default, !> which keeps z up). !> !> The default camera (`reset_view`) looks along +y at the frame's bound from the !> distance at which it fills the field of view (or from `default_view_distance`, !> or from `set_default_view_parameters`). Views are not owned by windows: a !> view, and the frames it refers to, must stay alive while used. !> !> The camera (OpenFrames' trackball get/setTransformation): a window's !> `get_camera` / `set_camera` for the view it shows (and smooth transitions, !> see vkf_window), or `View%set_camera` for a view's camera when it is next !> shown. `camera_between` interpolates between two cameras (each eye, center, !> up): the center along a straight line, the distance geometrically, the !> orientation by the shortest rotation. module vkf_view use vkf_math , only : wp , pi , quat_from_vectors , quat_to_matrix , translation_matrix , identity_matrix , & rigid_inverse , quat_from_matrix , quat_slerp , quat_normalize , cross use vkf_frames , only : ReferenceFrame implicit none private !> the base frame of the trackball (OpenFrames' ViewFrameType) integer , parameter , public :: ABSOLUTE_FRAME = 0 !! the root frame's axes, at the viewed frame's origin integer , parameter , public :: RELATIVE_FRAME = 1 !! the viewed frame itself !> how a view between frames turns toward the look-at frame (OpenFrames' ViewRotationType) integer , parameter , public :: VIEW_DIRECT = 0 !! one direct rotation integer , parameter , public :: VIEW_AZEL = 1 !! azimuth, then elevation (keeps z up) !> projections (OpenFrames' ProjectionType) integer , parameter , public :: ORTHOGRAPHIC = 0 !! orthographic projection integer , parameter , public :: PERSPECTIVE = 1 !! perspective projection !> A view (see the module documentation). type , public :: View private class ( ReferenceFrame ), pointer :: root => null () !! the root of the frames' tree (not owned) class ( ReferenceFrame ), pointer :: frame => null () !! the viewed frame (not owned) class ( ReferenceFrame ), pointer :: lookat => null () !! the frame looked at (view between frames; not owned) integer :: frame_type = RELATIVE_FRAME !! ABSOLUTE_FRAME or RELATIVE_FRAME integer :: rotation_type = VIEW_AZEL !! VIEW_DIRECT or VIEW_AZEL integer :: projection = PERSPECTIVE !! ORTHOGRAPHIC or PERSPECTIVE real ( wp ) :: fovy = 4 5.0_wp !! vertical field of view (degrees) real ( wp ) :: ortho ( 4 ) = [ - 1.0_wp , 1.0_wp , - 1.0_wp , 1.0_wp ] !! left, right, bottom, top real ( wp ) :: default_distance = 0.0_wp !! radius framed on reset (<= 0: the frame's bound) real ( wp ) :: default_eye ( 3 ) = 0.0_wp !! camera eye after a reset (view-frame coordinates) real ( wp ) :: default_center ( 3 ) = 0.0_wp !! camera center after a reset (view-frame coordinates) real ( wp ) :: default_up ( 3 ) = 0.0_wp !! camera up after a reset (zero: no default camera) ! the trackball state of this view (view-frame coordinates), kept while another view is shown real ( wp ) :: eye ( 3 ) = 0.0_wp !! kept eye real ( wp ) :: center ( 3 ) = 0.0_wp !! kept center real ( wp ) :: up ( 3 ) = 0.0_wp !! kept up direction logical :: has_state = . false . !! true if eye, center, up are kept logical :: reset_pending = . true . !! true if the camera is to be reset when shown real ( wp ) :: pending ( 3 , 3 ) = 0.0_wp !! a camera set (eye, center, up), for when it is shown logical :: camera_pending = . false . !! true if `pending` is to be applied when shown contains procedure :: set_view_frame , set_view_between_frames procedure :: view_root , view_frame , lookat_frame , view_frame_type , view_rotation_type , is_valid procedure :: set_perspective , field_of_view , set_orthographic , orthographic_bounds , projection_type procedure :: set_default_view_distance , default_view_distance procedure :: set_default_view_parameters , default_view_parameters , clear_default_view_parameters procedure :: reset_view procedure :: world_to_view , home procedure :: save_state , saved_state , take_reset procedure :: set_camera => view_set_camera , take_camera end type View public :: camera_between , transform_camera !> The View constructor: `View(...)` makes one (see `new_view` for its !> arguments). interface View module procedure new_view end interface View contains !> A view of `frame` (in the tree of `root`), with base `frame_type` !> (default RELATIVE_FRAME); with `lookat`, a view from `frame` at `lookat`, !> turned by `rotation_type` (default VIEW_AZEL). Without frames, the view !> looks at the root frame's origin. The frames must stay alive while the !> view is used. function new_view ( root , frame , lookat , frame_type , rotation_type ) result ( v ) class ( ReferenceFrame ), intent ( in ), target , optional :: root , frame , lookat integer , intent ( in ), optional :: frame_type !! ABSOLUTE_FRAME or RELATIVE_FRAME integer , intent ( in ), optional :: rotation_type !! VIEW_DIRECT or VIEW_AZEL type ( View ) :: v integer :: ft , rt ft = RELATIVE_FRAME rt = VIEW_AZEL if ( present ( frame_type )) ft = frame_type if ( present ( rotation_type )) rt = rotation_type if ( present ( root )) v % root => root if ( present ( frame )) v % frame => frame if ( present ( lookat )) v % lookat => lookat v % frame_type = ft v % rotation_type = rt end function new_view !> View `frame` (in the tree of `root`) with base `frame_type` (default RELATIVE_FRAME). subroutine set_view_frame ( self , root , frame , frame_type ) class ( View ), intent ( inout ) :: self class ( ReferenceFrame ), intent ( in ), target :: root , frame integer , intent ( in ), optional :: frame_type !! ABSOLUTE_FRAME or RELATIVE_FRAME self % root => root self % frame => frame self % lookat => null () self % frame_type = RELATIVE_FRAME if ( present ( frame_type )) self % frame_type = frame_type end subroutine set_view_frame !> Look from `frame` at `lookat` (both in the tree of `root`). subroutine set_view_between_frames ( self , root , frame , lookat , frame_type , rotation_type ) class ( View ), intent ( inout ) :: self class ( ReferenceFrame ), intent ( in ), target :: root , frame , lookat integer , intent ( in ), optional :: frame_type !! ABSOLUTE_FRAME or RELATIVE_FRAME (default) integer , intent ( in ), optional :: rotation_type !! VIEW_DIRECT or VIEW_AZEL (default) self % root => root self % frame => frame self % lookat => lookat self % frame_type = RELATIVE_FRAME self % rotation_type = VIEW_AZEL if ( present ( frame_type )) self % frame_type = frame_type if ( present ( rotation_type )) self % rotation_type = rotation_type end subroutine set_view_between_frames !> The root of the viewed frames' tree (null if none). function view_root ( self ) result ( f ) class ( View ), intent ( in ) :: self class ( ReferenceFrame ), pointer :: f f => self % root end function view_root !> The viewed frame (null if none). function view_frame ( self ) result ( f ) class ( View ), intent ( in ) :: self class ( ReferenceFrame ), pointer :: f f => self % frame end function view_frame !> The frame looked at, for a view between frames (null if none). function lookat_frame ( self ) result ( f ) class ( View ), intent ( in ) :: self class ( ReferenceFrame ), pointer :: f f => self % lookat end function lookat_frame !> The base of the trackball: ABSOLUTE_FRAME or RELATIVE_FRAME. pure integer function view_frame_type ( self ) class ( View ), intent ( in ) :: self view_frame_type = self % frame_type end function view_frame_type !> How a view between frames turns: VIEW_DIRECT or VIEW_AZEL. pure integer function view_rotation_type ( self ) class ( View ), intent ( in ) :: self view_rotation_type = self % rotation_type end function view_rotation_type !> True if the view has a frame to view. logical function is_valid ( self ) class ( View ), intent ( in ) :: self is_valid = associated ( self % frame ) end function is_valid ! ================================================================== ! projection and defaults !> A perspective projection with vertical field of view `fovy` (degrees; default 45). subroutine set_perspective ( self , fovy ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( in ) :: fovy !! vertical field of view (degrees) self % projection = PERSPECTIVE self % fovy = fovy end subroutine set_perspective !> The vertical field of view (degrees) of the perspective projection. pure real ( wp ) function field_of_view ( self ) result ( fovy ) class ( View ), intent ( in ) :: self fovy = self % fovy end function field_of_view !> An orthographic projection with the given bounds (in view units). subroutine set_orthographic ( self , left , right , bottom , top ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( in ) :: left , right , bottom , top self % projection = ORTHOGRAPHIC self % ortho = [ left , right , bottom , top ] end subroutine set_orthographic !> The bounds [left, right, bottom, top] of the orthographic projection. pure function orthographic_bounds ( self ) result ( bounds ) class ( View ), intent ( in ) :: self real ( wp ) :: bounds ( 4 ) bounds = self % ortho end function orthographic_bounds !> The projection: ORTHOGRAPHIC or PERSPECTIVE. pure integer function projection_type ( self ) class ( View ), intent ( in ) :: self projection_type = self % projection end function projection_type !> The radius to frame when the view is reset (<= 0: the viewed frame's !> bound, the default), as OpenFrames' default view distance. subroutine set_default_view_distance ( self , distance ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( in ) :: distance !! radius (<= 0: the frame's bound) self % default_distance = distance end subroutine set_default_view_distance !> The radius framed when the view is reset (<= 0: the viewed frame's bound). pure real ( wp ) function default_view_distance ( self ) class ( View ), intent ( in ) :: self default_view_distance = self % default_distance end function default_view_distance !> The camera after a reset, in view-frame coordinates (overrides the !> default view distance). subroutine set_default_view_parameters ( self , eye , center , up ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( in ) :: eye ( 3 ), center ( 3 ), up ( 3 ) self % default_eye = eye self % default_center = center self % default_up = up end subroutine set_default_view_parameters !> The camera after a reset (view-frame coordinates; all zero if none is set). pure subroutine default_view_parameters ( self , eye , center , up ) class ( View ), intent ( in ) :: self real ( wp ), intent ( out ) :: eye ( 3 ), center ( 3 ), up ( 3 ) eye = self % default_eye center = self % default_center up = self % default_up end subroutine default_view_parameters !> Forget the camera set by `set_default_view_parameters` (back to the default view distance). subroutine clear_default_view_parameters ( self ) class ( View ), intent ( inout ) :: self self % default_eye = 0.0_wp self % default_center = 0.0_wp self % default_up = 0.0_wp end subroutine clear_default_view_parameters !> Put the camera back at the default position (applied at the next frame !> in which the view is shown). subroutine reset_view ( self ) class ( View ), intent ( inout ) :: self self % reset_pending = . true . end subroutine reset_view ! ================================================================== ! camera (used by the window showing the view) !> The transform from the root frame to the view frame (4x4), from the !> frames' current positions and attitudes. function world_to_view ( self ) result ( m ) class ( View ), intent ( in ) :: self real ( wp ) :: m ( 4 , 4 ) real ( wp ) :: f ( 4 , 4 ), rel ( 3 ), xy ( 3 ), r ( 3 , 3 ), len real ( wp ), parameter :: eps = 1.0e-6_wp m = identity_matrix () if (. not . associated ( self % frame )) return f = frame_to_root ( self , self % frame ) if ( self % frame_type == ABSOLUTE_FRAME ) then m = translation_matrix ( - f ( 1 : 3 , 4 )) else m = rigid_inverse ( f ) end if if (. not . associated ( self % lookat )) return ! the look-at frame's origin in the view frame, turned onto +y f = frame_to_root ( self , self % lookat ) rel = matmul ( m ( 1 : 3 , 1 : 3 ), f ( 1 : 3 , 4 )) + m ( 1 : 3 , 4 ) if ( norm2 ( rel ) <= eps ) return if ( self % rotation_type == VIEW_DIRECT ) then m = rotated ( quat_to_matrix ( quat_from_vectors ( rel , [ 0.0_wp , 1.0_wp , 0.0_wp ])), m ) else xy = [ rel ( 1 ), rel ( 2 ), 0.0_wp ] len = norm2 ( xy ) if ( len > eps ) m = rotated ( quat_to_matrix ( quat_from_vectors ( xy , [ 0.0_wp , 1.0_wp , 0.0_wp ])), m ) r = quat_to_matrix ( quat_from_vectors ([ 0.0_wp , len , rel ( 3 )], [ 0.0_wp , 1.0_wp , 0.0_wp ])) m = rotated ( r , m ) end if end function world_to_view !> The default camera (eye, center, up in view-frame coordinates) for a !> viewport of aspect ratio `aspect` (width / height): OpenFrames' resetView. subroutine home ( self , aspect , eye , center , up ) class ( View ), intent ( in ) :: self real ( wp ), intent ( in ) :: aspect !! viewport width / height real ( wp ), intent ( out ) :: eye ( 3 ), center ( 3 ), up ( 3 ) real ( wp ) :: c ( 3 ), r , dist , half_fovy , half_fovx , m ( 4 , 4 ) if ( norm2 ( self % default_up ) /= 0.0_wp ) then eye = self % default_eye center = self % default_center up = self % default_up return end if c = 0.0_wp r = 0.0_wp if ( associated ( self % frame )) then call self % frame % bound ( c , r ) m = matmul ( self % world_to_view (), frame_to_root ( self , self % frame )) ! frame to view frame c = matmul ( m ( 1 : 3 , 1 : 3 ), c ) + m ( 1 : 3 , 4 ) end if if ( self % default_distance > 0.0_wp ) then r = self % default_distance else if ( r <= 0.0_wp ) then r = 1.0_wp end if dist = 2.0_wp * r if ( self % projection == PERSPECTIVE ) then half_fovy = 0.5_wp * self % fovy * pi / 18 0.0_wp half_fovx = atan ( aspect * tan ( half_fovy )) dist = r / sin ( min ( half_fovy , half_fovx )) end if center = c eye = c + [ 0.0_wp , - dist , 0.0_wp ] up = [ 0.0_wp , 0.0_wp , 1.0_wp ] end subroutine home !> Keep the trackball state while another view is shown. subroutine save_state ( self , eye , center , up ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( in ) :: eye ( 3 ), center ( 3 ), up ( 3 ) self % eye = eye self % center = center self % up = up self % has_state = . true . end subroutine save_state !> The kept trackball state; false if there is none. logical function saved_state ( self , eye , center , up ) class ( View ), intent ( in ) :: self real ( wp ), intent ( out ) :: eye ( 3 ), center ( 3 ), up ( 3 ) saved_state = self % has_state eye = self % eye center = self % center up = self % up end function saved_state !> The camera (view-frame coordinates) to show the next time the view is !> drawn (at once if it is shown: the window's `set_camera` can also fly !> there). It replaces a pending reset. subroutine view_set_camera ( self , eye , center , up ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( in ) :: eye ( 3 ), center ( 3 ), up ( 3 ) self % pending (:, 1 ) = eye self % pending (:, 2 ) = center self % pending (:, 3 ) = up self % camera_pending = . true . self % reset_pending = . false . end subroutine view_set_camera !> True (once) if a camera was set (`set_camera`), and that camera. logical function take_camera ( self , cam ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( out ) :: cam ( 3 , 3 ) !! (columns: eye, center, up (view-frame coordinates)) take_camera = self % camera_pending cam = self % pending self % camera_pending = . false . end function take_camera !> The camera a fraction `s` (0 to 1) of the way from camera `from` to !> camera `to` (columns: eye, center, up; in one frame's coordinates): the !> center moved along a straight line, the distance to it changed by the !> same factor at each step (so far-to-near flights don't rush the near !> part), and the orientation turned by the shortest rotation. pure function camera_between ( s , from , to ) result ( cam ) real ( wp ), intent ( in ) :: s !! fraction of the way (0: `from`, 1: `to`) real ( wp ), intent ( in ) :: from ( 3 , 3 ) !! (columns: eye, center, up) real ( wp ), intent ( in ) :: to ( 3 , 3 ) !! (columns: eye, center, up) real ( wp ) :: cam ( 3 , 3 ) real ( wp ) :: q0 ( 4 ), q1 ( 4 ), m ( 3 , 3 ), d0 , d1 , d , c ( 3 ) call camera_orientation ( from , q0 , d0 ) call camera_orientation ( to , q1 , d1 ) c = from (:, 2 ) + s * ( to (:, 2 ) - from (:, 2 )) d = d0 * ( d1 / d0 ) ** s m = quat_to_matrix ( quat_normalize ( quat_slerp ( s , q0 , q1 ))) ! columns: right, up, back cam (:, 1 ) = c + d * m (:, 3 ) cam (:, 2 ) = c cam (:, 3 ) = m (:, 2 ) end function camera_between !> A camera's orientation (columns: right, up, back, as a quaternion) and !> its distance from eye to center (at least a tiny one). pure subroutine camera_orientation ( cam , q , d ) real ( wp ), intent ( in ) :: cam ( 3 , 3 ) !! (columns: eye, center, up) real ( wp ), intent ( out ) :: q ( 4 ) !! orientation quaternion [x, y, z, w] real ( wp ), intent ( out ) :: d !! distance from eye to center real ( wp ) :: f ( 3 ), r ( 3 ), m ( 3 , 3 ) f = cam (:, 2 ) - cam (:, 1 ) d = norm2 ( f ) if ( d > 0.0_wp ) then f = f / d else f = [ 0.0_wp , 1.0_wp , 0.0_wp ] end if d = max ( d , tiny ( 1.0_wp ) * 1.0e10_wp ) r = cross ( f , cam (:, 3 )) if ( norm2 ( r ) < 1.0e-12_wp ) r = cross ( f , [ 0.0_wp , 0.0_wp , 1.0_wp ]) ! (up along the view: any) if ( norm2 ( r ) < 1.0e-12_wp ) r = cross ( f , [ 1.0_wp , 0.0_wp , 0.0_wp ]) r = r / norm2 ( r ) m (:, 1 ) = r m (:, 2 ) = cross ( r , f ) m (:, 3 ) = - f q = quat_from_matrix ( m ) end subroutine camera_orientation !> A camera (columns: eye, center, up) in the coordinates a rigid !> transform `m` (4x4) takes it to: the points moved, the up direction turned. pure function transform_camera ( m , cam ) result ( out ) real ( wp ), intent ( in ) :: m ( 4 , 4 ) !! rigid transform real ( wp ), intent ( in ) :: cam ( 3 , 3 ) !! (columns: eye, center, up) real ( wp ) :: out ( 3 , 3 ) out (:, 1 ) = matmul ( m ( 1 : 3 , 1 : 3 ), cam (:, 1 )) + m ( 1 : 3 , 4 ) out (:, 2 ) = matmul ( m ( 1 : 3 , 1 : 3 ), cam (:, 2 )) + m ( 1 : 3 , 4 ) out (:, 3 ) = matmul ( m ( 1 : 3 , 1 : 3 ), cam (:, 3 )) end function transform_camera !> True (once) if a reset is pending. logical function take_reset ( self ) class ( View ), intent ( inout ) :: self take_reset = self % reset_pending self % reset_pending = . false . if ( take_reset ) self % has_state = . false . end function take_reset ! ================================================================== ! helpers !> The transform from `f` to the view's root frame (the tree root if none). function frame_to_root ( self , f ) result ( m ) type ( View ), intent ( in ) :: self class ( ReferenceFrame ), intent ( in ) :: f real ( wp ) :: m ( 4 , 4 ) m = f % world_matrix () if ( associated ( self % root )) m = matmul ( rigid_inverse ( self % root % world_matrix ()), m ) end function frame_to_root !> rotate(r) * m, for a rotation r (3x3). pure function rotated ( r , m ) result ( rm ) real ( wp ), intent ( in ) :: r ( 3 , 3 ), m ( 4 , 4 ) real ( wp ) :: rm ( 4 , 4 ) rm = m rm ( 1 : 3 , :) = matmul ( r , m ( 1 : 3 , :)) end function rotated end module vkf_view","tags":"","url":"sourcefile/vkf_view.f90.html"},{"title":"vkf_window.f90 – vkframes","text":"This file depends on sourcefile~~vkf_window.f90~~EfferentGraph sourcefile~vkf_window.f90 vkf_window.f90 sourcefile~vkf_clock.f90 vkf_clock.f90 sourcefile~vkf_window.f90->sourcefile~vkf_clock.f90 sourcefile~vkf_diagnostics.f90 vkf_diagnostics.f90 sourcefile~vkf_window.f90->sourcefile~vkf_diagnostics.f90 sourcefile~vkf_frames.f90 vkf_frames.f90 sourcefile~vkf_window.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_gui.f90 vkf_gui.f90 sourcefile~vkf_window.f90->sourcefile~vkf_gui.f90 sourcefile~vkf_handles.f90 vkf_handles.f90 sourcefile~vkf_window.f90->sourcefile~vkf_handles.f90 sourcefile~vkf_hud.f90 vkf_hud.f90 sourcefile~vkf_window.f90->sourcefile~vkf_hud.f90 sourcefile~vkf_layer.f90 vkf_layer.f90 sourcefile~vkf_window.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_math.f90 vkf_math.f90 sourcefile~vkf_window.f90->sourcefile~vkf_math.f90 sourcefile~vkf_pick.f90 vkf_pick.f90 sourcefile~vkf_window.f90->sourcefile~vkf_pick.f90 sourcefile~vkf_sky.f90 vkf_sky.f90 sourcefile~vkf_window.f90->sourcefile~vkf_sky.f90 sourcefile~vkf_text.f90 vkf_text.f90 sourcefile~vkf_window.f90->sourcefile~vkf_text.f90 sourcefile~vkf_view.f90 vkf_view.f90 sourcefile~vkf_window.f90->sourcefile~vkf_view.f90 sourcefile~vkf_clock.f90->sourcefile~vkf_math.f90 sourcefile~vkf_diagnostics.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_diagnostics.f90->sourcefile~vkf_math.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_math.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_pick.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_text.f90 sourcefile~vkf_follower.f90 vkf_follower.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_follower.f90 sourcefile~vkf_geometry.f90 vkf_geometry.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_geometry.f90 sourcefile~vkf_trajectory.f90 vkf_trajectory.f90 sourcefile~vkf_frames.f90->sourcefile~vkf_trajectory.f90 sourcefile~vkf_gui.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_gui.f90->sourcefile~vkf_math.f90 sourcefile~vkf_handles.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_handles.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_handles.f90->sourcefile~vkf_math.f90 sourcefile~vkf_handles.f90->sourcefile~vkf_pick.f90 sourcefile~vkf_artists.f90 vkf_artists.f90 sourcefile~vkf_handles.f90->sourcefile~vkf_artists.f90 sourcefile~vkf_handles.f90->sourcefile~vkf_geometry.f90 sourcefile~vkf_handles.f90->sourcefile~vkf_trajectory.f90 sourcefile~vkf_hud.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_hud.f90->sourcefile~vkf_math.f90 sourcefile~vkf_pick.f90->sourcefile~vkf_math.f90 sourcefile~vkf_sky.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_sky.f90->sourcefile~vkf_math.f90 sourcefile~vkf_sky.f90->sourcefile~vkf_text.f90 sourcefile~vkf_files.f90 vkf_files.f90 sourcefile~vkf_sky.f90->sourcefile~vkf_files.f90 sourcefile~vkf_text.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_text.f90->sourcefile~vkf_math.f90 sourcefile~vkf_text.f90->sourcefile~vkf_files.f90 sourcefile~vkf_view.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_view.f90->sourcefile~vkf_math.f90 sourcefile~vkf_artists.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_artists.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_artists.f90->sourcefile~vkf_math.f90 sourcefile~vkf_artists.f90->sourcefile~vkf_pick.f90 sourcefile~vkf_artists.f90->sourcefile~vkf_trajectory.f90 sourcefile~vkf_line_chain.f90 vkf_line_chain.f90 sourcefile~vkf_artists.f90->sourcefile~vkf_line_chain.f90 sourcefile~vkf_follower.f90->sourcefile~vkf_math.f90 sourcefile~vkf_follower.f90->sourcefile~vkf_trajectory.f90 sourcefile~vkf_geometry.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_geometry.f90->sourcefile~vkf_math.f90 sourcefile~vkf_trajectory.f90->sourcefile~vkf_math.f90 sourcefile~vkf_line_chain.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_line_chain.f90->sourcefile~vkf_math.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~vkf_window.f90~~AfferentGraph sourcefile~vkf_window.f90 vkf_window.f90 sourcefile~vkframes.f90 vkframes.f90 sourcefile~vkframes.f90->sourcefile~vkf_window.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code !> Windows showing a scene of frames, with its simulation time, as OpenFrames' !> FrameManager and WindowProxy (for now with a single viewport, which holds !> the views as OpenFrames' RenderRectangle does; OpenFrames' grid of !> viewports comes later). !> !> A FrameManager holds the root frame of a scene. A WindowProxy shows one: in !> a window of its own, or in a host's native window (e.g. a Qt QWindow's !> `winId()`), in which case the host forwards the window's events !> (`mouse`, `scroll`, `key`, `resize`, `close`). Each `frame()` advances the !> simulation clock, updates the frames (followed trajectories), copies their !> positions and attitudes to the renderer, places the camera for the current !> View and draws. !> !> Several windows can show one scene (its render nodes are shared). The scene !> is updated once per simulation time: a window whose time is the one the !> scene was last updated for, by another window since this one's last frame, !> doesn't update it again (`FrameManager%update`). Windows whose clocks are !> synchronized (`SimulationClock%synchronize`) render the same time, their !> master's at its last frame, so they show the scene in the same state and !> update it once per round of frames, also while the time is paused (then !> each round still updates once, for data added meanwhile). !> !> A window has a list of views (`add_view`, `select_view`, `next_view`, ...); !> each keeps its own camera (the trackball) while another one is shown. !> Without views, a default view of the scene's root frame is used. !> !> Keyboard and mouse (OpenFrames' WindowProxy callbacks, setKeyPressCallback, !> setMouseMotionCallback, setButtonPressCallback, setButtonReleaseCallback): !> a program's WindowEventHandler, an extension overriding the procedures it !> wants (`key_press`, `key_release`, `mouse_motion`, `button_press`, !> `button_release`), is given the window's events (`set_event_handler`), !> also those a host forwards. They're passed on after the frame in which they !> arrived (from `frame()`), so a handler may change anything, the window !> included (its views, its time, closing it). Positions are in -1 to 1 across !> the window, y up, as OpenFrames'. The built-in keys, as OpenFrames': `v` the !> next view, `V` the previous one, the space bar resets the view (unless the !> handler's `key_press` says it handled the key, or `set_default_keys(.false.)`). !> The mouse moves the camera (the trackball); the keys don't. !> !> Each frame, the handler's `before_draw(window, t)` is called once the !> scene is at the frame's time and the camera is placed (the trackball's !> moves included), just before drawing: what it changes (HUD text, labels, !> frames' positions) is in this frame, e.g. a callout kept next to a moving !> object (`screen_position`) without lagging a frame behind, whoever runs !> the frame loop (the program or a host GUI). !> !> The camera (OpenFrames' trackball getTransformation / setTransformation): !> `get_camera` and `set_camera` (eye, center, up in the shown view's frame, !> or in its root frame with `in_root`). Smooth transitions (not in !> OpenFrames): `set_camera` with a `duration` flies there, and with !> `set_view_transition(seconds)` (default 0: a cut, as OpenFrames) changing !> the view (select_view, next_view, previous_view, the keys v and V; or with !> their own `duration`) and resetting it (the space bar) fly from the camera !> shown to the new one. A flight moves the center along a straight line, the !> distance geometrically and the orientation by the shortest rotation, eased !> in and out, in the root frame (both views' frames as they move), over the !> wall-clock time given (the video's while recording); a mouse press, `stop_transition` or another flight !> ends it. !> !> Video recording (not in OpenFrames, which has only screenshots): !> `start_recording(file, fps)` ... `stop_recording()` records the frames !> drawn to a video file, encoded by ffmpeg (conda-forge's, in the pixi !> environment; or `ffmpeg`, or VKFRAMES_FFMPEG): the frames are piped to it !> as raw pixels (no image files; see vkf_viewer_record_start in !> src/vsg/vkf_layer.cpp). While recording, the window's time is the video's: !> each frame advances the simulation time by exactly scale/fps, and camera !> flights and animated shaders (pulsing markers, highlighted lines) by !> 1/fps s, so the video plays smoothly at its own speed however long a !> frame takes to draw (or to encode). Stopping goes back to the wall clock !> from where the video was. A watermark (e.g. a logo) can be drawn over the !> video by ffmpeg (`watermark`). The video's size is its first frame's (a window !> resized while recording is cropped or padded). !> !> The mouse's sensitivity: `set_zoom_speed` (the zoom per wheel or trackpad !> step and per right drag; default 1, VSG's) and `set_camera_throw` (the !> camera keeps moving after a drag released while moving; default on). !> !> Picking (not in OpenFrames): `pick(x, y, hits)` gives what is under a !> point of the window (x, y as the event handler's: -1 to 1, y up), nearest !> first, as drawn at the last frame: trajectory curves (the point and the !> time there), segments and markers (within a few pixels: `tolerance`, plus !> half a line's width or a marker's size), bodies (the point on the surface, !> with latitude and longitude) and frames' origins. Each frame of the scene !> tests its own contents (ReferenceFrame%pick, vkf_pick); nothing is done !> until `pick` is called. `cursor_ray(x, y, origin, direction)` gives the ray !> from the eye through a point of the window (root frame), e.g. to place !> something where the cursor points (vkf_pick's ray_plane, ray_sphere, !> ray_line). !> !> Handles (vkf_handles: DragHandle, e.g. VectorHandle): while a scene shown !> in a window has handles, the window looks for one under the cursor at each !> mouse move (a pick of PICK_HANDLE only), hovers it (drawn brighter) and !> arms a grab: a left button press then grabs the handle instead of moving !> the camera, the moves drag it (DragHandle%drag, with the cursor's ray) and !> the release lets it go. The handler is told (`handle_drag`: DRAG_START, !> DRAG_MOVE, DRAG_END), not given those presses, moves and releases !> (`button_press`, `mouse_motion`, `button_release`). A handle is dragged !> from the frame after the event's, as other events are handled. The !> middle and right buttons move the camera over handles too. module vkf_window use , intrinsic :: iso_c_binding , only : c_ptr , c_null_ptr , c_associated , c_int , c_long_long , c_double , c_float , c_char use , intrinsic :: iso_fortran_env , only : int64 use vkf_math , only : wp , rigid_inverse , identity_matrix use vkf_frames , only : ReferenceFrame , PickHit , PICK_HANDLE use vkf_pick , only : PickCamera , pick_camera , project , ray use vkf_handles , only : DragHandle , handles_shown use vkf_clock , only : SimulationClock , wall_time use vkf_view , only : View , PERSPECTIVE , camera_between , transform_camera use vkf_hud , only : HUDText use vkf_sky , only : SkySphere use vkf_text , only : label_create , label_set_layout , find_font , default_font use vkf_gui , only : Gui use vkf_layer , only : vkf_viewer_create , vkf_viewer_delete , vkf_viewer_add_node , vkf_viewer_frame , & vkf_viewer_capture , vkf_viewer_look_at , vkf_viewer_perspective , vkf_viewer_set_background , & vkf_viewer_get_look_at , vkf_viewer_set_view_transform , vkf_viewer_orthographic , & vkf_viewer_hud_add , vkf_label_set_text , vkf_label_set_color , & vkf_viewer_mouse , vkf_viewer_scroll , vkf_viewer_key , vkf_viewer_resize , vkf_viewer_close , & vkf_viewer_light , vkf_viewer_light_enable , vkf_light_set , vkf_viewer_remove_node , & vkf_viewer_hud_remove , vkf_node_delete , vkf_viewer_set_pixel_ratio , & vkf_viewer_events , vkf_viewer_size , vkf_viewer_pixel_ratio , & vkf_viewer_frame_begin , vkf_viewer_frame_draw , vkf_viewer_gui , & vkf_viewer_record_start , vkf_viewer_record_stop , vkf_viewer_record_frames , & vkf_viewer_set_camera_controls , vkf_driver_preload , vkf_viewer_set_grab , & vkf_viewer_device_info , vkf_viewer_stats , vkf_viewer_scene_counts use vkf_diagnostics , only : RenderStats , DeviceInfo , SceneCounts implicit none private !> mouse event kinds for WindowProxy%mouse integer , parameter , public :: MOUSE_MOVE = 1 , MOUSE_PRESS = 2 , MOUSE_RELEASE = 3 !! WindowProxy%mouse kind !> mouse buttons (WindowEventHandler, WindowProxy%mouse) integer , parameter , public :: MOUSE_LEFT = 1 , MOUSE_MIDDLE = 2 , MOUSE_RIGHT = 3 !! button numbers !> a handle's drag (WindowEventHandler%handle_drag): grabbed, moved, released integer , parameter , public :: DRAG_START = 1 , DRAG_MOVE = 2 , DRAG_END = 3 !> keys (WindowEventHandler): printable keys are their characters, !> iachar('a'), iachar('A') with shift; the others (VSG's key symbols): integer , parameter , public :: KEY_SPACE = 32 , KEY_BACKSPACE = int ( z 'FF08' ), KEY_TAB = int ( z 'FF09' ), & KEY_RETURN = int ( z 'FF0D' ), KEY_ESCAPE = int ( z 'FF1B' ), KEY_DELETE = int ( z 'FFFF' ), & KEY_HOME = int ( z 'FF50' ), KEY_LEFT = int ( z 'FF51' ), KEY_UP = int ( z 'FF52' ), & KEY_RIGHT = int ( z 'FF53' ), KEY_DOWN = int ( z 'FF54' ), KEY_PAGE_UP = int ( z 'FF55' ), & KEY_PAGE_DOWN = int ( z 'FF56' ), KEY_END = int ( z 'FF57' ), KEY_INSERT = int ( z 'FF63' ), & KEY_F1 = int ( z 'FFBE' ) !! F2 to F12: KEY_F1 + 1 to 11 !> modifier keys held (bits of `modifiers`: iand(modifiers, MOD_SHIFT) /= 0) integer , parameter , public :: MOD_SHIFT = 1 , MOD_CAPS_LOCK = 2 , MOD_CONTROL = 4 , MOD_ALT = 8 , & MOD_NUM_LOCK = 16 , MOD_META = 128 !! bits of `modifiers` !> The root frame of a scene (OpenFrames' FrameManager). The frame is not !> owned: it must stay alive while managed. type , public :: FrameManager private class ( ReferenceFrame ), pointer :: root => null () !! the scene's root frame (not owned) integer :: updates = 0 !! scene updates so far real ( wp ) :: updated_time = 0.0_wp !! the time of the last one contains procedure :: set_frame => fm_set_frame procedure :: frame => fm_frame procedure :: update => fm_update , num_updates => fm_num_updates end type FrameManager !> The FrameManager constructor: `FrameManager(...)` makes one (see `new_frame_manager` for its !> arguments). interface FrameManager module procedure new_frame_manager end interface FrameManager !> One of a window's views: a pointer to it (Fortran has no arrays of !> pointers). type :: ViewPointer type ( View ), pointer :: p => null () !! the view (not owned) end type ViewPointer !> A HUD text shown in a window, with the window's node for it. type :: HUDEntry type ( HUDText ), pointer :: p => null () !! the HUD text (not owned) type ( c_ptr ) :: node = c_null_ptr !! the window's label node for it (null until made) integer :: revision = - 1 !! the text's revision last shown character ( len = :), allocatable :: font !! the font its node was made with end type HUDEntry !> A camera flight (see the module documentation): from camera `start` !> (in view `from`'s frame) to camera `finish` (in view `to`'s). type :: CameraFlight logical :: active = . false . !! flying type ( View ), pointer :: from => null (), to => null () !! the views flown from and to real ( wp ) :: start ( 3 , 3 ) = 0.0_wp , finish ( 3 , 3 ) = 0.0_wp !! (columns: eye, center, up) real ( wp ) :: started = 0.0_wp !! the window's wall time at the start (s; window_wall) real ( wp ) :: duration = 0.0_wp !! s end type CameraFlight !> A program's handler of a window's keyboard and mouse events (see the !> module documentation): extend it and override the procedures wanted !> (the others do nothing). type , public :: WindowEventHandler contains procedure :: key_press => handler_key_press procedure :: key_release => handler_key_release procedure :: mouse_motion => handler_mouse_motion procedure :: button_press => handler_button_press procedure :: button_release => handler_button_release procedure :: before_draw => handler_before_draw procedure :: handle_drag => handler_handle_drag end type WindowEventHandler !> A window showing a scene (see the module documentation). type , public :: WindowProxy private type ( c_ptr ) :: viewer_ = c_null_ptr !! the rendering layer's viewer (null while closed) type ( FrameManager ), pointer :: scene => null () !! the scene shown (not owned) integer :: scene_seen = - 1 !! the scene's updates at this window's last frame type ( SimulationClock ) :: clock_ !! the window's simulation clock logical :: scene_added = . false . !! scene, sky, HUD texts given to the viewer real ( wp ) :: background ( 3 ) = [ 0.0_wp , 0.0_wp , 0.0_wp ] !! background color [r, g, b] (0 to 1) logical :: running = . false . !! open, and not closed by the user integer :: width_ = 1 , height_ = 1 !! logical size (for the views' aspect ratio) real ( wp ) :: pixel_ratio_ = 1.0_wp !! framebuffer pixels per window unit (a host's window) ! views type ( ViewPointer ), allocatable :: views (:) !! not owned (first n_views used) integer :: n_views = 0 , current = 0 !! number of views; the current one (0: none) type ( View ) :: default_view !! used when there are no views type ( View ), pointer :: shown => null () !! the view whose camera is in the renderer ! HUD text type ( HUDEntry ), allocatable :: huds (:) !! the HUD texts shown (first n_huds used) integer :: n_huds = 0 !! number of HUD texts type ( SkySphere ), pointer :: sky_ => null () !! the background sky ! the window's light (OpenFrames' default: a headlight) real ( wp ) :: light_ambient_ ( 3 ) = 0.2_wp , light_diffuse_ ( 3 ) = 1.0_wp , light_specular_ ( 3 ) = 0.0_wp !! [r, g, b] real ( wp ) :: light_position_ ( 4 ) = [ 0.0_wp , 0.0_wp , 1.0_wp , 0.0_wp ] !! eye coordinates (w 0: directional) logical :: light_on = . true . !! the window's light enabled (no frame's light source) ! keyboard and mouse class ( WindowEventHandler ), pointer :: handler => null () !! the program's event handler (not owned) class ( DragHandle ), pointer :: hovered_handle => null () !! the handle under the cursor (not owned) class ( DragHandle ), pointer :: dragged_handle => null () !! the handle grabbed (not owned) logical :: default_keys_ = . true . !! the built-in keys on logical :: hosted = . false . !! in a host's window (its size from `resize`) ! camera transitions real ( wp ) :: transition_ = 0.0_wp !! s, for view changes and resets real ( wp ) :: switch_duration = - 1.0_wp !! s, for the next view change (< 0: transition_) type ( CameraFlight ) :: flight !! the camera flight (when active) real ( wp ) :: zoom_speed_ = 1.0_wp !! the trackball's zoom per scroll step and drag (1: VSG's) logical :: camera_throw_ = . true . !! the camera keeps moving after a drag released while moving ! video recording logical :: recording_ = . false . !! recording (start_recording) real ( wp ) :: record_fps = 3 0.0_wp !! the video's frames per second real ( wp ) :: record_wall = 0.0_wp !! the wall time at the start (s) integer ( int64 ) :: record_frames = 0_int64 !! frames drawn while recording ! diagnostics (render_stats) real ( wp ) :: rate_start = - 1.0_wp !! the wall time the frames are counted from (s; -1: none) integer :: rate_frames = 0 !! frames since then real ( wp ) :: fps_ = 0.0_wp !! frames per second (the last count's) real ( wp ) :: frame_ms_ = 0.0_wp !! milliseconds between frames (the last count's) real ( wp ) :: last_frame_ms = 0.0_wp !! the last frame()'s duration (ms) contains procedure :: open , close , is_open , pixel_ratio procedure :: set_scene procedure :: frame , run procedure :: capture ! video recording (see the module documentation) procedure :: start_recording , stop_recording , is_recording , recorded_frames ! diagnostics (vkf_diagnostics) procedure :: render_stats , device_info , scene_counts procedure :: set_background_color , background_color ! views (OpenFrames' RenderRectangle) procedure :: add_view , remove_view , remove_all_views procedure :: select_view , next_view , previous_view procedure :: current_view , num_views ! the camera (OpenFrames' trackball transformation), smooth transitions procedure :: get_camera , set_camera procedure :: set_view_transition , view_transition , in_transition , stop_transition procedure :: set_zoom_speed , zoom_speed , set_camera_throw , camera_throw ! picking (see the module documentation), and where points are on the screen procedure :: pick => window_pick procedure :: screen_position , cursor_ray ! GUI panels (vkf_gui) procedure :: gui => window_gui ! HUD text (OpenFrames' RenderRectangle HUD) procedure :: add_hud_text , remove_hud_text procedure :: set_sky , sky procedure :: set_light_ambient , set_light_diffuse , set_light_specular , set_light_position procedure :: light_ambient , light_diffuse , light_specular , light_position procedure :: view => window_view ! simulation time (OpenFrames' WindowProxy time control) procedure :: set_time , time , pause_time , is_time_paused , set_time_scale , time_scale procedure :: set_time_range , time_range , clock procedure :: viewer => window_viewer ! events from a host window procedure :: mouse , scroll , key , resize ! the program's event handler (OpenFrames' callbacks), built-in keys procedure :: set_event_handler , clear_event_handler , event_handler procedure :: set_default_keys , default_keys end type WindowProxy contains ! ================================================================== ! FrameManager !> A frame manager for the scene with root `frame` (optional). function new_frame_manager ( frame ) result ( fm ) class ( ReferenceFrame ), intent ( in ), target , optional :: frame !! the root frame (not owned) type ( FrameManager ) :: fm if ( present ( frame )) call fm % set_frame ( frame ) end function new_frame_manager !> Set the root frame of the scene (not owned: it must stay alive while managed). !> (The scene is for a window: this also starts loading the Vulkan driver for the !> first one, in the background, which can take a few tenths of a second.) subroutine fm_set_frame ( self , frame ) class ( FrameManager ), intent ( inout ) :: self class ( ReferenceFrame ), intent ( in ), target :: frame !! the root frame (not owned) self % root => frame call vkf_driver_preload () end subroutine fm_set_frame !> The root frame (null if none). function fm_frame ( self ) result ( root ) class ( FrameManager ), intent ( in ) :: self class ( ReferenceFrame ), pointer :: root root => self % root end function fm_frame !> Update the scene for time t (followed trajectories, artists) and copy !> the frames' positions and attitudes to the renderer, unless another !> window already did for this time since this window's last frame. !> `seen` is the window's own: the number of updates at its last frame. subroutine fm_update ( self , t , seen ) class ( FrameManager ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t !! simulation time integer , intent ( inout ) :: seen if (. not . associated ( self % root )) return if (. not . ( self % updates > 0 . and . t == self % updated_time . and . seen /= self % updates )) then call self % root % update ( t ) call self % root % late_update ( t ) ! (all frames at their positions for t) call self % root % sync () self % updates = self % updates + 1 self % updated_time = t end if seen = self % updates end subroutine fm_update !> Number of scene updates so far (`update`). pure integer function fm_num_updates ( self ) result ( n ) class ( FrameManager ), intent ( in ) :: self n = self % updates end function fm_num_updates ! ================================================================== ! the window !> Open the window: `width` x `height` (logical pixels) titled `title`, or, !> with `native_window` (a host window's native handle) and its !> `pixel_ratio`, render into that window. `vsync` (default true): frames !> are presented at the display's refresh; false: as soon as they are ready !> (where the driver allows it), e.g. to measure frame times. Returns false !> on failure. logical function open ( self , width , height , title , native_window , pixel_ratio , vsync ) result ( ok ) class ( WindowProxy ), intent ( inout ) :: self integer , intent ( in ) :: width , height !! window units (logical pixels) character ( len =* ), intent ( in ), optional :: title !! default 'vkframes' integer ( c_long_long ), intent ( in ), optional :: native_window !! host window's handle (0: own window) real ( wp ), intent ( in ), optional :: pixel_ratio !! framebuffer pixels per window unit (default 1) logical , intent ( in ), optional :: vsync character ( len = :), allocatable :: t integer ( c_long_long ) :: handle real ( c_double ) :: ratio integer ( c_int ) :: sync t = 'vkframes' if ( present ( title )) t = title handle = 0 ratio = 1.0_c_double if ( present ( native_window )) handle = native_window if ( present ( pixel_ratio )) ratio = pixel_ratio self % pixel_ratio_ = ratio sync = 1_c_int if ( present ( vsync )) sync = merge ( 1_c_int , 0_c_int , vsync ) self % viewer_ = vkf_viewer_create ( int ( width , c_int ), int ( height , c_int ), t , len ( t , kind = c_int ), handle , ratio , sync ) ok = c_associated ( self % viewer_ ) if (. not . ok ) return self % running = . true . self % scene_added = . false . self % shown => null () self % width_ = max ( 1 , width ) self % height_ = max ( 1 , height ) self % hosted = handle /= 0 call self % set_background_color ( self % background ) self % light_on = . true . call apply_window_light ( self ) call apply_camera_controls ( self ) end function open !> Close the window (waiting for the GPU). The scene is kept, and can be !> shown again in another window. So are the window's settings (views, !> HUD texts, sky, handler, time): `open` again (e.g. on a host's new !> native window, after Qt destroyed the old one) shows them as before. subroutine close ( self ) class ( WindowProxy ), intent ( inout ) :: self logical :: ok integer :: k if ( self % recording_ ) ok = self % stop_recording () call forget_handles ( self ) if ( c_associated ( self % viewer_ )) call vkf_viewer_delete ( self % viewer_ ) self % viewer_ = c_null_ptr self % running = . false . do k = 1 , self % n_huds ! (made again for the next viewer) if ( c_associated ( self % huds ( k )% node )) call vkf_node_delete ( self % huds ( k )% node ) self % huds ( k )% node = c_null_ptr end do self % scene_added = . false . ! (the scene, sky and HUD given to the next viewer) self % scene_seen = - 1 end subroutine close !> Framebuffer pixels per window unit of a host's window (as given to !> `open` or `resize`; 1 for a window of its own). pure real ( wp ) function pixel_ratio ( self ) class ( WindowProxy ), intent ( in ) :: self pixel_ratio = self % pixel_ratio_ end function pixel_ratio !> Whether the window is open (not closed, by the program or the user). pure logical function is_open ( self ) class ( WindowProxy ), intent ( in ) :: self is_open = c_associated ( self % viewer_ ) . and . self % running end function is_open !> Show the scene of `fm` (which must stay alive while shown). For now, set !> it before the window's first frame. subroutine set_scene ( self , fm ) class ( WindowProxy ), intent ( inout ) :: self type ( FrameManager ), intent ( in ), target :: fm call forget_handles ( self ) self % scene => fm self % scene_seen = - 1 self % scene_added = . false . end subroutine set_scene !> Render one frame: advance the clock, update the frames and draw. Returns !> false once the window has been closed (or on failure). logical function frame ( self ) result ( running ) class ( WindowProxy ), intent ( inout ) :: self class ( ReferenceFrame ), pointer :: root real ( wp ) :: t integer ( c_int ) :: status integer ( c_long_long ) :: frames real ( wp ) :: started running = . false . if (. not . self % is_open ()) return started = wall_time () root => null () if ( associated ( self % scene )) root => self % scene % frame () if (. not . self % scene_added ) then if ( associated ( root )) then call root % realize ( self % viewer_ ) if ( vkf_viewer_add_node ( self % viewer_ , root % node ()) /= 0 ) write ( * , '(a)' ) 'vkframes: could not add the scene' end if if ( associated ( self % sky_ )) then if ( vkf_viewer_add_node ( self % viewer_ , self % sky_ % node ( self % viewer_ )) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not add the sky' end if call create_huds ( self ) self % scene_added = . true . end if t = self % clock_ % update ( window_wall ( self )) if ( associated ( root )) call self % scene % update ( t , self % scene_seen ) ! (once per time across windows) call update_window_light ( self , root ) call place_camera ( self ) status = vkf_viewer_frame_begin ( self % viewer_ ) ! (to the window's events: the camera is final) self % running = status == 1 if ( self % running . and . associated ( self % handler )) then call self % handler % before_draw ( self , t ) if ( associated ( root ) . and . self % is_open ()) call root % sync () ! (frames it moved) end if if ( self % running . and . self % is_open ()) then call update_huds ( self ) self % running = vkf_viewer_frame_draw ( self % viewer_ ) == 1 end if if ( self % recording_ . and . self % running ) then frames = vkf_viewer_record_frames ( self % viewer_ ) ! (frames not drawn don't count) if ( frames >= 0 ) then self % record_frames = frames else ! (ffmpeg failed: see its messages) if (. not . self % stop_recording ()) write ( * , '(a)' ) 'vkframes: recording failed' end if end if if ( self % running ) call dispatch_events ( self ) if ( self % running ) call count_frame ( self , started ) running = self % running . and . self % is_open () end function frame !> Count a frame for the frame rate (render_stats): its duration, and the !> rate over about half a second. subroutine count_frame ( self , started ) type ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: started !! the wall time frame() started (s) real ( wp ), parameter :: span = 0.5_wp !! s: the rate's averaging time real ( wp ) :: now , elapsed now = wall_time () self % last_frame_ms = 100 0.0_wp * ( now - started ) if ( self % rate_start < 0.0_wp ) then self % rate_start = now self % rate_frames = 0 return end if self % rate_frames = self % rate_frames + 1 elapsed = now - self % rate_start if ( elapsed >= span ) then self % fps_ = self % rate_frames / elapsed self % frame_ms_ = 100 0.0_wp * elapsed / self % rate_frames self % rate_start = now self % rate_frames = 0 end if end subroutine count_frame !> The window's frame rate and frame times (see vkf_diagnostics); zeros !> while it isn't open. function render_stats ( self ) result ( stats ) class ( WindowProxy ), intent ( in ) :: self type ( RenderStats ) :: stats real ( c_double ) :: s ( 9 ) if (. not . c_associated ( self % viewer_ )) return if ( vkf_viewer_stats ( self % viewer_ , s , 9_c_int ) /= 0 ) return stats % fps = self % fps_ stats % frame_ms = self % frame_ms_ stats % frames = int ( s ( 1 ), int64 ) stats % acquire_ms = s ( 2 ) stats % record_ms = s ( 3 ) stats % present_ms = s ( 4 ) stats % gpu_ms = s ( 5 ) stats % width = nint ( s ( 6 )) stats % height = nint ( s ( 7 )) stats % gpu_memory_used = s ( 8 ) stats % gpu_memory_budget = s ( 9 ) stats % program_ms = max ( 0.0_wp , self % last_frame_ms - ( s ( 2 ) + s ( 3 ) + s ( 4 ))) end function render_stats !> The window's Vulkan device and driver (see vkf_diagnostics); '' while it !> isn't open. function device_info ( self ) result ( info ) class ( WindowProxy ), intent ( in ) :: self type ( DeviceInfo ) :: info info % name = device_string ( 1 ) info % kind = device_string ( 2 ) info % vulkan = device_string ( 3 ) info % driver = device_string ( 4 ) info % driver_info = device_string ( 5 ) contains function device_string ( which ) result ( str ) integer , intent ( in ) :: which !! 1 the name ... 5 the driver's information character ( len = :), allocatable :: str character ( kind = c_char , len = 256 ) :: buf integer ( c_int ) :: n str = '' if (. not . c_associated ( self % viewer_ )) return n = vkf_viewer_device_info ( self % viewer_ , int ( which , c_int ), buf , len ( buf , kind = c_int )) if ( n > 0 ) str = trim ( buf ( 1 : min ( int ( n ), len ( buf )))) end function device_string end function device_info !> The size of the window's scene graph (see vkf_diagnostics): traverses !> it all, for an occasional update, not every frame. Zeros while it isn't !> open. function scene_counts ( self ) result ( counts ) class ( WindowProxy ), intent ( in ) :: self type ( SceneCounts ) :: counts real ( c_double ) :: c ( 3 ) if (. not . c_associated ( self % viewer_ )) return if ( vkf_viewer_scene_counts ( self % viewer_ , c ) /= 0 ) return counts % nodes = int ( c ( 1 ), int64 ) counts % draws = int ( c ( 2 ), int64 ) counts % vertices = int ( c ( 3 ), int64 ) end function scene_counts !> Render frames until the window is closed (or for `max_frames` frames). subroutine run ( self , max_frames ) class ( WindowProxy ), intent ( inout ) :: self integer , intent ( in ), optional :: max_frames integer :: n n = 0 do while ( self % frame ()) n = n + 1 if ( present ( max_frames )) then if ( n >= max_frames ) exit end if end do end subroutine run !> Save the last frame as an image (format from the file extension, e.g. !> .png). Returns false on failure. logical function capture ( self , file ) result ( ok ) class ( WindowProxy ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: file !! image file name (e.g. .png) ok = . false . if (. not . self % is_open ()) return ok = vkf_viewer_capture ( self % viewer_ , file , len ( file , kind = c_int )) == 0 end function capture !> Start recording the frames drawn to the video `file` (see the module !> documentation), `fps` frames per second (default 30). Encoded by !> `codec` (an ffmpeg encoder; default libx264, H.264) at `quality` (for !> libx264, libx265 and libvpx-vp9 the CRF: 0 lossless to 51, default 18, !> visually lossless), scaled by `scale` (default 1; e.g. 0.5 for half the !> size of a Retina window's pixels), the size made even. `options` !> replaces the encoder options (codec, quality; and the scale, unless !> there is a watermark), e.g. '-c:v prores_ks -profile:v 3'. !> `watermark`: an image (e.g. a logo; PNG, SVG, ... with transparency) !> drawn over the video's bottom right corner by ffmpeg, `watermark_width` !> of the video's width (default 0.2), `watermark_opacity` opaque (default !> 0.6). `ffmpeg`: the program (default: VKFRAMES_FFMPEG, else ffmpeg on !> the path). Returns false if the window isn't open, is already !> recording or the watermark doesn't exist; ffmpeg's errors (e.g. an !> unknown encoder) show when it starts, at the next frame, and end the !> recording. logical function start_recording ( self , file , fps , quality , codec , scale , options , watermark , watermark_width , & watermark_opacity , ffmpeg ) result ( ok ) class ( WindowProxy ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: file !! the video file (e.g. .mp4, .mov, .webm) real ( wp ), intent ( in ), optional :: fps !! frames per second of the video (default 30) integer , intent ( in ), optional :: quality !! the CRF (default 18; lower is better) character ( len =* ), intent ( in ), optional :: codec !! an ffmpeg encoder (default libx264) real ( wp ), intent ( in ), optional :: scale !! of the window's pixels (default 1) character ( len =* ), intent ( in ), optional :: options !! ffmpeg's encoder options, instead of those above character ( len =* ), intent ( in ), optional :: watermark !! an image file drawn at the bottom right real ( wp ), intent ( in ), optional :: watermark_width !! its width, of the video's (default 0.2) real ( wp ), intent ( in ), optional :: watermark_opacity !! 0 to 1 (default 0.6) character ( len =* ), intent ( in ), optional :: ffmpeg !! the ffmpeg program character ( len = :), allocatable :: output , program , filter character ( len = 1024 ) :: env character ( len = 32 ) :: f , w , a integer :: n , status logical :: exists ok = . false . if (. not . self % is_open () . or . self % recording_ ) return write ( f , '(g0)' ) 1.0_wp if ( present ( scale )) write ( f , '(g0)' ) max ( scale , 0.01_wp ) filter = 'scale=trunc(iw*' // trim ( f ) // '/2)*2:trunc(ih*' // trim ( f ) // '/2)*2' ! (an even size) output = '' if ( present ( watermark )) then inquire ( file = watermark , exist = exists ) if (. not . exists ) then write ( * , '(a)' ) 'vkframes: recording: no watermark file ' // trim ( watermark ) return end if output = '-i \"' // trim ( watermark ) // '\" ' ! (ffmpeg's second input) end if if ( present ( options )) then output = output // trim ( options ) else output = output // encoder_options ( codec , quality ) end if if ( present ( watermark )) then ! the video scaled; the image scaled to its width and made translucent, over its bottom right corner write ( w , '(g0)' ) 0.2_wp if ( present ( watermark_width )) write ( w , '(g0)' ) max ( 0.01_wp , min ( 1.0_wp , watermark_width )) write ( a , '(g0)' ) 0.6_wp if ( present ( watermark_opacity )) write ( a , '(g0)' ) max ( 0.0_wp , min ( 1.0_wp , watermark_opacity )) output = output // ' -filter_complex \"[0:v]' // filter // '[v];[1:v][v]scale=w=rw*' // trim ( w ) // & ':h=-1,format=rgba,colorchannelmixer=aa=' // trim ( a ) // '[w];[v][w]overlay=W-w-H*0.03:H-h-H*0.03\"' else if (. not . present ( options )) then output = output // ' -vf \"' // filter // '\"' end if output = output // ' \"' // trim ( file ) // '\"' if ( present ( ffmpeg )) then program = '\"' // trim ( ffmpeg ) // '\"' else call get_environment_variable ( 'VKFRAMES_FFMPEG' , env , n , status ) program = 'ffmpeg' if ( status == 0 . and . n > 0 ) program = '\"' // trim ( env ) // '\"' end if self % record_fps = 3 0.0_wp if ( present ( fps )) self % record_fps = fps if ( self % record_fps <= 0.0_wp ) return if ( vkf_viewer_record_start ( self % viewer_ , program , len ( program , kind = c_int ), output , len ( output , kind = c_int ), & real ( self % record_fps , c_double )) /= 0 ) return self % record_wall = wall_time () ! (the window's time goes on from now, at the video's pace) self % record_frames = 0_int64 self % recording_ = . true . ok = . true . end function start_recording !> ffmpeg's encoder options for `codec` and `quality` (see start_recording). function encoder_options ( codec , quality ) result ( args ) character ( len =* ), intent ( in ), optional :: codec integer , intent ( in ), optional :: quality character ( len = :), allocatable :: args , c character ( len = 32 ) :: q c = 'libx264' if ( present ( codec )) c = trim ( codec ) write ( q , '(i0)' ) 18 if ( present ( quality )) write ( q , '(i0)' ) max ( 0 , min ( 63 , quality )) args = '-c:v ' // c select case ( c ) case ( 'libx264' ) args = args // ' -preset medium -crf ' // trim ( q ) // ' -pix_fmt yuv420p' case ( 'libx265' ) args = args // ' -preset medium -crf ' // trim ( q ) // ' -pix_fmt yuv420p -tag:v hvc1' ! (hvc1: QuickTime) case ( 'libvpx-vp9' ) args = args // ' -crf ' // trim ( q ) // ' -b:v 0 -pix_fmt yuv420p' end select end function encoder_options !> Stop recording: ffmpeg finishes the file. The window's time goes on !> from where the video was, on the wall clock again. `frames`: the !> frames written. Returns false if not recording or if the recording !> failed (ffmpeg's messages are on the standard error). logical function stop_recording ( self , frames ) result ( ok ) class ( WindowProxy ), intent ( inout ) :: self integer ( int64 ), intent ( out ), optional :: frames !! frames written to the video integer ( c_long_long ) :: n real ( wp ) :: shift ok = . false . if ( present ( frames )) frames = 0_int64 if (. not . self % recording_ ) return n = - 1 if ( c_associated ( self % viewer_ )) n = vkf_viewer_record_stop ( self % viewer_ ) shift = wall_time () - window_wall ( self ) self % recording_ = . false . if (. not . associated ( self % clock_ % synchronized_to ())) call self % clock_ % set_time ( self % clock_ % time ()) if ( self % flight % active ) self % flight % started = self % flight % started + shift ok = n >= 0 if ( present ( frames )) frames = max ( 0_c_long_long , n ) end function stop_recording !> Whether the window is recording a video. pure logical function is_recording ( self ) class ( WindowProxy ), intent ( in ) :: self is_recording = self % recording_ end function is_recording !> Frames recorded since recording started (the video's length: frames / fps). pure integer ( int64 ) function recorded_frames ( self ) class ( WindowProxy ), intent ( in ) :: self recorded_frames = self % record_frames end function recorded_frames !> The window's wall time (s): the wall clock's, or while recording the !> video's (its start, plus a frame's time per frame drawn). real ( wp ) function window_wall ( self ) type ( WindowProxy ), intent ( in ) :: self if ( self % recording_ ) then window_wall = self % record_wall + real ( self % record_frames , wp ) / self % record_fps else window_wall = wall_time () end if end function window_wall !> The background color [r, g, b] (0 to 1; default black). subroutine set_background_color ( self , rgb ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: rgb ( 3 ) self % background = rgb if ( c_associated ( self % viewer_ )) then if ( vkf_viewer_set_background ( self % viewer_ , real ([ rgb , 1.0_wp ], c_float )) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not set the background color' end if end subroutine set_background_color !> The background color [r, g, b]. pure function background_color ( self ) result ( rgb ) class ( WindowProxy ), intent ( in ) :: self real ( wp ) :: rgb ( 3 ) rgb = self % background end function background_color ! ================================================================== ! the window's light !> The ambient, diffuse and specular colors ([r, g, b], 0 to 1) of the !> window's light (OpenFrames' defaults: 0.2 gray, white, none). The !> window's light is used while no frame of the scene has a light source !> (ReferenceFrame%set_light_source_enabled). subroutine set_light_ambient ( self , rgb ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: rgb ( 3 ) self % light_ambient_ = rgb call apply_window_light ( self ) end subroutine set_light_ambient !> The diffuse color of the window's light (see `set_light_ambient`). subroutine set_light_diffuse ( self , rgb ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: rgb ( 3 ) self % light_diffuse_ = rgb call apply_window_light ( self ) end subroutine set_light_diffuse !> The specular color of the window's light (see `set_light_ambient`). subroutine set_light_specular ( self , rgb ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: rgb ( 3 ) self % light_specular_ = rgb call apply_window_light ( self ) end subroutine set_light_specular !> The light's position in eye coordinates (x right, y up, z toward the !> viewer): [x, y, z, 0] for a directional light from direction (x, y, z), !> [x, y, z, 1] for a point light (OpenFrames' setLightPosition; default !> [0, 0, 1, 0], a headlight). subroutine set_light_position ( self , position ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: position ( 4 ) !! [x, y, z, w], eye coordinates (not all 0) if ( all ( position ( 1 : 3 ) == 0.0_wp ) . and . position ( 4 ) == 0.0_wp ) return self % light_position_ = position call apply_window_light ( self ) end subroutine set_light_position !> The ambient color of the window's light [r, g, b]. pure function light_ambient ( self ) result ( rgb ) class ( WindowProxy ), intent ( in ) :: self real ( wp ) :: rgb ( 3 ) rgb = self % light_ambient_ end function light_ambient !> The diffuse color of the window's light [r, g, b]. pure function light_diffuse ( self ) result ( rgb ) class ( WindowProxy ), intent ( in ) :: self real ( wp ) :: rgb ( 3 ) rgb = self % light_diffuse_ end function light_diffuse !> The specular color of the window's light [r, g, b]. pure function light_specular ( self ) result ( rgb ) class ( WindowProxy ), intent ( in ) :: self real ( wp ) :: rgb ( 3 ) rgb = self % light_specular_ end function light_specular !> The position of the window's light (see `set_light_position`). pure function light_position ( self ) result ( p ) class ( WindowProxy ), intent ( in ) :: self real ( wp ) :: p ( 4 ) p = self % light_position_ end function light_position !> Give the renderer's window light its colors and position (if open). subroutine apply_window_light ( self ) type ( WindowProxy ), intent ( inout ) :: self type ( c_ptr ) :: light if (. not . c_associated ( self % viewer_ )) return light = vkf_viewer_light ( self % viewer_ ) if (. not . c_associated ( light )) return if ( vkf_light_set ( light , real ( self % light_ambient_ , c_float ), real ( self % light_diffuse_ , c_float ), & real ( self % light_specular_ , c_float ), real ( self % light_position_ , c_double )) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not set the window light' end subroutine apply_window_light !> The window's light on while no frame of the scene has a light source. subroutine update_window_light ( self , root ) type ( WindowProxy ), intent ( inout ) :: self class ( ReferenceFrame ), pointer , intent ( in ) :: root !! the scene's root (may be null) logical :: on on = . true . if ( associated ( root )) on = . not . root % has_light_source () if ( on . eqv . self % light_on ) return self % light_on = on if ( vkf_viewer_light_enable ( self % viewer_ , merge ( 1_c_int , 0_c_int , on )) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not switch the window light' end subroutine update_window_light ! ================================================================== ! sky !> Draw `sky` behind the scene (it must stay alive while shown; it can be !> shown in several windows), in place of the window's sky so far; at any !> time (its texture and stars can change too). subroutine set_sky ( self , sky ) class ( WindowProxy ), intent ( inout ) :: self type ( SkySphere ), intent ( inout ), target :: sky integer ( c_int ) :: status if ( self % scene_added ) then ! shown: swap the sky's node if ( associated ( self % sky_ )) status = vkf_viewer_remove_node ( self % viewer_ , self % sky_ % node ( self % viewer_ )) if ( vkf_viewer_add_node ( self % viewer_ , sky % node ( self % viewer_ )) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not add the sky' end if self % sky_ => sky end subroutine set_sky !> The sky drawn behind the scene (null if none). function sky ( self ) result ( s ) class ( WindowProxy ), intent ( in ) :: self type ( SkySphere ), pointer :: s s => self % sky_ end function sky ! ================================================================== ! HUD text !> Show `h` in the window, on top of the scene (it must stay alive while !> shown), from the next frame. subroutine add_hud_text ( self , h ) class ( WindowProxy ), intent ( inout ) :: self type ( HUDText ), intent ( in ), target :: h type ( HUDEntry ), allocatable :: tmp (:) if (. not . allocated ( self % huds )) allocate ( self % huds ( 4 )) if ( self % n_huds == size ( self % huds )) then allocate ( tmp ( 2 * self % n_huds )) tmp ( 1 : self % n_huds ) = self % huds ( 1 : self % n_huds ) call move_alloc ( tmp , self % huds ) end if self % n_h