n_vertices , c_int ), int ( n_indices , c_int ), rgba , c_null_ptr , c_null_ptr , 2_c_int ) if (. not . c_associated ( mesh )) return call mesh_arrays ( mesh , n_vertices , n_indices , xyz , normals , uv , indices ) call arrow ( base , direction , body_length , head_length , body_radius , head_radius , n , xyz , normals , uv , indices ) end function arrow_create","tags":"","url":"proc/arrow_create.html"},{"title":"ellipsoid_create – vkframes","text":"public  function ellipsoid_create(radii, rgba, texture, n_lon, n_lat, night_texture, translucent) result(mesh) An ellipsoid mesh node with semi-axes radii (x, y, z) and color ( rgba ,\nmultiplying the texture), with an optional equirectangular texture and\nnight texture (image handles; the night texture shows where the light\nis weak). n_lon and n_lat default to 128 and 64 segments. With translucent , a translucent surface (its material's alpha; drawn after\nthe opaque scene, sorted by depth). Null on failure. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(3) :: radii semi-axes along x, y, z real(kind=c_float), intent(in), dimension(4) :: rgba color [r, g, b, a] (0 to 1) type(c_ptr), intent(in), optional :: texture image handle of the (day) texture integer, intent(in), optional :: n_lon segments in longitude (default 128) integer, intent(in), optional :: n_lat segments in latitude (default 64) type(c_ptr), intent(in), optional :: night_texture image handle of the night texture logical, intent(in), optional :: translucent a translucent surface (default false) Return Value type(c_ptr) Calls proc~~ellipsoid_create~~CallsGraph proc~ellipsoid_create ellipsoid_create interface~vkf_mesh_create vkf_mesh_create proc~ellipsoid_create->interface~vkf_mesh_create interface~vkf_mesh_set_bound vkf_mesh_set_bound proc~ellipsoid_create->interface~vkf_mesh_set_bound proc~ellipsoid ellipsoid proc~ellipsoid_create->proc~ellipsoid proc~ellipsoid_size ellipsoid_size proc~ellipsoid_create->proc~ellip