) real ( wp ), intent ( in ), optional :: arrow_spacing !! between arrows (window units; default 40) real ( wp ), intent ( in ), optional :: arrow_speed !! (window units per second; default 50) real ( wp ), intent ( in ), optional :: band_width !! of the arrows' band (window units; default 12) real ( wp ), intent ( in ), optional :: pulse_period !! (s; default 1.5) integer :: k do k = 1 , self % n_artists select type ( a => self % artists ( k )% p ) class is ( CurveArtist ) call a % set_highlight ( mode , color , arrow_spacing , arrow_speed , band_width , pulse_period ) class is ( SegmentArtist ) call a % set_highlight ( mode , color , arrow_spacing , arrow_speed , band_width , pulse_period ) end select end do end subroutine drawable_set_highlight","tags":"","url":"proc/drawable_set_highlight.html"},{"title":"drawable_update – vkframes","text":"private recursive subroutine drawable_update(self, t) Update the frame (and its descendants), then its artists. Type Bound DrawableTrajectory Arguments Type Intent Optional Attributes Name class( DrawableTrajectory ), intent(inout) :: self real(kind=wp), intent(in) :: t Calls proc~~drawable_update~~CallsGraph proc~drawable_update DrawableTrajectory%drawable_update proc~build_artist build_artist proc~drawable_update->proc~build_artist proc~update~3 ReferenceFrame%update proc~drawable_update->proc~update~3 build build proc~build_artist->build interface~vkf_compile_node vkf_compile_node proc~build_artist->interface~vkf_compile_node interface~vkf_node_add_child vkf_node_add_child proc~build_artist->interface~vkf_node_add_child interface~vkf_switch_create vkf_switch_create proc~build_artist->interface~vkf_switch_create interface~vkf_viewer_any vkf_viewer_any proc~build_artist->interface~vkf_viewer_any proc~check_status check_status proc~build_artist->proc~check_status proc~update TrajectoryFollower%update proc~update~3->proc~update proc~chosen_trajectory chosen_trajectory proc~update->proc~chosen_trajectory proc~data_valid Traject