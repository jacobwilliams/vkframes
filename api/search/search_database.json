tent Optional Attributes Name type( Sphere ), intent(inout) :: self integer, intent(in) :: k index into lod_segments logical, intent(in) :: compile private pure subroutine material (self, ambient, diffuse, specular, emission, shininess) The material (each optional): ambient, diffuse, specular and emission colors\nand shininess. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self real(kind=wp), intent(out), optional :: ambient (4) [r, g, b, a] real(kind=wp), intent(out), optional :: diffuse (4) [r, g, b, a] real(kind=wp), intent(out), optional :: specular (4) [r, g, b, a] real(kind=wp), intent(out), optional :: emission (4) [r, g, b, a] real(kind=wp), intent(out), optional :: shininess 0 to 128 private  subroutine set_auto_lod (self, lod) Level of detail (default on; see the module documentation): meshes of\nseveral resolutions, the one drawn chosen per view. Off: one mesh of set_resolution 's segments. Set it before a window shows the sphere. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self logical, intent(in) :: lod private  subroutine set_material (self, ambient, diffuse, specular, emission, shininess) The material (OpenFrames' setMaterial; each optional): ambient, diffuse,\nspecular and emission colors ([r, g, b] or [r, g, b, a], 0 to 1) and\nshininess (0 to 128: the specular highlight's sharpness; 0 for none).\nThe ambient and diffuse colors scale the body's color or texture (VSG's\nPhong); the specular color is reflected from the lights' specular parts.\nDefaults: ambient and diffuse white, no specular reflection or emission. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in), optional :: ambient (:) [r, g, b(, a)], 0 to 1 real(kind=wp), intent(in), optional :: diffuse (:) [r, g, b(, a)], 0 to 1 real(kind=wp), intent(in), optional :: specular (:) [r, g, b(, a)], 0 to 1 real(kind=wp), intent(in), optional :: emission (:) [r, g, b(, a)], 0 to 1 real(kind=wp), intent(in), optional :: shininess 0 to 128 (< 0: 0) private  subroutine set_night_texture_map (self, file) The texture for the side away from the light (e.g. city lights; an\nequirectangular image file as the texture, '' for none), shown where the\ndiffuse light is weak. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self character(len=*), intent(in) :: file found with find_data_file; '' for none private  subroutine set_opacity (self, opacity) The body's opacity, 0 (invisible) to 1 (opaque, the default): below 1\nit is drawn translucent (see the module documentation). Set below 1\nbefore a window first shows it to make it translucent; then the\nopacity can change at any time (a translucent body stays translucent,\nan opaque one opaque). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: opacity 0 to 1 private  subroutine set_radius (self, radius) The sphere's radius (scene units, > 0; default 1); can change at any time. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: radius scene units (<= 0: ignored) private  subroutine set_resolution (self, n_lon, n_lat) The mesh resolution without level of detail: segments in longitude and\nlatitude (default 128 x 64). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self integer, intent(in) :: n_lon segments in longitude (at least 3) integer, intent(in) :: n_lat segments in latitude (at least 2) private  subroutine set_sphere_attitude (self, q) Attitude of the body in its frame (quaternion [x, y, z, w]), e.g. to\norient its texture. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) quaternion [x, y, z, w] (normalized here) private  subroutine set_sphere_position (self, position) Position of the body's center in its frame. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) scene units private  subroutine set_sphere_scale (self, scale) Scale the sphere along its x, y and z axes (all > 0), making an\nellipsoid with semi-axes radius * scale. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: scale (3) along x, y and z (all > 0, else ignored) private  subroutine set_texture_map (self, file) The texture: an equirectangular image file ('' for none). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self character(len=*), intent(in) :: file found with find_data_file; '' for none private  subroutine set_twilight (self, angle) The twilight: the diffuse light extended past the terminator to where\nthe light is angle (radians, 0 to 1.5) below the horizon, fading out\nsmoothly (where it meets the light on the day side: the same brightness\nand slope, so no line shows), and the night texture fading in across it.\n0 (the default): none, the light ends at the terminator (an airless\nbody). Not in OpenFrames. Can change at any time. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: angle radians below the horizon (clamped to 0 to 1.5) private  subroutine sphere_bound (self, center, radius) The body's bounding sphere: its center, and its largest semi-axis. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self real(kind=wp), intent(out) :: center (3) the bounding sphere, frame coordinates (scene units) real(kind=wp), intent(out) :: radius the bounding sphere, frame coordinates (scene units) private  subroutine sphere_build_contents (self, viewer, group) The body: an ellipsoid mesh under the sphere's transform. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer (null: headless) type(c_ptr), intent(in) :: group the frame's contents group private  subroutine sphere_pick (self, cam, to_root, hits, n) Picked on the ellipsoid (exact), with the geodetic latitude and longitude\nof the point hit (in the body's axes: sphere_attitude); else the frame's\norigin. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in), target :: self type( PickCamera ), intent(in) :: cam the camera and cursor of the pick real(kind=wp), intent(in) :: to_root (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits so far, in hits(1:n); added to integer, intent(inout) :: n number of hits private  subroutine sphere_set_color (self, color) The body's color (used without a texture); [r, g, b] or [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) private recursive subroutine sphere_update (self, t) Update the frame (followed trajectories, children) and, with level of\ndetail, build the mesh the views have wanted if it isn't built yet (the\ncoarsest with as many segments as wanted, or the finest). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(inout) :: self real(kind=wp), intent(in) :: t the scene time private  subroutine update_sphere_transform (self) The body's transform: its position, attitude and scale (radii / the built\nradii); nothing before it is built. Arguments Type Intent Optional Attributes Name type( Sphere ), intent(inout) :: self","tags":"","url":"module/vkf_sphere.html"},{"title":"vkf_text – vkframes","text":"Text for vkframes: fonts (found by name on a search path, read once) and\nlabels (text that always faces the screen). A font is given as a file name (e.g. 'DejaVuSans.ttf', the default) or a\npath. A name is looked for in, in order: the directories of the\nVKFRAMES_FONT_PATH environment variable (separated by ':' or ';'), the fonts directory of the active conda/pixi environment (where pixi installs\nDejaVu), and the usual system font directories of macOS, Linux and Windows. Uses vkf_layer vkf_math vkf_files iso_c_binding module~~vkf_text~~UsesGraph module~vkf_text vkf_text iso_c_binding iso_c_binding module~vkf_text->iso_c_binding module~vkf_files vkf_files module~vkf_text->module~vkf_files module~vkf_layer vkf_layer module~vkf_text->module~vkf_layer module~vkf_math vkf_math module~vkf_text->module~vkf_math module~vkf_layer->iso_c_binding iso_fortran_env iso_fortran_env module~vkf_math->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~vkf_text~~UsedByGraph module~vkf_text vkf_text module~vkf_frames vkf_frames module~vkf_frames->module~vkf_text module~vkf_sky vkf_sky module~vkf_sky->module~vkf_text module~vkf_window vkf_window module~vkf_window->module~vkf_text module~vkf_window->module~vkf_frames module~vkf_window->module~vkf_sky module~vkf_handles vkf_handles module~vkf_window->module~vkf_handles module~vkf_hud vkf_hud module~vkf_window->module~vkf_hud module~vkf_view vkf_view module~vkf_window->module~vkf_view module~vkf_artists vkf_artists module~vkf_artists->module~vkf_frames module~vkf_handles->module~vkf_frames module~vkf_handles->module~vkf_artists module~vkf_hud->module~vkf_frames module~vkf_line_segments vkf_line_segments module~vkf_line_segments->module~vkf_frames module~vkf_model vkf_model module~vkf_model->module~vkf_frames module~vkf_shadow vkf_shadow module~vkf_shadow->module~vkf_frames module~vkf_sphere vkf_sphere module~vkf_shadow->module~vkf_sphere module~vkf_terrain vkf_terrain module~vkf_shadow->module~vkf_terrain module~vkf_shapes vkf_sh