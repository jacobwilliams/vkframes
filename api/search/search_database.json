90 vkf_terrain.f90 sourcefile~vkf_shadow.f90->sourcefile~vkf_terrain.f90 sourcefile~vkf_shapes.f90 vkf_shapes.f90 sourcefile~vkf_shapes.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_shapes.f90->sourcefile~vkf_artists.f90 sourcefile~vkf_sphere.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_terrain.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_view.f90 vkf_view.f90 sourcefile~vkf_view.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_window.f90 vkf_window.f90 sourcefile~vkf_window.f90->sourcefile~vkf_frames.f90 sourcefile~vkf_window.f90->sourcefile~vkf_handles.f90 sourcefile~vkf_window.f90->sourcefile~vkf_hud.f90 sourcefile~vkf_window.f90->sourcefile~vkf_view.f90 sourcefile~vkframes.f90 vkframes.f90 sourcefile~vkframes.f90->sourcefile~vkf_frames.f90 sourcefile~vkframes.f90->sourcefile~vkf_artists.f90 sourcefile~vkframes.f90->sourcefile~vkf_handles.f90 sourcefile~vkframes.f90->sourcefile~vkf_hud.f90 sourcefile~vkframes.f90->sourcefile~vkf_line_segments.f90 sourcefile~vkframes.f90->sourcefile~vkf_model.f90 sourcefile~vkframes.f90->sourcefile~vkf_shadow.f90 sourcefile~vkframes.f90->sourcefile~vkf_shapes.f90 sourcefile~vkframes.f90->sourcefile~vkf_sphere.f90 sourcefile~vkframes.f90->sourcefile~vkf_terrain.f90 sourcefile~vkframes.f90->sourcefile~vkf_view.f90 sourcefile~vkframes.f90->sourcefile~vkf_window.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code !> Reference frames: the tree of frames that every scene object belongs to, as !> OpenFrames' ReferenceFrame. !> !> A frame has a position and attitude relative to its parent, a color for its !> decorations (axes, labels), and children. It can follow trajectories !> (`follow`), which then set its position and/or attitude at each `update`. !> Scene objects (spheres, models, trajectories' artists, ...) extend this type. !> !> Frames are owned by the program, not by the tree: `add_child` stores !> pointers, so a frame (declared `target`, or allocated) must stay alive while !> it is in a tree, or be removed first (`detach`). A frame may have several !> parents; adding a child that is an ancestor of the parent is refused. !> !> Rendering: when a window first shows a tree (`realize`), each frame gets a !> transform node, with its contents (`build_contents`, which extensions !> override) under a switch for `show_contents`; children's nodes go under the !> parent's transform, so a frame with several parents is drawn under each. !> Each frame, `update` moves followed frames to the time, then `late_update` !> lets contents depend on other frames' positions at that time (e.g. !> CustomLineSegments between spacecraft), and `sync` copies positions and !> attitudes to the transforms. A shown !> tree can change: children added to a shown frame are realized and compiled !> (for the windows running) and drawn from the next frame; !> removed ones stop being drawn; moved axes (move_x_axis, ...) are made again. !> !> Labels: the name label (at the origin, facing the screen) and the axes' !> labels can change while shown: the name (`set_name`, e.g. a readout that !> follows the frame), color, label size, alignment and font, and the axes' !> label texts. !> !> Picking (WindowProxy%pick): each frame tests what it draws against a !> PickCamera (vkf_pick) in its `pick` procedure, given its transform to the !> root frame, and adds a PickHit for each thing within reach (the window !> sorts them nearest first). A plain frame is picked at its origin if it !> shows axes or its name label (PICK_FRAME); extensions pick their contents !> (bodies, trajectories). module vkf_frames use , intrinsic :: iso_c_binding , only : c_ptr , c_null_ptr , c_associated , c_int , c_float , c_double use vkf_layer , only : check_status , vkf_transform_create , vkf_transform_set_matrix , vkf_switch_create , vkf_switch_set , & vkf_node_add_child , vkf_node_remove_child , vkf_node_delete , vkf_compile_node , vkf_viewer_any , & vkf_light_create , vkf_light_set , vkf_label_set_text , vkf_label_set_color , vkf_label_set_on_top use vkf_geometry , only : arrow_create use vkf_text , only : label_create , label_set_layout use vkf_math , only : wp , quat_identity , quat_normalize , frame_matrix , rigid_inverse use vkf_pick , only : PickCamera , point_pick , ray , ray_ellipsoid , wants use vkf_trajectory , only : Trajectory use vkf_follower , only : TrajectoryFollower , FOLLOW_LOOP , FOLLOW_POSITION , FOLLOW_ATTITUDE implicit none private !> which axes to show (OpenFrames' AxesType), combined with ior integer , parameter , public :: NO_AXES = 0 !! none integer , parameter , public :: X_AXIS = 1 !! the x axis integer , parameter , public :: Y_AXIS = 2 !! the y axis integer , parameter , public :: Z_AXIS = 4 !! the z axis integer , parameter , public :: ALL_AXES = 7 !! all three !> text alignment of labels (osgText's AlignmentType, as OpenFrames uses) integer , parameter , public :: ALIGN_LEFT_TOP = 0 , ALIGN_LEFT_CENTER = 1 , ALIGN_LEFT_BOTTOM = 2 integer , parameter , public :: ALIGN_CENTER_TOP = 3 , ALIGN_CENTER_CENTER = 4 , ALIGN_CENTER_BOTTOM = 5 integer , parameter , public :: ALIGN_RIGHT_TOP = 6 , ALIGN_RIGHT_CENTER = 7 , ALIGN_RIGHT_BOTTOM = 8 integer , parameter , public :: ALIGN_LEFT_BASE_LINE = 9 , ALIGN_CENTER_BASE_LINE = 10 , ALIGN_RIGHT_BASE_LINE = 11 !> A frame in a list of frames (a frame's children and parents): a pointer !> to it (Fortran has no arrays of pointers). type :: FramePointer class ( ReferenceFrame ), pointer :: p => null () !! the frame (not owned) end type FramePointer !> what a pick hit (PickHit%kind) integer , parameter , public :: PICK_FRAME = 1 !! a frame's origin (its axes or name label shown) integer , parameter , public :: PICK_BODY = 2 !! a body's surface (Sphere, Model, TerrainBody) integer , parameter , public :: PICK_CURVE = 3 !! a trajectory's curve (CurveArtist) integer , parameter , public :: PICK_SEGMENT = 4 !! a trajectory's segment (SegmentArtist) integer , parameter , public :: PICK_MARKER = 5 !! a trajectory's marker (MarkerArtist) integer , parameter , public :: PICK_HANDLE = 6 !! a handle the mouse drags (vkf_handles: VectorHandle) !> What a pick found (WindowProxy%pick): the frame it belongs to and, for !> trajectories, the artist (select type to use it) and the trajectory. type , public :: PickHit integer :: kind = 0 !! PICK_* class ( ReferenceFrame ), pointer :: frame => null () !! the frame hit (what it draws, or its origin) class ( * ), pointer :: artist => null () !! the trajectory artist (curves, segments, markers) type ( Trajectory ), pointer :: trajectory => null () !! (trajectories: the artist's trajectory) !> For curves, the trajectory point the hit is after (on the segment from it !> to the next); segments: the segment (from point 1 + (index - 1) * !> stride); markers: the point (start, end) or the intermediate !> marker's number integer :: index = 0 integer :: marker = 0 !! (markers: MARKER_START, MARKER_END or MARKER_INTERMEDIATE) real ( wp ) :: time = 0.0_wp !! (trajectories: the time there (interpolated on curves)) real ( wp ) :: position ( 3 ) = 0.0_wp !! the point hit, in the root frame real ( wp ) :: local ( 3 ) = 0.0_wp !! the point hit, in the frame's coordinates real ( wp ) :: distance = 0.0_wp !! its depth from the eye (nearest first) real ( wp ) :: pixels = 0.0_wp !! its distance from the cursor (framebuffer pixels; 0 on a body) real ( wp ) :: latitude = 0.0_wp , longitude = 0.0_wp !! (bodies: geodetic, radians (Sphere, TerrainBody)) end type PickHit public :: add_pick_hit , pick_ellipsoid !> A reference frame (see the module documentation). type , public :: ReferenceFrame private character ( len = :), allocatable :: name_ !! the name (shown by the name label) real ( wp ) :: color_ ( 4 ) = [ 1.0_wp , 1.0_wp , 1.0_wp , 0.9_wp ] !! decorations' color [r, g, b, a] (0 to 1) real ( wp ) :: position_ ( 3 ) = 0.0_wp !! relative to the parent real ( wp ) :: attitude_ ( 4 ) = quat_identity !! relative to the parent: quaternion [x, y, z, w] type ( FramePointer ), allocatable :: children (:), parents (:) !! not owned (first n_children, n_parents used) integer :: n_children = 0 , n_parents = 0 !! number of children and parents type ( TrajectoryFollower ) :: follower_ !! sets position and attitude from followed trajectories logical :: following = . false . !! following trajectories (`follow`, until `unfollow`) ! decorations (drawn by the renderer) integer :: axes = ALL_AXES !! OpenFrames' defaults: all shown integer :: axes_labels = ALL_AXES !! axes labels shown (as axes) logical :: name_label = . true . !! the name label shown logical :: name_on_top = . false . !! the name label drawn on top of the scene character ( len = :), allocatable :: x_label_ , y_label_ , z_label_ !! axes labels (unallocated: 'X', 'Y', 'Z') character ( len = :), allocatable :: label_font_ !! labels' font (unallocated: the renderer's default) integer :: label_size_ = 20 !! labels' size (pixels) integer :: label_alignment_ = ALIGN_LEFT_BASE_LINE !! labels' alignment (ALIGN_*) logical :: light_source = . false . !! carries a light source (set_light_source_enabled) ! the light source's colors (OSG's default light, as OpenFrames') real ( wp ) :: light_ambient_ ( 3 ) = 0.05_wp , light_diffuse_ ( 3 ) = 0.8_wp , light_specular_ ( 3 ) = 0.05_wp !! [r, g, b] type ( c_ptr ) :: light_node = c_null_ptr , light_switch = c_null_ptr !! light and switch (made when enabled) logical :: contents = . true . !! what the frame draws shown (show_contents) logical :: pickable_ = . true . !! picked (WindowProxy%pick); its children aside ! rendering type ( c_ptr ) :: node_ = c_null_ptr !! the frame's transform node type ( c_ptr ) :: contents_node = c_null_ptr !! switch holding the contents logical :: shown_ = . false . !! realized for a window (not headless): later nodes are compiled logical :: realized = . false . !! render nodes made (realize) logical :: synced = . false . !! the node has synced_position/attitude real ( wp ) :: synced_position ( 3 ) = 0.0_wp , synced_attitude ( 4 ) = 0.0_wp !! last copied to the node ! axes (OpenFrames' moveXAxis/...: base, length, head ratio, radii; 0 radius: auto) real ( wp ) :: axis_base ( 3 , 3 ) = 0.0_wp !! each axis's base (columns; frame coordinates) real ( wp ) :: axis_len ( 3 ) = 1.0_wp !! each axis's length real ( wp ) :: axis_head_ratio ( 3 ) = 0.3_wp !! each axis's head, as a fraction of its length real ( wp ) :: axis_body_radius ( 3 ) = 0.0_wp , axis_head_radius ( 3 ) = 0.0_wp !! (0: 0.05 and 0.1 of the length) logical :: axes_moved = . false . !! set by move_*_axis (else reposition_axes places them) type ( c_ptr ) :: axis_node ( 3 ) = c_null_ptr !! the axes arrows' switches type ( c_ptr ) :: axis_label_node ( 3 ) = c_null_ptr !! the axes labels' switches type ( c_ptr ) :: axis_arrow ( 3 ) = c_null_ptr !! the axes arrows (in axis_node; made again when an axis moves) type ( c_ptr ) :: axis_text ( 3 ) = c_null_ptr !! the axes labels (in axis_label_node) type ( c_ptr ) :: name_label_node = c_null_ptr !! the name label's switch type ( c_ptr ) :: name_text = c_null_ptr !! the name label (in name_label_node) contains procedure :: set_name , name procedure :: set_color , color procedure :: set_position , position procedure :: set_attitude , attitude procedure :: local_matrix , world_matrix , position_of procedure :: show_axes , axes_shown procedure :: show_axes_labels , axes_labels_shown procedure :: show_name_label , name_label_shown procedure :: show_decorations procedure :: set_name_label_on_top , name_label_on_top procedure :: set_x_label , set_y_label , set_z_label , axis_label procedure :: set_label_font , label_font procedure :: set_label_size , label_size procedure :: set_label_alignment , label_alignment procedure :: set_light_source_enabled , light_source_enabled , has_light_source procedure :: set_light_ambient , set_light_diffuse , set_light_specular procedure :: light_ambient , light_diffuse , light_specular procedure :: show_contents , contents_shown procedure :: frame_info procedure :: add_child , remove_child , detach procedure :: num_children , child , child_index procedure :: num_parents , parent , parent_index procedure :: frame_string procedure :: follow , unfollow , follower , is_following procedure :: update , late_update procedure :: realize , build_contents , sync , node procedure :: bound , pick , set_pickable , pickable procedure :: move_x_axis , move_y_axis , move_z_axis , reposition_axes end type ReferenceFrame !> The ReferenceFrame constructor: `ReferenceFrame(...)` makes one (see `new_reference_frame` for its !> arguments). interface ReferenceFrame module procedure new_reference_frame end interface ReferenceFrame public :: FramePointer contains !> A frame named `name`, with decorations of color `color` ([r, g, b] or !> [r, g, b, a], 0 to 1; default white, 90% opaque). function new_reference_frame ( name , color ) result ( frame ) character ( len =* ), intent ( in ) :: name real ( wp ), intent ( in ), optional :: color (:) type ( ReferenceFrame ) :: frame frame % name_ = name if ( present ( color )) call frame % set_color ( color ) end function new_reference_frame ! ================================================================== ! name, color, position, attitude !> The frame's name, shown by its name label (also once shown: e.g. a !> readout that follows the frame). subroutine set_name ( self , name ) class ( ReferenceFrame ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: name self % name_ = name if ( c_associated ( self % name_text )) call check_status ( vkf_label_set_text ( self % name_text , name , len ( name , kind = c_int ))) end subroutine set_name !> The frame's name ('' if none). function name ( self ) result ( n ) class ( ReferenceFrame ), intent ( in ) :: self character ( len = :), allocatable :: n if ( allocated ( self % name_ )) then n = self % name_ else n = '' end if end function name !> The color of the frame's decorations: [r, g, b] (alpha unchanged) or [r, g, b, a]. subroutine set_color ( self , color ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: color (:) integer :: n n = min ( 4 , size ( color )) self % color_ ( 1 : n ) = color ( 1 : n ) if (. not . self % realized ) return if ( c_associated ( self % name_text )) call check_status ( vkf_label_set_color ( self % name_text , real ( self % color_ , c_float ))) call remake_axes ( self ) end subroutine set_color !> The color of the frame's decorations, [r, g, b, a] (0 to 1). pure function color ( self ) result ( c ) class ( ReferenceFrame ), intent ( in ) :: self real ( wp ) :: c ( 4 ) c = self % color_ end function color !> Position relative to the parent frame (overridden by a followed trajectory). subroutine set_position ( self , position ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: position ( 3 ) !! parent frame's coordinates self % position_ = position end subroutine set_position !> Position relative to the parent frame. pure function position ( self ) result ( p ) class ( ReferenceFrame ), intent ( in ) :: self real ( wp ) :: p ( 3 ) p = self % position_ end function position !> Attitude relative to the parent frame, a quaternion [x, y, z, w] !> (normalized here; overridden by a followed trajectory). subroutine set_attitude ( self , q ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: q ( 4 ) self % attitude_ = quat_normalize ( q ) end subroutine set_attitude !> Attitude relative to the parent frame, a quaternion [x, y, z, w]. pure function attitude ( self ) result ( q ) class ( ReferenceFrame ), intent ( in ) :: self real ( wp ) :: q ( 4 ) q = self % attitude_ end function attitude !> The transform from this frame to its parent (4x4). pure function local_matrix ( self ) result ( m ) class ( ReferenceFrame ), intent ( in ) :: self real ( wp ) :: m ( 4 , 4 ) m = frame_matrix ( self % position_ , self % attitude_ ) end function local_matrix !> The transform from this frame to the root of its tree, through the first !> parent at each level. recursive function world_matrix ( self ) result ( m ) class ( ReferenceFrame ), intent ( in ) :: self real ( wp ) :: m ( 4 , 4 ) m = self % local_matrix () if ( self % n_parents > 0 ) m = matmul ( self % parents ( 1 )% p % world_matrix (), m ) end function world_matrix !> The origin of `other` (a frame of the same tree) in this frame's !> coordinates, from both frames' transforms to the root (through their !> first parents). function position_of ( self , other ) result ( p ) class ( ReferenceFrame ), intent ( in ) :: self , other real ( wp ) :: p ( 3 ) real ( wp ) :: m ( 4 , 4 ) m = matmul ( rigid_inverse ( self % world_matrix ()), other % world_matrix ()) p = m ( 1 : 3 , 4 ) end function position_of ! ================================================================== ! decorations !> Which axes vectors to show: NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined with ior. subroutine show_axes ( self , axes ) class ( ReferenceFrame ), intent ( inout ) :: self integer , intent ( in ) :: axes self % axes = iand ( axes , ALL_AXES ) call update_switches ( self ) end subroutine show_axes !> Which axes vectors are shown (NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined). pure integer function axes_shown ( self ) class ( ReferenceFrame ), intent ( in ) :: self axes_shown = self % axes end function axes_shown !> Which axes labels to show (as `show_axes`). subroutine show_axes_labels ( self , labels ) class ( ReferenceFrame ), intent ( inout ) :: self integer , intent ( in ) :: labels self % axes_labels = iand ( labels , ALL_AXES ) call update_switches ( self ) end subroutine show_axes_labels !> Which axes labels are shown (as `axes_shown`). pure integer function axes_labels_shown ( self ) class ( ReferenceFrame ), intent ( in ) :: self axes_labels_shown = self % axes_labels end function axes_labels_shown !> Show or hide the name label (at the frame's origin; default shown). subroutine show_name_label ( self , show ) class ( ReferenceFrame ), intent ( inout ) :: self logical , intent ( in ) :: show !! (true: shown) self % name_label = show call update_switches ( self ) end subroutine show_name_label !> Show (true) or hide all the frame's decorations at once: its axes, !> their labels and its name label (show_axes, show_axes_labels, !> show_name_label). subroutine show_decorations ( self , show ) class ( ReferenceFrame ), intent ( inout ) :: self logical , intent ( in ) :: show !! true: all axes, axes labels and the name label call self % show_axes ( merge ( ALL_AXES , NO_AXES , show )) call self % show_axes_labels ( merge ( ALL_AXES , NO_AXES , show )) call self % show_name_label ( show ) end subroutine show_decorations !> Draw the name label on top of the scene (true: not hidden by bodies in !> front of it, as HUD text; e.g. a readout) or depth-tested (false, the !> default, as OpenFrames'). subroutine set_name_label_on_top ( self , on_top ) class ( ReferenceFrame ), intent ( inout ) :: self logical , intent ( in ) :: on_top self % name_on_top = on_top if ( c_associated ( self % name_text )) & call check_status ( vkf_label_set_on_top ( self % name_text , merge ( 1_c_int , 0_c_int , on_top ))) end subroutine set_name_label_on_top !> Whether the name label is drawn on top of the scene (`set_name_label_on_top`). pure logical function name_label_on_top ( self ) class ( ReferenceFrame ), intent ( in ) :: self name_label_on_top = self % name_on_top end function name_label_on_top !> Whether the name label is shown. pure logical function name_label_shown ( self ) class ( ReferenceFrame ), intent ( in ) :: self name_label_shown = self % name_label end function name_label_shown !> The text of the x-axis label (default 'X'). subroutine set_x_label ( self , text ) class ( ReferenceFrame ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: text self % x_label_ = text if ( self % realized ) call make_axis ( self , 1 ) end subroutine set_x_label !> The text of the y-axis label (default 'Y'). subroutine set_y_label ( self , text ) class ( ReferenceFrame ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: text self % y_label_ = text if ( self % realized ) call make_axis ( self , 2 ) end subroutine set_y_label !> The text of the z-axis label (default 'Z'). subroutine set_z_label ( self , text ) class ( ReferenceFrame ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: text self % z_label_ = text if ( self % realized ) call make_axis ( self , 3 ) end subroutine set_z_label !> The label text of axis X_AXIS, Y_AXIS or Z_AXIS. function axis_label ( self , axis ) result ( text ) class ( ReferenceFrame ), intent ( in ) :: self integer , intent ( in ) :: axis character ( len = :), allocatable :: text select case ( axis ) case ( X_AXIS ) text = 'X' if ( allocated ( self % x_label_ )) text = self % x_label_ case ( Y_AXIS ) text = 'Y' if ( allocated ( self % y_label_ )) text = self % y_label_ case ( Z_AXIS ) text = 'Z' if ( allocated ( self % z_label_ )) text = self % z_label_ case default text = '' end select end function axis_label !> The font of the labels: a font file name (found on the data search !> path) or a full path; default: the renderer's default font. subroutine set_label_font ( self , font ) class ( ReferenceFrame ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: font self % label_font_ = font if (. not . self % realized ) return call make_name_label ( self ) ! (another font: made again) call remake_axes ( self ) end subroutine set_label_font !> The labels' font as set ('' for the renderer's default). function label_font ( self ) result ( font ) class ( ReferenceFrame ), intent ( in ) :: self character ( len = :), allocatable :: font if ( allocated ( self % label_font_ )) then font = self % label_font_ else font = '' end if end function label_font !> The size of the labels in pixels (default 20): the name label's size, !> and the maximum size of the axes labels (which shrink with distance). subroutine set_label_size ( self , size ) class ( ReferenceFrame ), intent ( inout ) :: self integer , intent ( in ) :: size self % label_size_ = size call relayout_labels ( self ) end subroutine set_label_size !> The labels' size in pixels. pure integer function label_size ( self ) class ( ReferenceFrame ), intent ( in ) :: self label_size = self % label_size_ end function label_size !> The alignment of the labels relative to their positions (ALIGN_*; !> default ALIGN_LEFT_BASE_LINE). subroutine set_label_alignment ( self , alignment ) class ( ReferenceFrame ), intent ( inout ) :: self integer , intent ( in ) :: alignment self % label_alignment_ = alignment call relayout_labels ( self ) end subroutine set_label_alignment !> The labels' alignment (ALIGN_*). pure integer function label_alignment ( self ) class ( ReferenceFrame ), intent ( in ) :: self label_alignment = self % label_alignment_ end function label_alignment !> Whether this frame carries a light source: a point light at its origin !> (e.g. the Sun), not dimmed with distance (default false; OpenFrames' !> setLightSourceEnabled). While any frame of a window's scene has one, the !> window's own light (WindowProxy%set_light_*) is off. subroutine set_light_source_enabled ( self , enable ) class ( ReferenceFrame ), intent ( inout ) :: self logical , intent ( in ) :: enable self % light_source = enable if ( self % realized . and . enable . and . . not . c_associated ( self % light_node )) call build_light ( self ) if ( c_associated ( self % light_switch )) & call check_status ( vkf_switch_set ( self % light_switch , merge ( 1_c_int , 0_c_int , enable ))) end subroutine set_light_source_enabled !> Whether this frame carries a light source. pure logical function light_source_enabled ( self ) class ( ReferenceFrame ), intent ( in ) :: self light_source_enabled = self % light_source end function light_source_enabled !> Whether this frame or one of its descendants has a light source enabled. recursive logical function has_light_source ( self ) result ( has ) class ( ReferenceFrame ), intent ( in ) :: self integer :: k has = self % light_source do k = 1 , self % n_children if ( has ) return has = self % children ( k )% p % has_light_source () end do end function has_light_source !> The light source's ambient, diffuse and specular colors ([r, g, b], 0 !> to 1; defaults 0.05, 0.8 and 0.05 gray). subroutine set_light_ambient ( self , rgb ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: rgb ( 3 ) self % light_ambient_ = rgb call apply_light ( self ) end subroutine set_light_ambient !> The light source's diffuse color (see `set_light_ambient`). subroutine set_light_diffuse ( self , rgb ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: rgb ( 3 ) self % light_diffuse_ = rgb call apply_light ( self ) end subroutine set_light_diffuse !> The light source's specular color (see `set_light_ambient`). subroutine set_light_specular ( self , rgb ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: rgb ( 3 ) self % light_specular_ = rgb call apply_light ( self ) end subroutine set_light_specular !> The light source's ambient color [r, g, b]. pure function light_ambient ( self ) result ( rgb ) class ( ReferenceFrame ), intent ( in ) :: self real ( wp ) :: rgb ( 3 ) rgb = self % light_ambient_ end function light_ambient !> The light source's diffuse color [r, g, b]. pure function light_diffuse ( self ) result ( rgb ) class ( ReferenceFrame ), intent ( in ) :: self real ( wp ) :: rgb ( 3 ) rgb = self % light_diffuse_ end function light_diffuse !> The light source's specular color [r, g, b]. pure function light_specular ( self ) result ( rgb ) class ( ReferenceFrame ), intent ( in ) :: self real ( wp ) :: rgb ( 3 ) rgb = self % light_specular_ end function light_specular !> The light source's node: a point light at the origin, under a switch. subroutine build_light ( self ) class ( ReferenceFrame ), intent ( inout ) :: self self % light_node = vkf_light_create () if (. not . c_associated ( self % light_node )) return self % light_switch = vkf_switch_create () call check_status ( vkf_node_add_child ( self % light_switch , self % light_node )) call check_status ( vkf_node_add_child ( self % node_ , self % light_switch )) call apply_light ( self ) end subroutine build_light !> Give the light source's node its colors (if it has been made). subroutine apply_light ( self ) class ( ReferenceFrame ), intent ( inout ) :: self if (. not . c_associated ( self % light_node )) return call check_status ( vkf_light_set ( self % light_node , real ( self % light_ambient_ , c_float ), real ( self % light_diffuse_ , c_float ), & real ( self % light_specular_ , c_float ), [ 0.0_c_double , 0.0_c_double , 0.0_c_double , 1.0_c_double ])) end subroutine apply_light !> Show or hide what the frame draws (its sphere, model, ...), but not its !> axes, labels or children. subroutine show_contents ( self , show ) class ( ReferenceFrame ), intent ( inout ) :: self logical , intent ( in ) :: show self % contents = show if ( c_associated ( self % contents_node )) call check_status ( vkf_switch_set ( self % contents_node , merge ( 1_c_int , 0_c_int , show ))) end subroutine show_contents !> Whether what the frame draws is shown (`show_contents`). pure logical function contents_shown ( self ) class ( ReferenceFrame ), intent ( in ) :: self contents_shown = self % contents end function contents_shown !> Whether `pick` tests what this frame draws (default true; e.g. false !> for an overlay such as a selection marker). Its children are picked or !> not by their own setting. subroutine set_pickable ( self , pickable ) class ( ReferenceFrame ), intent ( inout ) :: self logical , intent ( in ) :: pickable self % pickable_ = pickable end subroutine set_pickable !> Whether `pick` tests what this frame draws (`set_pickable`). pure logical function pickable ( self ) class ( ReferenceFrame ), intent ( in ) :: self pickable = self % pickable_ end function pickable !> Pick what the frame draws (see the module documentation): `to_root` !> is its transform to the root frame; hits are added to hits(1:n). A !> plain frame: its origin, if it shows axes or its name label. subroutine pick ( self , cam , to_root , hits , n ) class ( ReferenceFrame ), intent ( in ), target :: self type ( PickCamera ), intent ( in ) :: cam !! the cursor's ray and the pick's settings real ( wp ), intent ( in ) :: to_root ( 4 , 4 ) !! the frame's transform to the root frame type ( PickHit ), allocatable , intent ( inout ) :: hits (:) !! hits so far (grown as needed) integer , intent ( inout ) :: n !! number of hits in hits type ( PickHit ) :: h if ( self % axes == NO_AXES . and . . not . self % name_label ) return if (. not . wants ( cam , PICK_FRAME )) return if (. not . point_pick ( cam , to_root ( 1 : 3 , 4 ), h % pixels , h % distance )) return h % kind = PICK_FRAME h % frame => self h % position = to_root ( 1 : 3 , 4 ) call add_pick_hit ( hits , n , h ) end subroutine pick !> Pick a body of frame `self`: the ellipsoid centered at `center` with !> semi-axes `radii` along the columns of `axes` (unit vectors; all in the !> frame's coordinates), hit by the ray through the cursor. Adds a !> PICK_BODY hit (with the geodetic latitude and longitude of the point !> on the ellipsoid if `geodetic`); true if hit. logical function pick_ellipsoid ( self , cam , to_root , center , axes , radii , geodetic , hits , n ) result ( hit ) class ( ReferenceFrame ), intent ( in ), target :: self type ( PickCamera ), intent ( in ) :: cam real ( wp ), intent ( in ) :: to_root ( 4 , 4 ), center ( 3 ), axes ( 3 , 3 ), radii ( 3 ) !! center, axes: frame coordinates logical , intent ( in ) :: geodetic type ( PickHit ), allocatable , intent ( inout ) :: hits (:) !! hits so far (grown as needed) integer , intent ( inout ) :: n !! number of hits in hits type ( PickHit ) :: h real ( wp ) :: origin ( 3 ), dir ( 3 ), along , local ( 3 ), normal ( 3 ) hit = . false . if (. not . wants ( cam , PICK_BODY )) return call ray ( cam , origin , dir ) hit = ray_ellipsoid ( origin , dir , matmul ( to_root ( 1 : 3 , 1 : 3 ), center ) + to_root ( 1 : 3 , 4 ), & matmul ( to_root ( 1 : 3 , 1 : 3 ), axes ), radii , along , h % position , local ) if ( hit ) hit = dot_product ( h % position - cam % eye , cam % forward ) <= cam % max_depth if (. not . hit ) return h % kind = PICK_BODY h % frame => self h % local = matmul ( transpose ( to_root ( 1 : 3 , 1 : 3 )), h % position - to_root ( 1 : 3 , 4 )) h % distance = dot_product ( h % position - cam % eye , cam % forward ) h % pixels = 0.0_wp if ( geodetic ) then normal = local / radii ** 2 ! (the surface normal there) h % latitude = asin ( max ( - 1.0_wp , min ( 1.0_wp , normal ( 3 ) / norm2 ( normal )))) h % longitude = atan2 ( normal ( 2 ), normal ( 1 )) end if call add_pick_hit ( hits , n , h ) end function pick_ellipsoid !> Add `hit` to hits(1:n) (growing the array). subroutine add_pick_hit ( hits , n , hit ) type ( PickHit ), allocatable , intent ( inout ) :: hits (:) !! grown as needed integer , intent ( inout ) :: n !! number of hits in hits type ( PickHit ), intent ( in ) :: hit type ( PickHit ), allocatable :: more (:) if (. not . allocated ( hits )) allocate ( hits ( 8 )) if ( n == size ( hits )) then allocate ( more ( 2 * n )) more ( 1 : n ) = hits ( 1 : n ) call move_alloc ( more , hits ) end if n = n + 1 hits ( n ) = hit end subroutine add_pick_hit !> The bounding sphere of what the frame draws, in its own coordinates !> (radius 0 if it draws nothing; extensions override it). Views use it for !> their default distance. subroutine bound ( self , center , radius ) class ( ReferenceFrame ), intent ( in ) :: self real ( wp ), intent ( out ) :: center ( 3 ), radius !! frame's coordinates center = 0.0_wp radius = 0.0_wp end subroutine bound !> Place the x axis vector: from `base`, `length` long, with a head of !> `head_ratio` of the length (default 0.3) and body and head radii (default !> 0.05 and 0.1 of the length); its label is at the tip, 0.4 of the length !> tall (at most `label_size` pixels). As OpenFrames' moveXAxis. Set before !> the frame is first shown. subroutine move_x_axis ( self , base , length , head_ratio , body_radius , head_radius ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: base ( 3 ), length !! (base: frame's coordinates) real ( wp ), intent ( in ), optional :: head_ratio , body_radius , head_radius call move_axis ( self , 1 , base , length , head_ratio , body_radius , head_radius ) end subroutine move_x_axis !> Place the y axis vector (as `move_x_axis`; OpenFrames' moveYAxis). subroutine move_y_axis ( self , base , length , head_ratio , body_radius , head_radius ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: base ( 3 ), length real ( wp ), intent ( in ), optional :: head_ratio , body_radius , head_radius call move_axis ( self , 2 , base , length , head_ratio , body_radius , head_radius ) end subroutine move_y_axis !> Place the z axis vector (as `move_x_axis`; OpenFrames' moveZAxis). subroutine move_z_axis ( self , base , length , head_ratio , body_radius , head_radius ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: base ( 3 ), length real ( wp ), intent ( in ), optional :: head_ratio , body_radius , head_radius call move_axis ( self , 3 , base , length , head_ratio , body_radius , head_radius ) end subroutine move_z_axis !> Place axis k (as `move_x_axis`), made again if the frame is shown. subroutine move_axis ( self , k , base , length , head_ratio , body_radius , head_radius ) class ( ReferenceFrame ), intent ( inout ) :: self integer , intent ( in ) :: k !! the axis: 1 (x), 2 (y) or 3 (z) real ( wp ), intent ( in ) :: base ( 3 ), length real ( wp ), intent ( in ), optional :: head_ratio , body_radius , head_radius self % axis_base (:, k ) = base self % axis_len ( k ) = length self % axis_head_ratio ( k ) = 0.3_wp self % axis_body_radius ( k ) = 0.0_wp self % axis_head_radius ( k ) = 0.0_wp if ( present ( head_ratio )) self % axis_head_ratio ( k ) = head_ratio if ( present ( body_radius )) self % axis_body_radius ( k ) = body_radius if ( present ( head_radius )) self % axis_head_radius ( k ) = head_radius self % axes_moved = . true . if ( self % realized ) call make_axis ( self , k ) ! shown: made again end subroutine move_axis !> Place the axes for what the frame draws, when it is first shown (unless !> move_*_axis was called): at its bound's surface, half the bound's radius !> long (as OpenFrames' Sphere and Model do); at the origin, 1 long, for a !> frame that draws nothing. subroutine reposition_axes ( self ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ) :: c ( 3 ), r , e ( 3 ) integer :: k call self % bound ( c , r ) if ( r <= 0.0_wp ) return do k = 1 , 3 e = 0.0_wp e ( k ) = 1.0_wp self % axis_base (:, k ) = c + r * e self % axis_len ( k ) = 0.5_wp * r end do end subroutine reposition_axes !> What kind of frame this is (shown by `frame_string`; extensions override it). function frame_info ( self ) result ( info ) class ( ReferenceFrame ), intent ( in ) :: self character ( len = :), allocatable :: info info = 'ReferenceFrame' end function frame_info ! ================================================================== ! the tree !> Add `child` to this frame's children. Returns false (and does nothing) !> for this frame itself or an ancestor of it; true if it is already a child. logical function add_child ( self , child ) result ( ok ) class ( ReferenceFrame ), intent ( inout ), target :: self class ( ReferenceFrame ), intent ( inout ), target :: child ok = . false . if ( same_frame ( self , child )) return if ( self % child_index ( child ) > 0 ) then ok = . true . return end if if ( is_descendant ( child , self )) return call append ( self % children , self % n_children , child ) call append ( child % parents , child % n_parents , self ) ok = . true . if ( self % realized ) then ! shown: draw the child from the next frame if (. not . child % realized ) then if ( self % shown_ ) then ! (for a window that exists now) call child % realize ( vkf_viewer_any ()) call check_status ( vkf_compile_node ( child % node_ )) else call child % realize ( c_null_ptr ) end if end if call check_status ( vkf_node_add_child ( self % node_ , child % node_ )) end if end function add_child !> Remove `child` from this frame's children. Returns false if it is not one. logical function remove_child ( self , child ) result ( ok ) class ( ReferenceFrame ), intent ( inout ), target :: self class ( ReferenceFrame ), intent ( inout ), target :: child ok = remove ( self % children , self % n_children , child ) if ( ok ) ok = remove ( child % parents , child % n_parents , self ) if ( ok . and . self % realized . and . child % realized ) call check_status ( vkf_node_remove_child ( self % node_ , child % node_ )) end function remove_child !> Remove this frame from all its parents and children (before it goes out !> of scope or is deallocated while in a tree). subroutine detach ( self ) class ( ReferenceFrame ), intent ( inout ), target :: self logical :: ok do while ( self % n_parents > 0 ) ok = self % parents ( self % n_parents )% p % remove_child ( self ) end do do while ( self % n_children > 0 ) ok = self % remove_child ( self % children ( self % n_children )% p ) end do end subroutine detach !> Number of children. pure integer function num_children ( self ) class ( ReferenceFrame ), intent ( in ) :: self num_children = self % n_children end function num_children !> Child i (1 to num_children). function child ( self , i ) result ( c ) class ( ReferenceFrame ), intent ( in ) :: self integer , intent ( in ) :: i class ( ReferenceFrame ), pointer :: c c => self % children ( i )% p end function child !> Index of `frame` among the children, or 0. integer function child_index ( self , frame ) class ( ReferenceFrame ), intent ( in ) :: self class ( ReferenceFrame ), intent ( in ), target :: frame child_index = find ( self % children , self % n_children , frame ) end function child_index !> Number of parents. pure integer function num_parents ( self ) class ( ReferenceFrame ), intent ( in ) :: self num_parents = self % n_parents end function num_parents !> Parent i (1 to num_parents). function parent ( self , i ) result ( p ) class ( ReferenceFrame ), intent ( in ) :: self integer , intent ( in ) :: i class ( ReferenceFrame ), pointer :: p p => self % parents ( i )% p end function parent !> Index of `frame` among the parents, or 0. integer function parent_index ( self , frame ) class ( ReferenceFrame ), intent ( in ) :: self class ( ReferenceFrame ), intent ( in ), target :: frame parent_index = find ( self % parents , self % n_parents , frame ) end function parent_index !> The tree below this frame, one line per frame (\"name (info)\"), in !> OpenFrames' createFrameString format: children are prefixed \"|-->\". recursive function frame_string ( self , prefix ) result ( str ) class ( ReferenceFrame ), intent ( in ) :: self character ( len =* ), intent ( in ), optional :: prefix !! before this frame's line (default ' ') character ( len = :), allocatable :: str , pre integer :: k pre = ' ' if ( present ( prefix )) pre = prefix str = pre // self % name () // ' (' // self % frame_info () // ')' // new_line ( 'a' ) if ( pre ( len ( pre ): len ( pre )) == '>' ) pre ( len ( pre ): len ( pre )) = '-' pre = pre // '|-->' do k = 1 , self % n_children str = str // self % children ( k )% p % frame_string ( pre ) end do end function frame_string ! ================================================================== ! following trajectories !> Follow `traj` (in addition to trajectories already followed, if `add` !> is true), with what to follow (`data`: FOLLOW_POSITION and/or !> FOLLOW_ATTITUDE; default both) and how (`mode`: FOLLOW_LOOP, the !> default, or FOLLOW_LIMIT). `traj` must stay alive while followed. subroutine follow ( self , traj , data , mode , add ) class ( ReferenceFrame ), intent ( inout ) :: self type ( Trajectory ), intent ( in ), target :: traj !! the trajectory to follow (not owned) integer , intent ( in ), optional :: data , mode !! FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT logical , intent ( in ), optional :: add !! (true: in addition to those followed (default false)) type ( Trajectory ), pointer :: p integer :: d , m logical :: adding p => traj adding = . false . if ( present ( add )) adding = add d = ior ( FOLLOW_POSITION , FOLLOW_ATTITUDE ) m = FOLLOW_LOOP if ( present ( data )) d = data if ( present ( mode )) m = mode if ( adding ) then call self % follower_ % add_trajectory ( p ) else call self % follower_ % set_trajectory ( p ) end if call self % follower_ % set_follow_type ( d , m ) self % following = . true . end subroutine follow !> Stop following trajectories (the frame keeps its last position and attitude). subroutine unfollow ( self ) class ( ReferenceFrame ), intent ( inout ) :: self call self % follower_ % remove_all () self % following = . false . end subroutine unfollow !> The frame's trajectory follower, for finer control (data sources, time !> offset, ...). function follower ( self ) result ( f ) class ( ReferenceFrame ), intent ( in ), target :: self type ( TrajectoryFollower ), pointer :: f f => self % follower_ end function follower !> Whether the frame follows trajectories (at least one, since `follow`). pure logical function is_following ( self ) class ( ReferenceFrame ), intent ( in ) :: self is_following = self % following . and . self % follower_ % num_trajectories () > 0 end function is_following !> Update this frame and its descendants for simulation time `t` (followed !> trajectories set positions and attitudes). recursive subroutine update ( self , t ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t !! simulation time logical :: has_position , has_attitude integer :: k if ( self % following ) & call self % follower_ % update ( t , self % position_ , self % attitude_ , has_position , has_attitude ) do k = 1 , self % n_children call self % children ( k )% p % update ( t ) end do end subroutine update !> After the whole tree's update for time t (all frames at their positions !> for t): for contents that depend on other frames' positions, e.g. !> CustomLineSegments between spacecraft. Here, only the descendants'. recursive subroutine late_update ( self , t ) class ( ReferenceFrame ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t !! simulation time integer :: k do k = 1 , self % n_children call self % children ( k )% p % late_update ( t ) end do end subroutine late_update ! ================================================================== ! rendering !> Create the render nodes of this frame and its descendants (once; for !> `viewer`, a window's viewer handle, which some contents need while they !> are built (not kept); null: headless). recursive subroutine realize ( self , viewer ) class ( ReferenceFrame ), intent ( inout ) :: self type ( c_ptr ), intent ( in ) :: viewer !! a window's viewer handle (null: headless) integer :: k if ( self % realized ) return self % realized = . true . self % shown_ = c_associated ( viewer ) self % node_ = vkf_transform_create () self % synced = . false . self % contents_node = vkf_switch_create () call check_status ( vkf_node_add_child ( self % node_ , self % contents_node )) call self % build_contents ( viewer , self % contents_node ) call build_decorations ( self ) if ( self % light_source ) call build_light ( self ) if (. not . self % contents ) call check_status ( vkf_switch_set ( self % contents_node , 0_c_int )) call self % sync () do k = 1 , self % n_children call self % children ( k )% p % realize ( viewer ) call check_status ( vkf_node_add_child ( self % node_ , self % children ( k )% p % node_ )) end do end subroutine realize !> Add what this frame draws to `group` (a node handle). ReferenceFrame !> draws nothing itself (its axes and labels come later); extensions such as !> Sphere and Model override this. subroutine build_contents ( self , viewer , group ) class ( ReferenceFrame ), intent ( inout ) :: self type ( c_ptr ), intent ( in ) :: viewer , group !! (viewer: as `realize`'s) end subroutine build_contents !> Copy the positions and attitudes of this frame and its descendants to !> their transform nodes (only those that changed since the last sync). recursive subroutine sync ( self ) class ( ReferenceFrame ), intent ( inout ) :: self integer :: k if (. not . self % realized ) return if (. not . ( self % synced . and . all ( self % position_ == self % synced_position ) . and . & all ( self % attitude_ == self % synced_attitude ))) then call check_status ( vkf_transform_set_matrix ( self % node_ , self % local_matrix ())) self % synced_position = self % position_ self % synced_attitude = self % attitude_ self % synced = . true . end if do k = 1 , self % n_children call self % children ( k )% p % sync () end do end subroutine sync !> The frame's transform node (null until realized). function node ( self ) result ( n ) class ( ReferenceFrame ), intent ( in ) :: self type ( c_ptr ) :: n n = self % node_ end function node !> The axes (arrows), axes labels and name label, each under a switch, in !> the frame's color (OpenFrames' ReferenceFrame decorations). subroutine build_decorations ( self ) class ( ReferenceFrame ), intent ( inout ) :: self integer :: k if (. not . self % axes_moved ) call self % reposition_axes () do k = 1 , 3 self % axis_node ( k ) = vkf_switch_create () self % axis_label_node ( k ) = vkf_switch_create () call make_axis ( self , k ) call check_status ( vkf_node_add_child ( self % node_ , self % axis_node ( k ))) call check_status ( vkf_node_add_child ( self % node_ , self % axis_label_node ( k ))) end do ! the name label at the origin, label_size pixels tall self % name_label_node = vkf_switch_create () call make_name_label ( self ) call check_status ( vkf_node_add_child ( self % node_ , self % name_label_node )) call update_switches ( self ) end subroutine build_decorations !> The name label (in place of the old one; compiled first if shown). subroutine make_name_label ( self ) class ( ReferenceFrame ), intent ( inout ) :: self call replace_child ( self , self % name_label_node , self % name_text , & label_create ( self % name (), [ 0.0_wp , 0.0_wp , 0.0_wp ], self % color_ , & real ( self % label_size_ , wp ), 0.0_wp , self % label_alignment_ , self % label_font ())) if ( self % name_on_top . and . c_associated ( self % name_text )) call check_status ( vkf_label_set_on_top ( self % name_text , 1_c_int )) call update_switches ( self ) ! (a node added to a switch is shown) end subroutine make_name_label !> The axes and their labels made again (another color, size or font). subroutine remake_axes ( self ) class ( ReferenceFrame ), intent ( inout ) :: self integer :: k if (. not . self % realized ) return do k = 1 , 3 call make_axis ( self , k ) end do end subroutine remake_axes !> The labels' size and alignment changed: the name label's in place, the !> axes' labels made again. subroutine relayout_labels ( self ) class ( ReferenceFrame ), intent ( inout ) :: self if (. not . self % realized ) return if ( c_associated ( self % name_text )) then if (. not . label_set_layout ( self % name_text , [ 0.0_wp , 0.0_wp , 0.0_wp ], real ( self % label_size_ , wp ), 0.0_wp , & self % label_alignment_ )) call check_status ( - 1_c_int ) end if call remake_axes ( self ) end subroutine relayout_labels !> Axis k's arrow and label, in their switches (in place of the old ones; !> compiled first if the window already runs). subroutine make_axis ( self , k ) class ( ReferenceFrame ), intent ( inout ) :: self integer , intent ( in ) :: k !! the axis: 1 (x), 2 (y) or 3 (z) real ( wp ) :: e ( 3 ), len , head , rb , rh , tip ( 3 ) e = 0.0_wp e ( k ) = 1.0_wp len = self % axis_len ( k ) head = self % axis_head_ratio ( k ) if ( head <= 0.0_wp . or . head >= 1.0_wp ) head = 0.3_wp rb = self % axis_body_radius ( k ) if ( rb <= 0.0_wp ) rb = 0.05_wp * len rh = self % axis_head_radius ( k ) if ( rh <= 0.0_wp ) rh = 0.1_wp * len call replace_child ( self , self % axis_node ( k ), self % axis_arrow ( k ), & arrow_create ( self % axis_base (:, k ), e , ( 1.0_wp - head ) * len , head * len , rb , rh , & real ( self % color_ , c_float ))) ! the label at the tip, 0.4 of the axis length tall, at most label_size pixels tip = self % axis_base (:, k ) + len * e call replace_child ( self , self % axis_label_node ( k ), self % axis_text ( k ), & label_create ( self % axis_label ( 2 ** ( k - 1 )), tip , self % color_ , - 0.4_wp * len , & real ( self % label_size_ , wp ), self % label_alignment_ , self % label_font ())) call update_switches ( self ) ! (a node added to a switch is shown) end subroutine make_axis !> Put `new` in `switch` in place of `old` (a kept handle, deleted). subroutine replace_child ( self , switch , old , new ) class ( ReferenceFrame ), intent ( in ) :: self type ( c_ptr ), intent ( in ) :: switch , new type ( c_ptr ), intent ( inout ) :: old if ( c_associated ( old )) then call check_status ( vkf_node_remove_child ( switch , old )) call vkf_node_delete ( old ) end if old = new if (. not . c_associated ( new )) return if ( self % shown_ ) call check_status ( vkf_compile_node ( new )) call check_status ( vkf_node_add_child ( switch , new )) end subroutine replace_child !> Show or hide the decorations' switches as set. subroutine update_switches ( self ) class ( ReferenceFrame ), intent ( inout ) :: self integer :: k if (. not . self % realized ) return do k = 1 , 3 if ( c_associated ( self % axis_node ( k ))) & call check_status ( vkf_switch_set ( self % axis_node ( k ), merge ( 1_c_int , 0_c_int , iand ( self % axes , 2 ** ( k - 1 )) /= 0 ))) if ( c_associated ( self % axis_label_node ( k ))) & call check_status ( vkf_switch_set ( self % axis_label_node ( k ), & merge ( 1_c_int , 0_c_int , iand ( self % axes_labels , 2 ** ( k - 1 )) /= 0 ))) end do if ( c_associated ( self % name_label_node )) & call check_status ( vkf_switch_set ( self % name_label_node , merge ( 1_c_int , 0_c_int , self % name_label ))) end subroutine update_switches ! ================================================================== ! helpers !> True if `a` and `b` are the same frame (object). logical function same_frame ( a , b ) class ( ReferenceFrame ), intent ( in ), target :: a , b class ( ReferenceFrame ), pointer :: pa pa => a same_frame = associated ( pa , b ) end function same_frame !> True if `frame` is `root` or one of its descendants. recursive logical function is_descendant ( root , frame ) result ( yes ) class ( ReferenceFrame ), intent ( in ), target :: root , frame integer :: k yes = same_frame ( root , frame ) do k = 1 , root % n_children if ( yes ) return yes = is_descendant ( root % children ( k )% p , frame ) end do end function is_descendant !> Index of `frame` in list(1:n), or 0. integer function find ( list , n , frame ) type ( FramePointer ), allocatable , intent ( in ) :: list (:) !! first n used integer , intent ( in ) :: n class ( ReferenceFrame ), intent ( in ), target :: frame integer :: k find = 0 do k = 1 , n if ( associated ( list ( k )% p , frame )) then find = k return end if end do end function find !> Add `frame` to list(1:n) (growing the array). subroutine append ( list , n , frame ) type ( FramePointer ), allocatable , intent ( inout ) :: list (:) !! first n used (grown as needed) integer , intent ( inout ) :: n class ( ReferenceFrame ), intent ( in ), target :: frame type ( FramePointer ), allocatable :: tmp (:) if (. not . allocated ( list )) allocate ( list ( 4 )) if ( n == size ( list )) then allocate ( tmp ( 2 * n )) tmp ( 1 : n ) = list ( 1 : n ) call move_alloc ( tmp , list ) end if n = n + 1 list ( n )% p => frame end subroutine append !> Remove `frame` from list(1:n); false if it is not in it. logical function remove ( list , n , frame ) type ( FramePointer ), allocatable , intent ( inout ) :: list (:) !! first n used integer , intent ( inout ) :: n class ( ReferenceFrame ), intent ( in ), target :: frame integer :: k k = find ( list , n , frame ) remove = k > 0 if (. not . remove ) return list ( k : n - 1 ) = list ( k + 1 : n ) list ( n )% p => null () n = n - 1 end function remove end module vkf_frames","tags":"","url":"sourcefile/vkf_frames.f90.html"},{"title":"vkf_line_chain.f90 – vkframes","text":"This file depends on sourcefile~~vkf_line_chain.f90~~EfferentGraph sourcefile~vkf_line_chain.f90 vkf_line_chain.f90 sourcefile~vkf_layer.f90 vkf_layer.f90 sourcefile~vkf_line_chain.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_math.f90 vkf_math.f90 sourcefile~vkf_line_chain.f90->sourcefile~vkf_math.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~vkf_line_chain.f90~~AfferentGraph sourcefile~vkf_line_chain.f90 vkf_line_chain.f90 sourcefile~vkf_artists.f90 vkf_artists.f90 sourcefile~vkf_artists.f90->sourcefile~vkf_line_chain.f90 sourcefile~vkf_line_segments.f90 vkf_line_segments.f90 sourcefile~vkf_line_segments.f90->sourcefile~vkf_line_chain.f90 sourcefile~vkf_handles.f90 vkf_handles.f90 sourcefile~vkf_handles.f90->sourcefile~vkf_artists.f90 sourcefile~vkf_shapes.f90 vkf_shapes.f90 sourcefile~vkf_shapes.f90->sourcefile~vkf_artists.f90 sourcefile~vkframes.f90 vkframes.f90 sourcefile~vkframes.f90->sourcefile~vkf_artists.f90 sourcefile~vkframes.f90->sourcefile~vkf_line_segments.f90 sourcefile~vkframes.f90->sourcefile~vkf_handles.f90 sourcefile~vkframes.f90->sourcefile~vkf_shapes.f90 sourcefile~vkf_window.f90 vkf_window.f90 sourcefile~vkframes.f90->sourcefile~vkf_window.f90 sourcefile~vkf_window.f90->sourcefile~vkf_handles.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code !> A growing set of points drawn from a chain of GPU buffers (\"chunks\"), for !> the trajectory artists: a line strip, separate segments (pairs of points), !> markers (one per point) or a ribbon (a translucent surface through pairs of !> points: a quad between each pair and the next). Points are written in place, as (high, low) !> float pairs for double precision (see src/vsg/vkf_layer.cpp: EyeRelative), !> with a strip's distance along it (for dash patterns, see shaders/line.vert; !> measured from the trajectory's points), and only the chunks written to are !> uploaded again. A full chain gets new chunks, each as large as the chain so !> far or as what is needed at once, but at least min_chunk and at most !> max_chunk points, so nothing is ever copied or reallocated, and changing a !> point uploads at most max_chunk points again. In a strip, consecutive chunks !> share their end point so that the line is continuous; in a ribbon, their !> end pair. !> !> Level of detail (strips): seen from far away, a dense trajectory is mostly !> segments shorter than a pixel. For each chunk, the chain keeps the bounding !> sphere of its points and, for strides 2, 4, ... 2&#94;lod_levels, a bound on how !> far the points skipped can be from the segments drawn (every stride-th point !> and the last), and gives them to the renderer (vkf_line_set_lod), which picks !> the stride per view (src/vsg/vkf_layer.cpp: EyeRelative). The bounds are !> built level by level: a segment at stride 2s is within the larger of its two !> halves' bounds, plus its middle point's distance from it, of the points it !> skips (the halves' segments lie within that distance of it). They are !> updated only for the segments the points written change. !> !> Writing points i1 .. i2 (indices along the whole chain): !> !>     call chain%reserve(i2) !>     do j = 1, chain%num_chunks() !>         call chain%slice(j, i1, i2, lo, hi, p)      ! p: points lo .. hi of chunk j !>         if (.not. associated(p)) cycle !>         ... fill p(1:3, :, 1:hi-lo+1) (e.g. with split_points) ... !>     end do !>     call chain%written(i1, i2)                     ! measure (strips) and upload !>     call chain%draw(i2) module vkf_line_chain use , intrinsic :: iso_c_binding , only : c_ptr , c_null_ptr , c_associated , c_int , c_float , c_double , c_f_pointer use vkf_math , only : wp use vkf_layer , only : check_status , & vkf_line_create , vkf_line_create_colored , vkf_line_colors , vkf_marker_create , vkf_ribbon_create , & vkf_line_points , vkf_line_points_changed , & vkf_line_set_range , vkf_node_add_child , vkf_node_remove_child , vkf_node_delete , & vkf_compile_node , line_set_style , line_set_pattern , line_set_segments , & marker_set_style , vkf_line_set_lod , vkf_line_set_highlight , vkf_line_set_trail , vkf_line_set_dash_mode implicit none private integer , parameter :: min_chunk = 64 !! points in the smallest chunk integer , parameter , public :: max_chunk = 65536 !! points in a chunk made for appending (1.5 MB) integer , parameter :: lod_levels = 12 !! strides up to 2&#94;12 = 4096 (strips) !> what a chain draws integer , parameter , public :: CHAIN_STRIP = 0 !! a line strip integer , parameter , public :: CHAIN_SEGMENTS = 1 !! separate segments (pairs of points) integer , parameter , public :: CHAIN_MARKERS = 2 !! a marker per point integer , parameter , public :: CHAIN_RIBBON = 3 !! a ribbon (a quad between each pair of points and the next) public :: split_points , split_distances , line_buffer !> Error bounds of a strip's segments at one stride (level of detail). type :: LodLevel real ( c_float ), allocatable :: bound (:) !! (0 : segments - 1) end type LodLevel !> A buffer holding points first .. first+capacity-1 of the chain. type :: LineChunk type ( c_ptr ) :: line = c_null_ptr !! the line, marker or ribbon node integer :: first = 1 !! the chain index of its first point integer :: capacity = 0 !! number of points it holds ! level of detail (strips) type ( LodLevel ) :: lod ( lod_levels ) !! error bounds at strides 2, 4, ... 2&#94;lod_levels real ( wp ) :: box_lo ( 3 ) = 0.0_wp !! bounding box of the points written: lower corner real ( wp ) :: box_hi ( 3 ) = 0.0_wp !! bounding box of the points written: upper corner integer :: n_written = 0 !! points written (the bounds are for them) end type LineChunk !> A chain of point buffers (see the module documentation). type , public :: LineChain private type ( c_ptr ) :: group = c_null_ptr !! the group node the chunks are under (null: not built) logical :: compile_new = . false . !! chunks made from now on are compiled (the group is shown) type ( LineChunk ), allocatable :: chunks (:) !! (capacity): the chunks, in chain order integer :: n_chunks = 0 !! number of chunks integer :: kind = CHAIN_STRIP !! what is drawn: a CHAIN_* constant type ( c_ptr ) :: image = c_null_ptr !! (markers: the image (shape 10)) logical :: colored = . false . !! (lines, markers: a color per point (color_slice)) ! style real ( c_float ) :: color ( 4 ) = 1.0_c_float !! [r, g, b, a] (0 to 1) real ( c_float ) :: width = 1.0_c_float !! line width, or marker size integer :: shape = 0 !! markers real ( c_float ) :: radius = 0.0_c_float !! (markers: attenuation radius) integer :: pattern_factor = 1 !! (lines: dash pattern (see line_set_pattern)) integer :: pattern = int ( z 'FFFF' ) !! (lines: 16-bit dash pattern (z'FFFF': solid)) logical :: lod = . true . !! (strips: level of detail (else every point drawn)) real ( c_float ) :: highlight ( 12 ) = [ 1.0_c_float , 1.0_c_float , 1.0_c_float , 1.0_c_float , & 0.0_c_float , 4 0.0_c_float , 5 0.0_c_float , 1 2.0_c_float , & 1.5_c_float , 0.0_c_float , 0.0_c_float , 0.0_c_float ] !! (lines: highlight, see vkf_line_set_highlight) real ( c_float ) :: trail ( 20 ) = 0.0_c_float !! (strips: the trail, see vkf_line_set_trail; z = 0: none) integer :: dash_mode = 0 !! (lines: 0 anchored, 1 screen-locked, 2 fixed length: vkf_line_set_dash_mode) real ( wp ) :: dash_length = 0.0_wp !! (2: the pattern's length, scene units; 0 from the first view) contains procedure :: init , set_compile , is_built , is_colored , release , detach procedure :: reserve , slice , color_slice , written , draw , draw_range procedure :: set_style , set_pattern , set_marker_style , set_highlight , set_trail , set_dash_mode , style_node procedure :: dash_mode_of , point , point_color , distance , num_chunks procedure :: set_lod , lod_error , chunk_bounds end type LineChain contains !> Draw under `group` (a CHAIN_* kind; markers with `image`, a !> vkf_image_read handle, for the image shape). Chunks made later are !> compiled once set_compile says so. subroutine init ( self , group , kind , image , colored ) class ( LineChain ), intent ( inout ) :: self type ( c_ptr ), intent ( in ) :: group integer , intent ( in ) :: kind !! a CHAIN_* constant type ( c_ptr ), intent ( in ), optional :: image !! (markers: a vkf_image_read handle) logical , intent ( in ), optional :: colored !! (lines, markers: a color per point (color_slice)) self % group = group self % kind = kind self % compile_new = . false . self % image = c_null_ptr if ( present ( image )) self % image = image self % colored = . false . if ( present ( colored )) self % colored = colored end subroutine init !> Forget the chunks (after their group was removed from the scene): init !> starts again. subroutine release ( self ) class ( LineChain ), intent ( inout ) :: self integer :: j do j = 1 , self % n_chunks call vkf_node_delete ( self % chunks ( j )% line ) end do self % n_chunks = 0 self % group = c_null_ptr self % compile_new = . false . end subroutine release !> Remove the chunks from the group (also while running), and release them. subroutine detach ( self ) class ( LineChain ), intent ( inout ) :: self integer :: j do j = 1 , self % n_chunks call check_status ( vkf_node_remove_child ( self % group , self % chunks ( j )% line ), 'trajectory artists' ) end do call self % release () end subroutine detach !> Compile chunks made from now on (for the windows running): once the !> group is shown (not while building, when they are compiled with it). subroutine set_compile ( self , compile ) class ( LineChain ), intent ( inout ) :: self logical , intent ( in ) :: compile self % compile_new = compile end subroutine set_compile !> True if the chain has a group to draw under (between `init` and `release`). pure logical function is_built ( self ) class ( LineChain ), intent ( in ) :: self is_built = c_associated ( self % group ) end function is_built !> For lines and markers, whether each point has its own color (init's `colored`). pure logical function is_colored ( self ) class ( LineChain ), intent ( in ) :: self is_colored = self % colored end function is_colored !> Number of chunks. pure integer function num_chunks ( self ) class ( LineChain ), intent ( in ) :: self num_chunks = self % n_chunks end function num_chunks !> Chunks for at least n points (at least one chunk). Separate segments and !> ribbons: chunks hold whole pairs (n should be even). subroutine reserve ( self , n ) class ( LineChain ), intent ( inout ) :: self integer , intent ( in ) :: n type ( LineChunk ), allocatable :: tmp (:) type ( LineChunk ) :: c integer :: covered covered = 0 if ( self % n_chunks > 0 ) covered = self % chunks ( self % n_chunks )% first + self % chunks ( self % n_chunks )% capacity - 1 do while ( self % n_chunks == 0 . or . covered < n ) if ( self % n_chunks == 0 ) then c % first = 1 c % capacity = max ( min_chunk , min ( max_chunk , n )) ! the data so far, up to max_chunk else if ( self % kind == CHAIN_STRIP ) then c % first = covered ! sharing the previous chunk's last point c % capacity = min ( max_chunk , max ( min_chunk , covered , n - covered + 1 )) else if ( self % kind == CHAIN_RIBBON ) then c % first = covered - 1 ! sharing the previous chunk's last pair c % capacity = min ( max_chunk , max ( min_chunk , covered , n - covered + 2 )) else c % first = covered + 1 c % capacity = min ( max_chunk , max ( min_chunk , covered , n - covered )) end if if ( self % kind == CHAIN_SEGMENTS . or . self % kind == CHAIN_RIBBON ) c % capacity = c % capacity + modulo ( c % capacity , 2 ) if ( self % kind == CHAIN_MARKERS ) then c % line = vkf_marker_create ( int ( c % capacity , c_int ), self % image , merge ( 1_c_int , 0_c_int , self % colored )) else if ( self % kind == CHAIN_RIBBON ) then c % line = vkf_ribbon_create ( int ( c % capacity , c_int ), merge ( 1_c_int , 0_c_int , self % colored )) else if ( self % colored ) then c % line = vkf_line_create_colored ( int ( c % capacity , c_int )) else c % line = vkf_line_create ( int ( c % capacity , c_int )) end if end if if (. not . c_associated ( c % line )) return if ( self % kind == CHAIN_SEGMENTS ) call check_status ( line_set_segments ( c % line , . true .), 'trajectory artists' ) call apply_style ( self , c % line ) if ( self % compile_new ) call check_status ( vkf_compile_node ( c % line ), 'trajectory artists' ) call check_status ( vkf_node_add_child ( self % group , c % line ), 'trajectory artists' ) if (. not . allocated ( self % chunks )) allocate ( self % chunks ( 4 )) if ( self % n_chunks == size ( self % chunks )) then allocate ( tmp ( 2 * self % n_chunks )) call move_chunks ( self % chunks ( 1 : self % n_chunks ), tmp ( 1 : self % n_chunks )) call move_alloc ( tmp , self % chunks ) end if self % n_chunks = self % n_chunks + 1 self % chunks ( self % n_chunks ) = c covered = c % first + c % capacity - 1 end do end subroutine reserve !> The part lo .. hi of points i1 .. i2 that chunk j holds, and its buffer !> p(xyz and distance, high/low, lo:hi) (null if none). subroutine slice ( self , j , i1 , i2 , lo , hi , p ) class ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: j , i1 , i2 integer , intent ( out ) :: lo , hi !! chain indices (lo > hi: none) real ( c_float ), dimension (:,:,:), pointer , intent ( out ) :: p !! (4, 2, hi-lo+1) real ( c_float ), dimension (:,:,:), pointer :: all p => null () associate ( c => self % chunks ( j )) lo = max ( i1 , c % first ) hi = min ( i2 , c % first + c % capacity - 1 ) if ( lo > hi ) return call line_buffer ( c % line , all ) if ( associated ( all )) p => all (:, :, lo - c % first + 1 : hi - c % first + 1 ) end associate end subroutine slice !> As `slice`, for the colors of a colored chain: c(rgba, point) of points !> lo .. hi of chunk j (null if not colored or nothing there). subroutine color_slice ( self , j , i1 , i2 , lo , hi , c ) class ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: j , i1 , i2 integer , intent ( out ) :: lo , hi !! chain indices (lo > hi: none) real ( c_float ), dimension (:,:), pointer , intent ( out ) :: c !! (4, hi-lo+1): [r, g, b, a] real ( c_float ), dimension (:,:), pointer :: all integer ( c_int ) :: capacity type ( c_ptr ) :: data c => null () associate ( k => self % chunks ( j )) lo = max ( i1 , k % first ) hi = min ( i2 , k % first + k % capacity - 1 ) if ( lo > hi . or . . not . self % colored ) return data = vkf_line_colors ( k % line , capacity ) if (. not . c_associated ( data )) return call c_f_pointer ( data , all , [ 4 , int ( capacity )]) c => all (:, lo - k % first + 1 : hi - k % first + 1 ) end associate end subroutine color_slice !> Chunks moved to a new array (their level-of-detail bounds moved, not copied). subroutine move_chunks ( from , to ) type ( LineChunk ), intent ( inout ) :: from (:), to (:) integer :: i , k do i = 1 , size ( from ) to ( i )% line = from ( i )% line to ( i )% first = from ( i )% first to ( i )% capacity = from ( i )% capacity to ( i )% box_lo = from ( i )% box_lo to ( i )% box_hi = from ( i )% box_hi to ( i )% n_written = from ( i )% n_written do k = 1 , lod_levels if ( allocated ( from ( i )% lod ( k )% bound )) call move_alloc ( from ( i )% lod ( k )% bound , to ( i )% lod ( k )% bound ) end do end do end subroutine move_chunks !> Points i1 .. i2 were written: measure a strip's distances along it (from !> the distance at point i1-1), update its level of detail, and upload the !> chunks holding them. `x`: the points in double precision, x(:, i) for !> chain point i (at least i1-1 .. i2), to measure from; without it, from !> the floats written. (i2 is the last point written in the chain.) subroutine written ( self , i1 , i2 , x ) class ( LineChain ), intent ( inout ) :: self integer , intent ( in ) :: i1 , i2 real ( wp ), intent ( in ), optional :: x (:,:) !! (3, at least i1-1 .. i2): the points integer :: j , lo , hi do j = 1 , self % n_chunks associate ( c => self % chunks ( j )) lo = max ( i1 , c % first ) hi = min ( i2 , c % first + c % capacity - 1 ) if ( lo > hi ) cycle if ( self % kind == CHAIN_STRIP ) then call measure ( self , j , lo , hi , x ) call update_lod ( self , j , lo , hi , x ) end if call check_status ( vkf_line_points_changed ( c % line , int ( hi - c % first + 1 , c_int )), 'trajectory artists' ) end associate end do end subroutine written !> The distances along the strip of points lo .. hi of chunk j: from the !> previous point (in this chunk; the first point of a chunk after the !> first is the previous chunk's last, measured before), or 0 at point 1. !> From `x` (as in `written`) if given, else from the floats written. subroutine measure ( self , j , lo , hi , x ) type ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: j , lo , hi real ( wp ), intent ( in ), optional :: x (:,:) real ( c_float ), dimension (:,:,:), pointer :: p , prev real ( wp ), allocatable :: xf (:,:), s (:) integer :: k0 , k1 , k , g call line_buffer ( self % chunks ( j )% line , p ) if (. not . associated ( p )) return k1 = hi - self % chunks ( j )% first + 1 ! local indices k0 .. k1 k0 = lo - self % chunks ( j )% first + 1 if ( lo > 1 . and . k0 > 1 ) k0 = k0 - 1 ! from the point before allocate ( s ( k0 : k1 )) if ( lo == 1 ) then s ( k0 ) = 0.0_wp else if ( k0 == lo - self % chunks ( j )% first + 1 ) then ! the chunk's first point: shared with the previous call line_buffer ( self % chunks ( j - 1 )% line , prev ) k = self % chunks ( j )% first - self % chunks ( j - 1 )% first + 1 s ( k0 ) = real ( prev ( 4 , 1 , k ), wp ) + real ( prev ( 4 , 2 , k ), wp ) else s ( k0 ) = real ( p ( 4 , 1 , k0 ), wp ) + real ( p ( 4 , 2 , k0 ), wp ) end if if ( present ( x )) then ! (one pass, no temporary arrays) g = self % chunks ( j )% first - 1 ! chain index = g + local index do k = k0 + 1 , k1 s ( k ) = s ( k - 1 ) + norm2 ( x (:, g + k ) - x (:, g + k - 1 )) end do else xf = real ( p ( 1 : 3 , 1 , k0 : k1 ), wp ) + real ( p ( 1 : 3 , 2 , k0 : k1 ), wp ) s ( k0 + 1 : k1 ) = norm2 ( xf (:, 2 :) - xf (:, : k1 - k0 ), dim = 1 ) do k = k0 + 1 , k1 s ( k ) = s ( k - 1 ) + s ( k ) end do end if call split_distances ( s , p ( 4 , :, k0 : k1 )) end subroutine measure !> Points lo .. hi of chunk j (a strip's) were written, the last being hi: !> update the bounding box and the error bounds of the segments they change !> at each stride, and give them to the renderer. `x` as in `written`. subroutine update_lod ( self , j , lo , hi , x ) type ( LineChain ), intent ( inout ) :: self integer , intent ( in ) :: j , lo , hi real ( wp ), intent ( in ), optional :: x (:,:) real ( c_float ), dimension (:,:,:), pointer :: p real ( wp ) :: b0 , b1 , q ( 3 ) integer :: n , q0 , k , s , m , seg , a , e , mid , i associate ( c => self % chunks ( j )) call line_buffer ( c % line , p ) if (. not . associated ( p )) return n = hi - c % first + 1 ! points written in the chunk (local 0 .. n-1) c % n_written = n q0 = lo - c % first ! the first one written now do i = q0 , n - 1 ! the bounding box q = pt ( i ) if ( i == 0 ) then c % box_lo = q c % box_hi = q else c % box_lo = min ( c % box_lo , q ) c % box_hi = max ( c % box_hi , q ) end if end do do k = 1 , lod_levels s = 2 ** k m = 0 if ( n >= 2 ) m = ( n - 2 ) / s + 1 ! segments at stride s if ( m == 0 ) exit if (. not . allocated ( c % lod ( k )% bound )) allocate ( c % lod ( k )% bound ( 0 :( c % capacity - 2 ) / s )) do seg = max ( 0 , q0 - 1 ) / s , m - 1 ! the segments the points written change a = seg * s e = min ( a + s , n - 1 ) mid = a + s / 2 b0 = 0.0_wp ! the halves' bounds (none at stride 1) b1 = 0.0_wp if ( k > 1 ) b0 = c % lod ( k - 1 )% bound ( 2 * seg ) if ( mid < e ) then ! two halves: also the middle point's distance if ( k > 1 ) b1 = c % lod ( k - 1 )% bound ( 2 * seg + 1 ) c % lod ( k )% bound ( seg ) = real ( max ( b0 , b1 ) + segment_distance ( pt ( mid ), pt ( a ), pt ( e )), c_float ) else c % lod ( k )% bound ( seg ) = real ( b0 , c_float ) end if end do end do end associate call send_lod ( self , j ) contains !> Local point i of the chunk, in double precision. function pt ( i ) result ( v ) integer , intent ( in ) :: i real ( wp ) :: v ( 3 ) if ( present ( x )) then v = x (:, self % chunks ( j )% first + i ) else v = real ( p ( 1 : 3 , 1 , i + 1 ), wp ) + real ( p ( 1 : 3 , 2 , i + 1 ), wp ) end if end function pt end subroutine update_lod !> Give chunk j's level of detail to the renderer (none if switched off). subroutine send_lod ( self , j ) type ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: j associate ( c => self % chunks ( j )) call check_status ( vkf_line_set_lod ( c % line , 0.5_wp * ( c % box_lo + c % box_hi ), 0.5_wp * norm2 ( c % box_hi - c % box_lo ), & self % lod_error ( j ), merge ( int ( lod_levels , c_int ), 0_c_int , self % lod )), 'trajectory artists' ) end associate end subroutine send_lod !> Level of detail on (the default: seen from far away, a strip is drawn !> from fewer points, within half a pixel of all of them) or off (every !> point drawn). subroutine set_lod ( self , enabled ) class ( LineChain ), intent ( inout ) :: self logical , intent ( in ) :: enabled integer :: j self % lod = enabled if ( self % kind /= CHAIN_STRIP ) return do j = 1 , self % n_chunks call send_lod ( self , j ) end do end subroutine set_lod !> Chunk j's error bounds: how far the points skipped can be from the !> segments drawn at stride 2&#94;k (k = 1 .. lod_levels; 0 where not known). function lod_error ( self , j ) result ( error ) class ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: j real ( c_float ) :: error ( lod_levels ) integer :: k , n , m error = 0.0_c_float if ( j < 1 . or . j > self % n_chunks ) return n = 0 do k = 1 , lod_levels if (. not . allocated ( self % chunks ( j )% lod ( k )% bound )) exit if ( k == 1 ) n = self % chunks ( j )% n_written m = 0 if ( n >= 2 ) m = ( n - 2 ) / 2 ** k + 1 if ( m > 0 ) error ( k ) = maxval ( self % chunks ( j )% lod ( k )% bound ( 0 : m - 1 )) end do end function lod_error !> Distance from point v to the segment from a to b. pure real ( wp ) function segment_distance ( v , a , b ) result ( d ) real ( wp ), intent ( in ) :: v ( 3 ), a ( 3 ), b ( 3 ) real ( wp ) :: ab ( 3 ), t , len2 ab = b - a len2 = dot_product ( ab , ab ) t = 0.0_wp if ( len2 > 0.0_wp ) t = max ( 0.0_wp , min ( 1.0_wp , dot_product ( v - a , ab ) / len2 )) d = norm2 ( v - ( a + t * ab )) end function segment_distance !> Draw points 1 .. k (no upload). subroutine draw ( self , k ) class ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: k call self % draw_range ( 1 , k ) end subroutine draw !> Draw points i1 .. i2 only (chain indices; none if i2 < i1): e.g. a trace !> of decreasing times, its last points. subroutine draw_range ( self , i1 , i2 ) class ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: i1 , i2 integer :: j , lo , hi do j = 1 , self % n_chunks associate ( c => self % chunks ( j )) lo = max ( i1 , c % first ) hi = min ( i2 , c % first + c % capacity - 1 ) if ( hi >= lo ) then call check_status ( vkf_line_set_range ( c % line , int ( lo - c % first + 1 , c_int ), int ( hi - lo + 1 , c_int )), & 'trajectory artists' ) else call check_status ( vkf_line_set_range ( c % line , 1_c_int , 0_c_int ), 'trajectory artists' ) end if end associate end do end subroutine draw_range !> For lines, a dash pattern (see line_set_pattern; z'FFFF' solid). subroutine set_pattern ( self , factor , pattern ) class ( LineChain ), intent ( inout ) :: self integer , intent ( in ) :: factor !! repeat count of each bit of the pattern integer , intent ( in ) :: pattern !! 16-bit dash pattern (z'FFFF': solid) integer :: j self % pattern_factor = factor self % pattern = pattern do j = 1 , self % n_chunks call apply_style ( self , self % chunks ( j )% line ) end do end subroutine set_pattern !> Color (rgba) and width (window units) of the whole chain. subroutine set_style ( self , color , width ) class ( LineChain ), intent ( inout ) :: self real ( wp ), intent ( in ) :: color ( 4 ) !! [r, g, b, a] (0 to 1) real ( wp ), intent ( in ) :: width !! (window units) integer :: j self % color = real ( color , c_float ) self % width = real ( width , c_float ) do j = 1 , self % n_chunks call apply_style ( self , self % chunks ( j )% line ) end do end subroutine set_style !> For lines, the highlight (see shaders/line.vert): `flags` (1 pulse, 2 !> arrows; 0 none), its color (rgba), the arrows' spacing and speed (window !> units, and per second), the band's width (window units) and the pulse's !> period (s). subroutine set_highlight ( self , flags , color , spacing , speed , band , period ) class ( LineChain ), intent ( inout ) :: self integer , intent ( in ) :: flags !! 1 pulse + 2 arrows (0: none) real ( wp ), intent ( in ) :: color ( 4 ) !! [r, g, b, a] (0 to 1) real ( wp ), intent ( in ) :: spacing !! between arrows (window units) real ( wp ), intent ( in ) :: speed !! of the arrows (window units per second) real ( wp ), intent ( in ) :: band !! width of the band the arrows are drawn in (window units) real ( wp ), intent ( in ) :: period !! of the pulse (s) integer :: j self % highlight = real ([ color , real ( flags , wp ), spacing , speed , band , period , 0.0_wp , 0.0_wp , 0.0_wp ], & c_float ) do j = 1 , self % n_chunks call apply_style ( self , self % chunks ( j )% line ) end do end subroutine set_highlight !> For strips, the trail (see vkf_line_set_trail: 20 values; the third 0: !> none), given to every chunk (changed every frame the time does: a few !> floats per chunk uploaded). subroutine set_trail ( self , values ) class ( LineChain ), intent ( inout ) :: self real ( c_float ), intent ( in ) :: values ( 20 ) integer :: j self % trail = values if ( self % kind /= CHAIN_STRIP ) return do j = 1 , self % n_chunks call check_status ( vkf_line_set_trail ( self % chunks ( j )% line , self % trail ), 'trajectory artists' ) end do end subroutine set_trail !> For lines, how the dashes are laid out: 0 anchored to the line (the !> default), 1 screen-locked (a constant length in pixels, following the !> line on screen), 2 a fixed length of the line (strips): `length` scene !> units for the pattern, or if 0 its length on screen when first drawn. subroutine set_dash_mode ( self , mode , length ) class ( LineChain ), intent ( inout ) :: self integer , intent ( in ) :: mode real ( wp ), intent ( in ) :: length integer :: j self % dash_mode = mode self % dash_length = length do j = 1 , self % n_chunks call apply_style ( self , self % chunks ( j )% line ) end do end subroutine set_dash_mode !> The dashes' layout (set_dash_mode). pure integer function dash_mode_of ( self ) class ( LineChain ), intent ( in ) :: self dash_mode_of = self % dash_mode end function dash_mode_of !> Give the chain's style to `line`, a node not in the chain (e.g. a !> curve's trace-mode tail, drawn as part of it). subroutine style_node ( self , line ) class ( LineChain ), intent ( in ) :: self type ( c_ptr ), intent ( in ) :: line call apply_style ( self , line ) end subroutine style_node !> For markers, the color (rgba), size (window units), shape (shaders/marker.frag) !> and attenuation radius (scene units, 0 for none). subroutine set_marker_style ( self , color , size , shape , radius ) class ( LineChain ), intent ( inout ) :: self real ( wp ), intent ( in ) :: color ( 4 ) !! [r, g, b, a] (0 to 1) real ( wp ), intent ( in ) :: size !! (window units) real ( wp ), intent ( in ) :: radius !! attenuation radius (scene units; 0: none) integer , intent ( in ) :: shape !! marker shape (shaders/marker.frag) integer :: j self % color = real ( color , c_float ) self % width = real ( size , c_float ) self % shape = shape self % radius = real ( radius , c_float ) do j = 1 , self % n_chunks call apply_style ( self , self % chunks ( j )% line ) end do end subroutine set_marker_style !> Give the chain's style (color, width or size, pattern, highlight, marker shape) to the node `line`. subroutine apply_style ( self , line ) type ( LineChain ), intent ( in ) :: self type ( c_ptr ), intent ( in ) :: line if ( self % kind == CHAIN_MARKERS ) then call check_status ( marker_set_style ( line , self % color , self % width , self % shape , self % radius ), 'trajectory artists' ) else call check_status ( line_set_style ( line , self % color , self % width ), 'trajectory artists' ) call check_status ( line_set_pattern ( line , self % pattern_factor , self % pattern ), 'trajectory artists' ) if ( self % kind /= CHAIN_RIBBON ) & call check_status ( vkf_line_set_highlight ( line , self % highlight ), 'trajectory artists' ) if ( self % kind == CHAIN_STRIP ) call check_status ( vkf_line_set_trail ( line , self % trail ), 'trajectory artists' ) if ( self % kind /= CHAIN_RIBBON ) call check_status ( vkf_line_set_dash_mode ( line , & int ( self % dash_mode , c_int ), real ( self % dash_length , c_double )), & 'trajectory artists' ) end if end subroutine apply_style !> Chunk j's points (strips: first .. first + n - 1 of the chain) and the !> bounding box of them (n = 0 if none are measured yet), e.g. to skip a !> chunk when picking. subroutine chunk_bounds ( self , j , first , n , lo , hi ) class ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: j integer , intent ( out ) :: first , n real ( wp ), intent ( out ) :: lo ( 3 ), hi ( 3 ) !! the bounding box's corners first = self % chunks ( j )% first n = self % chunks ( j )% n_written lo = self % chunks ( j )% box_lo hi = self % chunks ( j )% box_hi end subroutine chunk_bounds !> Point i as written: read back from the buffers (zero if not held). function point ( self , i ) result ( v ) class ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: i real ( wp ) :: v ( 3 ) real ( c_float ), dimension (:,:,:), pointer :: p integer :: j v = 0.0_wp do j = 1 , self % n_chunks associate ( c => self % chunks ( j )) if ( i < c % first . or . i > c % first + c % capacity - 1 ) cycle call line_buffer ( c % line , p ) if ( associated ( p )) v = real ( p ( 1 : 3 , 1 , i - c % first + 1 ), wp ) + real ( p ( 1 : 3 , 2 , i - c % first + 1 ), wp ) return end associate end do end function point !> The color of point i of a colored chain, as stored (rgba; white if not colored). function point_color ( self , i ) result ( rgba ) class ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: i real ( wp ) :: rgba ( 4 ) real ( c_float ), dimension (:,:), pointer :: c integer :: j , lo , hi rgba = 1.0_wp do j = 1 , self % n_chunks call self % color_slice ( j , i , i , lo , hi , c ) if ( associated ( c )) then rgba = real ( c (:, 1 ), wp ) return end if end do end function point_color !> A strip's distance along it at point i, as written. function distance ( self , i ) result ( s ) class ( LineChain ), intent ( in ) :: self integer , intent ( in ) :: i real ( wp ) :: s real ( c_float ), dimension (:,:,:), pointer :: p integer :: j s = 0.0_wp do j = 1 , self % n_chunks associate ( c => self % chunks ( j )) if ( i < c % first . or . i > c % first + c % capacity - 1 ) cycle call line_buffer ( c % line , p ) if ( associated ( p )) s = real ( p ( 4 , 1 , i - c % first + 1 ), wp ) + real ( p ( 4 , 2 , i - c % first + 1 ), wp ) return end associate end do end function distance !> Points x(3, n) into p(xyz and distance, high/low, n): the floats !> nearest, and the rest (the distances are left as they are). pure subroutine split_points ( x , p ) real ( wp ), intent ( in ) :: x (:,:) !! (3, n) real ( c_float ), intent ( inout ) :: p (:,:,:) !! (4, 2, n) p ( 1 : 3 , 1 , :) = real ( x , c_float ) p ( 1 : 3 , 2 , :) = real ( x - real ( p ( 1 : 3 , 1 , :), wp ), c_float ) end subroutine split_points !> Distances s(n) into d(high/low, n). pure subroutine split_distances ( s , d ) real ( wp ), intent ( in ) :: s (:) !! (n) real ( c_float ), intent ( inout ) :: d (:,:) !! (2, n) d ( 1 , :) = real ( s , c_float ) d ( 2 , :) = real ( s - real ( d ( 1 , :), wp ), c_float ) end subroutine split_distances !> The point buffer of a line or marker node: (xyz and distance, high/low, !> point). subroutine line_buffer ( line , p ) type ( c_ptr ), intent ( in ) :: line real ( c_float ), dimension (:,:,:), pointer , intent ( out ) :: p !! (4, 2, capacity); null if none integer ( c_int ) :: capacity type ( c_ptr ) :: data p => null () data = vkf_line_points ( line , capacity ) if ( c_associated ( data )) call c_f_pointer ( data , p , [ 4 , 2 , int ( capacity )]) end subroutine line_buffer end module vkf_line_chain","tags":"","url":"sourcefile/vkf_line_chain.f90.html"},{"title":"vkf_geometry.f90 – vkframes","text":"This file depends on sourcefile~~vkf_geometry.f90~~EfferentGraph sourcefile~vkf_geometry.f90 vkf_geometry.f90 sourcefile~vkf_layer.f90 vkf_layer.f90 sourcefile~vkf_geometry.f90->sourcefile~vkf_layer.f90 sourcefile~vkf_math.f90 vkf_math.f90 sourcefile~vkf_geometry.f90->sourcefile~vkf_math.f90 Help Graph Key Nodes of 