ata ( self ) class ( TrajectoryFollower ), intent ( inout ) :: self if ( self % n > 0 ) then self % sources_ = position_sources ( self % trajs ( 1 )% p % dof ()) else self % sources_ = position_sources ( 0 ) end if self % default_data = . true . end subroutine set_default_data","tags":"","url":"proc/set_default_data.html"},{"title":"set_follow_type – vkframes","text":"private  subroutine set_follow_type(self, data, mode) What to follow (FOLLOW_POSITION and/or FOLLOW_ATTITUDE, combined with\nior) and how (FOLLOW_LOOP or FOLLOW_LIMIT). Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self integer, intent(in) :: data FOLLOW_POSITION and/or FOLLOW_ATTITUDE (ior) integer, intent(in) :: mode FOLLOW_LOOP or FOLLOW_LIMIT Called by proc~~set_follow_type~~CalledByGraph proc~set_follow_type TrajectoryFollower%set_follow_type proc~follow ReferenceFrame%follow proc~follow->proc~set_follow_type Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_follow_type ( self , data , mode ) class ( TrajectoryFollower ), intent ( inout ) :: self integer , intent ( in ) :: data !! FOLLOW_POSITION and/or FOLLOW_ATTITUDE (ior) integer , intent ( in ) :: mode !! FOLLOW_LOOP or FOLLOW_LIMIT self % data_ = data self % mode_ = mode end subroutine set_follow_type","tags":"","url":"proc/set_follow_type.html"},{"title":"set_offset_time – vkframes","text":"private  subroutine set_offset_time(self, offset) Follow at the simulation time plus offset (the default, offset 0). Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self real(kind=wp), intent(in) :: offset added to the simulation time (s) Source Code subroutine set_offset_time ( self , offset ) class ( TrajectoryFollower ), intent ( inout ) :: self real ( wp ), intent ( in ) :: offset !! added to the simulation time (s) self % time_value = offset self % follow_time = . true . end subroutine set_offset_time","tags":"","url":"proc/set_offset_time.html"},{"title":"set_time – vkframes","text":"private  subroutine set_time(self, t) Follow at a fixed time (independent of the simulation time). Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self real(kind=wp), intent(in) :: t the time (s) Source Code subroutine set_time ( self , t ) class ( TrajectoryFollower ), intent ( inout ) :: self real ( wp ), intent ( in ) :: t !! the time (s) self % time_value = t self % follow_time = . false . end subroutine set_time","tags":"","url":"proc/set_time.html"},{"title":"set_trajectory – vkframes","text":"private  subroutine set_trajectory(self, traj) Follow only traj (none if it is not associated). Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self type( Trajectory ), intent(in), pointer :: traj Calls proc~~set_trajectory~~CallsGraph proc~set_trajectory TrajectoryFollower%set_trajectory proc~add_trajectory TrajectoryFollower%add_trajectory proc~set_trajectory->proc~add_trajectory proc~remove_all TrajectoryFollower%remove_all proc~set_trajectory->proc~remove_all proc~set_default_data TrajectoryFollower%set_default_data proc~add_trajectory->proc~set_default_data proc~dof Trajectory%dof proc~set_default_data->proc~dof proc~position_sources position_sources proc~set_default_data->proc~position_sources Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~set_trajectory~~CalledByGraph proc~set_trajectory TrajectoryFollower%set_trajectory proc~follow ReferenceFrame%follow proc~follow->proc~set_trajectory Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_trajectory ( self , traj ) class ( TrajectoryFollower ), intent ( inout ) :: self type ( Trajectory ), pointer , intent ( in ) :: traj call self % remove_all () if ( associated ( traj )) call self % add_trajectory ( traj ) end subroutine set_trajectory","tags":"","url":"proc/set_trajectory.html"},{"title":"update – vkframes","text":"private  subroutine update(self, sim_time, position, attitude, has_position, has_attitude) The position and attitude at simulation time sim_time . has_position and has_attitude say whether each could be computed (and is being\nfollowed); otherwise position / attitude are left unchanged. Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(inout) :: self real(kind=wp), intent(in) :: sim_time simulation time (s) real(kind=wp), intent(inout) :: position (3) the followed position (in the trajectories' frame) real(kind=wp), intent(inout) :: attitude (4) the followed attitude (quaternion [x, y, z, w]) logical, intent(out) :: has_position logical, intent(out) :: has_attitude Calls proc~~update~~CallsGraph proc~update TrajectoryFollower%update proc~chosen_trajectory chosen_trajectory proc~update->proc~chosen_trajectory proc~data_valid TrajectoryFollower%data_valid proc~update->proc~data_valid proc~interpolate_attitude interpolate_attitude proc~update->proc~interpolate_attitude proc~interpolate_position interpolate_position proc~update->proc~interpolate_position proc~time_index Trajectory%time_index proc~update->proc~time_index proc~wrapped_time wrapped_time proc~update->proc~wrapped_time proc~time_distance Trajectory%time_distance proc~chosen_trajectory->proc~time_distance proc~verify_data Trajectory%verify_data proc~data_valid->proc~verify_data proc~attitude~2 Trajectory%attitude proc~interpolate_attitude->proc~attitude~2 proc~num_attitudes Trajectory%num_attitudes proc~interpolate_attitude->proc~num_attitudes proc~quat_slerp quat_slerp proc~interpolate_attitude->proc~quat_slerp proc~num_points Trajectory%num_points proc~interpolate_position->proc~num_points proc~point Trajectory%point proc~interpolate_position->proc~point proc~point_between Trajectory%point_between proc~interpolate_position->proc~point_between proc~time_index->proc~time_distance proc~time_range Trajectory%time_range proc~wrapped_time->proc~time_range proc~point_between->proc~num_points proc~point_between->proc~point proc~time_fraction Trajectory%time_fraction proc~point_between->proc~time_fraction Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~update~~CalledByGraph proc~update TrajectoryFollower%update proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine update ( self , sim_time , position , attitude , has_position , has_attitude ) class ( TrajectoryFollower ), intent ( inout ) :: self real ( wp ), intent ( in ) :: sim_time !! simulation time (s) real ( wp ), intent ( inout ) :: position ( 3 ) !! the followed position (in the trajectories' frame) real ( wp ), intent ( inout ) :: attitude ( 4 ) !! the followed attitude (quaternion [x, y, z, w]) logical , intent ( out ) :: has_position , has_attitude type ( Trajectory ), pointer :: traj real ( wp ) :: t integer :: status , i has_position = . false . has_attitude = . false . if ( self % n == 0 ) return if ( self % follow_time ) then t = sim_time + self % time_value else t = self % time_value end if t = wrapped_time ( self , t ) self % last_time_ = t self % current = chosen_trajectory ( self , t ) traj => self % trajs ( self % current )% p status = traj % time_index ( t , i ) ! (once, for the position and the attitude) if ( iand ( self % data_ , FOLLOW_POSITION ) /= 0 . and . self % data_valid ()) & call interpolate_position ( traj , self % sources_ , t , status , i , position , has_position ) if ( iand ( self % data_ , FOLLOW_ATTITUDE ) /= 0 ) & call interpolate_attitude ( traj , t , status , i , attitude , has_attitude ) end subroutine update","tags":"","url":"proc/update.html"},{"title":"pick_camera – vkframes","text":"public pure function pick_camera(eye, center, up, perspective, fovy, aspect, ortho, width, height, x, y, tolerance) result(cam) The camera of a pick: eye, center and up (root frame), a perspective\nprojection ( fovy , degrees, and aspect ) or an orthographic one\n( ortho : left, right, bottom, top), a viewport of width x height framebuffer pixels, the cursor (x, y: -1 to 1, y up) and the tolerance\n(framebuffer pixels). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: eye (3) the camera (root frame) real(kind=wp), intent(in) :: center (3) the camera (root frame) real(kind=wp), intent(in) :: up (3) the camera (root frame) logical, intent(in) :: perspective (true: perspective; false: orthographic) real(kind=wp), intent(in) :: fovy vertical field of view (degrees; perspective) real(kind=wp), intent(in) :: aspect width / height (perspective) real(kind=wp), intent(in) :: ortho (4) left, right, bottom, top (orthographic) integer, intent(in) :: width the viewport (framebuffer pixels) integer, intent(in) :: height the viewport (framebuffer pixels) real(kind=wp), intent(in) :: x the cursor (-1 to 1, y up) real(kind=wp), intent(in) :: y the cursor (-1 to 1, y up) real(kind=wp), intent(in) :: tolerance (framebuffer pixel