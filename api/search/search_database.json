t ), allocatable , intent ( inout ) :: hits (:) !! hits so far (grown as needed) integer , intent ( inout ) :: n !! number of hits in hits type ( PickHit ) :: h real ( wp ) :: origin ( 3 ), dir ( 3 ), along , local ( 3 ), normal ( 3 ) hit = . false . if (. not . wants ( cam , PICK_BODY )) return call ray ( cam , origin , dir ) hit = ray_ellipsoid ( origin , dir , matmul ( to_root ( 1 : 3 , 1 : 3 ), center ) + to_root ( 1 : 3 , 4 ), & matmul ( to_root ( 1 : 3 , 1 : 3 ), axes ), radii , along , h % position , local ) if ( hit ) hit = dot_product ( h % position - cam % eye , cam % forward ) <= cam % max_depth if (. not . hit ) return h % kind = PICK_BODY h % frame => self h % local = matmul ( transpose ( to_root ( 1 : 3 , 1 : 3 )), h % position - to_root ( 1 : 3 , 4 )) h % distance = dot_product ( h % position - cam % eye , cam % forward ) h % pixels = 0.0_wp if ( geodetic ) then normal = local / radii ** 2 ! (the surface normal there) h % latitude = asin ( max ( - 1.0_wp , min ( 1.0_wp , normal ( 3 ) / norm2 ( normal )))) h % longitude = atan2 ( normal ( 2 ), normal ( 1 )) end if call add_pick_hit ( hits , n , h ) end function pick_ellipsoid","tags":"","url":"proc/pick_ellipsoid.html"},{"title":"pickable – vkframes","text":"private pure function pickable(self) Whether pick tests what this frame draws ( set_pickable ). Type Bound ReferenceFrame Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical Called by proc~~pickable~~CalledByGraph proc~pickable ReferenceFrame%pickable proc~window_pick WindowProxy%window_pick proc~window_pick->proc~pickable proc~hover_handle hover_handle proc~hover_handle->proc~window_pick proc~dispatch_event dispatch_event proc~dispatch_event->proc~hover_handle proc~release_handle release_handle proc~dispatch_event->proc~release_handle proc~release_handle->proc~hover_handle proc~dispatch_events dispatch_events proc~dispatch_events->proc~dispatch_event proc~frame WindowProxy%frame proc~fram