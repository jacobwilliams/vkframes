ent Optional Attributes Name class( Polyhedron ), intent(inout) :: self integer, intent(in) :: edges (:,:) procedure, public :: set_face_color private  subroutine set_face_color (self, color) The faces' color (the alpha times the opacity). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) procedure, public :: set_faces private  subroutine set_faces (self, vertices, faces, sizes) Faces given as polygons: faces the vertex numbers (1-based) of each\npolygon in turn, sizes how many each has (>= 3; convex, or at least\nstar-shaped from its first vertex: drawn as a fan of triangles from\nit); the edges are the polygons' sides. E.g. a cube: 8 vertices, 6\nfaces of 4. A face's front: its vertices counterclockwise. Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: vertices (:,:) (3, n), frame coordinates integer, intent(in) :: faces (:) (sum(sizes)) vertex numbers integer, intent(in) :: sizes (:) each face's number of vertices procedure, public :: set_grid private  subroutine set_grid (self, points, closed_u, closed_v, lines) Faces given as a grid of points (3, nu, nv): quadrilaterals between\nneighbours (two triangles each), joined around if closed_u (the last\npoint i to the first, for each j; e.g. a tube's circumference) or closed_v . The edges: the grid's lines, those of constant i (along j)\nevery lines(1) and of constant j (along i) every lines(2) (default:\nevery one; 0 for none). Arguments Type Intent Optional Attributes Name class( Polyhedron ), intent(inout) :: self real(kind=wp), intent(in) :: points (:,:,:) (3, nu, nv), frame coordinates logical, intent(in), optional :: closed_u logical, intent(in), optional :: closed_v integer, intent(in), optional :: lines (2) procedure, public :: set_label_alignment private  subroutine set_label_alignment (self, alignment) The alignment of the labels relative to their positions (ALIGN_*;\ndefault ALIGN_LEFT_BASE_LINE). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: alignment procedure, public :: set_label_font private  subroutine set_label_font (self, font) The font of the labels: a font file name (found on the data search\npath) or a full path; default: the renderer's default font. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: font procedure, public :: set_label_size private  subroutine set_label_size (self, size) The size of the labels in pixels (default 20): the name label's size,\nand the maximum size of the axes labels (which shrink with distance). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: size procedure, public :: set_light_ambient private  subroutine set_light_ambient (self, rgb) The light source's ambient, diffuse and specular colors ([r, g, b], 0\nto 1; defaults 0.05, 0.8 and 0.05 gray). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_diffuse private  subroutine set_light_diffuse (self, rgb) The light source's diffuse color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_source_enabled private  subroutine set_light_source_enabled (self, enable) Whether this frame carries a light source: a point light at its origin\n(e.g. the Sun), not dimmed with distance (default false; OpenFrames'\nsetLightSourceEnabled). While any frame of a window's scene has one, the\nwindow's own light (WindowProxy%set_light_*) is off. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: enable