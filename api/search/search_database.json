e_node proc~make_star_node make_star_node proc~make_star_node->proc~make_name_node proc~set_star_names SkySphere%set_star_names proc~set_star_names->proc~make_name_node proc~node SkySphere%node proc~node->proc~make_star_node proc~set_star_data SkySphere%set_star_data proc~set_star_data->proc~make_star_node proc~set_sky WindowProxy%set_sky proc~set_sky->proc~node Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine make_name_node ( self ) type ( SkySphere ), intent ( inout ) :: self type ( c_ptr ) :: label integer :: i if ( c_associated ( self % name_node )) then call check_status ( vkf_node_remove_child ( self % star_switch , self % name_node ), 'SkySphere' ) call vkf_node_delete ( self % name_node ) self % name_node = c_null_ptr end if self % n_labels = 0 if (. not . self % names_shown . or . self % n_names == 0 ) return if (. not . allocated ( self % names_font )) self % names_font = '' self % name_node = vkf_transform_create () if (. not . c_associated ( self % name_node )) return do i = 1 , self % n_names if ( self % names ( i )% mag > self % names_max_mag ) cycle ! (two spaces: beside the star, not over it) label = label_create ( '  ' // self % names ( i )% text , real ( self % stars ( 1 : 3 , self % names ( i )% star ), wp ), & self % names_rgba , self % names_size , 0.0_wp , NAME_ALIGNMENT , self % names_font ) if (. not . c_associated ( label )) exit ! (no font: said) call check_status ( vkf_label_set_at_infinity ( label , 1_c_int ), 'SkySphere' ) call check_status ( vkf_node_add_child ( self % name_node , label ), 'SkySphere' ) call vkf_node_delete ( label ) ! (held by the node) self % n_labels = self % n_labels + 1 end do call apply_name_attitude ( self ) if ( self % shown ) call check_status ( vkf_compile_node ( self % name_node ), 'SkySphere' ) call check_status ( vkf_node_add_child ( self % star_switch , self % name_node ), 'SkySphere' ) call apply_mode ( self ) end subroutine make_name_node","tags":"","url":"proc/make_name_node.html"},{"title":"make_star_node – vkframes","text":"private  subroutine make_star_node(self) The star node for the current stars, in place of the old one. Arguments Type Intent Optional Attributes Name type( SkySphere ), intent(inout) :: self Calls proc~~make_star_node~~CallsGraph proc~make_star_node make_star_node interface~vkf_compile_node vkf_compile_node proc~make_star_node->interface~vkf_compile_node interface~vkf_node_add_child vkf_node_add_child proc~make_star_node->interface~vkf_node_add_child interface~vkf_node_delete vkf_node_delete proc~make_star_node->interface~vkf_node_delete interface~vkf_node_remove_child vkf_node_remove_child proc~make_star_node->interface~vkf_node_remove_child interface~vkf_sky_stars vkf_sky_stars proc~make_star_node->interface~vkf_sky_stars interface~vkf_sky_stars_changed vkf_sky_stars_changed proc~make_star_node->interface~vkf_sky_stars_changed interface~vkf_stars_create vkf_stars_create proc~make_star_node->interface~vkf_stars_create proc~apply_attitude apply_attitude proc~make_star_node->proc~apply_attitude proc~apply_mode apply_mode proc~make_star_node->proc~apply_mode proc~check_status check_status proc~make_star_node->proc~check_status proc~make_name_node make_name_node proc~make_star_node->proc~make_name_node proc~apply_attitude->proc~check_status interface~vkf_sky_style vkf_sky_style proc~apply_attitude->interface~vkf_sky_style interface~vkf_sky_style_changed vkf_sky_style_changed proc~apply_attitude->interface~vkf_sky_style