ents Type Intent Optional Attributes Name class( LineChain ), intent(in) :: self Return Value integer procedure, public :: detach private  subroutine detach (self) Remove the chunks from the group (also while running), and release them. Arguments Type Intent Optional Attributes Name class( LineChain ), intent(inout) :: self procedure, public :: distance private  function distance (self, i) result(s) A strip's distance along it at point i, as written. Arguments Type Intent Optional Attributes Name class( LineChain ), intent(in) :: self integer, intent(in) :: i Return Value real(kind=wp) procedure, public :: draw private  subroutine draw (self, k) Draw points 1 .. k (no upload). Arguments Type Intent Optional Attributes Name class( LineChain ), intent(in) :: self integer, intent(in) :: k procedure, public :: draw_range private  subroutine draw_range (self, i1, i2) Draw points i1 .. i2 only (chain indices; none if i2 < i1): e.g. a trace\nof decreasing times, its last points. Arguments Type Intent Optional Attributes Name class( LineChain ), intent(in) :: self integer, intent(in) :: i1 integer, intent(in) :: i2 procedure, public :: init private  subroutine init (self, group, kind, image, colored) Draw under group (a CHAIN_* kind; markers with image , a\nvkf_image_read handle, for the image shape). Chunks made later are\ncompiled once set_compile says so. Arguments Type Intent Optional Attributes Name class( LineChain ), intent(inout) :: self type(c_ptr), intent(in) :: group integer, intent(in) :: kind a CHAIN_* constant type(c_ptr), intent(in), optional :: image (markers: a vkf_image_read handle) logical, intent(in), optional :: colored (lines, markers: a color per point (color_slice)) procedure, public :: is_built private pure function is_built (self) True if the chain has a group to draw under (between init and release ). Arguments Type Intent Optional Attributes Name class( LineChain ), intent(in) :: self Return Value logical procedure, public :: is_colored private p