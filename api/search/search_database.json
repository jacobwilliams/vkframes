length , head_length , body_radius , head_radius ) result ( mesh ) real ( c_double ), intent ( in ) :: body_length !! the shaft's length (0: none) real ( c_double ), intent ( in ) :: head_length !! the head's length (0: a flat top) real ( c_double ), intent ( in ) :: body_radius !! the shaft's radius real ( c_double ), intent ( in ) :: head_radius !! the head's radius at its base type ( c_ptr ) :: mesh integer , parameter :: segments = 24 real ( c_float ), dimension (:,:), pointer :: xyz , normals , uv integer ( c_int32_t ), dimension (:), pointer :: indices integer :: n_vertices , n_indices call arrow_size ( segments , n_vertices , n_indices ) mesh = vkf_mesh_create ( int ( n_vertices , c_int ), int ( n_indices , c_int ), & [ 1.0_c_float , 1.0_c_float , 1.0_c_float , 1.0_c_float ], c_null_ptr , c_null_ptr , 2_c_int ) if (. not . c_associated ( mesh )) return call mesh_arrays ( mesh , n_vertices , n_indices , xyz , normals , uv , indices ) call arrow ([ 0.0_c_double , 0.0_c_double , 0.0_c_double ], [ 0.0_c_double , 0.0_c_double , 1.0_c_double ], & body_length , head_length , body_radius , head_radius , segments , xyz , normals , uv , indices ) end function unit_part","tags":"","url":"proc/unit_part.html"},{"title":"vector – vkframes","text":"private pure function vector(self) result(v) The vector (frame coordinates). Type Bound VectorHandle Arguments Type Intent Optional Attributes Name class( VectorHandle ), intent(in) :: self Return Value real(kind=wp), (3) Source Code function new_vector_handle ( name , vector , color , scale ) result ( h ) character ( len =* ), intent ( in ) :: name !! the frame's name real ( wp ), intent ( in ), optional :: vector ( 3 ) !! frame coordinates real ( wp ), intent ( in ), optional :: color (:) !! [r, g, b] or [r, g, b, a] (0 to 1) real ( wp ), intent ( in ), optional :: scale !! display scale (scene units per vector unit; > 0) type ( VectorHandle ) :: h h % ReferenceFrame = ReferenceFrame ( name , color ) call h % show_decorations 