ne_node ), 'SkySphere' ) call vkf_node_delete ( self % line_node ) self % line_node = c_null_ptr end if if ( self % lines_shown . and . self % n_lines > 0 ) then self % line_node = vkf_sky_lines_create ( int ( self % n_lines , c_int )) if ( c_associated ( self % line_node )) then data = vkf_sky_stars ( self % line_node , capacity ) if ( c_associated ( data )) then call c_f_pointer ( data , p , [ 8 , int ( capacity )]) p (:, 1 : self % n_lines ) = self % lines (:, 1 : self % n_lines ) call check_status ( vkf_sky_stars_changed ( self % line_node , int ( self % n_lines , c_int )), 'SkySphere' ) end if data = vkf_sky_style ( self % line_node ) if ( c_associated ( data )) then ! (the attitude: apply_attitude) call c_f_pointer ( data , style , [ 24 ]) style ( 17 : 24 ) = real ([ self % lines_width , 0.0_wp , 0.0_wp , 0.0_wp , self % lines_rgba ], c_float ) end if call apply_attitude ( self , self % line_node ) if ( self % shown ) call check_status ( vkf_compile_node ( self % line_node ), 'SkySphere' ) call check_status ( vkf_node_add_child ( self % line_switch , self % line_node ), 'SkySphere' ) end if end if call apply_mode ( self ) end subroutine make_line_node","tags":"","url":"proc/make_line_node.html"},{"title":"make_name_node – vkframes","text":"private  subroutine make_name_node(self) The star names node for the current names and settings, in place of the\nold one: a label per named star drawn up to the names' magnitude, under\nthe stars' switch (shown with them), turned by the sky's attitude. Arguments Type Intent Optional Attributes Name type( SkySphere ), intent(inout) :: self Calls proc~~make_name_node~~CallsGraph proc~make_name_node make_name_node interface~vkf_compile_node vkf_compile_node proc~make_name_node->interface~vkf_compile_node interface~vkf_label_set_at_infinity vkf_label_set_at_infinity proc~make_name_node->interface~vkf_label_set_at_infinity interface~vkf_node_add_child vkf_node_add_child proc~make_name_node->interface~vkf_node_add_child interface