um_colors","tags":"","url":"proc/num_colors.html"},{"title":"num_optionals – vkframes","text":"private pure function num_optionals(self) Number of optional vectors per position. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self Return Value integer Source Code pure integer function num_optionals ( self ) class ( Trajectory ), intent ( in ) :: self num_optionals = self % nopt_ end function num_optionals","tags":"","url":"proc/num_optionals.html"},{"title":"num_points – vkframes","text":"private pure function num_points(self, sources) Number of points available with these sources: the number of times,\nlimited by the positions or attitudes they use; huge() if all are zero. Type Bound Trajectory Arguments Type Intent Optional Attributes Name class( Trajectory ), intent(in) :: self type( DataSource ), intent(in) :: sources (3) Return Value integer Called by proc~~num_points~~CalledByGraph proc~num_points Trajectory%num_points proc~interpolate_position interpolate_position proc~interpolate_position->proc~num_points proc~point_between Trajectory%point_between proc~interpolate_position->proc~point_between proc~point_at Trajectory%point_at proc~point_at->proc~num_points proc~point_at->proc~point_between proc~point_between->proc~num_points proc~source_points source_points proc~source_points->proc~num_points proc~curve_points CurveArtist%curve_points proc~curve_points->proc~source_points proc~marker_pick marker_pick proc~marker_pick->proc~source_points proc~marker_update MarkerArtist%marker_update proc~marker_update->proc~source_points proc~ribbon_points RibbonArtist%ribbon_points proc~ribbon_points->proc~source_points proc~segment_count segment_count proc~segment_count->proc~source_points proc~trajectory_path_position TrajectoryPath%trajectory_path_position proc~trajectory_path_position->proc~point_at proc~update TrajectoryFollower%update proc~update->proc~interpolate_position proc~drawable_pick DrawableTrajectory%dr