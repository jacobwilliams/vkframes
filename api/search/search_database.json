class( View ), intent(inout) :: self real(kind=wp), intent(in) :: eye (3) real(kind=wp), intent(in) :: center (3) real(kind=wp), intent(in) :: up (3) Source Code subroutine set_default_view_parameters ( self , eye , center , up ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( in ) :: eye ( 3 ), center ( 3 ), up ( 3 ) self % default_eye = eye self % default_center = center self % default_up = up end subroutine set_default_view_parameters","tags":"","url":"proc/set_default_view_parameters.html"},{"title":"set_orthographic – vkframes","text":"private  subroutine set_orthographic(self, left, right, bottom, top) An orthographic projection with the given bounds (in view units). Type Bound View Arguments Type Intent Optional Attributes Name class( View ), intent(inout) :: self real(kind=wp), intent(in) :: left real(kind=wp), intent(in) :: right real(kind=wp), intent(in) :: bottom real(kind=wp), intent(in) :: top Source Code subroutine set_orthographic ( self , left , right , bottom , top ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( in ) :: left , right , bottom , top self % projection = ORTHOGRAPHIC self % ortho = [ left , right , bottom , top ] end subroutine set_orthographic","tags":"","url":"proc/set_orthographic.html"},{"title":"set_perspective – vkframes","text":"private  subroutine set_perspective(self, fovy) A perspective projection with vertical field of view fovy (degrees; default 45). Type Bound View Arguments Type Intent Optional Attributes Name class( View ), intent(inout) :: self real(kind=wp), intent(in) :: fovy vertical field of view (degrees) Source Code subroutine set_perspective ( self , fovy ) class ( View ), intent ( inout ) :: self real ( wp ), intent ( in ) :: fovy !! vertical field of view (degrees) self % projection = PERSPECTIVE self % fovy = fovy end subroutine set_perspective","tags":"","url":"proc/set_perspective.html"},{"title":"set_view_between_frames – vkframes","text":"private  subroutine set_view_between_frames(self, root, frame, lookat, frame_type, rotation_type) Look from frame at lookat (both in the tree of root ). Type Bound View Arguments Type Intent Optional Attributes Name class( View ), intent(inout) :: self class( ReferenceFrame ), intent(in), target :: root class( ReferenceFrame ), intent(in), target :: frame class( ReferenceFrame ), intent(in), target :: lookat integer, intent(in), optional :: frame_type ABSOLUTE_FRAME or RELATIVE_FRAME (default) integer, intent(in), optional :: rotation_type VIEW_DIRECT or VIEW_AZEL (default) Source Code subroutine set_view_between_frames ( self , root , frame , lookat , frame_type , rotation_type ) class ( View ), intent ( inout ) :: self class ( ReferenceFrame ), intent ( in ), target :: root , frame , lookat integer , intent ( in ), optional :: frame_type !! ABSOLUTE_FRAME or RELATIVE_FRAME (default) integer , intent ( in ), optional :: rotation_type !! VIEW_DIRECT or VIEW_AZEL (default) self % root => root self % frame => frame self % lookat => lookat self % frame_type = RELATIVE_FRAME self % rotation_type = VIEW_AZEL if ( present ( frame_type )) self % frame_type = frame_type if ( present ( rotation_type )) self % rotation_type = rotation_type end subroutine set_view_between_frames","tags":"","url":"proc/set_view_between_frames.html"},{"title":"set_view_frame – vkframes","text":"private  subroutine set_view_frame(self, root, frame, frame_type) View frame (in the tree of root ) with base frame_type (default RELATIVE_FRAME). Type Bound View Arguments Type Intent Optional Attributes Name class( View ), intent(inout) :: self class( ReferenceFrame ), intent(in), target :: root class( ReferenceFrame ), intent(in), target :: frame integer, intent(in), optional :: frame_type ABSOLUTE_FRAME or RELATIVE_FRAME Called by proc~~set_view_frame~~CalledByGraph proc~set_view_frame View%set_view_frame proc~place_camera place_camera proc~place_camera->proc~set_view_frame proc~frame WindowProxy%frame proc~frame->proc~place_camera proc~