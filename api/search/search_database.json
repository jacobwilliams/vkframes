, intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) private  subroutine set_name (self, name) The frame's name, shown by its name label (also once shown: e.g. a\nreadout that follows the frame). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: name private  subroutine set_name_label_on_top (self, on_top) Draw the name label on top of the scene (true: not hidden by bodies in\nfront of it, as HUD text; e.g. a readout) or depth-tested (false, the\ndefault, as OpenFrames'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: on_top private  subroutine set_pickable (self, pickable) Whether pick tests what this frame draws (default true; e.g. false\nfor an overlay such as a selection marker). Its children are picked or\nnot by their own setting. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: pickable private  subroutine set_position (self, position) Position relative to the parent frame (overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) parent frame's coordinates private  subroutine set_x_label (self, text) The text of the x-axis label (default 'X'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text private  subroutine set_y_label (self, text) The text of the y-axis label (default 'Y'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text private  subroutine set_z_label (self, text) The text of the z-axis label (default 'Z'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text private  subroutine show_axes (self, axes) Which axes vectors to show: NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined with ior. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: axes private  subroutine show_axes_labels (self, labels) Which axes labels to show (as show_axes ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: labels private  subroutine show_contents (self, show) Show or hide what the frame draws (its sphere, model, ...), but not its\naxes, labels or children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show private  subroutine show_decorations (self, show) Show (true) or hide all the frame's decorations at once: its axes,\ntheir labels and its name label (show_axes, show_axes_labels,\nshow_name_label). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show true: all axes, axes labels and the name label private  subroutine show_name_label (self, show) Show or hide the name label (at the frame's origin; default shown). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show (true: shown) private recursive subroutine sync (self) Copy the positions and attitudes of this frame and its descendants to\ntheir transform nodes (only those that changed since the last sync). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self private  subroutine unfollow (self) Stop following trajectories (the frame keeps its last position and attitude). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self private recursive subroutine update (self, t) Update this frame and its descendants for simulation time t (followed\ntrajectories set positions and attitudes). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time private  subroutine update_switches (self) Show or hide the decorations' switches as set. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self","tags":"","url":"module/vkf_frames.html"},{"title":"vkf_line_chain – vkframes","text":"A growing set of points drawn from a chain of GPU buffers (\"chunks\"), for\nthe trajectory artists: a line strip, separate segments (pairs of points),\nmarkers (one per point) or a ribbon (a translucent surface through pairs of\npoints: a quad between each pair and the next). Points are written in place, as (high, low)\nfloat pairs for double precision (see src/vsg/vkf_layer.cpp: EyeRelative),\nwith a strip's distance along it (for dash patterns, see shaders/line.vert;\nmeasured from the trajectory's points), and only the chunks written to are\nuploaded again. A full chain gets new chunks, each as large as the chain so\nfar or as what is needed at once, but at least min_chunk and at most\nmax_chunk points, so nothing is ever copied or reallocated, and changing a\npoint uploads at most max_chunk points again. In a strip, consecutive chunks\nshare their end point so that the line is continuous; in a ribbon, their\nend pair. Level of detail (strips): seen from far away, a dense trajectory is mostly\nsegments shorter than a pixel. For each chunk, the chain keeps the bounding\nsphere of its points and, for strides 2, 4, ... 2&#94;lod_levels, a bound on how\nfar the points skipped can be from the segments drawn (every stride-th point\nand the last), and gives them to the renderer (vkf_line_set_lod), which picks\nthe stride per view (src/vsg/vkf_layer.cpp: EyeRelative). The bounds are\nbuilt level by level: a segment at stride 2s is within the larger of its two\nhalves' bounds, plus its middle point's distance from it, of the points it\nskips (the halves' segments lie within that distance of it). They are\nupdated only for the segments the points written change. Writing points i1 .. i2 (indices along the whole chain): call chain % reserve ( i2 ) do j = 1 , chain % num_chunks () call chain % slice ( j , i1 , i2 , lo , hi , p ) ! p : points lo .. hi of chunk j if ( . not . associated ( p )) cycle ... fill p ( 1 : 3 , :, 1 : hi - lo + 1 ) ( e . g . with split_points ) ... end do call chain % written ( i1 , i2 ) ! measure ( strips ) and upload call chain % draw ( i2 ) Uses vkf_layer vkf_math iso_c_binding module~~vkf_line_chain~~UsesGraph module~vkf_line_chain vkf_line_chain iso_c_binding iso_c_binding module~vkf_line_chain->iso_c_binding module~vkf_layer vkf_layer module~vkf_line_chain->module~vkf_layer module~vkf_math vkf_math module~vkf_line_chain->module~vkf_math module~vkf_layer->iso_c_binding iso_fortran_env iso_fortran_env module~vkf_math->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~vkf_line_chain~~UsedByGraph module~vkf_line_chain vkf_line_chain module~vkf_artists vkf_artists module~vkf_artists->module~vkf_line_chain module~vkf_line_segments vkf_line_segments module~vkf_line_segments->module~vkf_line_chain module~vkf_handles vkf_handles module~vkf_handles->module~vkf_artists module~vkf_shapes vkf_shapes module~vkf_shapes->module~vkf_artists module~vkframes vkframes module~vkframes->module~vkf_artists module~vkframes->module~vkf_line_segments module~vkframes->module~vkf_handles module~vkframes->module~vkf_shapes module~vkf_window vkf_window module~vkframes->module~vkf_window module~vkf_window->module~vkf_handles Help Graph Key Nodes of different colours represent the following: Graph Key Module Module