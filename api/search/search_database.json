tions character ( len =* ), intent ( in ), optional :: file !! constellation file real ( wp ), intent ( in ), optional :: rgba ( 4 ) !! color [r, g, b, a] (0 to 1) real ( wp ), intent ( in ), optional :: width !! window units (> 0) ok = . true . if ( present ( width )) ok = width > 0.0_wp if (. not . ok ) return self % lines_shown = shown if ( present ( rgba )) self % lines_rgba = rgba if ( present ( width )) self % lines_width = width if ( present ( file )) then ok = read_constellations ( self , file ) else if ( shown . and . . not . allocated ( self % constellation_file )) then ok = read_constellations ( self , default_constellations ) end if if ( c_associated ( self % root )) call make_line_node ( self ) end function set_constellations","tags":"","url":"proc/set_constellations.html"},{"title":"set_star_data – vkframes","text":"private  function set_star_data(self, catalog, min_mag, max_mag, max_stars, min_size, max_size, min_dim_ratio) result(ok) Draw the stars of catalog (found with find_data_file; '' for none)\nwith magnitudes from min_mag to max_mag (default -2 to 8), at most max_stars (default 10000), sized from min_size to max_size window\nunits (default 1 to 10) by brightness, the smallest dimmed to min_dim_ratio (0 to 1, default 0.5) of their color (OpenFrames'\nsetSkySphereStarData). Returns false if the catalog cannot be read or the\nlimits are invalid (min_mag > max_mag, max_stars < 1, min_size >\nmax_size, a ratio outside 0 to 1). Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(inout) :: self character(len=*), intent(in) :: catalog star catalog file; '' for none real(kind=wp), intent(in), optional :: min_mag apparent magnitudes real(kind=wp), intent(in), optional :: max_mag apparent magnitudes integer, intent(in), optional :: max_stars real(kind=wp), intent(in), optional :: min_size window units real(kind=wp), intent(in), optional :: max_size window units real(kind=wp), intent(in), optional :: min_dim_rati