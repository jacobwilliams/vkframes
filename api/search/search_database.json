or show its imagery as it is. subroutine set_lighting ( self , lit ) class ( TerrainBody ), intent ( inout ) :: self logical , intent ( in ) :: lit self % lighting_ = lit call apply_settings ( self ) end subroutine set_lighting !> True if the body is lit by the scene's lights. pure logical function lighting ( self ) class ( TerrainBody ), intent ( in ) :: self lighting = self % lighting_ end function lighting !> Rocky's tiling profile ('': Rocky's default, the Earth). function profile ( self ) result ( p ) class ( TerrainBody ), intent ( in ) :: self character ( len = :), allocatable :: p p = self % profile_ end function profile !> Scene units per meter the body is drawn at. pure real ( wp ) function units_per_meter ( self ) class ( TerrainBody ), intent ( in ) :: self units_per_meter = self % units_per_meter_ end function units_per_meter","tags":"","url":"proc/units_per_meter.html"},{"title":"add_elevation_layer – vkframes","text":"private  subroutine add_elevation_layer(self, uri, source, encoding) Add an elevation layer: uri of a source kind (LAYER_ ; default\nLAYER_TMS), heights in meters or encoding (ELEVATION_ ; default\nELEVATION_HEIGHTS). Type Bound TerrainBody Arguments Type Intent Optional Attributes Name class( TerrainBody ), intent(inout) :: self character(len=*), intent(in) :: uri integer, intent(in), optional :: source a LAYER_* constant (default LAYER_TMS) integer, intent(in), optional :: encoding an ELEVATION_* constant (default ELEVATION_HEIGHTS) Calls proc~~add_elevation_layer~~CallsGraph proc~add_elevation_layer TerrainBody%add_elevation_layer proc~add_layer add_layer proc~add_elevation_layer->proc~add_layer proc~apply_layer apply_layer proc~add_layer->proc~apply_layer interface~vkf_rocky_add_elevation vkf_rocky_add_elevation proc~apply_layer->interface~vkf_rocky_add_elevation interface~vkf_rocky_add_image vkf_rocky_add_image proc~apply_layer->interface~vkf_rocky_add_image proc~find_data_file find_data_file proc~apply_layer->proc~find_data_file pr