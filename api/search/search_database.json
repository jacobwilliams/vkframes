nit = unit , file = path , status = 'old' , action = 'read' , iostat = status ) if ( status /= 0 ) then write ( * , '(a)' ) 'vkframes: could not open the star catalog ' // path return end if ! right ascension in hours, unless the header says \"ra_<limit>\" ra_limit = 2 4.0_wp read ( unit , '(a)' , iostat = status ) line if ( status == 0 ) then read ( line , * , iostat = status ) label k = index ( label , '_' ) if ( status == 0 . and . k > 0 ) then read ( label ( k + 1 :), * , iostat = status ) ra_limit if ( status /= 0 . or . ra_limit <= 0.0_wp ) ra_limit = 2 4.0_wp end if end if ! sizes from brightness, scaled from [raw_min, raw_max] to [min_size, max_size] raw_max = raw_size ( self % min_mag ) ! the brightest: the largest raw_min = raw_size ( self % max_mag ) if (. not . allocated ( self % stars )) allocate ( self % stars ( 8 , min ( self % max_stars , 1024 ))) self % n_stars = 0 self % n_names = 0 self % mag_range = [ huge ( 1.0_wp ), - huge ( 1.0_wp )] do while ( self % n_stars < self % max_stars ) read ( unit , '(a)' , iostat = status ) line if ( status /= 0 ) exit read ( line , * , iostat = status ) ra , dec , mag , ci if ( status /= 0 ) then read ( line , * , iostat = status ) ra , dec , mag if ( status /= 0 ) cycle ci = 0.0_wp end if if ( mag < self % min_mag . or . mag > self % max_mag ) cycle call star_to_point ( ra / ra_limit * 2.0_wp * pi , dec * pi / 18 0.0_wp , mag , ci , dir , rgb , size ) ratio = 0.0_wp if ( raw_max /= raw_min ) then ratio = ( size - raw_min ) / ( raw_max - raw_min ) size = self % min_size + ratio * ( self % max_size - self % min_size ) else size = self % min_size end if dim = max ( self % min_dim , ratio ) ! big stars at full color, small ones dimmed if ( self % n_stars == size_of ( self % stars )) then allocate ( tmp ( 8 , min ( self % max_stars , 2 * self % n_stars ))) tmp (:, 1 : self % n_stars ) = self % stars (:, 1 : self % n_stars ) call move_alloc ( tmp , self % stars ) end if self % n_stars = self % n_stars + 1 self % stars (:, self % n_stars ) = real ([ dir , size , dim * rgb , 1.0_wp ], c_float ) self % mag_range = [ min ( self % mag_range ( 1 ), mag ), max ( self % mag_range ( 2 ), mag )] call add_name ( self , after_fields ( line , 4 ), mag ) end do close ( unit ) if ( self % n_stars == 0 ) self % mag_range = 0.0_wp ok = . true . end function read_stars","tags":"","url":"proc/read_stars.html"},{"title":"set_constellations – vkframes","text":"private  function set_constellations(self, shown, file, rgba, width) result(ok) Draw the constellations: faint lines between their stars, from\nconstellation file file (found with find_data_file; read when given,\nor when first shown without one: default_constellations), shown (default false), in color rgba (default a faint blue, alpha 0.45) and width window units wide (default 1). Also while shown; the settings\nnot given are kept. Returns false if the file can't be read (the\nconstellations read before are kept) or width isn't > 0 (nothing\nchanged). Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(inout) :: self logical, intent(in) :: shown draw the constellations character(len=*), intent(in), optional :: file constellation file real(kind=wp), intent(in), optional :: rgba (4) color [r, g, b, a] (0 to 1) real(kind=wp), intent(in), optional :: width window units (> 0) Return Value logical Calls proc~~set_constellations~~CallsGraph proc~set_constellations SkySphere%set_constellations proc~make_line_node make_line_node proc~set_constellations->proc~make_line_node proc~read_constellations read_constellations proc~set_constellations->proc~read_constellations interface~vkf_compile_node vkf_compile_node proc~make_line_node->interface~vkf_compile_node interface~vkf_node_add_child vkf_node_add_child proc~make_line_node->interface~vkf_node_add_child interface~vkf_node_delete vkf_node_delete proc~make_line_node->interface~vkf_node_delete interface~vkf_node_remove_child vkf_node_remove_child proc~make_line_no