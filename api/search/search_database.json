odule. Source Code subroutine follow ( self , traj , data , mode , add ) class ( ReferenceFrame ), intent ( inout ) :: self type ( Trajectory ), intent ( in ), target :: traj !! the trajectory to follow (not owned) integer , intent ( in ), optional :: data , mode !! FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT logical , intent ( in ), optional :: add !! (true: in addition to those followed (default false)) type ( Trajectory ), pointer :: p integer :: d , m logical :: adding p => traj adding = . false . if ( present ( add )) adding = add d = ior ( FOLLOW_POSITION , FOLLOW_ATTITUDE ) m = FOLLOW_LOOP if ( present ( data )) d = data if ( present ( mode )) m = mode if ( adding ) then call self % follower_ % add_trajectory ( p ) else call self % follower_ % set_trajectory ( p ) end if call self % follower_ % set_follow_type ( d , m ) self % following = . true . end subroutine follow","tags":"","url":"proc/follow.html"},{"title":"late_update – vkframes","text":"private recursive subroutine late_update(self, t) After the whole tree's update for time t (all frames at their positions\nfor t): for contents that depend on other frames' positions, e.g.\nCustomLineSegments between spacecraft. Here, only the descendants'. Type Bound ReferenceFrame Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time Called by proc~~late_update~~CalledByGraph proc~late_update ReferenceFrame%late_update proc~late_update->proc~late_update proc~fm_update FrameManager%fm_update proc~fm_update->proc~late_update proc~segments_late_update CustomLineSegments%segments_late_update proc~segments_late_update->proc~late_update proc~shadow_late_update ShadowCones%shadow_late_update proc~shadow_late_update->proc~late_update Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Proced