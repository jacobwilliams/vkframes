kes one (see new_segment_artist for its\narguments). private  function new_segment_artist (traj, color, width, stride) result(a) A segment artist for traj (optional), drawn in color color ([r, g,\nb] or [r, g, b, a]; default white) and width (window units; default\n1), at every stride -th point (default 1). Arguments Type Intent Optional Attributes Name type( Trajectory ), intent(in), optional, target :: traj real(kind=wp), intent(in), optional :: color (:) real(kind=wp), intent(in), optional :: width integer, intent(in), optional :: stride Return Value type( SegmentArtist ) Type-Bound Procedures procedure, public :: build => segment_build private  subroutine segment_build (self, viewer, group) Create the chain of line buffers (sized for the segments now) under group . Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type(c_ptr), intent(in) :: viewer type(c_ptr), intent(in) :: group procedure, public :: color => segment_color private pure function segment_color (self) result(c) The segments' color [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: dash_mode => segment_dash_mode private pure function segment_dash_mode (self) result(mode) The dash pattern's layout: DASH_SCENE or DASH_SCREEN. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(in) :: self Return Value integer procedure, public :: drawn_segment private  subroutine drawn_segment (self, s, a, b) Segment s (at point 1 + (s-1) stride; first_drawn to first_drawn +\nnum_drawn - 1 drawn) as written: read back from the line buffers. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(in) :: self integer, intent(in) :: s real(kind=wp), intent(out) :: a (3) the segment's start (frame coordinates) real(kind=wp), intent(out) :: b (3) its end procedure, public :: end_data_sources private pure function end_data_sources