% width_ = max ( 1 , width ) self % height_ = max ( 1 , height ) self % hosted = handle /= 0 call self % set_background_color ( self % background ) self % light_on = . true . call apply_window_light ( self ) call apply_camera_controls ( self ) end function open","tags":"","url":"proc/open.html"},{"title":"pixel_ratio – vkframes","text":"private pure function pixel_ratio(self) Framebuffer pixels per window unit of a host's window (as given to open or resize ; 1 for a window of its own). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(in) :: self Return Value real(kind=wp) Source Code logical function open ( self , width , height , title , native_window , pixel_ratio , vsync ) result ( ok ) class ( WindowProxy ), intent ( inout ) :: self integer , intent ( in ) :: width , height !! window units (logical pixels) character ( len =* ), intent ( in ), optional :: title !! default 'vkframes' integer ( c_long_long ), intent ( in ), optional :: native_window !! host window's handle (0: own window) real ( wp ), intent ( in ), optional :: pixel_ratio !! framebuffer pixels per window unit (default 1) logical , intent ( in ), optional :: vsync character ( len = :), allocatable :: t integer ( c_long_long ) :: handle real ( c_double ) :: ratio integer ( c_int ) :: sync t = 'vkframes' if ( present ( title )) t = title handle = 0 ratio = 1.0_c_double if ( present ( native_window )) handle = native_window if ( present ( pixel_ratio )) ratio = pixel_ratio self % pixel_ratio_ = ratio sync = 1_c_int if ( present ( vsync )) sync = merge ( 1_c_int , 0_c_int , vsync ) self % viewer_ = vkf_viewer_create ( int ( width , c_int ), int ( height , c_int ), t , len ( t , kind = c_int ), handle , ratio , sync ) ok = c_associated ( self % viewer_ ) if (. not . ok ) return self % running = . true . self % scene_added = . false . self % shown => null () self % width_ = max ( 1 , width ) self % height_ = max ( 1 , height ) self % hosted = handle /= 0 call self % set_background_color ( self % background ) self % light_on = . true . call apply_window_light ( self ) call apply_camera_controls ( self ) end function open !> Close the window (waiting for the GPU). The scene is kept, and can be !> shown again in another window. So are the window's settings (views, !> HUD texts, sky, handler, time): `open` again (e.g. on a host's new !> native window, after Qt destroyed the old one) shows them as before. subroutine close ( self ) class ( WindowProxy ), intent ( inout ) :: self logical :: ok integer :: k if ( self % recording_ ) ok = self % stop_recording () call forget_handles ( self ) if ( c_associated ( self % viewer_ )) call vkf_viewer_delete ( self % viewer_ ) self % viewer_ = c_null_ptr self % running = . false . do k = 1 , self % n_huds ! (made again for the next viewer) if ( c_associated ( self % huds ( k )% node )) call vkf_node_delete ( self % huds ( k )% node ) self % huds ( k )% node = c_null_ptr end do self % scene_added = . false . ! (the scene, sky and HUD given to the next viewer) self % scene_seen = - 1 end subroutine close !> Framebuffer pixels per window unit of a host's window (as given to !> `open` or `resize`; 1 for a window of its own). pure real ( wp ) function pixel_ratio ( self ) class ( WindowProxy ), intent ( in ) :: self pixel_ratio = self % pixel_ratio_ end function pixel_ratio","tags":"","url":"proc/pixel_ratio.html"},{"title":"recorded_frames – vkframes","text":"private pure function recorded_frames(self) Frames recorded since recording started (the video's length: frames / fps). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(in) :: self Return Value integer(kind=int64) Source Code pure integer ( int64 ) function recorded_frames ( self ) class ( WindowProxy ), intent ( in ) :: self recorded_frames = self % record_frames end function recorded_frames","tags":"","url":"proc/recorded_frames.html"},{"title":"render_stats – vkframes","text":"private  function render_stats(self) result(stats) The window's frame rate and frame times (see vkf_diagnostics); zeros\nwhile it isn't open. Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(in) :: self Return Value type( RenderStats ) Calls proc~~render_stats~~CallsGraph proc~render_stats WindowProxy%render_stats interface~vkf_viewer_stats vkf_viewer_stats proc~render_stats->interface~vkf_viewer_stats Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function render_stats ( self ) result ( stats ) class ( WindowProxy ), intent ( in ) :: self type ( RenderStats ) :: stats real ( c_double ) :: s ( 9 ) if (. not . c_associated ( self % viewer_ )) return if ( vkf_viewer_stats ( self % viewer_ , s , 9_c_int ) /= 0 ) return stats % fps = self % fps_ stats % frame_ms = self % frame_ms_ stats % frames = int ( s ( 1 ), int64 ) stats % acquire_ms = s ( 2 ) stats % record_ms = s ( 3 ) stats % present_ms = s ( 4 ) stats % gpu_ms = s ( 5 ) stats % width = nint ( s ( 6 )) stats % height = nint ( s ( 7 )) stats % gpu_memory_used = s ( 8 ) stats % gpu_memory_budget = s ( 9 ) stats % program_ms = max ( 0.0_wp , self % last_frame_ms - ( s ( 2 ) + s ( 3 ) + s ( 4 ))) end function render_stats","tags":"","url":"proc/render_stats.html"},{"title":"scene_counts – vkframes","text":"private  function scene_counts(self) result(counts) The size of the window's scene graph (see vkf_diagnostics): traverses\nit all, for an occasional update, not every frame. Zeros while it isn't\nopen. Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(in) :: self Return Value type( SceneCounts ) Calls proc~~scene_counts~~CallsGraph proc~scene_counts WindowProxy%scene_counts interface~vkf_viewer_scene_counts vkf_viewer_scene_counts proc~scene_counts->interface~vkf_viewer_scene_counts Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function scene_counts ( self ) result ( counts ) class ( WindowProxy ), intent ( in ) :: self type ( SceneCounts ) :: counts real ( c_double ) :: c ( 3 ) if (. not . c_associated ( self % viewer_ )) return if ( vkf_viewer_scene_counts ( self % viewer_ , c ) /= 0 ) return counts % nodes = int ( c ( 1 ), int64 ) counts % draws = int ( c ( 2 ), int64 ) counts % vertices = int ( c ( 3 ), int64 ) end function scene_counts","tags":"","url":"proc/scene_counts.html"},{"title":"screen_position – vkframes","text":"private  function screen_position(self, p, position) result(visible) Where point p (root frame) is in the window, as HUD text positions:\n(x, y) from 0 to 1, left to right and bottom to top (as at the last\nframe). False if it is behind the eye (or before the first frame).\nE.g. to keep HUD text next to a moving object, each frame: a callout. Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(in) :: self real(kind=wp), intent(in) :: p (3) root frame real(kind=wp), intent(out) :: position (2) (x, y), 0 to 1 from the bottom left Return Value logical Calls proc~~screen_position~~CallsGraph proc~screen_position WindowProxy%screen_position proc~project project proc~screen_position->proc~project proc~view_camera view_camera proc~screen_position->proc~view_camera interface~vkf_viewer_pixel_ratio vkf_viewer_pixel_ratio proc~view_camera->interface~vkf_viewer_pixel_ratio interface~vkf_viewer_size vkf_viewer_size proc~view_camera->interface~vkf_viewer_size proc~aspect_ratio aspect_ratio proc~view_camera->proc~aspect_ratio proc~field_of_view View%field_of_view proc~view_camera->proc~field_of_view proc~get_camera WindowProxy%get_camera proc~view_camera->proc~get_camera proc~is_open WindowProxy%is_open proc~view_camera->proc~is_open proc~orthographic_bounds View%orthographic_bounds proc~view_camera->proc~orthographic_bounds proc~pick_camera pick_camera proc~view_camera->proc~pick_camera proc~projection_type View%projection_type proc~view_camera->proc~projection_type proc~aspect_ratio->interface~vkf_viewer_size proc~get_camera->proc~is_open interface~vkf_viewer_get_look_at vkf_viewer_get_look_at proc~get_camera->interface~vkf_viewer_get_look_at proc~rigid_inverse rigid_inverse proc~get_camera->proc~rigid_inverse proc~transform_camera transform_camera proc~get_camera->proc~transform_camera proc~world_to_view View%world_to_view proc~get_camera->proc~world_to_view proc~cross cross proc~pick_camera->proc~cross proc~world_to_view->proc~rigid_inverse proc~frame_to_root frame_to_root proc~world_to_view->proc~frame_to_root proc~identity_matrix identity_matrix proc~world_to_view->proc~identity_matrix proc~quat_from_vectors quat_from_vectors proc~world_to_view->proc~quat_from_vectors proc~quat_to_matrix quat_to_matrix proc~world_to_view->proc~quat_to_matrix proc~rotated rotated proc~world_to_view->proc~rotated proc~translation_matrix translation_matrix proc~world_to_view->proc~translation_matrix proc~frame_to_root->proc~rigid_inverse proc~world_matrix ReferenceFrame%world_matrix proc~frame_to_root->proc~world_matrix proc~quat_from_vectors->proc~cross proc~quat_normalize quat_normalize proc~quat_from_vectors->proc~quat_normalize proc~translation_matrix->proc~identity_matrix proc~world_matrix->proc~world_matrix proc~local_matrix ReferenceFrame%local_matrix proc~world_matrix->proc~local_matrix proc~frame_matrix frame_matrix proc~local_matrix->proc~frame_matrix proc~frame_matrix->proc~quat_to_matrix Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code logical function screen_position ( self , p , position ) result ( visible ) class ( WindowProxy ), intent ( in ) :: self real ( wp ), intent ( in ) :: p ( 3 ) !! root frame real ( wp ), intent ( out ) :: position ( 2 ) !! (x, y), 0 to 1 from the bottom left type ( PickCamera ) :: cam real ( wp ) :: sx , sy , depth visible = . false . position = 0.0_wp if (. not . view_camera ( self , 0.0_wp , 0.0_wp , cam )) return if (. not . project ( cam , p , sx , sy , depth )) return ! (offsets from the center, in pixels) position = 0.5_wp * ([ sx / cam % half_w , sy / cam % half_h ] + 1.0_wp ) visible = . true . end function screen_position","tags":"","url":"proc/screen_position.html"},{"title":"sky – vkframes","text":"private  function sky(self) result(s) The sky drawn behind the scene (null if none). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(in) :: self Return Value type( SkySphere ), pointer Source Code function sky ( self ) result ( s ) class ( WindowProxy ), intent ( in ) :: self type ( SkySphere ), pointer :: s s => self % sky_ end function sky","tags":"","url":"proc/sky.html"},{"title":"start_recording – vkframes","text":"private  function start_recording(self, file, fps, quality, codec, scale, options, watermark, watermark_width, watermark_opacity, ffmpeg) result(ok) Start recording the frames drawn to the video file (see the module\ndocumentation), fps frames per second (default 30). Encoded by codec (an ffmpeg encoder; default libx264, H.264) at quality (for\nlibx264, libx265 and libvpx-vp9 the CRF: 0 lossless to 51, default 18,\nvisually lossless), scaled by scale (default 1; e.g. 0.5 for half the\nsize of a Retina window's pixels), the size made even. options replaces the encoder options (codec, quality; and the scale, unless\nthere is a watermark), e.g. '-c:v prores_ks -profile:v 3'. watermark : an image (e.g. a logo; PNG, SVG, ... with transparency)\ndrawn over the video's bottom right corner by ffmpeg, watermark_width of the video's width (default 0.2), watermark_opacity opaque (default\n0.6). ffmpeg : the program (default: VKFRAMES_FFMPEG, else ffmpeg on\nthe path). Returns false if the window isn't open, is already\nrecording or the watermark doesn't exist; ffmpeg's errors (e.g. an\nunknown encoder) show when it starts, at the next frame, and end the\nrecording. Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self character(len=*), intent(in) :: file the video file (e.g. .mp4, .mov, .webm) real(kind=wp), intent(in), optional :: fps frames per second of the video (default 30) integer, intent(in), optional :: quality the CRF (default 18; lower is better) character(len=*), intent(in), optional :: codec an ffmpeg encoder (default libx264) real(kind=wp), intent(in), optional :: scale of the window's pixels (default 1) character(len=*), intent(in), optional :: options ffmpeg's encoder options, instead of those above character(len=*), intent(in), optional :: watermark an image file drawn at the bottom right real(kind=wp), intent(in), optional :: watermark_width its width, of the video's (default 0.2) real(kind=wp), intent(in), optional :: watermark_opacity 0 to 1 (default 0.6) character(len=*), intent(in), optional :: ffmpeg the ffmpeg program Return Value logical Calls proc~~start_recording~~CallsGraph proc~start_recording WindowProxy%start_recording interface~vkf_viewer_record_start vkf_viewer_record_start proc~start_recording->interface~vkf_viewer_record_start proc~encoder_options encoder_options proc~start_recording->proc~encoder_options proc~is_open WindowProxy%is_open proc~start_recording->proc~is_open proc~wall_time wall_time proc~start_recording->proc~wall_time Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code logical function start_recording ( self , file , fps , quality , codec , scale , options , watermark , watermark_width , & watermark_opacity , ffmpeg ) result ( ok ) class ( WindowProxy ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: file !! the video file (e.g. .mp4, .mov, .webm) real ( wp ), intent ( in ), optional :: fps !! frames per second of the video (default 30) integer , intent ( in ), optional :: quality !! the CRF (default 18; lower is better) character ( len =* ), intent ( in ), optional :: codec !! an ffmpeg encoder (default libx264) real ( wp ), intent ( in ), optional :: scale !! of the window's pixels (default 1) character ( len =* ), intent ( in ), optional :: options !! ffmpeg's encoder options, instead of those above character ( len =* ), intent ( in ), optional :: watermark !! an image file drawn at the bottom right real ( wp ), intent ( in ), optional :: watermark_width !! its width, of the video's (default 0.2) real ( wp ), intent ( in ), optional :: watermark_opacity !! 0 to 1 (default 0.6) character ( len =* ), intent ( in ), optional :: ffmpeg !! the ffmpeg program character ( len = :), allocatable :: output , program , filter character ( len = 1024 ) :: env character ( len = 32 ) :: f , w , a integer :: n , status logical :: exists ok = . false . if (. not . self % is_open () . or . self % recording_ ) return write ( f , '(g0)' ) 1.0_wp if ( present ( scale )) write ( f , '(g0)' ) max ( scale , 0.01_wp ) filter = 'scale=trunc(iw*' // trim ( f ) // '/2)*2:trunc(ih*' // trim ( f ) // '/2)*2' ! (an even size) output = '' if ( present ( watermark )) then inquire ( file = watermark , exist = exists ) if (. not . exists ) then write ( * , '(a)' ) 'vkframes: recording: no watermark file ' // trim ( watermark ) return end if output = '-i \"' // trim ( watermark ) // '\" ' ! (ffmpeg's second input) end if if ( present ( options )) then output = output // trim ( options ) else output = output // encoder_options ( codec , quality ) end if if ( present ( watermark )) then ! the video scaled; the image scaled to its width and made translucent, over its bottom right corner write ( w , '(g0)' ) 0.2_wp if ( present ( watermark_width )) write ( w , '(g0)' ) max ( 0.01_wp , min ( 1.0_wp , watermark_width )) write ( a , '(g0)' ) 0.6_wp if ( present ( watermark_opacity )) write ( a , '(g0)' ) max ( 0.0_wp , min ( 1.0_wp , watermark_opacity )) output = output // ' -filter_complex \"[0:v]' // filter // '[v];[1:v][v]scale=w=rw*' // trim ( w ) // & ':h=-1,format=rgba,colorchannelmixer=aa=' // trim ( a ) // '[w];[v][w]overlay=W-w-H*0.03:H-h-H*0.03\"' else if (. not . present ( options )) then output = output // ' -vf \"' // filter // '\"' end if output = output // ' \"' // trim ( file ) // '\"' if ( present ( ffmpeg )) then program = '\"' // trim ( ffmpeg ) // '\"' else call get_environment_variable ( 'VKFRAMES_FFMPEG' , env , n , status ) program = 'ffmpeg' if ( status == 0 . and . n > 0 ) program = '\"' // trim ( env ) // '\"' end if self % record_fps = 3 0.0_wp if ( present ( fps )) self % record_fps = fps if ( self % record_fps <= 0.0_wp ) return if ( vkf_viewer_record_start ( self % viewer_ , program , len ( program , kind = c_int ), output , len ( output , kind = c_int ), & real ( self % record_fps , c_double )) /= 0 ) return self % record_wall = wall_time () ! (the window's time goes on from now, at the video's pace) self % record_frames = 0_int64 self % recording_ = . true . ok = . true . end function start_recording","tags":"","url":"proc/start_recording.html"},{"title":"stop_recording – vkframes","text":"private  function stop_recording(self, frames) result(ok) Stop recording: ffmpeg finishes the file. The window's time goes on\nfrom where the video was, on the wall clock again. frames : the\nframes written. Returns false if not recording or if the recording\nfailed (ffmpeg's messages are on the standard error). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self integer(kind=int64), intent(out), optional :: frames frames written to the video Return Value logical Calls proc~~stop_recording~~CallsGraph proc~stop_recording WindowProxy%stop_recording interface~vkf_viewer_record_stop vkf_viewer_record_stop proc~stop_recording->interface~vkf_viewer_record_stop proc~set_time~2 SimulationClock%set_time proc~stop_recording->proc~set_time~2 proc~synchronized_to SimulationClock%synchronized_to proc~stop_recording->proc~synchronized_to proc~wall_time wall_time proc~stop_recording->proc~wall_time proc~window_wall window_wall proc~stop_recording->proc~window_wall proc~set_time~2->proc~s