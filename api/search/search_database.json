ault light, as OpenFrames') real ( wp ) :: light_ambient_ ( 3 ) = 0.05_wp , light_diffuse_ ( 3 ) = 0.8_wp , light_specular_ ( 3 ) = 0.05_wp !! [r, g, b] type ( c_ptr ) :: light_node = c_null_ptr , light_switch = c_null_ptr !! light and switch (made when enabled) logical :: contents = . true . !! what the frame draws shown (show_contents) logical :: pickable_ = . true . !! picked (WindowProxy%pick); its children aside ! rendering type ( c_ptr ) :: node_ = c_null_ptr !! the frame's transform node type ( c_ptr ) :: contents_node = c_null_ptr !! switch holding the contents logical :: shown_ = . false . !! realized for a window (not headless): later nodes are compiled logical :: realized = . false . !! render nodes made (realize) logical :: synced = . false . !! the node has synced_position/attitude real ( wp ) :: synced_position ( 3 ) = 0.0_wp , synced_attitude ( 4 ) = 0.0_wp !! last copied to the node ! axes (OpenFrames' moveXAxis/...: base, length, head ratio, radii; 0 radius: auto) real ( wp ) :: axis_base ( 3 , 3 ) = 0.0_wp !! each axis's base (columns; frame coordinates) real ( wp ) :: axis_len ( 3 ) = 1.0_wp !! each axis's length real ( wp ) :: axis_head_ratio ( 3 ) = 0.3_wp !! each axis's head, as a fraction of its length real ( wp ) :: axis_body_radius ( 3 ) = 0.0_wp , axis_head_radius ( 3 ) = 0.0_wp !! (0: 0.05 and 0.1 of the length) logical :: axes_moved = . false . !! set by move_*_axis (else reposition_axes places them) type ( c_ptr ) :: axis_node ( 3 ) = c_null_ptr !! the axes arrows' switches type ( c_ptr ) :: axis_label_node ( 3 ) = c_null_ptr !! the axes labels' switches type ( c_ptr ) :: axis_arrow ( 3 ) = c_null_ptr !! the axes arrows (in axis_node; made again when an axis moves) type ( c_ptr ) :: axis_text ( 3 ) = c_null_ptr !! the axes labels (in axis_label_node) type ( c_ptr ) :: name_label_node = c_null_ptr !! the name label's switch type ( c_ptr ) :: name_text = c_null_ptr !! the name label (in name_label_node) contains procedure :: set_name , nam