lass ( WindowProxy ), intent ( in ) :: self camera_throw = self % camera_throw_ end function camera_throw !> Give the zoom speed and throw to the trackball (if open). subroutine apply_camera_controls ( self ) type ( WindowProxy ), intent ( inout ) :: self if (. not . c_associated ( self % viewer_ )) return if ( vkf_viewer_set_camera_controls ( self % viewer_ , real ( self % zoom_speed_ , c_double ), & merge ( 1_c_int , 0_c_int , self % camera_throw_ )) /= 0 ) & write ( * , '(a)' ) 'vkframes: could not set the camera controls' end subroutine apply_camera_controls !> The camera of the view shown (from the last frame): eye, center and up !> in the view frame's coordinates (OpenFrames' trackball !> getTransformation), or in its root frame's if `in_root`. Zero before !> the window's first frame. subroutine get_camera ( self , eye , center , up , in_root ) class ( WindowProxy ), intent ( in ) :: self real ( wp ), intent ( out ) :: eye ( 3 ), center ( 3 ), up ( 3 ) !! view frame's coordinates (or root's) logical , intent ( in ), optional :: in_root real ( wp ) :: cam ( 3 , 3 ) eye = 0.0_wp center = 0.0_wp up = 0.0_wp if (. not . self % is_open () . or . . not . associated ( self % shown )) return if ( vkf_viewer_get_look_at ( self % viewer_ , eye , center , up ) /= 0 ) return if (. not . present ( in_root )) return if (. not . in_root ) return cam = transform_camera ( rigid_inverse ( self % shown % world_to_view ()), reshape ([ eye , center , up ], [ 3 , 3 ])) eye = cam (:, 1 ) center = cam (:, 2 ) up = cam (:, 3 ) end subroutine get_camera !> Set the camera of the current view: eye, center and up in the view !> frame's coordinates (OpenFrames' trackball setTransformation), or in its !> root frame's if `in_root` (as the frames are now). With `duration` (s), !> fly there from the camera shown. Before the view is shown, it is its !> camera when it is (View%set_camera). subroutine set_camera ( self , eye , center , up , duration , in_root ) class ( WindowProxy ), intent ( ino