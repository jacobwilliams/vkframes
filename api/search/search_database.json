ointer procedure, public :: num_updates => fm_num_updates private pure function fm_num_updates (self) result(n) Number of scene updates so far ( update ). Arguments Type Intent Optional Attributes Name class( FrameManager ), intent(in) :: self Return Value integer procedure, public :: set_frame => fm_set_frame private  subroutine fm_set_frame (self, frame) Set the root frame of the scene (not owned: it must stay alive while managed).\n(The scene is for a window: this also starts loading the Vulkan driver for the\nfirst one, in the background, which can take a few tenths of a second.) Arguments Type Intent Optional Attributes Name class( FrameManager ), intent(inout) :: self class( ReferenceFrame ), intent(in), target :: frame the root frame (not owned) procedure, public :: update => fm_update private  subroutine fm_update (self, t, seen) Update the scene for time t (followed trajectories, artists) and copy\nthe frames' positions and attitudes to the renderer, unless another\nwindow already did for this time since this window's last frame. seen is the window's own: the number of updates at its last frame. Arguments Type Intent Optional Attributes Name class( FrameManager ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time integer, intent(inout) :: seen Source Code type , public :: FrameManager private class ( ReferenceFrame ), pointer :: root => null () !! the scene's root frame (not owned) integer :: updates = 0 !! scene updates so far real ( wp ) :: updated_time = 0.0_wp !! the time of the last one contains procedure :: set_frame => fm_set_frame procedure :: frame => fm_frame procedure :: update => fm_update , num_updates => fm_num_updates end type FrameManager","tags":"","url":"type/framemanager.html"},{"title":"HUDEntry – vkframes ","text":"type, private :: HUDEntry A HUD text shown in a window, with the window's node for it. Inherits type~~hudentry~~InheritsGraph type~hudentry HUDEntry c_ptr c_ptr type~hudentry->c_ptr node type~hudtext HUDTex