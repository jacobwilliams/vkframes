tent ( in ) :: i1 , i2 real ( c_float ), dimension (:,:,:), pointer :: p real ( c_float ), dimension (:,:), pointer :: c , col real ( c_float ) :: own ( 4 ) real ( wp ), allocatable :: v (:,:) integer :: j , lo , hi , ia , ib , m , k do j = 1 , self % chain % num_chunks () call self % chain % slice ( j , 2 * i1 - 1 , 2 * i2 , lo , hi , p ) ! chunks hold whole pairs if (. not . associated ( p )) cycle ia = ( lo + 1 ) / 2 ! the trajectory points of the pairs ib = hi / 2 allocate ( v ( 3 , ib - ia + 1 )) call self % traj % points ( ia , ib , self % start_ , v ) call split_points ( v , p (:, :, 1 : hi - lo + 1 : 2 )) call self % traj % points ( ia , ib , self % end_ , v ) call split_points ( v , p (:, :, 2 : hi - lo + 1 : 2 )) deallocate ( v ) end do if ( self % chain % is_colored ()) then ! each pair in its point's color call self % traj % colors ( col ) m = self % traj % num_colors () own = real ( self % color_ , c_float ) own ( 4 ) = 1.0_c_float ! (the style has the alpha) do j = 1 , self % chain % num_chunks () call self % chain % color_slice ( j , 2 * i1 - 1 , 2 * i2 , lo , hi , c ) if (. not . associated ( c )) cycle do k = ( lo + 1 ) / 2 , hi / 2 if ( k <= m ) then c (:, 2 * k - lo : 2 * k - lo + 1 ) = spread ( col (:, k ), 2 , 2 ) else c (:, 2 * k - lo : 2 * k - lo + 1 ) = spread ( own , 2 , 2 ) end if end do end do self % n_colored = min ( m , i2 ) end if call self % chain % written ( 2 * i1 - 1 , 2 * i2 ) end subroutine write_ribbon","tags":"","url":"proc/write_ribbon.html"},{"title":"write_segments – vkframes","text":"private  subroutine write_segments(self, s1, s2) Write segments s1 .. s2 into the chain (and upload the chunks written to). Arguments Type Intent Optional Attributes Name type( SegmentArtist ), intent(inout) :: self integer, intent(in) :: s1 integer, intent(in) :: s2 Calls proc~~write_segments~~CallsGraph proc~write_segments write_segments points points proc~write_segments->points proc~num_chunks~2 LineChain%num_chunks proc~write_segments->proc~