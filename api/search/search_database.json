te  function add_child (self, child) result(ok) Add child to this frame's children. Returns false (and does nothing)\nfor this frame itself or an ancestor of it; true if it is already a child. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self class( ReferenceFrame ), intent(inout), target :: child Return Value logical procedure, public :: attitude private pure function attitude (self) result(q) Attitude relative to the parent frame, a quaternion [x, y, z, w]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: axes_labels_shown private pure function axes_labels_shown (self) Which axes labels are shown (as axes_shown ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: axes_shown private pure function axes_shown (self) Which axes vectors are shown (NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: axis_label private  function axis_label (self, axis) result(text) The label text of axis X_AXIS, Y_AXIS or Z_AXIS. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: axis Return Value character(len=:), allocatable procedure, public :: bound => model_frame_bound private  subroutine model_frame_bound (self, center, radius) The model's bounding sphere in the frame (through the model transform). Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: self real(kind=wp), intent(out) :: center (3) real(kind=wp), intent(out) :: radius procedure, public :: build_contents => model_build_contents private  subroutine model_build_contents (self, viewer, group) The model under the model transform. Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer handle (null: headless) type(c_ptr), intent(in) :: group the group node to build under procedure, public :: child private  function child (self, i) result(c) Child i (1 to num_children). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: child_index private  function child_index (self, frame) Index of frame among the children, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: color private pure function color (self) result(c) The color of the frame's decorations, [r, g, b, a] (0 to 1). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: contents_shown private pure function contents_shown (self) Whether what the frame draws is shown ( show_contents ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: detach private  subroutine detach (self) Remove this frame from all its parents and children (before it goes out\nof scope or is deallocated while in a tree). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self procedure, public :: follow private  subroutine follow (self, traj, data, mode, add) Follow traj (in addition to trajectories already followed, if add is true), with what to follow ( data : FOLLOW_POSITION and/or\nFOLLOW_ATTITUDE; default both) and how ( mode : FOLLOW_LOOP, the\ndefault, or FOLLOW_LIMIT). traj must stay alive while followed. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type( Trajectory ), intent(in), target :: traj the trajectory to follow (not owned) integer, intent(in), optional :: data FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT integer, intent(in), optional :: mode FOLLOW_POSITION/FOLLOW_ATTITUDE; FOLLOW_LOOP/FOLLOW_LIMIT logical, intent(in), optional :: add (true: in addition to those followed (default false)) procedure, public :: follower private  function follower (self) result(f) The frame's trajectory follower, for finer control (data sources, time\noffset, ...). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in), target :: self Return Value type( TrajectoryFollower ), pointer procedure, public :: frame_info => model_frame_info private  function model_frame_info (self) result(info) The kind of frame: 'Model'. Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: frame_string private recursive function frame_string (self, prefix) result(str) The tree below this frame, one line per frame (\"name (info)\"), in\nOpenFrames' createFrameString format: children are prefixed \"|-->\". Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self character(len=*), intent(in), optional :: prefix before this frame's line (default ' ') Return Value character(len=:), allocatable procedure, public :: has_light_source private recursive function has_light_source (self) result(has) Whether this frame or one of its descendants has a light source enabled. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: has_model private pure function has_model (self) True if a model was read (or shared). Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: self Return Value logical procedure, public :: is_following private pure function is_following (self) Whether the frame follows trajectories (at least one, since follow ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: label_alignment private pure function label_alignment (self) The labels' alignment (ALIGN_*). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: label_font private  function label_font (self) result(font) The labels' font as set ('' for the renderer's default). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: label_size private pure function label_size (self) The labels' size in pixels. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: late_update private recursive subroutine late_update (self, t) After the whole tree's update for time t (all frames at their positions\nfor t): for contents that depend on other frames' positions, e.g.\nCustomLineSegments between spacecraft. Here, only the descendants'. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time procedure, public :: light_ambient private pure function light_ambient (self) result(rgb) The light source's ambient color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_diffuse private pure function light_diffuse (self) result(rgb) The light source's diffuse color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: light_source_enabled private pure function light_source_enabled (self) Whether this frame carries a light source. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: light_specular private pure function light_specular (self) result(rgb) The light source's specular color [r, g, b]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: local_matrix private pure function local_matrix (self) result(m) The transform from this frame to its parent (4x4). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) procedure, public :: model_attitude private pure function model_attitude (self) result(q) Attitude of the model in its frame (quaternion [x, y, z, w]). Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: self Return Value real(kind=wp), (4) procedure, public :: model_bound private  subroutine model_bound (self, center, radius) The model's bounding sphere, in the model's own coordinates (before its transform). Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: self real(kind=wp), intent(out) :: center (3) real(kind=wp), intent(out) :: radius procedure, public :: model_file private  function model_file (self) result(file) The model file ('' if none). Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: model_pivot private pure function model_pivot (self) result(p) The model's pivot, in its own coordinates (see set_model_pivot ). Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: model_position private pure function model_position (self) result(p) Where the model's pivot is placed in its frame (frame coordinates). Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: model_scale private pure function model_scale (self) result(s) Scale along the model's x, y and z axes. Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: move_x_axis private  subroutine move_x_axis (self, base, length, head_ratio, body_radius, head_radius) Place the x axis vector: from base , length long, with a head of head_ratio of the length (default 0.3) and body and head radii (default\n0.05 and 0.1 of the length); its label is at the tip, 0.4 of the length\ntall (at most label_size pixels). As OpenFrames' moveXAxis. Set before\nthe frame is first shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) (base: frame's coordinates) real(kind=wp), intent(in) :: length (base: frame's coordinates) real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_y_axis private  subroutine move_y_axis (self, base, length, head_ratio, body_radius, head_radius) Place the y axis vector (as move_x_axis ; OpenFrames' moveYAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: move_z_axis private  subroutine move_z_axis (self, base, length, head_ratio, body_radius, head_radius) Place the z axis vector (as move_x_axis ; OpenFrames' moveZAxis). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: base (3) real(kind=wp), intent(in) :: length real(kind=wp), intent(in), optional :: head_ratio real(kind=wp), intent(in), optional :: body_radius real(kind=wp), intent(in), optional :: head_radius procedure, public :: name private  function name (self) result(n) The frame's name ('' if none). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value character(len=:), allocatable procedure, public :: name_label_on_top private pure function name_label_on_top (self) Whether the name label is drawn on top of the scene ( set_name_label_on_top ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: name_label_shown private pure function name_label_shown (self) Whether the name label is shown. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: node private  function node (self) result(n) The frame's transform node (null until realized). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value type(c_ptr) procedure, public :: num_children private pure function num_children (self) Number of children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: num_parents private pure function num_parents (self) Number of parents. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value integer procedure, public :: parent private  function parent (self, i) result(p) Parent i (1 to num_parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self integer, intent(in) :: i Return Value class( ReferenceFrame ), pointer procedure, public :: parent_index private  function parent_index (self, frame) Index of frame among the parents, or 0. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in), target :: frame Return Value integer procedure, public :: pick => model_pick private  subroutine model_pick (self, cam, to_root, hits, n) Picked on the model's bounding sphere (not its triangles); else at the\nframe's origin. Arguments Type Intent Optional Attributes Name class( Model ), intent(in), target :: self type( PickCamera ), intent(in) :: cam the cursor's ray and the pick's settings real(kind=wp), intent(in) :: to_root (4,4) the frame's transform to the root frame type( PickHit ), intent(inout), allocatable :: hits (:) hits so far (grown as needed) integer, intent(inout) :: n number of hits in hits procedure, public :: pickable private pure function pickable (self) Whether pick tests what this frame draws ( set_pickable ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value logical procedure, public :: position private pure function position (self) result(p) Position relative to the parent frame. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (3) procedure, public :: position_of private  function position_of (self, other) result(p) The origin of other (a frame of the same tree) in this frame's\ncoordinates, from both frames' transforms to the root (through their\nfirst parents). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self class( ReferenceFrame ), intent(in) :: other Return Value real(kind=wp), (3) procedure, public :: realize private recursive subroutine realize (self, viewer) Create the render nodes of this frame and its descendants (once; for viewer , a window's viewer handle, which some contents need while they\nare built (not kept); null: headless). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self type(c_ptr), intent(in) :: viewer a window's viewer handle (null: headless) procedure, public :: remove_child private  function remove_child (self, child) result(ok) Remove child from this frame's children. Returns false if it is not one. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout), target :: self class( ReferenceFrame ), intent(inout), target :: child Return Value logical procedure, public :: reposition_axes private  subroutine reposition_axes (self) Place the axes for what the frame draws, when it is first shown (unless\nmove_*_axis was called): at its bound's surface, half the bound's radius\nlong (as OpenFrames' Sphere and Model do); at the origin, 1 long, for a\nframe that draws nothing. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: set_attitude private  subroutine set_attitude (self, q) Attitude relative to the parent frame, a quaternion [x, y, z, w]\n(normalized here; overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) procedure, public :: set_color private  subroutine set_color (self, color) The color of the frame's decorations: [r, g, b] (alpha unchanged) or [r, g, b, a]. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) procedure, public :: set_label_alignment private  subroutine set_label_alignment (self, alignment) The alignment of the labels relative to their positions (ALIGN_*;\ndefault ALIGN_LEFT_BASE_LINE). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: alignment procedure, public :: set_label_font private  subroutine set_label_font (self, font) The font of the labels: a font file name (found on the data search\npath) or a full path; default: the renderer's default font. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: font procedure, public :: set_label_size private  subroutine set_label_size (self, size) The size of the labels in pixels (default 20): the name label's size,\nand the maximum size of the axes labels (which shrink with distance). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: size procedure, public :: set_light_ambient private  subroutine set_light_ambient (self, rgb) The light source's ambient, diffuse and specular colors ([r, g, b], 0\nto 1; defaults 0.05, 0.8 and 0.05 gray). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_diffuse private  subroutine set_light_diffuse (self, rgb) The light source's diffuse color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_light_source_enabled private  subroutine set_light_source_enabled (self, enable) Whether this frame carries a light source: a point light at its origin\n(e.g. the Sun), not dimmed with distance (default false; OpenFrames'\nsetLightSourceEnabled). While any frame of a window's scene has one, the\nwindow's own light (WindowProxy%set_light_*) is off. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: enable procedure, public :: set_light_specular private  subroutine set_light_specular (self, rgb) The light source's specular color (see set_light_ambient ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) procedure, public :: set_model private  function set_model (self, file) result(ok) Read the model file (now, so its bound is known). Returns false if it\ncould not be read. Set it before a window first shows the model. Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: self character(len=*), intent(in) :: file Return Value logical procedure, public :: set_model_attitude private  subroutine set_model_attitude (self, q) Attitude of the model in its frame (quaternion [x, y, z, w]). Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) procedure, public :: set_model_pivot private  subroutine set_model_pivot (self, pivot) The point of the model (in its own coordinates) placed at model_position,\nabout which it is rotated and scaled. Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: self real(kind=wp), intent(in) :: pivot (3) (model coordinates) procedure, public :: set_model_position private  subroutine set_model_position (self, position) Where the model's pivot is placed in its frame (frame coordinates). Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) procedure, public :: set_model_scale private  subroutine set_model_scale (self, scale) Scale along the model's x, y and z axes. Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: self real(kind=wp), intent(in) :: scale (3) procedure, public :: set_name private  subroutine set_name (self, name) The frame's name, shown by its name label (also once shown: e.g. a\nreadout that follows the frame). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: name procedure, public :: set_name_label_on_top private  subroutine set_name_label_on_top (self, on_top) Draw the name label on top of the scene (true: not hidden by bodies in\nfront of it, as HUD text; e.g. a readout) or depth-tested (false, the\ndefault, as OpenFrames'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: on_top procedure, public :: set_pickable private  subroutine set_pickable (self, pickable) Whether pick tests what this frame draws (default true; e.g. false\nfor an overlay such as a selection marker). Its children are picked or\nnot by their own setting. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: pickable procedure, public :: set_position private  subroutine set_position (self, position) Position relative to the parent frame (overridden by a followed trajectory). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: position (3) parent frame's coordinates procedure, public :: set_x_label private  subroutine set_x_label (self, text) The text of the x-axis label (default 'X'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_y_label private  subroutine set_y_label (self, text) The text of the y-axis label (default 'Y'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: set_z_label private  subroutine set_z_label (self, text) The text of the z-axis label (default 'Z'). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self character(len=*), intent(in) :: text procedure, public :: share_model private  function share_model (self, other) result(ok) Use the model already read by other (no second copy in memory). Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: self class( Model ), intent(in) :: other Return Value logical procedure, public :: show_axes private  subroutine show_axes (self, axes) Which axes vectors to show: NO_AXES, or X_AXIS, Y_AXIS, Z_AXIS combined with ior. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: axes procedure, public :: show_axes_labels private  subroutine show_axes_labels (self, labels) Which axes labels to show (as show_axes ). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self integer, intent(in) :: labels procedure, public :: show_contents private  subroutine show_contents (self, show) Show or hide what the frame draws (its sphere, model, ...), but not its\naxes, labels or children. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show procedure, public :: show_decorations private  subroutine show_decorations (self, show) Show (true) or hide all the frame's decorations at once: its axes,\ntheir labels and its name label (show_axes, show_axes_labels,\nshow_name_label). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show true: all axes, axes labels and the name label procedure, public :: show_name_label private  subroutine show_name_label (self, show) Show or hide the name label (at the frame's origin; default shown). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self logical, intent(in) :: show (true: shown) procedure, public :: sync private recursive subroutine sync (self) Copy the positions and attitudes of this frame and its descendants to\ntheir transform nodes (only those that changed since the last sync). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: unfollow private  subroutine unfollow (self) Stop following trajectories (the frame keeps its last position and attitude). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self procedure, public :: update private recursive subroutine update (self, t) Update this frame and its descendants for simulation time t (followed\ntrajectories set positions and attitudes). Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(inout) :: self real(kind=wp), intent(in) :: t simulation time procedure, public :: world_matrix private recursive function world_matrix (self) result(m) The transform from this frame to the root of its tree, through the first\nparent at each level. Arguments Type Intent Optional Attributes Name class( ReferenceFrame ), intent(in) :: self Return Value real(kind=wp), (4,4) Source Code type , extends ( ReferenceFrame ), public :: Model private character ( len = :), allocatable :: file !! the model file (unallocated: none) type ( c_ptr ) :: model_ = c_null_ptr !! the loaded model's node real ( wp ) :: model_position_ ( 3 ) = 0.0_wp !! where the pivot is in the frame real ( wp ) :: model_attitude_ ( 4 ) = quat_identity !! attitude in the frame (quaternion [x, y, z, w]) real ( wp ) :: scale_ ( 3 ) = 1.0_wp !! scale along the model's x, y, z real ( wp ) :: pivot_ ( 3 ) = 0.0_wp !! the model's point at model_position_ (model coordinates) real ( wp ) :: bound_center ( 3 ) = 0.0_wp !! the model's bounding sphere: center (model coordinates) real ( wp ) :: bound_radius = 0.0_wp !! the model's bounding sphere: radius (0: unknown) type ( c_ptr ) :: model_node = c_null_ptr !! transform of the model within the frame contains procedure :: set_model , share_model , model_file , has_model , model_bound procedure :: set_model_position , model_position procedure :: set_model_attitude , model_attitude procedure :: set_model_scale , model_scale procedure :: set_model_pivot , model_pivot procedure :: frame_info => model_frame_info procedure :: bound => model_frame_bound procedure :: pick => model_pick procedure :: build_contents => model_build_contents end type Model","tags":"","url":"type/model.html"},{"title":"FramePointer – vkframes ","text":"type, public :: FramePointer A frame in a list of frames (a frame's children and parents): a pointer\nto it (Fortran has no arrays of pointers). Inherits type~~framepointer~~InheritsGraph type~framepointer FramePointer type~referenceframe ReferenceFrame type~framepointer->type~referenceframe p type~referenceframe->type~framepointer children, parents c_ptr c_ptr type~referen