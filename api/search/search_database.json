 type ( c_ptr ) :: n if (. not . c_associated ( self % root )) then self % root = vkf_transform_create () self % texture_switch = vkf_switch_create () self % star_switch = vkf_switch_create () self % line_switch = vkf_switch_create () call check_status ( vkf_node_add_child ( self % root , self % texture_switch ), 'SkySphere' ) ! the texture first, call check_status ( vkf_node_add_child ( self % root , self % line_switch ), 'SkySphere' ) ! the constellations, call check_status ( vkf_node_add_child ( self % root , self % star_switch ), 'SkySphere' ) ! the stars over them call make_texture_node ( self ) call make_line_node ( self ) call make_star_node ( self ) self % shown = c_associated ( viewer ) ! (the first nodes are compiled with the scene) end if n = self % root end function node","tags":"","url":"proc/node.html"},{"title":"num_constellation_lines – vkframes","text":"private pure function num_constellation_lines(self) Number of constellation lines read (of all of them). Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(in) :: self Return Value integer Source Code pure integer function num_constellation_lines ( self ) class ( SkySphere ), intent ( in ) :: self num_constellation_lines = self % n_lines end function num_constellation_lines","tags":"","url":"proc/num_constellation_lines.html"},{"title":"num_constellations – vkframes","text":"private pure function num_constellations(self) Number of constellations read. Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(in) :: self Return Value integer Source Code pure integer function num_constellations ( self ) class ( SkySphere ), intent ( in ) :: self num_constellations = self % n_groups end function num_constellations","tags":"","url":"proc/num_constellations.html"},{"title":"num_star_names – vkframes","text":"private pure function num_star_names(self) Number of named stars read (of the stars read). Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(in) :: self Return Value integer Source Code pure integer function num_star_names ( self ) class ( SkySphere ), intent ( in ) :: self num_star_names = self % n_names end function num_star_names","tags":"","url":"proc/num_star_names.html"},{"title":"num_star_names_drawn – vkframes","text":"private pure function num_star_names_drawn(self) Number of star names drawn now (0 until the sky is shown, or if the\nnames aren't). Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(in) :: self Return Value integer Source Code pure integer function num_star_names_drawn ( self ) class ( SkySphere ), intent ( in ) :: self num_star_names_drawn = self % n_labels end function num_star_names_drawn","tags":"","url":"proc/num_star_names_drawn.html"},{"title":"num_stars – vkframes","text":"private pure function num_stars(self) Number of stars read. Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(in) :: self Return Value integer Source Code pure integer function num_stars ( self ) class ( SkySphere ), intent ( in ) :: self num_stars = self % n_stars end function num_stars","tags":"","url":"proc/num_stars.html"},{"title":"raw_size – vkframes","text":"private pure function raw_size(mag) A star's pixel diameter from its apparent magnitude, from its brightness\nand luminance (OpenFrames' getStarPixelSizeFromMagnitude). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: mag apparent magnitude Return Value real(kind=wp) Called by proc~~raw_size~~CalledByGraph proc~raw_size raw_size proc~read_stars read_stars proc~read_stars->proc~raw_size proc~star_to_point star_to_point proc~read_stars->proc~star_to_point proc~star_to_point->proc~raw_size proc~set_star_data SkySphere%set_star_data proc~set_star_data->proc~read_stars Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure real ( wp ) function raw_size ( mag ) real ( wp ), intent ( in ) :: mag !! apparent magnitude real ( wp ) :: la , l la = 10 0.0_wp ** ( - 2.0_wp / 5.0_wp ) ! transition luminance l = 10 0.0_wp ** ( - mag / 5.0_wp ) ! relative luminance raw_size = 2.0_wp * sqrt ( l / ( l ** ( 2.0_wp / 3.0_wp ) + la )) end function raw_size","tags":"","url":"proc/raw_size.html"},{"title":"read_constellations – vkframes","text":"private  function read_constellations(self, file) result(ok) Read the constellations of file (found with find_data_file; '' for\nnone) into self%lines and self%groups, in place of those read before.\nFalse (those kept) if it can't be found or read. Arguments Type Intent Optional Attributes Name type( SkySphere ), intent(inout) :: self character(len=*), intent(in) :: file constellation file ('' for none) Return Value logical Calls proc~~read_constellations~~CallsGraph proc~read_constellations read_constellations proc~find_data_file find_data_file proc~read_constellations->proc~find_data_file proc~sky_direction sky_direction proc~read_constellations->proc~sky_direction proc~find_in_dirs find_in_dirs proc~find_data_file->proc~find_in_dirs Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~read_constellations~~CalledByGraph proc~read_constellations read_constellations proc~set_constellations SkySphere%set_constellations proc~set_constellations->proc~read_constellations Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code logical function read_constellations ( self , file ) result ( ok ) type ( SkySphere ), intent ( inout ) :: self character ( len =* ), intent ( in ) :: file !! constellation file ('' for none) character ( len = :), allocatable :: path character ( len = 1024 ) :: line real ( c_float ), allocatable :: lines (:,:), tmp (:,:) type ( Constellation ), allocatable :: groups (:), gtmp (:) real ( wp ) :: v ( 4 ) integer :: unit , status , n , ng , k ok = . true . if ( len_trim ( file ) == 0 ) then self % constellation_file = '' self % n_lines = 0 self % n_groups = 0 return end if ok = . false . path = find_data_file ( file ) if ( len ( path ) == 0 ) then write ( * , '(a)' ) 'vkframes: constellation file ' // trim ( file ) // ' not found (set VKFRAMES_DATA_PATH)' return end if open ( newunit = unit , file = path , status = 'old' , action = 'read' , iostat = status ) if ( status /= 0 ) then write ( * , '(a)' ) 'vkframes: could not open the constellation file ' // path return end if allocate ( lines ( 8 , 1024 ), groups ( 128 )) n = 0 ng = 0 do read ( unit , '(a)' , iostat = status ) line if ( status /= 0 ) exit k = scan ( line , achar ( 13 )) ! (CRLF line ends) if ( k > 0 ) line ( k :) = '' line = adjustl ( line ) if ( line ( 1 : 2 ) == 'N ' ) then ! a constellation if ( ng == size ( groups )) then allocate ( gtmp ( 2 * ng )) gtmp ( 1 : ng ) = groups ( 1 : ng ) call move_alloc ( gtmp , groups ) end if ng = ng + 1 groups ( ng ) = Constellation ( trim ( adjustl ( line ( 3 :))), n + 1 , n ) cycle end if if ( len_trim ( line ) == 0 . or . line ( 1 : 1 ) == '#' ) cycle k = index ( line , '#' ) ! (a comment after the line) if ( k > 0 ) line ( k :) = '' read ( line , * , iostat = status ) v ! dec1, ra1, dec2, ra2 (degrees, hours) if ( status /= 0 ) cycle if ( n == size ( lines , 2 )) then allocate ( tmp ( 8 , 2 * n )) tmp (:, 1 : n ) = lines (:, 1 : n ) call move_alloc ( tmp , lines ) end if n = n + 1 lines (:, n ) = real ([ sky_direction ( v ( 2 ), v ( 1 )), 0.0_wp , sky_direction ( v ( 4 ), v ( 3 )), 0.0_wp ], c_float ) if ( ng > 0 ) groups ( ng )% last = n end do close ( unit ) call move_alloc ( lines , self % lines ) call move_alloc ( groups , self % groups ) self % n_lines = n self % n_groups = ng self % constellation_file = trim ( file ) ok = . true . end function read_constellations","tags":"","url":"proc/read_constellations.html"},{"title":"read_stars – vkframes","text":"private  function read_stars(self) result(ok) Read the stars of the catalog into self%stars. Arguments Type Intent Optional Attributes Name type( SkySphere ), intent(inout) :: self Return Value logical Calls proc~~read_stars~~CallsGraph proc~read_stars read_stars proc~add_name add_name proc~read_stars->proc~add_name proc~after_fields after_fields proc~read_stars->proc~after_fields proc~find_data_file find_data_file proc~read_stars->proc~find_data_file proc~raw_size raw_size proc~read_stars->proc~raw_size proc~size_of size_of proc~read_stars->proc~size_of proc~star_to_point star_to_point proc~read_stars->proc~star_