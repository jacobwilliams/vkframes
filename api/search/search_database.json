e_frame->proc~set_color~2 proc~place_axes place_axes proc~place_axes->proc~move_x_axis proc~place_axes->proc~move_y_axis proc~place_axes->proc~move_z_axis proc~place_grid_axes place_grid_axes proc~place_grid_axes->proc~move_x_axis proc~place_grid_axes->proc~move_y_axis proc~place_grid_axes->proc~move_z_axis proc~segments_set_color CustomLineSegments%segments_set_color proc~segments_set_color->proc~set_color~2 proc~set_label_alignment ReferenceFrame%set_label_alignment proc~set_label_alignment->proc~relayout_labels proc~set_label_size ReferenceFrame%set_label_size proc~set_label_size->proc~relayout_labels proc~sphere_set_color Sphere%sphere_set_color proc~sphere_set_color->proc~set_color~2 proc~time_set_color TimeHandle%time_set_color proc~time_set_color->proc~set_color~2 proc~vector_set_color VectorHandle%vector_set_color proc~vector_set_color->proc~set_color~2 interface~referenceframe ReferenceFrame interface~referenceframe->proc~new_reference_frame proc~grid_set_parameters LatLonGrid%grid_set_parameters proc~grid_set_parameters->proc~place_grid_axes proc~new_coordinate_axes new_coordinate_axes proc~new_coordinate_axes->proc~place_axes proc~new_lat_lon_grid new_lat_lon_grid proc~new_lat_lon_grid->proc~place_grid_axes proc~new_radial_plane new_radial_plane proc~new_radial_plane->proc~place_axes proc~plane_set_parameters RadialPlane%plane_set_parameters proc~plane_set_parameters->proc~place_axes proc~resize WindowProxy%resize proc~resize->proc~frame proc~run WindowProxy%run proc~run->proc~frame proc~set_axis_length CoordinateAxes%set_axis_length proc~set_axis_length->proc~place_axes interface~coordinateaxes CoordinateAxes interface~coordinateaxes->proc~new_coordinate_axes interface~latlongrid LatLonGrid interface~latlongrid->proc~new_lat_lon_grid interface~radialplane RadialPlane interface~radialplane->proc~new_radial_plane Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine arrow_size ( n_segments , n_vertices , n_indices ) integer , intent ( in ) :: n_segments !! segments around integer , intent ( out ) :: n_vertices !! number of vertices integer , intent ( out ) :: n_indices !! number of triangle indices (3 per triangle) n_vertices = 6 * ( n_segments + 1 ) + 2 n_indices = 15 * n_segments end subroutine arrow_size","tags":"","url":"proc/arrow_size.html"},{"title":"ellipsoid – vkframes","text":"public pure subroutine ellipsoid(radii, n_lon, n_lat, xyz, normals, uv, indices) A triaxial ellipsoid with semi-axes radii (x, y, z) centered at the\norigin, for an equirectangular texture in geodetic coordinates. The vertex at geodetic latitude lat and longitude lon is the point\nwhose surface normal is n = (cos lat cos lon, cos lat sin lon, sin lat):\np = (a&#94;2 nx, b&#94;2 ny, c&#94;2 nz) / sqrt(a&#94;2 nx&#94;2 + b&#94;2 ny&#94;2 + c&#94;2 nz&#94;2).\nSo the normals are exact and texture rows are at geodetic latitude.\n(OpenFrames makes an ellipsoid by scaling a sphere, which skews the\nnormals and maps the texture by parametric latitude.) Longitude 0 is on +x and the north pole on +z; texture u runs from\nlongitude -180 (u = 0) to +180 (u = 1), v from the north pole (v = 0) to\nthe south pole (v = 1). The seam column and pole rows are duplicated so\nthe texture wraps; triangles are counter-clockwise seen from outside, and\nthe degenerate triangles at the poles are left out. Indices are 0-based.\nSizes are given by ellipsoid_size . Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(3) :: radii semi-axes along x, y, z integer, intent(in) :: n_lon segments in longitude (>= 3) integer, intent(in) :: n_lat segments in latitude (>= 2) real(kind=c_float), intent(out), dimension(:,:) :: xyz (3, n_vertices) real(kind=c_float), intent(out), dimension(:,:) :: normals (3, n_vertices) real(kind=c_float), intent(out), dimension(:,:) :: uv (2, n_vertices) integer(kind=c_int32_t), intent(out), dimension(:) :: indices (n_indices) Called by proc~~ellipsoid~~CalledByGraph proc~ellipsoid ellipsoid proc~ellipsoid_create ellipsoid_create proc~ellipsoid_create->proc~ellipsoid proc~build_lod_mesh build_lod_mesh proc~build_lod_mesh->proc~ellipsoid_create proc~sphere_build_contents Sphere%sphere_build_contents proc~sphere_build_contents->proc~ellipsoid_create proc~sphere_build_contents->proc~build_lod_mesh proc~sphere_create sphere_create proc~sphere_create->proc~ellipsoid_create proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~build_lod_mesh Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine ellipsoid ( radii , n_lon , n_lat , xyz , normals , uv , indices ) real ( c_double ), dimension ( 3 ), intent ( in ) :: radii !! semi-axes along x, y, z integer , intent ( in ) :: n_lon !! segments in longitude (>= 3) integer , intent ( in ) :: n_lat !! segments in latitude (>= 2) real ( c_float ), dimension (:,:), intent ( out ) :: xyz !! (3, n_vertices) real ( c_float ), dimension (:,:), intent ( out ) :: normals !! (3, n_vertices) real ( c_float ), dimension (:,:), intent ( out ) :: uv !! (2, n_vertices) integer ( c_int32_t ), dimension (:), intent ( out ) :: indices !! (n_indices) real ( c_double ), parameter :: pi = acos ( - 1.0_c_double ) real ( c_double ) :: lat , lon , n ( 3 ), r2 ( 3 ), p ( 3 ) integer :: i , j , k , a , b , c , d r2 = radii ** 2 do j = 0 , n_lat lat = - 0.5_c_double * pi + pi * real ( j , c_double ) / real ( n_lat , c_double ) do i = 0 , n_lon lon = - pi + 2.0_c_double * pi * real ( i , c_double ) / real ( n_lon , c_double ) k = j * ( n_lon + 1 ) + i + 1 n = [ cos ( lat ) * cos ( lon ), cos ( lat ) * sin ( lon ), sin ( lat )] p = r2 * n xyz (:, k ) = real ( p / sqrt ( dot_product ( p , n )), c_float ) normals (:, k ) = real ( n , c_float ) uv (:, k ) = real ([ real ( i , c_double ) / real ( n_lon , c_double ), & 1.0_c_double - real ( j , c_double ) / real ( n_lat , c_double )], c_float ) end do end do ! quad (i, j): a = (i, j), b = (i+1, j), c = (i+1, j+1), d = (i, j+1); ! triangles (a, b, c) and (a, c, d), except (a, b, c) on the south row ! and (a, c, d) on the north row, which are degenerate k = 0 do j = 0 , n_lat - 1 do i = 0 , n_lon - 1 a = j * ( n_lon + 1 ) + i b = a + 1 d = a + n_lon + 1 c = d + 1 if ( j > 0 ) then indices ( k + 1 : k + 3 ) = int ([ a , b , c ], c_int32_t ) k = k + 3 end if if ( j < n_lat - 1 ) then indices ( k + 1 : k + 3 ) = int ([ a , c , d ], c_int32_t ) k = k + 3 end if end do end do end subroutine ellipsoid","tags":"","url":"proc/ellipsoid.html"},{"title":"ellipsoid_size – vkframes","text":"public pure subroutine ellipsoid_size(n_lon, n_lat, n_vertices, n_indices) Number of vertices and triangle indices of ellipsoid(radii, n_lon, n_lat, ...) . Arguments Type Intent Optional Attributes Name integer, intent(in) :: n_lon segments in longitude integer, intent(in) :: n_lat segments in latitude integer, intent(out) :: n_vertices number of vertices integer, intent(out) :: n_indices number of triangle indices (3 per triangle) Ca