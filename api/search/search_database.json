wp] the view direction (unit vector, root frame) real(kind=wp), public :: half_h = 1.0_wp half the viewport (framebuffer pixels) real(kind=wp), public :: half_w = 1.0_wp half the viewport (framebuffer pixels) integer, public :: kinds = -1 the kinds of hits wanted: bit k for kind k (all) real(kind=wp), public :: max_depth = huge(1.0_wp) hits deeper than this aren't wanted (nearest only) real(kind=wp), public :: near = 0.0_wp the smallest depth in front of the eye real(kind=wp), public :: ortho (4) = [-1.0_wp, 1.0_wp, -1.0_wp, 1.0_wp] (orthographic: left, right, bottom, top) logical, public :: perspective = .true. (true: perspective; false: orthographic) real(kind=wp), public :: pixel_ratio = 1.0_wp framebuffer pixels per window unit (for line widths, marker sizes) real(kind=wp), public :: right (3) = [1.0_wp, 0.0_wp, 0.0_wp] the camera's right axis (unit vector, root frame) real(kind=wp), public :: tan_y = 0.0_wp tan(vertical field of view / 2) real(kind=wp), public :: tolerance = 6.0_wp framebuffer pixels real(kind=wp), public :: up (3) = [0.0_wp, 0.0_wp, 1.0_wp] the camera's up axis (unit vector, root frame) real(kind=wp), public :: x = 0.0_wp the cursor (-1 to 1, y up) real(kind=wp), public :: y = 0.0_wp the cursor (-1 to 1, y up) Functions public pure function pick_camera (eye, center, up, perspective, fovy, aspect, ortho, width, height, x, y, tolerance) result(cam) The camera of a pick: eye, center and up (root frame), a perspective\nprojection ( fovy , degrees, and aspect ) or an orthographic one\n( ortho : left, right, bottom, top), a viewport of width x height framebuffer pixels, the cursor (x, y: -1 to 1, y up) and the tolerance\n(framebuffer pixels). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: eye (3) the camera (root frame) real(kind=wp), intent(in) :: center (3) the camera (root frame) real(kind=wp), intent(in) :: up (3) the camera (root frame) logical, intent(in) :: perspective (true: perspective; false: orthographic) real(kind=wp), intent(in) :: fovy vertical field of view (degrees; perspective) real(kind=wp), intent(in) :: aspect width / height (perspective) real(kind=wp), intent(in) :: ortho (4) left, right, bottom, top (orthographic) integer, intent(in) :: width the viewport (framebuffer pixels) integer, intent(in) :: height the viewport (framebuffer pixels) real(kind=wp), intent(in) :: x the cursor (-1 to 1, y up) real(kind=wp), intent(in) :: y the cursor (-1 to 1, y up) real(kind=wp), intent(in) :: tolerance (framebuffer pixels) Return Value type( PickCamera ) public  function point_pick (cam, p, pixels, depth, extra) result(hit) Point p (root frame) is within the tolerance (plus extra pixels, e.g.\nhalf a marker's size) of the cursor: its distance from it (pixels) and\nits depth. Arguments Type Intent Optional Attributes Name type( PickCamera ), intent(in) :: cam real(kind=wp), intent(in) :: p (3) real(kind=wp), intent(out) :: pixels distance from the cursor (framebuffer pixels) real(kind=wp), intent(out) :: depth (scene units) real(kind=wp), intent(in), optional :: extra added to the tolerance (framebuffer pixels) Return Value logical public  function project (cam, p, sx, sy, depth) result(visible) The screen offset (framebuffer pixels) of point p (root frame) from the\ncursor, and its depth; false if it is behind the eye. Arguments Type Intent Optional Attributes Name type( PickCamera ), intent(in) :: cam real(kind=wp), intent(in) :: p (3) real(kind=wp), intent(out) :: sx offset from the cursor (framebuffer pixels, y up) real(kind=wp), intent(out) :: sy offset from the cursor (framebuffer pixels, y up) real(kind=wp), intent(out) :: depth (scene units) Return Value logical public  function ray_ellipsoid (origin, dir, center, axes, radii, distance, point, local) result(hit) Where the ray (origin, unit dir) first meets the ellipsoid centered at center with semi-axes radii along the columns of axes (unit\nvectors): the distance along the ray, the point, and the point in the\nellipsoid's axes (from its center). False if it misses (or the\nellipsoid is behind). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: origin (3) the ray (dir: a unit vector) real(kind=wp), intent(in) :: dir (3) the ray (dir: a unit vector) real(kind=wp), intent(in) :: center (3) the ellipsoid's center real(kind=wp), intent(in) :: axes (3,3) its axes (columns: unit vectors) real(kind=wp), intent(in) :: radii (3) its semi-axes along them real(kind=wp), intent(out) :: distance along the ray (huge() if missed) real(kind=wp), intent(out) :: point (3) the point met real(kind=wp), intent(out) :: local (3) the point in the ellipsoid's axes, from its center Return Value logical public  function ray_line (origin, dir, point, axis, s, line_point) result(hit) The point of the line through point along axis closest to the ray\n(origin, unit dir): its parameter s (the point is point + s * axis,\naxis normalized) and the point. False if the ray and the line are\nparallel (within 1e-6 of it, as a sine squared), or the closest point\nof the ray is behind its origin. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: origin (3) the ray (dir: a unit vector) real(kind=wp), intent(in) :: dir (3) the ray (dir: a unit vector) real(kind=wp), intent(in) :: point (3) the line (axis: any length but 0) real(kind=wp), intent(in) :: axis (3) the line (axis: any length but 0) real(kind=wp), intent(out) :: s along the line (scene units, from point ) real(kind=wp), intent(out) :: line_point (3) the point of the line Return Value logical public  function ray_plane (origin, dir, point, normal, distance, hit_point) result(hit) Where the ray (origin, unit dir) meets the plane through point with\nnormal normal : the distance along the ray and the point. False if the\nray is parallel to the plane (within 1e-6 of it, as a cosine) or the\nplane is behind. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: origin (3) the ray (dir: a unit vector) real(kind=wp), intent(in) :: dir (3) the ray (dir: a unit vector) real(kind=wp), intent(in) :: point (3) the plane (normal: any length but 0) real(kind=wp), intent(in) :: normal (3) the plane (normal: any length but 0) real(kind=wp), intent(out) :: distance along the ray (huge() if missed) real(kind=wp), intent(out) :: hit_point (3) the point met Return Value logical public  function ray_sphere (origin, dir, center, radius, near, far) result(hit) Where the ray (origin, unit dir) meets the sphere of center and radius : the distances along the ray of where it enters and leaves\n( near <= far ; near < 0 if the origin is inside). False if it\nmisses, or the sphere is behind. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: origin (3) the ray (dir: a unit vector) real(kind=wp), intent(in) :: dir (3) the ray (dir: a unit vector) real(kind=wp), intent(in) :: center (3) the sphere's center real(kind=wp), intent(in) :: radius its radius (> 0) real(kind=wp), intent(out) :: near distances along the ray (huge() if missed) real(kind=wp), intent(out) :: far distances along the ray (huge() if missed) Return Value logical public  function segment_pick (cam, a, b, pixels, s, depth, extra) result(hit) Segment a-b (root frame) passes within the tolerance (plus extra pixels, e.g. half the line's width) of the cursor: the distance\n(pixels) of its closest point, the fraction s of the way from a to b\nof that point in the scene (perspective-correct), and its depth. The\npart behind the eye is cut off. Arguments Type Intent Optional Attributes Name type( PickCamera ), intent(in) :: cam real(kind=wp), intent(in) :: a (3) real(kind=wp), intent(in) :: b (3) real(kind=wp), intent(out) :: pixels distance from the cursor (framebuffer pixels) real(kind=wp), intent(out) :: s fraction of the way from a to b (0 to 1) real(kind=wp), intent(out) :: depth (scene units) real(kind=wp), intent(in), optional :: extra added to the tolerance (framebuffer pixels) Return Value logical public  function sphere_near (cam, c, r, extra) result(near) A sphere (root frame: center c, radius r) might be within the tolerance\n(plus extra pixels) of the cursor on the screen (false only if it\nsurely isn't: to skip what it bounds). Arguments Type Intent Optional Attributes Name type( PickCamera ), intent(in) :: cam real(kind=wp), intent(in) :: c (3) real(kind=wp), intent(in) :: r real(kind=wp), intent(in), optional :: extra added to the tolerance (framebuffer pixels) Return Value logical public pure function wants (cam, kind) Hits of kind (vkf_frames' PICK_*) are wanted. Arguments Type Intent Optional Attributes Name type( PickCamera ), intent(in) :: cam integer, intent(in) :: kind a PICK_* constant of vkf_frames Return Value logical Subroutines public pure subroutine ray (cam, origin, dir) The ray from the eye through the cursor (root frame; dir a unit vector). Arguments Type Intent Optional Attributes Name type( PickCamera ), intent(in) :: cam real(kind=wp), intent(out) :: origin (3) real(kind=wp), intent(out) :: dir (3)","tags":"","url":"module/vkf_pick.html"},{"title":"vkf_gui – vkframes","text":"GUI panels in a window (not in OpenFrames): Dear ImGui panels, buttons,\ncheckboxes and sliders, drawn flat on top of the scene, through vsgImGui. A window's Gui ( WindowProxy%gui() , made on first use) is described\nimmediate-mode, each frame (e.g. in the event handler's before_draw , or\nin the frame loop before frame() ): panels ( begin_panel ... end_panel )\nholding text, buttons, checkboxes, sliders, combo boxes (drop-down\nmenus), separators. A widget's call gives what the user did with it at the\nframe before: button is true once after a click; checkbox , slider and combo change the value given (and are true then). What isn't described in a frame isn't shown in it. A panel is placed where ImGui puts it (and can be moved), or at a position\n(0 to 1 across the window, y up, as HUD text), at first or every frame\n( follow ): e.g. next to a picked object, kept at its screen position\n(WindowProxy%screen_position). A title starting with '##' gives no title\nbar (a callout). Clicks, drags and keys over a panel go to it: the camera,\nthe event handler and picking don't get them. The GUI is scaled by the\nwindow's pixel ratio. A Gui is a handle (copies are the same GUI), valid\nwhile its window is open. Uses vkf_layer vkf_math iso_c_binding module~~vkf_gui~~UsesGraph module~vkf_gui vkf_gui iso_c_binding iso_c_binding module~vkf_gui->iso_c_binding module~vkf_layer vkf_layer module~vkf_gui->module~vkf_layer module~vkf_math vkf_math module~vkf_gui->module~vkf_math module~vkf_layer->iso_c_binding iso_fortran_env iso_fortran_env module~vkf_math->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~vkf_gui~~UsedByGraph module~vkf_gui vkf_gui module~vkf_window vkf_window module~vkf_window->module~vkf_gui module~vkframes vkframes module~vkframes->module~vkf_gui module~vkframes->module~vkf_window Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Derived Types type, public :: Gui A window's GUI panels (see the module documentation). Components Type Visibility Attributes Name Initial type(c_ptr), public :: handle = c_null_ptr the window's GUI in the C++ layer (null: none) Type-Bound Procedures procedure, public :: begin_panel procedure, public :: button procedure, public :: checkbox procedure, public :: combo procedure, public :: end_panel procedure, public :: is_valid procedure, public :: same_line procedure, public :: separator procedure, public :: slider procedure, public :: text Functions private  function button (self, label) A button: true once after it was clicked. Arguments Type Intent Optional Attributes Name class( Gui ), intent(inout) :: self character(len=*), intent(in) :: label Return Value logical private  function checkbox (self, label, value) result(changed) A checkbox showing value : true (and value changed) after the user\nchanged it. Arguments Type Intent Optional Attributes Name class( Gui ), intent(inout) :: self character(len=*), intent(in) :: label logical, intent(inout) :: value Return Value logical private  function combo (self, label, index, items) result(changed) A combo box (a drop-down menu) of items (trailing blanks trimmed),\nshowing item index (1-based): true (and index changed) after the\nuser chose another. Arguments Type Intent Optional Attributes Name class( Gui ), intent(inout) :: self character(len=*), intent(in) :: label integer, intent(inout) :: index character(len=*), intent(in) :: items (:) Return Value logical private pure function is_valid (self) False if the window has no GUI (not open). Arguments Type Intent Optional Attributes Name class( Gui ), intent(in) :: self Return Value logical private  function slider (self, label, value, low, high, format) result(changed) A slider showing value , from low to high : true (and value changed) after the user moved it. format : how the value is shown\n(printf's, e.g. '%.0f km'; default '%.4g'). Arguments Type Intent Optional Attributes Name class( Gui ), intent(inout) :: self character(len=*), intent(in) :: label real(kind=wp), intent(inout) :: value real(kind=wp), intent(in) :: low real(kind=wp), intent(in) :: high character(len=*), intent(in), optional :: format Return Value logical Subroutines private  subroutine begin_panel (self, title, position, pivot, follow) A panel titled title ('##name': no title bar), with the widgets up to end_panel . position ([x, y], 0 to 1 across the window, y up; default:\nwhere ImGui puts it) is where its point pivot is ([0, 0], the default:\nits top left; [0.5, 1]: the middle of its bottom); with follow , every\nframe (and it can't be moved), else at first. Arguments Type Intent Optional Attributes Name class( Gui ), intent(inout) :: self character(len=*), intent(in) :: title real(kind=wp), intent(in), optional :: position (2) [x, y] (0 to 1 across the window, y up) real(kind=wp), intent(in), optional :: pivot (2) the panel's point at position (0 to 1, from its top left) logical, intent(in), optional :: follow place it every frame (default false: at first) private  subroutine end_panel (self) End the panel started by begin_panel . Arguments Type Intent Optional Attributes Name class( Gui ), intent(inout) :: self private  subroutine same_line (self) The next widget on the same line as the last. Arguments Type Intent Optional Attributes Name class( Gui ), intent(inout) :: self private  subroutine separator (self) A horizontal separator line. Arguments Type Intent Optional Attributes Name class( Gui ), intent(inout) :: self private  subroutine text (self, line) A line of text. Arguments Type Intent Optional Attributes Name class( Gui ), intent(inout) :: self character(len=*), intent(in) :: line","tags":"","url":"module/vkf_gui.html"},{"title":"vkf_trajectory – vkframes","text":"Trajectory data: times with positions, attitudes and optional data vectors, as\nin OpenFrames' Trajectory. Data are appended: each time may get one position (with num_optionals optional vectors), one attitude and one color, so there may be fewer\npositions, attitudes or colors than times (data can arrive separately).\nColors are optional (not in OpenFrames): a CurveArtist draws a trajectory\nwith colors in them, blended along each segment between its points'\ncolors (see CurveArtist%set_point_colors). No sorting is done; times\nare expected to be monotonic, increasing or decreasing. Indices are 1-based. Differences from OpenFrames:\n* Storage grows by doubling, positions, attitudes and colors separately, so\n  a trajectory without attitudes (colors) holds no attitude (color) memory. reserve sets it for a known size; compact frees what's unused once a\n  trajectory is complete (one copy of each array; storage_bytes says\n  what is held).\n* Instead of subscriber callbacks, a trajectory counts its changes\n  ( revision ) and clears ( generation ): a reader such as an artist compares\n  them with what it last saw and updates only what changed (e.g. uploads only\n  the points appended since).\n* No locking: vkframes updates and renders on one thread. Between points, a trajectory is linear in time: point_at(t) is the point\nat any time (the first or last point outside its times), and point_between(k, k2, t) and time_fraction(k, k2, t) the same between\ntwo points already found (followers, trace mode's tail, intermediate\nmarkers and time handles use them). Uses iso_fortran_env vkf_math iso_c_binding module~~vkf_trajectory~~UsesGraph module~vkf_trajectory vkf_trajectory iso_c_binding iso_c_binding module~vkf_trajectory->iso_c_binding iso_fortran_env iso_fortran_env module~vkf_trajectory->iso_fortran_env module~vkf_math vkf_math module~vkf_trajectory->module~vkf_math module~vkf_math->iso_fortran_env Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~vkf_trajectory~~UsedByGraph module~vkf_trajectory vkf_trajectory module~vkf_artists vkf_artists module~vkf_artists->module~vkf_trajectory module~vkf_frames vkf_frames module~vkf_artists->module~vkf_f