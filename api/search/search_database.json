ure subroutine segment_pattern (self, factor, bits) The dash pattern: its factor and 16 pattern bits . Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(in) :: self integer, intent(out) :: factor integer, intent(out) :: bits procedure, public :: pickable => artist_pickable private pure function artist_pickable (self) Whether pick tests what this artist draws. Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(in) :: self Return Value logical procedure, public :: release => segment_release private  subroutine segment_release (self) Forget the render nodes (see artist_release). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self procedure, public :: set_color => segment_set_color private  subroutine segment_set_color (self, color) The segments' color: [r, g, b] (alpha unchanged) or [r, g, b, a], 0 to 1. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self real(kind=wp), intent(in) :: color (:) procedure, public :: set_dash_mode => segment_set_dash_mode private  subroutine segment_set_dash_mode (self, mode) The dash pattern's layout (see CurveArtist%set_dash_mode): screen-locked\ndashes start again at each segment's start, as GL_LINES; DASH_FIXED\n(strips only) is taken as DASH_SCENE. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self integer, intent(in) :: mode DASH_SCENE or DASH_SCREEN procedure, public :: set_end_data private  function set_end_data (self, src) result(valid) All three end sources at once (see set_start_data). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src (3) Return Value logical procedure, public :: set_end_relative private  subroutine set_end_relative (self, relative) Relative ends (default false): each segment ends at its start plus the\nend sources' values (a vector drawn from each point), not at them. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self logical, intent(in) :: relative procedure, public :: set_end_scale private  subroutine set_end_scale (self, scale) Set the scale of all three end sources (with relative ends: the length\ndrawn per unit of the stored vector, e.g. km per newton). Only this\nartist's segments are written again. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self real(kind=wp), intent(in) :: scale procedure, public :: set_end_x_data private  function set_end_x_data (self, src) result(valid) Where the x of the segments' end points come from (see set_start_x_data). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical procedure, public :: set_end_y_data private  function set_end_y_data (self, src) result(valid) Where the y of the segments' end points come from (see set_start_x_data). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical procedure, public :: set_end_z_data private  function set_end_z_data (self, src) result(valid) Where the z of the segments' end points come from (see set_start_x_data). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical procedure, public :: set_highlight => segment_set_highlight private  subroutine segment_set_highlight (self, mode, color, arrow_spacing, arrow_speed, band_width, pulse_period) Highlight the segments (see CurveArtist%set_highlight): the arrows run\nalong each segment from its start to its end. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self integer, intent(in) :: mode HIGHLIGHT_* (added) real(kind=wp), intent(in), optional :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) real(kind=wp), intent(in), optional :: arrow_spacing between arrows (window units; default 40) real(kind=wp), intent(in), optional :: arrow_speed (window units per second; default 50) real(kind=wp), intent(in), optional :: band_width of the arrows' band (window units; default 12) real(kind=wp), intent(in), optional :: pulse_period (s; default 1.5) procedure, public :: set_pattern => segment_set_pattern private  subroutine segment_set_pattern (self, factor, pattern) A dash pattern (see CurveArtist%set_pattern), starting again at the\nstart of each segment. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self integer, intent(in) :: factor integer, intent(in) :: pattern procedure, public :: set_pickable => artist_set_pickable private  subroutine artist_set_pickable (self, pickable) Whether pick tests what this artist draws (default true; e.g. false for\na spacecraft's marker beside its orbit's curve). Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(inout) :: self logical, intent(in) :: pickable procedure, public :: set_start_data private  function set_start_data (self, src) result(valid) All three start (end) sources at once, e.g. position_sources(3) or\noptional_sources(1). Returns whether the trajectory has their data. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src (3) Return Value logical procedure, public :: set_start_x_data private  function set_start_x_data (self, src) result(valid) Where the x (y, z) of the segments' start (end) points come from.\nReturns whether the trajectory has the data of all sources. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical procedure, public :: set_start_y_data private  function set_start_y_data (self, src) result(valid) Where the y of the segments' start points come from (see set_start_x_data). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical procedure, public :: set_start_z_data private  function set_start_z_data (self, src) result(valid) Where the z of the segments' start points come from (see set_start_x_data). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type( DataSource ), intent(in) :: src Return Value logical procedure, public :: set_stride private  subroutine set_stride (self, stride) Draw a segment at points 1, 1 + stride, 1 + 2 stride, ... (stride >= 1). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self integer, intent(in) :: stride procedure, public :: set_trace_mode private  subroutine set_trace_mode (self, enabled) Draw only the part up to the current time (see the module documentation). Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(inout) :: self logical, intent(in) :: enabled procedure, public :: set_trajectory => segment_set_trajectory private  subroutine segment_set_trajectory (self, traj) Draw traj ; with the default data sources, from the origin to its\npositions (per its DOF). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self type( Trajectory ), intent(in), target :: traj procedure, public :: set_width => segment_set_width private  subroutine segment_set_width (self, width) The segments' width in window units (logical pixels). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self real(kind=wp), intent(in) :: width procedure, public :: start_data_sources private pure function start_data_sources (self) result(s) The x, y and z data sources of the segments' start points. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(in) :: self Return Value type( DataSource ), (3) procedure, public :: stride private pure function stride (self) The stride: a segment at every stride-th point. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(in) :: self Return Value integer procedure, public :: trace_mode private pure function trace_mode (self) Whether only the part up to the current time is drawn. Arguments Type Intent Optional Attributes Name class( TrajectoryArtist ), intent(in) :: self Return Value logical procedure, public :: update => segment_update private  subroutine segment_update (self, t) Write the segments added (all of them on a redraw), and draw them all or,\nin trace mode, those at the points passed at time t. Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(inout) :: self real(kind=wp), intent(in) :: t procedure, public :: width => segment_width private pure function segment_width (self) The segments' width (window units). Arguments Type Intent Optional Attributes Name class( SegmentArtist ), intent(in) :: self Return Value real(kind=wp) Source Code type , extends ( TrajectoryArtist ), public :: SegmentArtist private type ( DataSource ) :: start_ ( 3 ), end_ ( 3 ) !! start and end points' x, y, z data sources logical :: default_data = . true . !! sources not set: the origin to the positions, per the DOF logical :: end_relative_ = . false . !! the end sources: an offset from the start integer :: stride_ = 1 !! a segment at every stride_-th point (>= 1) real ( wp ) :: color_ ( 4 ) = [ 1.0_wp , 1.0_wp , 1.0_wp , 1.0_wp ] !! segment color [r, g, b, a] (default white) real ( wp ) :: width_ = 1.0_wp !! segment width (window units) integer :: pattern_factor = 1 !! window units per pattern bit (>= 1) integer :: pattern_ = int ( z 'FFFF' ) !! 16-bit dash pattern (z'FFFF': solid) type ( HighlightStyle ) :: highlight_ !! (see set_highlight) ! rendering type ( LineChain ) :: chain !! the line buffers (a pair of points per segment) integer :: n_written = 0 !! segments written to the chain integer :: n_drawn = 0 !! segments drawn from it integer :: first_drawn_ = 1 !! the first of them (trace mode, decreasing times: later) contains procedure :: set_trajectory => segment_set_trajectory procedure :: set_start_x_data , set_start_y_data , set_start_z_data procedure :: set_end_x_data , set_end_y_data , set_end_z_data procedure :: set_start_data , set_end_data procedure :: start_data_sources , end_data_sources procedure :: set_end_relative , end_relative , set_end_scale procedure :: set_stride , stride procedure :: set_color => segment_set_color , color => segment_color procedure :: set_width => segment_set_width , width => segment_width procedure :: set_pattern => segment_set_pattern , pattern => segment_pattern procedure :: set_highlight => segment_set_highlight , highlight => segment_highlight procedure :: set_dash_mode => segment_set_dash_mode , dash_mode => segment_dash_mode procedure :: build => segment_build procedure :: update => segment_update procedure :: release => segment_release procedure :: num_chunks => segment_num_chunks , num_drawn => segment_num_drawn procedure :: first_drawn => segment_first_drawn procedure :: drawn_segment end type SegmentArtist","tags":"","url":"type/segmentartist.html"},{"title":"TrailStyle – vkframes ","text":"type, private :: TrailStyle A curve's trail (see the module documentation and set_trail). Inherited by type~~trailstyle~~InheritedByGraph type~trailstyle TrailStyle type~curveartist CurveArtist type~curveartist->type~trailstyle trail_ Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Components Type Visibility Attributes Name Initial real(kind=wp), public :: color (4,2) = 1.0_wp each part's color (if replace ) [r, g, b, a] integer, public :: factor (2) = 1 each part's dash pattern real(kind=wp), public :: fade = 0.25_wp of each part's window, faded toward its cutoff (0 to 1) real(kind=wp), public :: future = 0.0_wp the window (s before and after the current time; huge: no limit) logical, public :: on = .false. real(kind=wp), public :: opacity (2) = 1.0_wp each part's alpha multiplied by it real(kind=wp), public :: past = 0.0_wp the window (s before and after the current time; huge: no limit) integer, public :: pattern (2) = int(z'FFFF') each part's dash pattern logical, public :: replace (2) = .false. each part in its own color (else the line's) Source Code type :: TrailStyle logical :: on = . false . real ( wp ) :: past = 0.0_wp , future = 0.0_wp !! the window (s before and after the current time; huge: no limit) real ( wp ) :: fade = 0.25_wp !! of each part's window, faded toward its cutoff (0 to 1) real ( wp ) :: color ( 4 , 2 ) = 1.0_wp !! each part's color (if `replace`) [r, g, b, a] logical :: replace ( 2 ) = . false . !! each part in its own color (else the line's) real ( wp ) :: opacity ( 2 ) = 1.0_wp !! each part's alpha multiplied by it integer :: factor ( 2 ) = 1 , pattern ( 2 ) = int ( z 'FFFF' ) !! each part's dash pattern end type TrailStyle","tags":"","url":"type/trailstyle.html"},{"title":"TrajectoryArtist – vkframes ","text":"type, public, abstract :: TrajectoryArtist The base of the trajectory artists (OpenFrames' TrajectoryArtist). Inherits type~~trajectoryartist~~InheritsGraph type~trajectoryartist TrajectoryArtist type~trajectory Trajectory type~trajectoryartist->type~trajectory traj Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Inherited by type~~trajectoryartist~~In