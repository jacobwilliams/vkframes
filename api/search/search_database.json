ubmodule of an interface in a parent module. Source Code subroutine set_light_diffuse ( self , rgb ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: rgb ( 3 ) self % light_diffuse_ = rgb call apply_window_light ( self ) end subroutine set_light_diffuse","tags":"","url":"proc/set_light_diffuse.html"},{"title":"set_light_position – vkframes","text":"private  subroutine set_light_position(self, position) The light's position in eye coordinates (x right, y up, z toward the\nviewer): [x, y, z, 0] for a directional light from direction (x, y, z),\n[x, y, z, 1] for a point light (OpenFrames' setLightPosition; default\n[0, 0, 1, 0], a headlight). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: position (4) [x, y, z, w], eye coordinates (not all 0) Calls proc~~set_light_position~~CallsGraph proc~set_light_position WindowProxy%set_light_position proc~apply_window_light apply_window_light proc~set_light_position->proc~apply_window_light interface~vkf_light_set vkf_light_set proc~apply_window_light->interface~vkf_light_set interface~vkf_viewer_light vkf_viewer_light proc~apply_window_light->interface~vkf_viewer_light Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_light_position ( self , position ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: position ( 4 ) !! [x, y, z, w], eye coordinates (not all 0) if ( all ( position ( 1 : 3 ) == 0.0_wp ) . and . position ( 4 ) == 0.0_wp ) return self % light_position_ = position call apply_window_light ( self ) end subroutine set_light_position","tags":"","url":"proc/set_light_position.html"},{"title":"set_light_specular – vkframes","text":"private  subroutine set_light_specular(self, rgb) The specular color of the window's light (see set_light_ambient ). Type Bound WindowProxy Arguments Type Intent Optional Attributes Name class( WindowProxy ), intent(inout) :: self real(kind=wp), intent(in) :: rgb (3) Calls proc~~set_light_specular~~CallsGraph proc~set_light_specular WindowProxy%set_light_specular proc~apply_window_light apply_window_light proc~set_light_specular->proc~apply_window_light interface~vkf_light_set vkf_light_set proc~apply_window_light->interface~vkf_light_set interface~vkf_viewer_light vkf_viewer_light proc~apply_window_light->interface~vkf_viewer_light Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_light_specular ( self , rgb ) class ( WindowProxy ), intent ( inout ) :: self real ( wp ), intent ( in ) :: rgb ( 3 ) self % light_specular_ = rgb call apply_window_light ( self ) end subroutine set_light_specular","tags":"","url":"proc/set_light_specular.html"},{"title":"set_scene – vkframes","text":"private  subroutine set_scene(self, fm) Show the scene of fm (which must stay alive while shown). For now, set\nit before the window's first frame. Type Bound WindowProxy A