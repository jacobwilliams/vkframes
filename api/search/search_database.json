 3 ), frac , t0 , t1 integer :: j if ( self % next_index == 0 ) then self % next_index = 2 self % arc = 0.0_wp self % prev_arc = 0.0_wp self % target = self % spacing_ self % prev_point = self % traj % point ( counted ( self , 1 , n ), self % sources_ ) end if do j = self % next_index , n p = self % traj % point ( counted ( self , j , n ), self % sources_ ) self % arc = self % arc + norm2 ( p - self % prev_point ) t0 = self % traj % time ( counted ( self , j - 1 , n )) t1 = self % traj % time ( counted ( self , j , n )) do while ( self % arc >= self % target ) frac = ( self % target - self % prev_arc ) / ( self % arc - self % prev_arc ) call push_intermediate ( self , self % prev_point + frac * ( p - self % prev_point ), t0 + frac * ( t1 - t0 )) self % target = self % target + self % spacing_ end do self % prev_arc = self % arc self % prev_point = p end do self % next_index = n + 1 end subroutine intermediates_by_distance","tags":"","url":"proc/intermediates_by_distance.html"},{"title":"intermediates_by_time – vkframes","text":"private  subroutine intermediates_by_time(self, n) Every spacing time units after the first time, before the last\n(counted from the start or the end). Arguments Type Intent Optional Attributes Name type( MarkerArtist ), intent(inout) :: self integer, intent(in) :: n Calls proc~~intermediates_by_time~~CallsGraph proc~intermediates_by_time intermediates_by_time point_between point_between proc~intermediates_by_time->point_between proc~counted counted proc~intermediates_by_time->proc~counted proc~push_intermediate push_intermediate proc~intermediates_by_time->proc~push_intermediate time_index time_index proc~intermediates_by_time->time_index proc~color_at color_at proc~push_intermediate->proc~color_at proc~is_colored LineChain%is_colored proc~push_intermediate->proc~is_colored proc~color_at->time_index num_times num_times proc~color_at->num_times proc~point_rgba_or point_rgba_or proc~color_at->proc~point_rgba_or proc~color Trajectory%color proc