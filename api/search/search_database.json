ents Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value logical private  function new_sphere (name, radius, color) result(s) A sphere named name , of radius radius (default 1) and color color ([r, g, b] or [r, g, b, a]; default white, 90% opaque). Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name real(kind=wp), intent(in), optional :: radius scene units (default 1) real(kind=wp), intent(in), optional :: color (:) [r, g, b] or [r, g, b, a] (0 to 1) Return Value type( Sphere ) private  function night_texture_map (self) result(file) The night texture file ('' for none). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value character(len=:), allocatable private  function num_lod_meshes (self) result(n) Number of level-of-detail meshes built so far (0 without level of detail). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value integer private pure function opacity (self) The body's opacity (set_opacity). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp) private pure function radii (self) result(r) The semi-axes: radius * sphere_scale. Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp), (3) private pure function radius (self) The sphere's radius (scene units). Arguments Type Intent Optional Attributes Name class( Sphere ), intent(in) :: self Return Value real(kind=wp) private  function read_texture (self, file) result(image) An image handle for texture file file (null if none or unreadable). Arguments Type Intent Optional Attributes Name type( Sphere ), intent(in) :: self character(len=:), intent(in), allocatable :: file found with find_data_file (unallocated or '': none) Return Value type(c_ptr) private pure function sphere_attitude (self) result(q) Attitude of the body in its frame (quaternion [x, y,