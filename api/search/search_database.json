":"private  subroutine set_attitude(self, q) The sky's attitude in the root frame (quaternion [x, y, z, w]): e.g. to\nturn an equatorial catalog into an ecliptic root frame. Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(inout) :: self real(kind=wp), intent(in) :: q (4) quaternion [x, y, z, w] (any length > 0) Calls proc~~set_attitude~~CallsGraph proc~set_attitude SkySphere%set_attitude proc~apply_attitude apply_attitude proc~set_attitude->proc~apply_attitude proc~apply_name_attitude apply_name_attitude proc~set_attitude->proc~apply_name_attitude interface~vkf_sky_style vkf_sky_style proc~apply_attitude->interface~vkf_sky_style interface~vkf_sky_style_changed vkf_sky_style_changed proc~apply_attitude->interface~vkf_sky_style_changed proc~check_status check_status proc~apply_attitude->proc~check_status proc~quat_to_matrix quat_to_matrix proc~apply_attitude->proc~quat_to_matrix interface~vkf_transform_set_matrix vkf_transform_set_matrix proc~apply_name_attitude->interface~vkf_transform_set_matrix proc~apply_name_attitude->proc~check_status proc~apply_name_attitude->proc~quat_to_matrix Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_attitude ( self , q ) class ( SkySphere ), intent ( inout ) :: self real ( wp ), intent ( in ) :: q ( 4 ) !! quaternion [x, y, z, w] (any length > 0) if ( norm2 ( q ) <= 0.0_wp ) return self % attitude_ = q / norm2 ( q ) call apply_attitude ( self , self % texture_node ) call apply_attitude ( self , self % star_node ) call apply_attitude ( self , self % line_node ) call apply_name_attitude ( self ) end subroutine set_attitude","tags":"","url":"proc/set_attitude.html"},{"title":"set_draw_mode – vkframes","text":"private  subroutine set_draw_mode(self, mode) What to draw: SKY_NONE, or SKY_TEXTURE + SKY_STARS (default; each only\nif given). Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(inout) :: self integer, intent(in) :: mode SKY_NONE, or a sum of SKY_TEXTURE and SKY_STARS Calls proc~~set_draw_mode~~CallsGraph proc~set_draw_mode SkySphere%set_draw_mode proc~apply_mode apply_mode proc~set_draw_mode->proc~apply_mode interface~vkf_switch_set vkf_switch_set proc~apply_mode->interface~vkf_switch_set proc~check_status check_status proc~apply_mode->proc~check_status Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine set_draw_mode ( self , mode ) class ( SkySphere ), intent ( inout ) :: self integer , intent ( in ) :: mode !! SKY_NONE, or a sum of SKY_TEXTURE and SKY_STARS self % mode = mode call apply_mode ( self ) end subroutine set_draw_mode","tags":"","url":"proc/set_draw_mode.html"},{"title":"star – vkframes","text":"private pure subroutine star(self, i, direction, rgb, size) Star i (1 to num_stars): its direction (unit vector, sky frame), color\n(rgb, dimmed) and size (window units). Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(in) :: self integer, intent(in) :: i 1 to num_stars real(kind=wp), intent(out) :: direction (3) unit vector, sky frame real(kind=wp), intent(out) :: rgb (3) color, dimmed (0 to 1) real(kind=wp), intent(out) :: size window units Source Code pure subroutine star ( self , i , direction , rgb , size ) class ( SkySphere ), intent ( in ) :: self integer , intent ( in ) :: i !! 1 to num_stars real ( wp ), intent ( out ) :: direction ( 3 ) !! unit vector, sky frame real ( wp ), intent ( out ) :: rgb ( 3 ) !! color, dimmed (0 to 1) real ( wp ), intent ( out ) :: size !! window units direction = real ( self % stars ( 1 : 3 , i ), wp ) size = real ( self % stars ( 4 , i ), wp ) rgb = real ( self % stars ( 5 : 7 , i ), wp ) end subroutine star","tags":"","url":"proc/star.html"},{"title":"star_name – vkframes","text":"private  subroutine star_name(self, i, name, mag, which) Named star i (1 to num_star_names): its name, apparent magnitude and\nstar (1 to num_stars: see star ). Type Bound SkySphere Arguments Type Intent Optional Attributes Name class( SkySphere ), intent(in) :: self integer, intent(in) :: i 1 to num_star_names character(len=:), intent(out), allocatable :: name the catalog's name real(kind=wp), intent(out) :: mag apparent magnitude integer, intent(out) :: which the star (1 to num_stars) Source Code subroutine star_name ( self , i , name , mag , which ) class ( SkySphere ), intent ( in ) :: self integer , intent ( in ) :: i !! 1 to num_star_names character ( len = :), allocatable , intent ( out ) :: name !! the catalog's name real ( wp ), intent ( out ) :: mag !! apparent magnitude integer , intent ( out ) :: which !! the star (1 to num_stars) name = self % names ( i )% text mag = self % names ( i )% mag which = self % names ( i )% star end subroutine star_name","tags":"","url":"proc/star_name.html"},{"title":"star_to_point – vkframes","text":"private pure subroutine star_to_point(ra, dec, mag, ci, dir, rgb, size) A star's direction, color (from its B-V color index: Ballesteros'\ntemperature, then Tanner Helland's temperature to RGB) and raw size\n(OpenFrames' SkySphere::StarToPoint). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: ra right ascension and declination (radians) real(kind=wp), intent(in) :: dec right ascension and declination (radians) real(kind=wp), intent(in) :: mag apparent magnitude and B-V color index real(kind=wp), intent(in) :: ci apparent magnitude and B-V color index real(kind=wp), intent(out) :: dir (3) unit vector real(kind=wp), intent(out) :: rgb (3) color (0 to 1) real(kind=wp), intent(out) :: size raw size (as raw_size) Calls proc~~star_to_point~~CallsGraph proc~star_to_point star_to_point proc~raw_size raw_size proc~star_to_point->proc~raw_size Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~star_to_point~~CalledByGraph proc~star_to_point star_to_point proc~read_stars read_stars proc~read_stars->proc~star_to_point proc~set_star_data SkySphere%set_star_data proc~set_star_data->proc~read_stars Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine star_to_point ( ra , dec , mag , ci , dir , rgb , size ) real ( wp ), intent ( in ) :: ra , dec !! right ascension and declination (radians) real ( wp ), intent ( in ) :: mag , ci !! apparent magnitude and B-V color index real ( wp ), intent ( out ) :: dir ( 3 ) !! unit vector real ( wp ), intent ( out ) :: rgb ( 3 ) !! color (0 to 1) real ( wp ), intent ( out ) :: size !! raw size (as raw_size) real ( wp ) :: t dir = [ cos ( ra ) * cos ( dec ), sin ( ra ) * cos ( dec ), sin ( dec )] size = raw_size ( mag ) t = 0.01_wp * 460 0.0_wp * ( 1.0_wp / ( 0.92_wp * ci + 1.7_wp ) + 1.0_wp / ( 0.92_wp * ci + 0.62_wp )) if ( t <= 6 6.0_wp ) then rgb ( 1 ) = 25 5.0_wp rgb ( 2 ) = 9 9.4708025861_wp * log ( t ) - 16 1.1195681661_wp else rgb ( 1 ) = 32 9.698727446_wp * ( t - 6 0.0_wp ) ** ( - 0.1332047592_wp ) rgb ( 2 ) = 28 8.1221695283_wp * ( t - 6 0.0_wp ) ** ( - 0.0755148492_wp ) end if if ( t >= 6 6.0_wp ) then rgb ( 3 ) = 25 5.0_wp else if ( t <= 1 9.0_wp ) then rgb ( 3 ) = 0.0_wp else rgb ( 3 ) = 13 8.5177312231_wp * log ( t - 1 0.0_wp ) - 30 5.0447927307_wp end if rgb = max ( 0.0_wp , min ( 25 5.0_wp , rgb )) / 25 5.0_wp end subroutine star_to_point","tags":"","url":"proc/star_to_point.html"},{"title":"chosen_trajectory – vkframes","text":"private  function chosen_trajectory(self, t) result(k) The trajectory to follow at time t: the current one if it contains t,\nelse the first that does, else the closest. Arguments Type Intent Optional Attributes Name type( TrajectoryFollower ), intent(in) :: self real(kind=wp), intent(in) :: t Return Value integer Calls proc~~chosen_trajectory~~CallsGraph proc~chosen_trajectory chosen_trajectory proc~time_distance Trajectory%time_distance proc~chosen_trajectory->proc~time_distance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~chosen_trajectory~~CalledByGraph proc~chosen_trajectory chosen_trajectory proc~update TrajectoryFollower%update proc~update->proc~chosen_trajectory proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code integer function chosen_trajectory ( self , t ) result ( k ) type ( TrajectoryFollower ), intent ( in ) :: self real ( wp ), intent ( in ) :: t real ( wp ) :: dist , min_dist integer :: j k = 1 if ( self % n == 1 ) return if ( self % current >= 1 . and . self % current <= self % n ) then if ( self % trajs ( self % current )% p % time_distance ( t ) <= 0.0_wp ) then k = self % current return end if end if min_dist = huge ( 1.0_wp ) do j = 1 , self % n dist = self % trajs ( j )% p % time_distance ( t ) if ( dist <= 0.0_wp ) then k = j return else if ( dist < min_dist ) then min_dist = dist k = j end if end do end function chosen_trajectory","tags":"","url":"proc/chosen_trajectory.html"},{"title":"data_sources – vkframes","text":"private pure function data_sources(self) result(s) Where the followed position's x, y and z come from. Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value type( DataSource ), (3) Source Code pure function data_sources ( self ) result ( s ) class ( TrajectoryFollower ), intent ( in ) :: self type ( DataSource ) :: s ( 3 ) s = self % sources_ end function data_sources","tags":"","url":"proc/data_sources.html"},{"title":"data_valid – vkframes","text":"private pure function data_valid(self) True if every followed trajectory has the data the position sources use. Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value logical Calls proc~~data_valid~~CallsGraph proc~data_valid TrajectoryFollower%data_valid proc~verify_data Trajectory%verify_data proc~data_valid->proc~verify_data Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~data_valid~~CalledByGraph proc~data_valid TrajectoryFollower%data_valid proc~set_x_data TrajectoryFollower%set_x_data proc~set_x_data->proc~data_valid proc~set_y_data TrajectoryFollower%set_y_data proc~set_y_data->proc~data_valid proc~set_z_data TrajectoryFollower%set_z_data proc~set_z_data->proc~data_valid proc~update TrajectoryFollower%update proc~update->proc~data_valid proc~update~3 ReferenceFrame%update proc~update~3->proc~update proc~drawable_update DrawableTrajectory%drawable_update proc~drawable_update->proc~update~3 proc~fm_update FrameManager%fm_update proc~fm_update->proc~update~3 proc~sphere_update Sphere%sphere_update proc~sphere_update->proc~update~3 proc~terrain_update TerrainBody%terrain_update proc~terrain_update->proc~update~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure logical function data_valid ( self ) class ( TrajectoryFollower ), intent ( in ) :: self integer :: k data_valid = . true . do k = 1 , self % n if (. not . self % trajs ( k )% p % verify_data ( self % sources_ )) data_valid = . false . end do end function data_valid","tags":"","url":"proc/data_valid.html"},{"title":"follow_data – vkframes","text":"private pure function follow_data(self) What is followed: FOLLOW_POSITION and/or FOLLOW_ATTITUDE (combined with ior). Type Bound TrajectoryFollower Arguments Type Intent Optional Attributes Name class( TrajectoryFollower ), intent(in) :: self Return Value integer Source Code pure integer function follow_data ( self ) class ( TrajectoryFollower ), intent ( in ) :: self follow_data = self % data_ end function follow_data","tags":"","url":"proc/follow_data.html"},{"title":"foll